        <ns1:IAO_0000115 xml:lang="en">A tendency inhering in a person, grounded in a material basis, whose realization may produce a target material disease entity.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Predisposition / risk proper</ns1:IAO_0000118>
        <dc:description xml:lang="en">A tendency inhering in a person, grounded in a material basis, whose realization may produce a target material disease entity.</dc:description>
        <rdfs:label xml:lang="en">disease predisposition</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/MILD/MILD_120024 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/MILD/MILD_120024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:subClassOf>
