    <!-- http://purl.obolibrary.org/obo/PATO_0001309 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001309">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0002062"/>
        <ns1:IAO_0000115>A process quality inhering in a bearer by virtue of the bearer&apos;s magnitude of the temporal extent between the starting and ending point.</ns1:IAO_0000115>
        <ns2:hasAlternativeId>PATO:0000081</ns2:hasAlternativeId>
