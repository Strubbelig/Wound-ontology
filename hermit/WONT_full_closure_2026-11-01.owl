            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000478"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0004035"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0007505"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002353"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000414"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">An injury that has as part a portion of the skin, alone or in continuity with damaged deeper tissue such as fascia, muscle or bone, and that is the output of a wound development process. Damaged skin tissue is a wound even while it is still attached, such as necrotic skin; an injury that involves no skin, such as a burn of the inner airways, is no wound.</ns1:IAO_0000115>
        <rdfs:label>Wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000381 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000381">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000093"/>
        <ns1:IAO_0000115 xml:lang="en">A drain that is placed in a wound or in soft tissue to conduct accumulated fluid out of it.</ns1:IAO_0000115>
        <rdfs:label>Wound and soft tissue drain</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000382 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000382">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000452"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000453"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000454"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000455"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A material entity that is part of a wound and consists of the tissue forming the floor of the wound, bounded by the wound edges.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Structural axiom, not a definition. This class was label-only under a bare BFO_0000040, so nothing in the ontology said it had anything to do with a wound - the mereology lived only in the class name. Asserting part_of some Wound makes the name&apos;s claim checkable and is what CQ025 was failing on. No genus-differentia definition is written here; per the C6 decision the axiom is left to carry the content.</ns1:IAO_0000116>
        <rdfs:label>Wound base</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000383 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000383">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <ns1:IAO_0000115 xml:lang="en">A material entity that is a structured community of microorganisms embedded in a self-produced extracellular polymeric matrix and attached to the surface or tissue of a wound.</ns1:IAO_0000115>
        <rdfs:label>Wound biofilm</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000384 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000384">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002353"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000414"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000541"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
        <ns1:IAO_0000115 xml:lang="en">A wound that is the output of a wound development process that has as part a process of the course of a venous insufficiency disorder. No claim is made that the disorder caused the wound.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">RENAMED. The previous label, &apos;Wound causally related to impaired venous backflow&apos;, asserted in its own name a causal relation that this ontology does not hold to be assertable: what a disease causes cannot be reliably separated from what the disease is. Only co-location in space and time is claimed. The old label is deliberately NOT retained as an alternative term, because doing so would keep the rejected causal claim in circulation as a searchable synonym.</ns1:IAO_0000116>
        <ns1:IAO_0000118 xml:lang="en">venous insufficiency ulcer</ns1:IAO_0000118>
        <ns1:IAO_0000118 xml:lang="en">venous wound</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Venous insufficiency wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000387 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000387">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000423"/>
        <ns1:IAO_0000115 xml:lang="en">A wound treatment process in which non-adherent material, exudate and microorganisms are removed from the wound surface and surrounding skin by rinsing or wiping with a cleansing solution, without excising tissue.</ns1:IAO_0000115>
        <rdfs:label>Wound cleansing process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000388 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000388">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000423"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002233"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A wound treatment process that brings the edges of a wound into apposition or covers the wound defect with tissue, so that the wound is no longer open.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Wound closure process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000389 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000389">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120089"/>
        <ns1:IAO_0000115 xml:lang="en">A treatment plan specification that prescribes the method and means by which a wound is to be closed in a wound closure process.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Wound closure technique</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Wound closure technique plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000391 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000391">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000409"/>
        <ns1:IAO_0000115 xml:lang="en">A wound healing related physiological process in which myofibroblasts in the granulation tissue draw the wound edges centripetally toward each other, reducing the area of the open wound.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Wound contraction process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000392 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000392">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120020"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002353"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000433"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A material disease entity that is the output of a wound dehiscence process.</ns1:IAO_0000115>
        <rdfs:label>Wound dehiscence</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000395 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000395">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120047"/>
        <ns1:IAO_0000115 xml:lang="en">A disease diagnostic process that is directed at a wound of a patient and assesses whether it is present and what its nature and characteristics are.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Wound diagnostic process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000397 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000397">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000082"/>
        <ns1:IAO_0000115 xml:lang="en">A planned process in which observations and findings about a wound of a patient are recorded in an information artifact.</ns1:IAO_0000115>
        <rdfs:label>Wound documentation process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000398 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000398">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0001300"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_120013"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000085"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_120012"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A device that bears a wound coverage function.</ns1:IAO_0000115>
        <rdfs:label>Wound dressing</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000399 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000399">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000427"/>
        <ns1:IAO_0000115 xml:lang="en">A wound-integrating wound dressing that consists of a membrane made of polylactide, a resorbable polymer of lactic acid.</ns1:IAO_0000115>
        <rdfs:label>Wound dressing composed of a polylactide membrane</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000400 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000400">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000427"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0005454"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A wound-integrating wound dressing that consists of a porous foam matrix made of polyurethane.</ns1:IAO_0000115>
        <rdfs:label>Wound dressing composed of polyurethane foam</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000401 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000401">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000434"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000451"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A material entity that is part of a wound and consists of the tissue at the margin of the wound where the wound bed adjoins the surrounding intact skin.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Structural axiom, not a definition. This class was label-only under a bare BFO_0000040, so nothing in the ontology said it had anything to do with a wound - the mereology lived only in the class name. Asserting part_of some Wound makes the name&apos;s claim checkable and is what CQ025 was failing on. No genus-differentia definition is written here; per the C6 decision the axiom is left to carry the content.</ns1:IAO_0000116>
        <rdfs:label>Wound edge</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000402 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000402">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000423"/>
        <ns1:IAO_0000115 xml:lang="en">A wound treatment process in which the wound edge is shielded from agents and forces that would damage it, such as exudate or adhesive stripping.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Wound edge protection process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000403 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000403">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OMRSE_00000012"/>
        <ns1:IAO_0000115 xml:lang="en">A health care provider role that is borne by a person holding a specialised qualification in wound care and that is realized in the assessment and treatment of patients&apos; wounds.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Wound expert role</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000404 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000404">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <ns1:IAO_0000115 xml:lang="en">A material entity that is fluid released from the tissues of a wound, derived from blood plasma that has passed from the vasculature into the wound.</ns1:IAO_0000115>
        <rdfs:label>Wound exudate</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000405 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000405">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000389"/>
        <ns1:IAO_0000115 xml:lang="en">A wound closure technique plan specification that prescribes closing the wound by applying a tissue adhesive that bonds the approximated wound edges.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Wound tissue adhesive plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000406 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000406">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DRON_00000005"/>
        <ns1:IAO_0000115 xml:lang="en">A clinical drug product that has a semisolid dosage form and is intended for topical application to a wound.</ns1:IAO_0000115>
        <rdfs:label>Wound gel/ointment/cream</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000408 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000408">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120024"/>
        <ns1:IAO_0000115 xml:lang="en">A disease diagnostic result that is about a material disease entity consisting in the abnormal organization of the tissues of and around a wound of a patient, such that the wound does not progress through healing in the expected manner.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Moved from material disease entity to disease diagnostic result (curator, 2026-10-31): the name denotes a diagnostic classification, not one material disease entity; the material disease entity is what the diagnosis is about.</ns1:IAO_0000116>
        <ns1:IAO_0000116 xml:lang="en">Recategorised when the causal-role groupings &apos;Medical condition contributing to wound formation&apos; / &apos;affecting wound healing&apos; / &apos;contributing to blistering wounds&apos; were dissolved. Those classes grouped entities by what they were said to cause, which this ontology does not assert, and they mixed material disorders with dispositions and processes. Relevance to wounds is now carried by co-location axioms on the wound classes instead of by membership in a causal class.</ns1:IAO_0000116>
        <ns1:IAO_0000116 xml:lang="en">Reparented from BFO_0000016 disposition to MILD_120022 pathological disorder (since 2026-10-30 merged into MILD_120020 material disease entity, whose exact synonym it is). A disorder is not a disposition. What is present in the patient is an abnormal organisation of material components in and around the wound; impaired healing is what that disorder is a disorder OF, not a potential the disorder bears. The dispositional reading was a residue of the dissolved causal-role grouping, which mixed material disorders with dispositions and processes.</ns1:IAO_0000116>
        <rdfs:label>Wound healing disorder</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000409 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000409">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
        <ns1:IAO_0000115 xml:lang="en">A biological_process that occurs in an organism after tissue injury and is part of the restoration of the integrity of the injured tissue.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Wound healing related physiological process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000410 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000410">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120028"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IDO_0000528"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A course of the disease process in which pathogenic microorganisms invade and multiply in the tissue of a wound and elicit a host response.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Wound infection process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000411 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000411">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000423"/>
        <ns1:IAO_0000115 xml:lang="en">A wound treatment process in which a flow of liquid is applied to a wound to rinse debris, exudate and microorganisms from its surface.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Wound irrigation process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000412 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000412">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DRON_00000005"/>
        <ns1:IAO_0000115 xml:lang="en">A clinical drug product that is a liquid formulated for rinsing a wound in a wound irrigation process.</ns1:IAO_0000115>
        <rdfs:label>Wound irrigation solution</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000413 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000413">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OMRSE_00000012"/>
        <ns1:IAO_0000115 xml:lang="en">A health care provider role that is borne by a person holding a qualification in wound management and that is realized in organising and coordinating the wound care of patients.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Wound manager role</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000414 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000414">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120021"/>
        <ns1:IAO_0000115 xml:lang="en">A disorder development process in which a wound comes into being in a patient through disruption of the continuity of body tissue.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Wound development process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000415 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000415">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000197"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002559"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A quality that inheres in a patient, that is the extent of the pain that patient feels, and that is causally influenced by a wound.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Retyped from BFO_0000016 disposition to BFO_0000019 quality, and the bearer moved from the wound to the patient. Wound pain is pain felt by a patient; a wound does not feel, so it cannot be the bearer. There is always some degree of pain inhering in the patient, which is what makes this a quality rather than a disposition waiting to be realized - so the IAO_0000112 note about realization in debridement or dressing change was dropped with the disposition typing, because qualities are not realized. The single qualifying value is WONT_0000474 painful, mirroring macerated under degree of maceration.</ns1:IAO_0000116>
        <ns1:IAO_0000118 xml:lang="en">Wound pain</ns1:IAO_0000118>
        <ns1:IAO_0000232 xml:lang="en">ON MILD MODEL COMMITMENT 4. Commitment 4 forbids asserting a causal relation between ONE DISORDER AND ANOTHER, on the ground that what a disease causes cannot be separated from what it is. This axiom is outside that scope: the wound is a disorder, but the pain is a quality of the patient, not a second disorder, so no disorder-to-disorder aetiology is claimed and no co-location rewrite is needed. RO_0002559 causally influenced by was chosen over RO_0002452 has symptom and RO_0004023, both of which carry rdfs:domain OGMS_0000031 and would silently infer the OGMS disposition-based disease model that MILD rejects. RO_0002559 has no domain or range axiom, so it carries the intended content with no side effect.</ns1:IAO_0000232>
        <rdfs:label xml:lang="en">degree of wound pain</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000416 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000416">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000089"/>
        <ns1:IAO_0000115 xml:lang="en">A diagnostic process to assess wound characteristics in which an examiner touches and presses the wound and the surrounding tissue with the hands to perceive their physical properties.</ns1:IAO_0000115>
        <rdfs:label>Wound palpation</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000417 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000417">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A material entity that is part of a wound and consists of the tissue enclosing a space that extends from the wound bed under the wound edge or into deeper tissue.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Structural axiom, not a definition. This class was label-only under a bare BFO_0000040, so nothing in the ontology said it had anything to do with a wound - the mereology lived only in the class name. Asserting part_of some Wound makes the name&apos;s claim checkable and is what CQ025 was failing on. No genus-differentia definition is written here; per the C6 decision the axiom is left to carry the content.</ns1:IAO_0000116>
        <rdfs:label>Wound pocket</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000418 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000418">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120021"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000414"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FMA_67135"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A process that has the newly developed wound as a participant or output and does so with near certainty.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Wound development subprocess</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000419 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000419">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000395"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000448"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A wound diagnostic process that has as specified output a wound depth measurement datum.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Wound size measurement process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000420 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000420">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000398"/>
        <ns1:IAO_0000115 xml:lang="en">A wound dressing that is a non-adherent open-mesh layer placed in direct contact with the wound bed, which separates the wound from a secondary dressing and lets exudate pass through it.</ns1:IAO_0000115>
        <rdfs:label>Wound spacer grid</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000421 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000421">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000389"/>
        <ns1:IAO_0000115 xml:lang="en">A wound closure technique plan specification that prescribes holding the approximated wound edges together with adhesive skin closure strips placed across the wound.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Wound closure strip plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000422 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000422">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000395"/>
        <ns1:IAO_0000115 xml:lang="en">A wound diagnostic process that has as specified output a datum about the temperature of the wound bed or of the periwound skin.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Wound temperature assessment process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000423 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000423">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120086"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002233"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A disease disorder treatment process that has as participant a wound and is directed at that wound&apos;s healing or management.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Wound treatment process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000425 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000425">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000419"/>
        <ns1:IAO_0000115 xml:lang="en">A wound size measurement process that has as specified output a datum about the volume of the wound cavity.</ns1:IAO_0000115>
        <rdfs:label>Wound volumetrics</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000426 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000426">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000339"/>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
        <ns1:IAO_0000115 xml:lang="en">A traumatic wound that is the output of a trauma process in wound development which also has as output a fracture of a bone in the same body region.</ns1:IAO_0000115>
        <rdfs:label>Wound with accompanying fracture</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000427 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000427">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000398"/>
        <ns1:IAO_0000115 xml:lang="en">A wound dressing that is made to remain in the wound bed, where it is resorbed or becomes incorporated into the newly formed tissue.</ns1:IAO_0000115>
        <rdfs:label>Wound-integrating wound dressing</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000429 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000429">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000426"/>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000441"/>
        <ns1:IAO_0000115 xml:lang="en">A wound with accompanying fracture that is a skin wound through which the fracture site communicates with the outside of the body, i.e. the soft tissue wound of an open fracture graded by the Gustilo and Anderson classification.</ns1:IAO_0000115>
        <rdfs:label>Wounds classified according to Gustilo and Anderson</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000430 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000430">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000426"/>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000441"/>
        <ns1:IAO_0000115 xml:lang="en">A wound with accompanying fracture that is a skin wound whose accompanying soft-tissue damage is graded by the Tscherne and Oestern wound classification.</ns1:IAO_0000115>
        <rdfs:label>Wounds classified according to Tscherne and Oestern</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000432 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000432">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000002"/>
        <ns1:IAO_0000115 xml:lang="en">An abdominal drain consisting of a T-shaped tube whose short crossbar limbs lie in the lumen of the common bile duct and whose long limb leads out through the abdominal wall, bearing a function of draining bile externally.</ns1:IAO_0000115>
        <rdfs:label>T drain</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000433 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000433">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120021"/>
        <ns1:IAO_0000115 xml:lang="en">A disorder development process in which previously approximated wound edges separate.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Wound dehiscence process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000434 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000434">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <ns1:IAO_0000115 xml:lang="en">A quality of a wound edge that is the extent to which its tissue has been softened by prolonged exposure to moisture.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">degree of maceration</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000435 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000435">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000434"/>
        <ns1:IAO_0000115 xml:lang="en">A degree of maceration that qualifies its bearer as macerated.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">macerated</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000436 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000436">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000066"/>
        <ns1:IAO_0000115 xml:lang="en">A wound classification scale that stratifies burn wounds by the depth of tissue destroyed.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Burn classification scale</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000437 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000437">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_120016"/>
        <ns1:IAO_0000115 xml:lang="en">A wound classification grade that is a category of the burn classification scale.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Burn classification grade</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000438 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000438">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_120016"/>
        <ns1:IAO_0000115 xml:lang="en">A wound classification grade that is a category of the Shea classification of pressure ulcers.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Shea classification grade</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000439 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000439">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000066"/>
        <ns1:IAO_0000115 xml:lang="en">A wound classification scale that stratifies surgical wounds by degree of intraoperative microbial contamination.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">CDC surgical wound classification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000440 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000440">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_120016"/>
        <ns1:IAO_0000115 xml:lang="en">A wound classification grade that is a category of the CDC surgical wound classification.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">CDC surgical wound classification grade</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000441 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000441">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001025"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FMA_7163"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
        <ns1:IAO_0000115 xml:lang="en">A wound whose disrupted tissue is skin.</ns1:IAO_0000115>
        <rdfs:comment xml:lang="en">WONT-owned material counterpart of HP_0032674 Cutaneous wound. HP models it as a phenotypic abnormality (a specifically dependent continuant); WONT needs a material wound, so the two are related rather than one subsuming the other.</rdfs:comment>
        <rdfs:label xml:lang="en">Skin wound</rdfs:label>
        <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/HP_0032674"/>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000442 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000442">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000477"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0003606"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000477"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0004858"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A wound that has failed to progress through the phases of healing in an orderly and timely fashion.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Chronic non-healing wound</ns1:IAO_0000118>
        <ns1:IAO_0000118 xml:lang="en">Non-healing wound</ns1:IAO_0000118>
        <rdfs:comment xml:lang="en">WONT-owned material counterpart of HP_0032676, which HP models as a phenotypic abnormality. Bridged, not subsumed.</rdfs:comment>
        <rdfs:label xml:lang="en">Chronic wound</rdfs:label>
        <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/HP_0032676"/>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000443 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000443">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120024"/>
        <ns1:IAO_0000115 xml:lang="en">A disease diagnostic result that is about a superficial bacterial skin infection, characteristically caused by Streptococcus pyogenes, involving the upper dermis and superficial lymphatics.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Moved from material disease entity to disease diagnostic result (curator, 2026-10-31): the name denotes a diagnostic classification, not one material disease entity; the material disease entity is what the diagnosis is about.</ns1:IAO_0000116>
        <ns1:IAO_0000116 xml:lang="en">Recategorised when the causal-role groupings &apos;Medical condition contributing to wound formation&apos; / &apos;affecting wound healing&apos; / &apos;contributing to blistering wounds&apos; were dissolved. Those classes grouped entities by what they were said to cause, which this ontology does not assert, and they mixed material disorders with dispositions and processes. Relevance to wounds is now carried by co-location axioms on the wound classes instead of by membership in a causal class.</ns1:IAO_0000116>
        <rdfs:comment xml:lang="en">Minted because no erysipelas class was available in the imported DOID module. DOID_0050061 is erysipeloid - a distinct zoonotic infection caused by Erysipelothrix rhusiopathiae - and had been mislabelled &apos;Erysipel&apos; in WONT. Deliberately NOT related to DOID_0050061.</rdfs:comment>
        <rdfs:label xml:lang="en">Erysipelas</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000444 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000444">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000188"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_48218"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000188"/>
        <ns1:IAO_0000115 xml:lang="en">A material used for wound treatment that bears the antiseptic drug role.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Antiseptic agent</rdfs:label>
        <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_48218"/>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000445 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000445">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_3095"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_48218"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000444"/>
        <ns1:IAO_0000115 xml:lang="en">A biguanide that bears the antiseptic drug role.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Antiseptic biguanide</rdfs:label>
        <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_3095"/>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000446 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000446">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000469"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000473"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">An autoimmune tissue disorder that is about one or more mucosal blisters.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Moved from material disease entity to disease diagnostic result (curator, 2026-10-31): the name denotes a diagnostic classification, not one material disease entity; the material disease entity is what the diagnosis is about.</ns1:IAO_0000116>
        <ns1:IAO_0000116 xml:lang="en">This class had no BFO anchor while its only parent was ns1:DOID_0080841 pemphigoid. It is now an autoimmune tissue disorder, a disease diagnostic result, and is about the blisters in the mucosa it groups; no causal claim is made between the autoimmunity and the blistering (MILD model commitment 4).</ns1:IAO_0000116>
        <rdfs:comment xml:lang="en">Bridging annotation, not subsumption. DOID_0080841 pemphigoid is a nosological category, i.e. a specifically dependent continuant, whereas this class is a diagnostic result, an information content entity; the imported DOID module also carries only that generic term, which WONT had been narrowing by label. Asserting rdfs:subClassOf between them is the category error corrected here, so the relation is recorded as skos:relatedMatch instead.</rdfs:comment>
        <rdfs:label xml:lang="en">Mucous membrane pemphigoid</rdfs:label>
        <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/DOID_0080841"/>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000447 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000447">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120024"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/MILD/MILD_120020"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_1280"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A disease diagnostic result that is about a material disease entity that is an infection whose causal agent is a methicillin-resistant strain of Staphylococcus aureus.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Moved from material disease entity to disease diagnostic result (curator, 2026-10-31): the name denotes a diagnostic classification, not one material disease entity; the material disease entity is what the diagnosis is about.</ns1:IAO_0000116>
        <rdfs:comment xml:lang="en">WONT-owned diagnostic counterpart of HP_0032326, which HP models as a phenotypic abnormality. Bridged, not subsumed.</rdfs:comment>
        <rdfs:label xml:lang="en">MRSA infection</rdfs:label>
        <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/HP_0032326"/>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000448 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000448">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000109"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001595"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A measurement datum that is about the depth of a wound.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">wound depth measurement datum</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000449 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000449">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120023"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000197"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001764"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A disease predisposition that inheres in a human being of advanced age and whose realization impairs wound healing.</ns1:IAO_0000115>
        <rdfs:comment xml:lang="en">Advanced age is a quality of the patient (PATO_0001764), not a disease. It is represented here as the predisposition it grounds, rather than by subsuming the PATO quality under a disease class.</rdfs:comment>
        <rdfs:label xml:lang="en">advanced age wound-healing predisposition</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000450 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000450">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <ns1:IAO_0000115 xml:lang="en">A quality of a bodily tissue that is the degree of resistance it offers to deformation.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">degree of tissue firmness</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000451 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000451">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <ns1:IAO_0000115 xml:lang="en">A quality of skin that is the extent to which it remains attached to the tissue beneath it.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">degree of skin adherence to underlying tissue</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000452 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000452">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <ns1:IAO_0000115 xml:lang="en">A quality of a wound base that is the extent to which it is covered by granulation tissue.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">degree of granulation</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000453 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000453">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <ns1:IAO_0000115 xml:lang="en">A quality of a wound base that is the extent to which its tissue is necrotic.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">degree of necrosis</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000454 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000454">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <ns1:IAO_0000115 xml:lang="en">A quality of a wound base that is the extent to which it is covered by fibrin.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">degree of fibrin coverage</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000455 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000455">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <ns1:IAO_0000115 xml:lang="en">A quality of a wound base that is the extent to which it has been covered by new epithelium.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">degree of epithelialization</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000456 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000456">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000014"/>
        <ns1:IAO_0000115 xml:lang="en">A color that qualifies its bearer as reddened.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Redness</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">reddened</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000457 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000457">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000014"/>
        <ns1:IAO_0000115 xml:lang="en">A color that qualifies its bearer as livid.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">livid</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000458 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000458">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000450"/>
        <ns1:IAO_0000115 xml:lang="en">A tissue firmness that qualifies its bearer as softened.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">softened</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000459 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000459">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000451"/>
        <ns1:IAO_0000115 xml:lang="en">A degree of skin adherence that qualifies its bearer as undermined.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">undermined</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000460 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000460">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000452"/>
        <ns1:IAO_0000115 xml:lang="en">A degree of granulation that qualifies its bearer as granulating.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">granulating</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000461 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000461">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000453"/>
        <ns1:IAO_0000115 xml:lang="en">A degree of necrosis that qualifies its bearer as necrotic.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">necrotic</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000462 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000462">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000454"/>
        <ns1:IAO_0000115 xml:lang="en">A degree of fibrin coverage that qualifies its bearer as fibrin-covered.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">fibrin-covered</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000463 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000463">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000455"/>
        <ns1:IAO_0000115 xml:lang="en">A degree of epithelialization that qualifies its bearer as epithelialized.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">epithelialized</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000464 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000464">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120020"/>
        <ns1:IAO_0000115 xml:lang="en">A material disease entity that has as part an abnormal mass of tissue arising from autonomous, uncoordinated proliferation of its constituent cells.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Neoplasm</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000465 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000465">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000464"/>
        <ns1:IAO_0000115 xml:lang="en">A neoplasm whose constituent cells are disposed to invade surrounding tissue or to metastasize.</ns1:IAO_0000115>
        <rdfs:comment xml:lang="en">PATO_0002097 &apos;neoplastic, malignant&apos; is a quality and cannot subsume a material disease entity, so it is bridged rather than used as a parent. Minted under MILD_120020 because the imported DOID module contains no neoplasm or carcinoma class.</rdfs:comment>
        <rdfs:label xml:lang="en">Malignancy</rdfs:label>
        <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/PATO_0002097"/>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000466 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000466">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120024"/>
        <ns1:IAO_0000115 xml:lang="en">A disease diagnostic result that is about a material disease entity consisting in an abnormal structure of the wall or of the lumen of one or more blood vessels, such that perfusion of the tissue those vessels supply is reduced.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Minted as the shared parent of Microangiopathy (WONT_0000201) and Peripheral arterial occlusive disease (WONT_0000229) so that Angiopathic wound (WONT_0000015) has a single material co-location target. Before the causal-role groupings were dissolved, the two sat side by side under a class that grouped them by what they were said to cause; they are grouped here by what they are.</ns1:IAO_0000116>
        <ns1:IAO_0000116 xml:lang="en">Moved from material disease entity to disease diagnostic result (curator, 2026-10-31): the name denotes a diagnostic classification, not one material disease entity; the material disease entity is what the diagnosis is about.</ns1:IAO_0000116>
        <rdfs:label xml:lang="en">Angiopathy</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000467 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000467">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120024"/>
        <ns1:IAO_0000115 xml:lang="en">A disease diagnostic result that is about a material disease entity consisting in the abnormal organization of the insulin-secreting or insulin-responsive tissues of a patient, such that glucose homeostasis is not maintained.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Moved from material disease entity to disease diagnostic result (curator, 2026-10-31): the name denotes a diagnostic classification, not one material disease entity; the material disease entity is what the diagnosis is about.</ns1:IAO_0000116>
        <rdfs:comment xml:lang="en">Bridging annotation, not subsumption. The OBO term is a nosological category / specifically dependent continuant, whereas this class is a diagnostic result, an information content entity. Asserting rdfs:subClassOf between them is a category error, so the relation is recorded as skos:relatedMatch instead.</rdfs:comment>
        <rdfs:label xml:lang="en">Diabetic metabolic disorder</rdfs:label>
        <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/DOID_9351"/>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000468 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000468">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120024"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_120086"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A disease diagnostic result that is about an insufficient limb vein.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Moved from material disease entity to disease diagnostic result (curator, 2026-10-31): the name denotes a diagnostic classification, not one material disease entity; the material disease entity is what the diagnosis is about.</ns1:IAO_0000116>
        <rdfs:comment xml:lang="en">Bridging annotation, not subsumption. The OBO term is a nosological category / specifically dependent continuant, whereas this class is a diagnostic result, an information content entity. Asserting rdfs:subClassOf between them is a category error, so the relation is recorded as skos:relatedMatch instead.</rdfs:comment>
        <rdfs:label xml:lang="en">Venous insufficiency disorder</rdfs:label>
        <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/DOID_0050853"/>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000469 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000469">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120024"/>
        <ns1:IAO_0000115 xml:lang="en">A disease diagnostic result that is about a material disease entity consisting in tissue of a patient that has been damaged by an immune response directed against constituents normally present in that patient&apos;s own body.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Moved from material disease entity to disease diagnostic result (curator, 2026-10-31): the name denotes a diagnostic classification, not one material disease entity; the material disease entity is what the diagnosis is about.</ns1:IAO_0000116>
        <rdfs:comment xml:lang="en">Bridging annotation, not subsumption. The OBO term is a nosological category / specifically dependent continuant, whereas this class is a diagnostic result, an information content entity. Asserting rdfs:subClassOf between them is a category error, so the relation is recorded as skos:relatedMatch instead.</rdfs:comment>
        <rdfs:label xml:lang="en">Autoimmune tissue disorder</rdfs:label>
        <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/DOID_417"/>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000470 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000470">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120020"/>
        <ns1:IAO_0000115 xml:lang="en">A material disease entity consisting in a collection of lymphatic fluid within a non-epithelialised cavity in a bodily structure.</ns1:IAO_0000115>
        <rdfs:comment xml:lang="en">Bridging annotation, not subsumption. The OBO term is a nosological category / specifically dependent continuant, whereas this class is the material disease entity itself. Asserting rdfs:subClassOf between them is a category error, so the relation is recorded as skos:relatedMatch instead.</rdfs:comment>
        <rdfs:label xml:lang="en">Lymphocele</rdfs:label>
        <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/DOID_4347"/>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000471 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000471">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000409"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0042060"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A wound healing related physiological process in which fibrous connective tissue replaces tissue lost in a wound, yielding a scar rather than restoration of the original tissue architecture.</ns1:IAO_0000115>
        <rdfs:comment xml:lang="en">Bridging annotation, not subsumption. HP_0100699 &apos;Scarring&apos; is a phenotypic abnormality, i.e. a quality and therefore a continuant, whereas this class is the process of scar formation. Asserting rdfs:subClassOf between them crosses the continuant/occurrent divide and renders both unsatisfiable, so the relation is recorded as skos:relatedMatch instead.</rdfs:comment>
        <rdfs:label xml:lang="en">Scarring process</rdfs:label>
        <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/HP_0100699"/>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000472 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000472">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120020"/>
        <ns1:IAO_0000115 xml:lang="en">A material disease entity consisting in a localized collection of purulent material within a bodily structure, surrounded by inflamed and granulating tissue.</ns1:IAO_0000115>
        <rdfs:comment xml:lang="en">Bridging annotation, not subsumption. The OBO term is a phenotypic abnormality / nosological category, i.e. a specifically dependent continuant, whereas this class is the material disease entity itself. Asserting rdfs:subClassOf between them is a category error that renders both unsatisfiable, so the relation is recorded as skos:relatedMatch instead.</rdfs:comment>
        <rdfs:label xml:lang="en">Abscess</rdfs:label>
        <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/HP_0025615"/>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000473 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000473">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120020"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000344"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A material disease entity that is part of a mucosa and consists in a fluid-filled separation of the epithelium of that mucosa from the tissue beneath it.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">The anatomical location uses BFO_0000050 part_of rather than RO_0004026 disease has location, deliberately. RO_0004026 carries rdfs:domain OGMS_0000031, the disposition-based disease class that MILD refuses as a parent; asserting it of a MILD_120020 material disease entity would infer that subsumption and silently reimport the OGMS commitment this ontology was built to avoid. That is the same domain trap already documented on BFO_0000218 in MILD. Plain mereology carries the intended content with no such side effect, and stays in the EL profile.</ns1:IAO_0000116>
        <rdfs:comment xml:lang="en">Minted so that the blistering diseases of the mucosa can be composed out of the disorders that actually constitute them, rather than asserted as unanalysed nosological labels. Deliberately not restricted to autoimmune blistering: friction, thermal and drug-induced mucosal blisters are instances too. The autoimmune reading is added at the point of use by intersecting this class with WONT_0000469.</rdfs:comment>
        <rdfs:label xml:lang="en">Mucosal blister</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000474 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000474">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000415"/>
        <ns1:IAO_0000115 xml:lang="en">A degree of wound pain that qualifies its bearer as painful.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">painful</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000475 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000475">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <ns1:IAO_0000115 xml:lang="en">A quality of a material disease entity that is the time that has elapsed since the disorder came into existence, taken relative to the course expected for a disorder of its kind.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">degree of time after disease inception</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000476 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000476">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000475"/>
        <ns1:IAO_0000115 xml:lang="en">A degree of time after disease inception that qualifies its bearer as acute: the disorder is of recent onset and still within the period in which an orderly course is expected.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">acute</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000477 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000477">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000475"/>
        <ns1:IAO_0000115 xml:lang="en">A degree of time after disease inception that qualifies its bearer as chronic: the disorder has persisted beyond the period in which an orderly course is expected.</ns1:IAO_0000115>
        <rdfs:comment xml:lang="en">PATO_0001863 chronic is a duration quality of a process; this quality is borne by the disorder itself, a material entity. Bridged, not subsumed.</rdfs:comment>
        <rdfs:label xml:lang="en">chronic</rdfs:label>
        <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/PATO_0001863"/>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000478 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000478">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <ns1:IAO_0000115 xml:lang="en">A quality of a wound that is the extent to which microorganisms are present in it, multiply in it and elicit a response from its bearer.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">degree of microbial burden</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000479 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000479">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000478"/>
        <ns1:IAO_0000115 xml:lang="en">A degree of microbial burden that qualifies its bearer as contaminated: microorganisms are present in the wound but are not multiplying.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">contaminated</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000480 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000480">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000478"/>
        <ns1:IAO_0000115 xml:lang="en">A degree of microbial burden that qualifies its bearer as infected: microorganisms are present in the wound, multiply in it and elicit a host response.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Added as a determinate beside the process reading, not instead of it: Infected wound (WONT_0000163) also participates in a wound infection process (WONT_0000410).</ns1:IAO_0000116>
        <rdfs:label xml:lang="en">infected</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000481 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000481">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000479"/>
                                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000480"/>
                                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000512"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
        <ns1:IAO_0000115 xml:lang="en">A wound whose microbial burden is assessed on the IWII wound infection continuum: it bears the quality contaminated, colonized or infected.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Wound with microbial burden assessed according to IWII</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000482 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000482">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000310"/>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_120087"/>
        <ns1:IAO_0000115 xml:lang="en">A thermal wound in which the injury is confined to the epidermis.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">First-degree burn wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000483 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000483">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000310"/>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_120088"/>
        <ns1:IAO_0000115 xml:lang="en">A thermal wound in which the injury extends through the epidermis into the dermis.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">2nd degree burn</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Second-degree burn wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000484 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000484">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000310"/>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_120088"/>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_120089"/>
        <ns1:IAO_0000115 xml:lang="en">A thermal wound in which the injury extends through the full thickness of the skin into the subcutis.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Third-degree burn wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000485 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000485">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000310"/>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_120089"/>
        <ns1:IAO_0000115 xml:lang="en">A thermal wound in which the injury extends beyond the skin into underlying tissue such as fascia, muscle or bone.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Fourth-degree burn wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000486 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000486">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000478"/>
        <ns1:IAO_0000115 xml:lang="en">A degree of microbial burden that qualifies its bearer as sterile: no viable microorganisms are present in the wound.</ns1:IAO_0000115>
        <rdfs:comment xml:lang="en">PATO_0000956 sterile is a fertility quality and is deliberately not used here.</rdfs:comment>
        <rdfs:label xml:lang="en">sterile</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000487 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000487">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <ns1:IAO_0000115 xml:lang="en">A quality of a wound that is the extent to which its tissue is supplied with blood.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">degree of tissue perfusion</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000488 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000488">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000487"/>
        <ns1:IAO_0000115 xml:lang="en">A degree of tissue perfusion that qualifies its bearer as ischemic: the blood supply to the tissue is insufficient for its metabolic needs.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">ischemic</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000492 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000492">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000437"/>
        <ns1:IAO_0000115 xml:lang="en">A burn classification grade that is one of the three concentric zones of a burn wound distinguished by Jackson according to the severity of tissue damage.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Burn classification grade of the Jackson classification</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Jackson burn wound zone</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000493 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000493">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000436"/>
        <ns1:IAO_0000115 xml:lang="en">A wound classification scale that divides a burn wound into three concentric zones - coagulation, stasis and hyperemia - by the severity of tissue damage.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Jackson burn wound classification</ns1:IAO_0000118>
        <dcterms:source>Jackson DM. The diagnosis of the depth of burning. Br J Surg. 1953;40(164):588-596.</dcterms:source>
        <rdfs:label xml:lang="en">Jackson burn wound zone classification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000494 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000494">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000436"/>
        <ns1:IAO_0000115 xml:lang="en">A wound classification scale that grades a burn wound by the depth of tissue destroyed: superficial, superficial partial-thickness, deep partial-thickness and full-thickness. Derganc&apos;s subdivision of the second degree refines the degree scheme attributed to Hildanus.</ns1:IAO_0000115>
        <dcterms:source>Derganc M. The theoretical and practical significance of the subdivision of the second degree burn into superficial and deep type. In: Artz CP, ed. Research in Burns. Vol 9. American Institute of Biological Sciences and F A Davis; 1962:315-326.</dcterms:source>
        <dcterms:source>Wallace A. Classification of Burns: A History of Development; with Comments for Today and Thoughts for the Future. Thesis PhD. University of St Andrews; 1973.</dcterms:source>
        <rdfs:label xml:lang="en">Burn wound classification according to Hildanus and Derganc</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000495 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000495">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000437"/>
        <ns1:IAO_0000115 xml:lang="en">A burn classification grade that is a category of the burn wound classification according to Hildanus and Derganc.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Burn wound classification grade according to Hildanus and Derganc</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000504 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000504">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000610"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
        <ns1:IAO_0000115 xml:lang="en">A wound that bears the quality open: its surface is breached, so that underlying tissue is exposed.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Open wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000505 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000505">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000608"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
        <ns1:IAO_0000115 xml:lang="en">A wound that bears the quality closed: the skin or mucosal surface over the injured tissue is intact.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Closed wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000506 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000506">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000463"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
        <ns1:IAO_0000115 xml:lang="en">A wound that bears the quality epithelialized: its surface has been covered by newly formed epithelium.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Healed wound</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Epithelialized wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000507 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000507">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002057"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
        <ns1:IAO_0000115 xml:lang="en">A wound that bears the quality increased size: its extent is greater than is typical for a wound of its kind.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Large wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000508 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000508">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001596"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
        <ns1:IAO_0000115 xml:lang="en">A wound that bears the quality increased depth: it extends further into the tissue than is typical for a wound of its kind.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Deep wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000509 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000509">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000510"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000488"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000510"/>
        <ns1:IAO_0000115 xml:lang="en">An arterial insufficiency wound that bears the quality ischemic.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Ischemic wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000510 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000510">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002353"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000414"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000543"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000015"/>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
        <ns1:IAO_0000115 xml:lang="en">A wound that is the output of a wound development process that has as part a process of the course of a peripheral arterial occlusive disease. No claim is made that the disorder caused the wound.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">arterial insufficiency ulcer</ns1:IAO_0000118>
        <ns1:IAO_0000118 xml:lang="en">arterial wound</ns1:IAO_0000118>
        <ns1:IAO_0000118 xml:lang="en">ischemic ulcer</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Arterial insufficiency wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000511 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000511">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000481"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000512"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000481"/>
        <ns1:IAO_0000115 xml:lang="en">A wound with recognized microbial burden that bears the quality colonized.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Colonized wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000512 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000512">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000478"/>
        <ns1:IAO_0000115 xml:lang="en">A degree of microbial burden that qualifies its bearer as colonized: microorganisms are present in the wound and multiply in it, without invading its tissue or eliciting a host response.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">colonized</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000513 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000513">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000495"/>
        <ns1:IAO_0000115 xml:lang="en">A burn wound classification grade according to Hildanus and Derganc in which the injury extends into but not through the dermis; its instances are the superficial and the deep partial-thickness grade.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Second degree</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Partial thickness</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000514 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000514">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120028"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000465"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A disease course process that has as participant a malignancy.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Malignant process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000515 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000515">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000418"/>
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000514"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <ns1:IAO_0000115 xml:lang="en">A malignant process that is a wound development subprocess.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Malignant process in wound development</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000516 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000516">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000338"/>
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000418"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <ns1:IAO_0000115 xml:lang="en">A trauma process that is a wound development subprocess.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Trauma process in wound development</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000517 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000517">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <ns1:IAO_0000115 xml:lang="en">A process in which an acid or a base acts on a tissue.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Acidity impact process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000518 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000518">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000338"/>
        <ns1:IAO_0000115 xml:lang="en">A process in which heat acts on a tissue.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Heat impact process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000519 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000519">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <ns1:IAO_0000115 xml:lang="en">A process in which sustained mechanical pressure acts on a tissue.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Sustained mechanical load</ns1:IAO_0000118>
        <ns1:IAO_0000118 xml:lang="en">Sustained mechanical load process</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Pressure impact process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000520 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000520">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000535"/>
        <ns1:IAO_0000115 xml:lang="en">A diabetes mellitus disease process of a diabetic metabolic disorder of type II.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Diabetes mellitus type II disease process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000521 -->

