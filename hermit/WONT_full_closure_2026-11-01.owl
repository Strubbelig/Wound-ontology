                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FMA_67811"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/fma#constitutional_part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FMA_67812"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/fma#constitutional_part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FMA_74657"/>
            </owl:Restriction>
        </rdfs:subClassOf>
