    <!-- http://purl.obolibrary.org/obo/FMA_9637 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_9637">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_67135"/>
        <ns1:IAO_0000115>Anatomical structure which has as its parts cells of predominantly one type with or without intercellular matrix. Examples: epithelium, muscle tissue, connective tissue, neural tissue, lymphoid tissue.</ns1:IAO_0000115>
        <ns2:hasExactSynonym>Tissue</ns2:hasExactSynonym>
        <ns2:hasOBONamespace>fma</ns2:hasOBONamespace>
        <ns2:id>FMA:9637</ns2:id>
        <rdfs:label>Portion of tissue</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FMA_9639 -->

