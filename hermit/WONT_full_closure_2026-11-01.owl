    <!-- http://purl.obolibrary.org/obo/RO_0002356 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002356">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002295"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CL_0000000"/>
        <ns1:IAO_0000115>The relationship linking a cell and its participation in a process that results in the fate of the cell being specified. Once specification has taken place, a cell will be committed to differentiate down a specific pathway if left in its normal environment. </ns1:IAO_0000115>
        <ns1:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <ns2:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_go_annotation_extension"/>
        <ns2:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_go_ontology"/>
        <ns2:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_gocam"/>
        <rdfs:label xml:lang="en">results in specification of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0002357 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002357">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002295"/>
        <ns1:IAO_0000115>p results in developmental induction of c if and only if p is a collection of cell-cell signaling processes that signal to a neighbouring tissue that is the precursor of the mature c, where the signaling results in the commitment to cell types necessary for the formation of c.</ns1:IAO_0000115>
        <ns1:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <rdfs:label xml:lang="en">results in developmental induction of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0002360 -->

