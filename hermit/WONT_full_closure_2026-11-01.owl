    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0012007 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0012007">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0040036"/>
        <ns1:IAO_0000115>The relationship that links anatomical entities with a process that results in the adhesion of two or more entities via the non-covalent interaction of molecules expressed in, located in, and/or adjacent to, those entities.</ns1:IAO_0000115>
        <ns2:created_by rdf:resource="https://orcid.org/0000-0003-1813-6857"/>
        <ns2:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-27T08:13:59Z</ns2:creation_date>
        <rdfs:label xml:lang="en">results in adhesion of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0012008 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0012008">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002592"/>
        <ns2:created_by rdf:resource="https://orcid.org/0000-0003-1813-6857"/>
        <ns2:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-02-26T07:28:29Z</ns2:creation_date>
        <ns2:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_go_annotation_extension"/>
        <ns2:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_go_ontology"/>
        <ns2:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_gocam"/>
        <rdfs:label xml:lang="en">results in fusion of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0012009 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0012009">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002304"/>
        <ns1:IAO_0000115>p is constitutively upstream of q iff p is causally upstream of q, p is required for execution of q or a part of q, and the execution of p is approximately constant.</ns1:IAO_0000115>
        <ns2:created_by rdf:resource="https://orcid.org/0000-0003-1813-6857"/>
        <ns2:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-09-26T06:01:01Z</ns2:creation_date>
        <ns2:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_go_annotation_extension"/>
        <ns2:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_gocam"/>
        <rdfs:label xml:lang="en">constitutively upstream of</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://wiki.geneontology.org/Constitutively_upstream_of</rdfs:seeAlso>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0012010 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0012010">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002305"/>
        <ns1:IAO_0000115>p removes input for q iff p is causally upstream of q, there exists some c such that p has_input c and q has_input c, p reduces the levels of c, and c is rate limiting for execution of q.</ns1:IAO_0000115>
        <ns2:created_by rdf:resource="https://orcid.org/0000-0003-1813-6857"/>
        <ns2:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-09-26T06:06:20Z</ns2:creation_date>
        <ns2:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_go_annotation_extension"/>
        <ns2:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_gocam"/>
        <rdfs:label xml:lang="en">removes input for</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://wiki.geneontology.org/Removes_input_for</rdfs:seeAlso>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0012011 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0012011">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002411"/>
        <ns1:IAO_0000115>p is indirectly causally upstream of q iff p is causally upstream of q and there exists some process r such that p is causally upstream of r and r is causally upstream of q.</ns1:IAO_0000115>
        <ns2:created_by rdf:resource="https://orcid.org/0000-0003-1813-6857"/>
        <ns2:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-09-26T06:07:17Z</ns2:creation_date>
        <rdfs:label xml:lang="en">indirectly causally upstream of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0012012 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0012012">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002211"/>
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0012011"/>
        <ns1:IAO_0000115>p indirectly regulates q iff p is indirectly causally upstream of q and p regulates q.</ns1:IAO_0000115>
        <ns2:created_by rdf:resource="https://orcid.org/0000-0003-1813-6857"/>
        <ns2:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-09-26T06:08:01Z</ns2:creation_date>
        <rdfs:label xml:lang="en">indirectly regulates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0012013 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0012013">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002010"/>
        <ns1:IAO_0000115>x &apos;positively regulates in other organism&apos; y if and only if: (x is the realization of a function to increase the frequency, rate or extent of y) AND (the agents of x are produced by organism o1 and the agents of y are produced by organism o2).</ns1:IAO_0000115>
        <ns1:RO_0004049 rdf:resource="http://purl.obolibrary.org/obo/RO_0002010"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-1813-6857"/>
        <ns2:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-10-12T10:02:28Z</ns2:creation_date>
        <ns2:hasExactSynonym>positively regulates in other organism</ns2:hasExactSynonym>
        <ns2:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_go_ontology"/>
        <rdfs:label xml:lang="en">positively regulates in another organism</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0012014 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0012014">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002010"/>
        <ns1:IAO_0000115>x &apos;negatively regulates in other organism&apos; y if and only if: (x is the realization of a function to reduce the frequency, rate or extent of y) AND (the agents of x are produced by organism o1 and the agents of y are produced by organism o2).</ns1:IAO_0000115>
        <ns1:RO_0004050 rdf:resource="http://purl.obolibrary.org/obo/RO_0002010"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-1813-6857"/>
        <ns2:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-10-12T10:02:42Z</ns2:creation_date>
        <ns2:hasExactSynonym>negatively regulates in other organism</ns2:hasExactSynonym>
        <ns2:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_go_ontology"/>
        <rdfs:label xml:lang="en">negatively regulates in another organism</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0013001 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0013001">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002130"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0013001"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000050"/>
        </owl:propertyChainAxiom>
        <ns1:IAO_0000115>A relationship between a neuron and a region, where the neuron has a functionally relevant number of input and/or output synapses in that region.</ns1:IAO_0000115>
        <ns2:created_by rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
        <ns2:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-17T09:26:52Z</ns2:creation_date>
        <ns2:hasExactSynonym>has synaptic input or output in</ns2:hasExactSynonym>
        <rdfs:label xml:lang="en">has synaptic IO in region</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0013002 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0013002">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002110"/>
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0013001"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
