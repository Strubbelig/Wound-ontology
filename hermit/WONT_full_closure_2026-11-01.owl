        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002234"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120024"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A planned process that has as output a disease diagnostic result.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Disease diagnostic process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/MILD/MILD_120048 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/MILD/MILD_120048">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120047"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120033"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A disease diagnostic process that has as specified output a candidate diagnosis.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Suspected disease diagnosis process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/MILD/MILD_120053 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/MILD/MILD_120053">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120021"/>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120028"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002234"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120020"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">disorder creating disease course process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/MILD/MILD_120054 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/MILD/MILD_120054">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000312"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120055"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:allValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120020"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">An information content entity that is the specified output of a disease classification process and that is about nothing other than a material disease entity.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">disease stage classification result</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/MILD/MILD_120055 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/MILD/MILD_120055">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120054"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A planned process that has as specified output a disease stage classification result.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">disease classification process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/MILD/MILD_120086 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/MILD/MILD_120086">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002233"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120020"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A planned process that realizes a treatment plan and that has as input a material disease entity.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Disease disorder treatment process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/MILD/MILD_120087 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/MILD/MILD_120087">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <owl:disjointWith rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120088"/>
        <owl:disjointWith rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120091"/>
        <rdfs:label xml:lang="en">disorder elimination process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/MILD/MILD_120088 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/MILD/MILD_120088">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120086"/>
        <owl:disjointWith rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120091"/>
        <rdfs:label xml:lang="en">disorder modification process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/MILD/MILD_120089 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/MILD/MILD_120089">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A plan specification that is about a treatment plan.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">treatment plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/MILD/MILD_120090 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/MILD/MILD_120090">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000260"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000197"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120093"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000059"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120089"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A plan that inheres in a Homo sapiens that bears the role physician role and that concretizes a treatment plan specification.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">treatment plan</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/MILD/MILD_120091 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/MILD/MILD_120091">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:label xml:lang="en">disorder addition process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/MILD/MILD_120093 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/MILD/MILD_120093">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OMRSE_00000012"/>
        <ns1:IAO_0000115 xml:lang="en">A healthcare provider role that inheres in a person in virtue of that person being licensed to practice medicine.</ns1:IAO_0000115>
        <rdfs:comment xml:lang="en">Relocated from WONT_0000090 when the MILD/WONT import direction was reversed: a physician role is not wound-specific, is not used by any WONT class, and its only consumer is the MILD treatment-plan axiom. Reuse an OMRSE physician-role class here if an OMRSE module is later added.</rdfs:comment>
        <rdfs:label xml:lang="en">Physician role</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/MILD/MILD_120098 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/MILD/MILD_120098">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <ns1:IAO_0000115 xml:lang="en">A directive information entity that has as part a threshold value and a comparison operator and that is about a quality, such that the quality&apos;s meeting the threshold is what the specification prescribes as decisive.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Generalises the disease threshold specification (MILD_120029), which is the special case about a phenotypic abnormality. Other specifications with the same shape - a wound healing criterion, an outcome criterion in a trial protocol - are about qualities that are not abnormalities, so they need a parent that does not say &apos;disease&apos;. Lives in MILD because WONT and any other domain ontology need it and MILD never imports them.</ns1:IAO_0000116>
        <rdfs:label xml:lang="en">threshold specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/MILD/MILD_120099 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/MILD/MILD_120099">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120089"/>
        <ns1:IAO_0000118 xml:lang="en">Method used for medical condition treatment</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Medical condition treatment plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/MILD/MILD_120100 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/MILD/MILD_120100">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <ns1:IAO_0000116 xml:lang="en">Sibling of treatment plan specification, not a child: a prophylaxis is planned to keep a condition from arising, not to treat one. Named with the plan-specification pattern by decision (2026-09-17); &apos;method used for prophylaxis&apos; was the alternative.</ns1:IAO_0000116>
        <rdfs:label xml:lang="en">prophylaxis plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/MILD/MILD_120102 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/MILD/MILD_120102">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <ns1:IAO_0000115 xml:lang="en">A quality that a material entity has because medicine classifies it as pathological. Pathologicity is asserted, never inferred: MILD lays down no criteria, rules or inferences for it, because what is pathological can depend on context.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">pathological</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000002 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000002">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000093"/>
        <ns1:IAO_0000115 xml:lang="en">A drain that is placed in the abdominal cavity or in an abdominal surgical site to carry fluid, blood or air out of the abdomen.</ns1:IAO_0000115>
        <rdfs:label>Abdominal drain</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000004 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000004">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000418"/>
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000517"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000517"/>
        <ns1:IAO_0000115 xml:lang="en">An acidity impact process that is a wound development subprocess.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Acidity impact process in wound development</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000005 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000005">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000398"/>
        <ns1:IAO_0000115 xml:lang="en">A wound dressing that has as part a layer of activated carbon, a highly porous carbon that adsorbs volatile odour molecules released from the wound.</ns1:IAO_0000115>
        <rdfs:label>Activated carbon layer wound dressing</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000006 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000006">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000093"/>
        <ns1:IAO_0000115 xml:lang="en">A drain that removes fluid or air from a wound or body cavity by negative pressure applied from a suction source, rather than by gravity or capillary action.</ns1:IAO_0000115>
        <rdfs:label>Active drain</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000008 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000008">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000280"/>
        <ns1:IAO_0000115 xml:lang="en">A silicone spacer grid whose silicone surface is tacky, so that it adheres to the skin around the wound without a separate fixation material.</ns1:IAO_0000115>
        <rdfs:label>Adhesive silicone grid</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000010 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000010">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000188"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_48218"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A material used for wound treatment that is an alcohol, an organic compound bearing a hydroxyl group on a saturated carbon atom, and that bears the antiseptic drug role.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Antiseptic alcohol</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000011 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000011">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000398"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000787"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A wound dressing that has as part fibres or a gel of alginate, a salt of alginic acid obtained from brown seaweed, which forms a gel on contact with wound exudate.</ns1:IAO_0000115>
        <rdfs:label>Alginate containing wound dressing</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000013 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000013">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120024"/>
        <ns1:IAO_0000115 xml:lang="en">A disease diagnostic result that is about a material disease entity consisting of necrotizing inflammation of the walls of predominantly small blood vessels, with few or no immune deposits, that is associated with antineutrophil cytoplasmic antibodies.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Moved from material disease entity to disease diagnostic result (curator, 2026-10-31): the name denotes a diagnostic classification, not one material disease entity; the material disease entity is what the diagnosis is about.</ns1:IAO_0000116>
        <ns1:IAO_0000116 xml:lang="en">Recategorised when the causal-role groupings &apos;Medical condition contributing to wound formation&apos; / &apos;affecting wound healing&apos; / &apos;contributing to blistering wounds&apos; were dissolved. Those classes grouped entities by what they were said to cause, which this ontology does not assert, and they mixed material disorders with dispositions and processes. Relevance to wounds is now carried by co-location axioms on the wound classes instead of by membership in a causal class.</ns1:IAO_0000116>
        <rdfs:label>ANCA-associated Vasculitis</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000015 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000015">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002353"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000414"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000537"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
        <ns1:IAO_0000115 xml:lang="en">A wound that is the output of a wound development process that has as part a process of the course of an angiopathy. No claim is made that the disorder caused the wound.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Angiopathic wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000016 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000016">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120089"/>
        <ns1:IAO_0000115 xml:lang="en">A treatment plan specification that prescribes the administration to a patient of one or more drugs bearing the antibiotic role, including the agent, route and duration.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Antibiotic therapy</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Antibiotic therapy plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000020 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000020">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000188"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_48218"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A material used for wound treatment that is a coloured compound that stains the tissue it is applied to and bears the antiseptic drug role.</ns1:IAO_0000115>
        <rdfs:label>Antiseptic dye</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000021 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000021">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000188"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_48218"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A material used for wound treatment that is a chemical compound releasing an oxidizing halogen species on application and bears the antiseptic drug role.</ns1:IAO_0000115>
        <rdfs:label>Antiseptic halogen-releasing compound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000022 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000022">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000188"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_48218"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A material used for wound treatment that consists of positively charged metal atoms, or of a material releasing them, and bears the antiseptic drug role.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Antiseptic metal ion</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000025 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000025">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000188"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_48218"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A material used for wound treatment that is a compound structurally derived from phenol, having a hydroxyl group bonded directly to an aromatic ring, and bears the antiseptic drug role.</ns1:IAO_0000115>
        <rdfs:label>Antiseptic phenol derivative</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000026 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000026">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000412"/>
        <ns1:IAO_0000115 xml:lang="en">A wound irrigation solution that contains a dissolved substance bearing the antiseptic drug role.</ns1:IAO_0000115>
        <rdfs:label>Antiseptic solution</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000027 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000027">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000441"/>
        <ns1:IAO_0000115 xml:lang="en">A skin wound located on the leg or foot in which the skin and underlying tissue are disrupted in an area that is ischaemic, with insufficient arterial blood supply.</ns1:IAO_0000115>
        <rdfs:label>Arterial leg ulcer</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000028 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000028">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000066"/>
        <ns1:IAO_0000115 xml:lang="en">A wound classification scale that grades a surgical wound for infection by summing points for additional treatment, serous discharge, erythema, purulent exudate, separation of deep tissues, isolation of bacteria and prolonged inpatient stay.</ns1:IAO_0000115>
        <rdfs:label>ASEPSIS score</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000029 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000029">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000200"/>
        <ns1:IAO_0000115 xml:lang="en">A wound treatment plan specification that prescribes that wound treatment be carried out with sterile instruments, materials and techniques so that microorganisms are not introduced into the wound.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Aseptic conditions plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000030 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000030">
        <ns1:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000227"/>
        <ns1:IAO_0100001 rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000029"/>
        <rdfs:comment xml:lang="en">Merged into WONT_0000029 Aseptic conditions plan specification: &apos;aseptic cuticle&apos; is a mistranslation of the German &apos;aseptische Kautelen&apos;, aseptic conditions (curator 2026-10-31, relayed by the thesis session: &quot;i agree with 1,2,3,4,5&quot;).</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Aseptic cuticle plan specification</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000032 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000032">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000089"/>
        <ns1:IAO_0000115 xml:lang="en">A diagnostic process to assess wound characteristics in which information on the patient&apos;s past and current diseases, treatments and the origin and course of the wound is obtained from the patient, relatives or records.</ns1:IAO_0000115>
        <rdfs:label>Assessing patient&apos;s medical history</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000033 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000033">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002353"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000414"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000538"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
        <ns1:IAO_0000115 xml:lang="en">A wound that is the output of a wound development process that has as part a process of the course of an autoimmune tissue disorder. No claim is made that the disorder caused the wound.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Autoimmune disease related wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000034 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000034">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000084"/>
        <ns1:IAO_0000115 xml:lang="en">A debridement process in which necrotic tissue and slough are broken down by the patient&apos;s own enzymes and phagocytic cells in a wound kept moist.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Autolytic wound debridement process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000037 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000037">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000406"/>
        <ns1:IAO_0000115 xml:lang="en">A wound gel/ointment/cream that is an ointment with dexpanthenol as its active ingredient.</ns1:IAO_0000115>
        <ns2:hasRelatedSynonym xml:lang="en">Bepanthen ointment</ns2:hasRelatedSynonym>
        <rdfs:label>Dexpanthenol ointment</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000038 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000038">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000040"/>
        <ns1:IAO_0000115 xml:lang="en">A biosurgical debridement plan specification that prescribes applying the sterile fly larvae to the wound enclosed in a sealed mesh bag, so that the larvae do not move freely over the wound surface.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Biobag debridement</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Biobag debridement plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000039 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000039">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000395"/>
        <ns1:IAO_0000115 xml:lang="en">A wound diagnostic process in which a sample of tissue is cut or punched from the wound bed or wound edge and that has as specified output a wound tissue specimen for laboratory examination.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Wound specimen procurement by biopsy process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000040 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000040">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120089"/>
        <ns1:IAO_0000115 xml:lang="en">A treatment plan specification that prescribes removing necrotic or devitalized tissue from a wound by applying live sterile fly larvae to it.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Biosurgical debridement</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Biosurgical debridement plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000041 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000041">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000084"/>
        <ns1:IAO_0000115 xml:lang="en">A debridement process in which live sterile fly larvae applied to a wound remove its necrotic or devitalized tissue.</ns1:IAO_0000115>
        <rdfs:label>Biosurgical wound debridement process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000042 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000042">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000398"/>
        <ns1:IAO_0000115 xml:lang="en">A wound dressing whose wound-contacting material is a cellulose membrane synthesized by bacteria.</ns1:IAO_0000115>
        <rdfs:label>Biosynthetic cellulose</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000043 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000043">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000022"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_48218"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">An antiseptic metal ion that is trivalent bismuth, applied as the compound bismuth(III) bromide.</ns1:IAO_0000115>
        <rdfs:label>Bismuth III bromide</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000044 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000044">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000339"/>
        <ns1:IAO_0000115 xml:lang="en">A traumatic wound that is the output of a trauma process in wound development in which the teeth of a human or an animal penetrate, tear or crush the tissue.</ns1:IAO_0000115>
        <rdfs:label>Bite wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000045 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000045">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000177"/>
        <ns1:IAO_0000115 xml:lang="en">A low-vacuum drain consisting of a silicone tube whose intracorporeal portion has open longitudinal channels around a solid core instead of side holes.</ns1:IAO_0000115>
        <rdfs:label>Blake drain</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000046 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000046">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000441"/>
        <ns1:IAO_0000115 xml:lang="en">A skin wound in which the skin layers separate within the epidermis or at the dermo-epidermal junction, and fluid collects in the space between them.</ns1:IAO_0000115>
        <rdfs:label>Blistering skin wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000047 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000047">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000427"/>
        <ns1:IAO_0000115 xml:lang="en">A wound-integrating wound dressing that has as part collagen derived from cattle.</ns1:IAO_0000115>
        <rdfs:label>Bovine collagen containing wound dressing</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000048 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000048">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000296"/>
        <ns1:IAO_0000115 xml:lang="en">A substance used for enzymatic wound debridement that consists of a mixture of cysteine proteases extracted from the pineapple plant (Ananas comosus).</ns1:IAO_0000115>
        <rdfs:label>Bromelain</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000049 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000049">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120024"/>
        <ns1:IAO_0000115 xml:lang="en">A disease diagnostic result that is about a material disease entity that has as parts one or more spontaneously arising, non-inflammatory skin blisters in a patient who has a diabetic metabolic disorder.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Moved from material disease entity to disease diagnostic result (curator, 2026-10-31): the name denotes a diagnostic classification, not one material disease entity; the material disease entity is what the diagnosis is about.</ns1:IAO_0000116>
        <ns1:IAO_0000116 xml:lang="en">Recategorised when the causal-role groupings &apos;Medical condition contributing to wound formation&apos; / &apos;affecting wound healing&apos; / &apos;contributing to blistering wounds&apos; were dissolved. Those classes grouped entities by what they were said to cause, which this ontology does not assert, and they mixed material disorders with dispositions and processes. Relevance to wounds is now carried by co-location axioms on the wound classes instead of by membership in a causal class.</ns1:IAO_0000116>
        <rdfs:label>Bullosis diabeticorum</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000050 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000050">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120024"/>
        <ns1:IAO_0000115 xml:lang="en">A disease diagnostic result that is about a material disease entity consisting of a superficial Staphylococcus aureus infection of the epidermis that has as parts one or more flaccid subcorneal blisters.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Moved from material disease entity to disease diagnostic result (curator, 2026-10-31): the name denotes a diagnostic classification, not one material disease entity; the material disease entity is what the diagnosis is about.</ns1:IAO_0000116>
        <ns1:IAO_0000116 xml:lang="en">Recategorised when the causal-role groupings &apos;Medical condition contributing to wound formation&apos; / &apos;affecting wound healing&apos; / &apos;contributing to blistering wounds&apos; were dissolved. Those classes grouped entities by what they were said to cause, which this ontology does not assert, and they mixed material disorders with dispositions and processes. Relevance to wounds is now carried by co-location axioms on the wound classes instead of by membership in a causal class.</ns1:IAO_0000116>
        <rdfs:label>Bullous impetigo</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000057 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000057">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000311"/>
        <ns1:IAO_0000115 xml:lang="en">A thoracic drain whose external end is placed under water in a collecting container, forming an underwater seal that lets air and fluid leave the pleural cavity while preventing their return.</ns1:IAO_0000115>
        <rdfs:label>Bülau drain</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000058 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000058">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000224"/>
        <ns1:IAO_0000115 xml:lang="en">A passive drain that conducts wound fluid out of the wound by capillary action along narrow spaces within or between its fibres or channels, rather than through a single open lumen.</ns1:IAO_0000115>
        <rdfs:label>Capillary drain</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000060 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000060">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000044"/>
        <ns1:IAO_0000115 xml:lang="en">A bite wound inflicted by the teeth of a cat.</ns1:IAO_0000115>
        <rdfs:label>Cat bite wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000061 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000061">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000398"/>
        <ns1:IAO_0000115 xml:lang="en">A wound dressing that is a non-adherent wound contact layer formed by a knitted mesh of cellulose acetate fibres coated with an emulsion of petrolatum.</ns1:IAO_0000115>
        <rdfs:label>Cellulose acetate mesh impregnated with a petrolatum emulsion</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000066 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000066">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000295"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_120015"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">An information content entity that is a specified input of a wound classification process.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Wound classification scale</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000067 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000067">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000524"/>
        <ns1:IAO_0000115 xml:lang="en">A wound with microbial burden assessed according to CDC that is an operative wound in which the respiratory, alimentary, genital or urinary tract is entered under controlled conditions and without unusual contamination.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Clean-contaminated wound according to CDC</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000068 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000068">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000524"/>
        <ns1:IAO_0000115 xml:lang="en">A wound with microbial burden assessed according to CDC that is an uninfected operative wound in which no inflammation is encountered and the respiratory, alimentary, genital or urinary tract is not entered.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Clean wound according to CDC</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000069 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000069">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000089"/>
        <ns1:IAO_0000115 xml:lang="en">A diagnostic process to assess wound characteristics in which a clinician directly observes the wound and the periwound skin by eye.</ns1:IAO_0000115>
        <rdfs:label>Clinical inspection</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000070 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000070">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000089"/>
        <ns1:IAO_0000115 xml:lang="en">A diagnostic process to assess wound characteristics in which a healthcare professional evaluates the wound, the periwound skin and the patient by history taking and physical examination at the point of care.</ns1:IAO_0000115>
        <rdfs:label>Clinical wound assessment</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000071 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000071">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000093"/>
        <ns1:IAO_0000115 xml:lang="en">A drain whose external end is connected to a sealed collecting container or system, so that the drained fluid is not exposed to the environment.</ns1:IAO_0000115>
        <rdfs:label>Closed drain</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000072 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000072">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000200"/>
        <ns1:IAO_0000115 xml:lang="en">A wound treatment plan specification that prescribes a bath in which the wound-bearing body part is exposed to carbon dioxide, either dissolved in water or as a gas.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">CO2 bath wound therapy</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">CO2 bath wound therapy plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000074 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000074">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000423"/>
        <ns1:IAO_0000115 xml:lang="en">A wound treatment process in which a non-thermal, partially ionized gas generated at atmospheric pressure is applied to the wound.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Cold plasma wound treatment process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000076 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000076">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000189"/>
        <ns1:IAO_0000115 xml:lang="en">A mechanical debridement plan specification that prescribes removing necrotic tissue, slough and debris from the wound bed by wiping or lifting them off with compresses.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Compress debridement</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Compress debridement plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000077 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000077">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000200"/>
        <ns1:IAO_0000115 xml:lang="en">A wound treatment plan specification that prescribes applying sustained external pressure to the wound-bearing limb or body part by means of bandages, garments or devices.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Compression therapy</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Compression therapy plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000078 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000078">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000481"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000479"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <ns1:IAO_0000115 xml:lang="en">A wound with recognized microbial burden that bears the quality contaminated.</ns1:IAO_0000115>
        <rdfs:label>Contaminated wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000079 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000079">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000301"/>
        <ns1:IAO_0000115 xml:lang="en">A suture in situ in which a single uninterrupted strand of suture material passes repeatedly through the tissue along the wound and is knotted only at its two ends.</ns1:IAO_0000115>
        <rdfs:label>Continuous suture</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000082 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000082">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000350"/>
        <ns1:IAO_0000115 xml:lang="en">An ultrasound-assisted wound debridement process that uses an ultrasonic surgical aspirator, which fragments tissue by ultrasonic vibration while simultaneously irrigating the site and aspirating the fragments.</ns1:IAO_0000115>
        <rdfs:label>CUSA(r) assisted debridement</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000084 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000084">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000387"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002233"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002233"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0002212"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A wound cleansing process in which necrotic or devitalized tissue, slough, foreign material and debris are removed from the wound.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Debridement process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000088 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000088">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002353"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000414"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000539"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
        <ns1:IAO_0000115 xml:lang="en">A wound that is the output of a wound development process that has as part a process of the course of a diabetic metabolic disorder. No claim is made that the disorder caused the wound.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Diabetic wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000089 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000089">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000395"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A wound diagnostic process in which the wound itself is examined and that has as specified output data about qualities of that wound.</ns1:IAO_0000115>
        <rdfs:label>Diagnostic process to assess wound characteristics</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000091 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000091">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000044"/>
        <ns1:IAO_0000115 xml:lang="en">A bite wound that was inflicted by the teeth of a dog.</ns1:IAO_0000115>
        <rdfs:label>Dog bite wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000092 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000092">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000395"/>
        <ns1:IAO_0000115 xml:lang="en">A wound diagnostic process that uses ultrasound and the frequency shift of waves reflected from moving blood to assess blood flow in the vessels supplying the wound region.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Doppler sonographic diagnostic process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000093 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000093">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000188"/>
        <ns1:IAO_0000115 xml:lang="en">A material used for wound treatment that is a device placed in a wound or surgical site to conduct accumulated fluid or air out of it.</ns1:IAO_0000115>
        <rdfs:label>Drain</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000094 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000094">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000200"/>
        <ns1:IAO_0000115 xml:lang="en">A wound treatment plan specification that prescribes removing the wound dressing currently applied to a wound and applying a new one.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Dressing change</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Dressing change plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000095 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000095">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_120020"/>
        <ns1:IAO_0000115 xml:lang="en">A necrotic material that has lost its water content and is firm to hard in consistency.</ns1:IAO_0000115>
        <rdfs:label>Dry necrosis</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000096 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000096">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000058"/>
        <ns1:IAO_0000115 xml:lang="en">A capillary drain consisting of a flat, flexible tube with longitudinal internal grooves along which wound fluid flows passively out of the wound.</ns1:IAO_0000115>
        <rdfs:label>Easy-Flow drain</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000097 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000097">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000112"/>
        <ns1:IAO_0000115 xml:lang="en">A fixing bandage made of a material that can be stretched lengthwise and returns to its original length when released.</ns1:IAO_0000115>
        <rdfs:label>Elastic bandage</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000098 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000098">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000084"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A debridement process in which necrotic tissue and slough are broken down and removed by topically applied proteolytic enzymes.</ns1:IAO_0000115>
        <rdfs:label>Enzymatic wound debridement process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000100 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000100">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000409"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0042060"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000101 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000101">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000382"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000463"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000382"/>
        <ns1:IAO_0000115 xml:lang="en">A wound base that bears the quality epithelialized.</ns1:IAO_0000115>
        <rdfs:label>Epithelializing wound bed</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000106 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000106">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000409"/>
        <ns1:IAO_0000115 xml:lang="en">A wound healing related physiological process in which fluid containing plasma proteins and cells passes from blood vessels into the wound tissue and onto the wound surface.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Exudation process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000107 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000107">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000398"/>
        <ns1:IAO_0000115 xml:lang="en">A wound dressing consisting of a wide-meshed gauze impregnated with a fatty or ointment-based substance that reduces its adherence to the wound surface.</ns1:IAO_0000115>
        <rdfs:label>Fat gauze</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000108 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000108">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <ns1:IAO_0000115 xml:lang="en">A material entity consisting of a layer of fibrin, formed from fibrinogen in wound exudate, that adheres to the surface of a wound bed.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Fibrin coating of the wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000109 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000109">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000382"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000462"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000382"/>
        <ns1:IAO_0000115 xml:lang="en">A wound base that bears the quality fibrin-covered.</ns1:IAO_0000115>
        <rdfs:label>Fibrin-covered wound bed</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000110 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000110">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120020"/>
        <ns1:IAO_0000115 xml:lang="en">A material disease entity that is an abnormal tract connecting two hollow organs, body cavities or vessels, or connecting one of these with the body surface.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">fistula</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000111 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000111">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120024"/>
        <ns1:IAO_0000115 xml:lang="en">A disease diagnostic result that is about a material disease entity consisting of one or more sharply demarcated inflammatory lesions of the skin or mucosa that are the output of a hypersensitivity reaction to a drug and recur at the same sites each time the patient is re-exposed to that drug.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Moved from material disease entity to disease diagnostic result (curator, 2026-10-31): the name denotes a diagnostic classification, not one material disease entity; the material disease entity is what the diagnosis is about.</ns1:IAO_0000116>
        <ns1:IAO_0000116 xml:lang="en">Recategorised when the causal-role groupings &apos;Medical condition contributing to wound formation&apos; / &apos;affecting wound healing&apos; / &apos;contributing to blistering wounds&apos; were dissolved. Those classes grouped entities by what they were said to cause, which this ontology does not assert, and they mixed material disorders with dispositions and processes. Relevance to wounds is now carried by co-location axioms on the wound classes instead of by membership in a causal class.</ns1:IAO_0000116>
        <rdfs:label>Fixed drug exanthema</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000112 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000112">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000398"/>
        <ns1:IAO_0000115 xml:lang="en">A wound dressing that is a strip or tube of flexible material applied around a body part to hold another wound dressing in place over a wound.</ns1:IAO_0000115>
        <rdfs:label>Fixing bandage</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000113 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000113">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000406"/>
        <ns1:IAO_0000115 xml:lang="en">A wound gel/ointment/cream that is an alginate hydrogel containing the enzymes glucose oxidase and lactoperoxidase.</ns1:IAO_0000115>
        <rdfs:label>Flaminal</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000114 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000114">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000200"/>
        <ns1:IAO_0000115 xml:lang="en">A wound treatment plan specification that prescribes closing or covering a wound by moving tissue from a donor site to the wound together with its own blood supply.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Flap plasty</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Flap plasty plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000115 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000115">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120024"/>
        <ns1:IAO_0000115 xml:lang="en">A disease diagnostic result that is about a material disease entity that is a necrotizing infection of the fascia and soft tissues of the perineal, genital or perianal region.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Moved from material disease entity to disease diagnostic result (curator, 2026-10-31): the name denotes a diagnostic classification, not one material disease entity; the material disease entity is what the diagnosis is about.</ns1:IAO_0000116>
        <rdfs:label>Fournier&apos;s gangrene</rdfs:label>
        <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/DOID_9602"/>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000116 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000116">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120020"/>
        <ns1:IAO_0000115 xml:lang="en">A material disease entity that is a fluid-filled cleft within the epidermis formed by repeated frictional shear forces acting on the skin.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Recategorised when the causal-role groupings &apos;Medical condition contributing to wound formation&apos; / &apos;affecting wound healing&apos; / &apos;contributing to blistering wounds&apos; were dissolved. Those classes grouped entities by what they were said to cause, which this ontology does not assert, and they mixed material disorders with dispositions and processes. Relevance to wounds is now carried by co-location axioms on the wound classes instead of by membership in a causal class.</ns1:IAO_0000116>
        <rdfs:label>Friction bubble</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000117 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000117">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000285"/>
        <ns1:IAO_0000115 xml:lang="en">A skin graft that consists of the entire epidermis and the entire dermis of the donor site.</ns1:IAO_0000115>
        <rdfs:label>Full-thickness skin graft</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000120 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000120">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000112"/>
        <ns1:IAO_0000115 xml:lang="en">A fixing bandage that is a roll of thin, loosely woven or knitted fabric with an open mesh.</ns1:IAO_0000115>
        <rdfs:label>Gauze bandage</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000121 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000121">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000395"/>
        <ns1:IAO_0000115 xml:lang="en">A wound diagnostic process that has as specified output a datum identifying the microorganisms present in a sample of wound material.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Germ spectrum assessment process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000131 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000131">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000382"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000460"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000382"/>
        <ns1:IAO_0000115 xml:lang="en">A wound base that bears the quality granulating.</ns1:IAO_0000115>
        <rdfs:label>Granulating wound bed</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000132 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000132">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000409"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0042060"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0003287"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002234"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0003216"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000133 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000133">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000224"/>
        <ns1:IAO_0000115 xml:lang="en">A passive drain that conducts fluid out of a wound by gravitational flow into a collecting receptacle positioned below the level of the wound.</ns1:IAO_0000115>
        <rdfs:label>Gravity drain</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000134 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000134">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000066"/>
        <ns1:IAO_0000115 xml:lang="en">A wound classification scale that stratifies the wounds of open fractures by wound size, extent of soft-tissue damage, degree of contamination and presence of arterial injury requiring repair.</ns1:IAO_0000115>
        <rdfs:label>Gustilo and Anderson wound classification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000135 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000135">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_120016"/>
        <ns1:IAO_0000115 xml:lang="en">A wound classification grade that is a category of the Gustilo and Anderson wound classification.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Gustilo and Anderson wound classification grade</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000138 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000138">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000029"/>
        <ns1:IAO_0000115 xml:lang="en">An aseptic conditions plan specification that prescribes that the hands of those treating the wound be disinfected with an antiseptic agent before they touch the wound or sterile material.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Hand disinfection</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Hand disinfection plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000140 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000140">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000418"/>
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000518"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000518"/>
        <ns1:IAO_0000115 xml:lang="en">A heat impact process that is a wound development subprocess.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Heat impact process in wound development</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000141 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000141">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120020"/>
        <ns1:IAO_0000115 xml:lang="en">A material disease entity consisting of a localized accumulation of blood that has escaped from blood vessels into a tissue, an organ or a body space.</ns1:IAO_0000115>
        <rdfs:label>Hematoma</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000145 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000145">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000006"/>
        <ns1:IAO_0000115 xml:lang="en">An active drain that draws fluid out of a wound by means of high negative pressure held in a sealed, evacuated collection container.</ns1:IAO_0000115>
        <rdfs:label>High-vacuum drain</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000146 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000146">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000395"/>
        <ns1:IAO_0000115 xml:lang="en">A wound diagnostic process in which tissue taken from a wound is fixed, sectioned, stained and examined microscopically to determine its cellular and structural characteristics.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Histopathological examination process of wound material</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000147 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000147">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000301"/>
        <ns1:IAO_0000115 xml:lang="en">A suture in situ in which each stitch crosses the wound twice, entering and leaving the skin on both sides of the wound, so that the exposed thread segments lie parallel to the wound edge and the knot lies on one side of the wound.</ns1:IAO_0000115>
        <rdfs:label>Horizontal mattress suture</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000148 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000148">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000044"/>
        <ns1:IAO_0000115 xml:lang="en">A bite wound inflicted by the teeth of a human.</ns1:IAO_0000115>
        <rdfs:label>Human bite wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000149 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000149">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000398"/>
        <ns1:IAO_0000115 xml:lang="en">A wound dressing that has as part a hydrocolloid, a hydrophilic colloidal material held in an adhesive matrix that forms a gel on contact with wound exudate.</ns1:IAO_0000115>
        <rdfs:label>Hydrocolloid containing wound dressing</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000150 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000150">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000398"/>
        <ns1:IAO_0000115 xml:lang="en">A wound dressing that has as part a hydrofiber, a nonwoven layer of gelling carboxymethylcellulose fibres that absorb wound exudate and turn into a cohesive gel.</ns1:IAO_0000115>
        <rdfs:label>Hydrofiber-containing wound dressing</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000151 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000151">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000398"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0003469"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A wound dressing that has as part a hydrogel, a cross-linked network of hydrophilic polymers with a high water content.</ns1:IAO_0000115>
        <rdfs:label>Hydrogel containing wound dressing</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000152 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000152">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000200"/>
        <ns1:IAO_0000115 xml:lang="en">A wound treatment plan specification that prescribes that the patient breathe oxygen while inside a chamber pressurized above atmospheric pressure.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Hyperbaric O2 wound therapy</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Hyperbaric O2 wound therapy plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000153 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000153">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120020"/>
        <ns1:IAO_0000115 xml:lang="en">A material disease entity consisting of granulation tissue in a wound bed that has proliferated above the level of the surrounding skin surface.</ns1:IAO_0000115>
        <rdfs:label>Hypergranulation</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000154 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000154">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000471"/>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0007878"/>
        <ns1:IAO_0000115 xml:lang="en">A scarring process in which collagen is laid down in excess of the amount needed to replace the tissue lost in the wound, yielding a raised scar.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Hypertrophic scarring process</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Excessive collagen deposition process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000161 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000161">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120023"/>
        <ns1:IAO_0000115 xml:lang="en">A disease predisposition that inheres in a patient whose immune response is weaker than normal, whether through a disorder of the immune system or through drugs given to suppress it.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Recategorised when the causal-role groupings &apos;Medical condition contributing to wound formation&apos; / &apos;affecting wound healing&apos; / &apos;contributing to blistering wounds&apos; were dissolved. Those classes grouped entities by what they were said to cause, which this ontology does not assert, and they mixed material disorders with dispositions and processes. Relevance to wounds is now carried by co-location axioms on the wound classes instead of by membership in a causal class.</ns1:IAO_0000116>
        <rdfs:label>Immunosuppression</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000162 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000162">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <ns1:IAO_0000115 xml:lang="en">A material entity that is an adhesive polymer film applied to the skin over a surgical site, through which the surgical incision is made.</ns1:IAO_0000115>
        <rdfs:label>Incision foil</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000163 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000163">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000481"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000480"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000410"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A wound that participates in a wound infection process.</ns1:IAO_0000115>
        <rdfs:label>Infected wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000165 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000165">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000401"/>
        <ns1:IAO_0000115 xml:lang="en">A wound edge whose skin is continuous and shows no maceration, erosion, inflammation or other damage.</ns1:IAO_0000115>
        <rdfs:label>Intact wound margin</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000166 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000166">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000301"/>
        <ns1:IAO_0000115 xml:lang="en">A suture in situ that runs within the dermis along the wound edges and, between its ends, does not pass through the epidermal surface.</ns1:IAO_0000115>
        <rdfs:label>Intracutaneous suture</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000168 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000168">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000406"/>
        <ns1:IAO_0000115 xml:lang="en">A wound gel/ointment/cream that is an ointment with iodine or an iodine-releasing compound as its active ingredient.</ns1:IAO_0000115>
        <rdfs:label>Iodine ointment</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000170 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000170">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000177"/>
        <ns1:IAO_0000115 xml:lang="en">A low-vacuum drain consisting of a perforated flexible tube connected to a compressible bulb reservoir whose re-expansion after manual compression produces the suction.</ns1:IAO_0000115>
        <rdfs:label>Jackson-Pratt drain</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000171 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000171">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000269"/>
        <ns1:IAO_0000115 xml:lang="en">A pathological scarring process in which collagen is deposited beyond the margins of the original wound into the surrounding skin, yielding a raised scar that extends past the wound boundaries.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Keloid development process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000173 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000173">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120024"/>
        <ns1:IAO_0000115 xml:lang="en">A disease diagnostic result that is about a material disease entity that has as parts one or more subepidermal blisters that are immune-mediated tissue disorders marked by linear deposits of IgA antibodies along the epidermal basement membrane zone.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Moved from material disease entity to disease diagnostic result (curator, 2026-10-31): the name denotes a diagnostic classification, not one material disease entity; the material disease entity is what the diagnosis is about.</ns1:IAO_0000116>
        <ns1:IAO_0000116 xml:lang="en">Recategorised when the causal-role groupings &apos;Medical condition contributing to wound formation&apos; / &apos;affecting wound healing&apos; / &apos;contributing to blistering wounds&apos; were dissolved. Those classes grouped entities by what they were said to cause, which this ontology does not assert, and they mixed material disorders with dispositions and processes. Relevance to wounds is now carried by co-location axioms on the wound classes instead of by membership in a causal class.</ns1:IAO_0000116>
        <rdfs:label>Linear IgA dermatosis</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000174 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000174">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120024"/>
        <ns1:IAO_0000115 xml:lang="en">A disease diagnostic result that is about a material disease entity consisting of occlusive thrombi in small blood vessels of the dermis, without primary inflammation of the vessel walls.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Moved from material disease entity to disease diagnostic result (curator, 2026-10-31): the name denotes a diagnostic classification, not one material disease entity; the material disease entity is what the diagnosis is about.</ns1:IAO_0000116>
        <ns1:IAO_0000116 xml:lang="en">Recategorised when the causal-role groupings &apos;Medical condition contributing to wound formation&apos; / &apos;affecting wound healing&apos; / &apos;contributing to blistering wounds&apos; were dissolved. Those classes grouped entities by what they were said to cause, which this ontology does not assert, and they mixed material disorders with dispositions and processes. Relevance to wounds is now carried by co-location axioms on the wound classes instead of by membership in a causal class.</ns1:IAO_0000116>
        <rdfs:label>Livedovasculopathy</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000175 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000175">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000401"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000457"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000401"/>
        <ns1:IAO_0000115 xml:lang="en">A wound edge that bears the quality livid.</ns1:IAO_0000115>
        <rdfs:label>Livider wound margin</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000176 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000176">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000579"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000040"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000585"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A process of drug administration in which a material entity bearing a local anesthetic drug role participates.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Process of administering a local anesthetic agent</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000177 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000177">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000006"/>
        <ns1:IAO_0000115 xml:lang="en">An active drain that draws fluid out of a wound or body cavity under a mild negative pressure, weaker than that applied by a high-vacuum drain.</ns1:IAO_0000115>
        <rdfs:label>Low-vacuum drain</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000178 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000178">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120020"/>
        <ns1:IAO_0000115 xml:lang="en">A material disease entity consisting of an abnormal passage that connects a lymphatic vessel or lymph node with the body surface or another anatomical structure and through which lymph leaks.</ns1:IAO_0000115>
        <rdfs:label>Lymphatic fistula</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000180 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000180">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000401"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000435"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000401"/>
        <ns1:IAO_0000115 xml:lang="en">A wound edge that bears the quality macerated.</ns1:IAO_0000115>
        <rdfs:label>Macerated wound edge</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000182 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000182">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002353"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000414"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000515"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
        <ns1:IAO_0000115 xml:lang="en">A wound that is the specified output of a disorder development process that has as participant a malignancy.</ns1:IAO_0000115>
        <rdfs:label>Malignant wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000185 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000185">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000196"/>
        <ns1:IAO_0000115 xml:lang="en">A medicinal honey produced by bees from the nectar of the manuka tree, Leptospermum scoparium.</ns1:IAO_0000115>
        <rdfs:label>Manuka honey</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000186 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000186">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000441"/>
        <ns1:IAO_0000115 xml:lang="en">A skin wound that is an ulcerated malignant neoplasm in scar tissue or in a long-standing chronic wound.</ns1:IAO_0000115>
        <rdfs:label>Marjolin ulcer</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000188 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000188">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <ns1:IAO_0000115 xml:lang="en">A material entity that is intended to be applied to or placed in a wound in the course of a wound treatment process.</ns1:IAO_0000115>
        <rdfs:label>Material used for wound treatment</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000189 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000189">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120089"/>
        <ns1:IAO_0000115 xml:lang="en">A treatment plan specification that prescribes the removal of non-viable tissue, debris and foreign material from a wound by physical force applied to the wound bed, without cutting and without enzymatic, autolytic or biological agents.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Mechanical debridement</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Mechanical debridement plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000190 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000190">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000084"/>
        <ns1:IAO_0000115 xml:lang="en">A debridement process in which non-viable tissue, debris and foreign material are removed from a wound by physical force applied to the wound bed, without cutting and without enzymatic, autolytic or biological action.</ns1:IAO_0000115>
        <rdfs:label>Mechanical wound debridement process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000196 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000196">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000188"/>
        <ns1:IAO_0000115 xml:lang="en">A material used for wound treatment that consists of honey that has been filtered and sterilised to a standard for medical application to wounds.</ns1:IAO_0000115>
        <rdfs:label>Medicinal honey</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000200 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000200">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120099"/>
        <ns1:IAO_0000115 xml:lang="en">A medical condition treatment plan specification that prescribes actions to be carried out on or for a wound with the aim of promoting its healing or preventing its deterioration.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Method used for wound treatment</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Wound treatment plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000201 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000201">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000466"/>
        <ns1:IAO_0000115 xml:lang="en">An angiopathy that is about an abnormal structure of the wall or lumen of small blood vessels, namely arterioles, capillaries or venules.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Moved from material disease entity to disease diagnostic result (curator, 2026-10-31): the name denotes a diagnostic classification, not one material disease entity; the material disease entity is what the diagnosis is about.</ns1:IAO_0000116>
        <ns1:IAO_0000116 xml:lang="en">Recategorised when the causal-role groupings &apos;Medical condition contributing to wound formation&apos; / &apos;affecting wound healing&apos; / &apos;contributing to blistering wounds&apos; were dissolved. Those classes grouped entities by what they were said to cause, which this ontology does not assert, and they mixed material disorders with dispositions and processes. Relevance to wounds is now carried by co-location axioms on the wound classes instead of by membership in a causal class.</ns1:IAO_0000116>
        <rdfs:label>Microangiopathy</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000202 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000202">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000089"/>
        <ns1:IAO_0000115 xml:lang="en">A diagnostic process to assess wound characteristics in which a specimen collected from the wound with a swab is examined in a laboratory to detect and identify microorganisms that participate in wound infection.</ns1:IAO_0000115>
        <rdfs:label>Microbial analysis of the wound swab for wound pathogens</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000203 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000203">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_120020"/>
        <ns1:IAO_0000115 xml:lang="en">A necrotic material that has a high water content and a soft, wet consistency, in contrast to dry, hardened necrotic tissue such as eschar.</ns1:IAO_0000115>
        <rdfs:label>Moist necrosis</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000204 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000204">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000311"/>
        <ns1:IAO_0000115 xml:lang="en">A thoracic drain that is inserted through the anterior chest wall at the second intercostal space in the midclavicular line.</ns1:IAO_0000115>
        <rdfs:label>Monaldi drain</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000205 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000205">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <ns1:IAO_0000115 xml:lang="en">A material entity that is suture thread consisting of a single strand, rather than of several filaments braided or twisted together.</ns1:IAO_0000115>
        <rdfs:label>Monofilament thread material</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000207 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000207">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000010"/>
        <ns1:IAO_0000115 xml:lang="en">An antiseptic alcohol that consists of propan-1-ol, the unbranched primary alcohol with three carbon atoms.</ns1:IAO_0000115>
        <rdfs:label>n-propanol</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000208 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000208">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000412"/>
        <ns1:IAO_0000115 xml:lang="en">A wound irrigation solution that is an aqueous solution of sodium chloride at a concentration of 0.9% (w/v), isotonic with body fluids.</ns1:IAO_0000115>
        <rdfs:label>NaCl 0.9%</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000209 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000209">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000412"/>
        <ns1:IAO_0000115 xml:lang="en">A wound irrigation solution that is an aqueous solution of sodium chloride at a concentration of 10% (w/v), hypertonic relative to body fluids.</ns1:IAO_0000115>
        <rdfs:label>NaCl 10%</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000211 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000211">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000382"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000461"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000382"/>
        <ns1:IAO_0000115 xml:lang="en">A wound base that bears the quality necrotic.</ns1:IAO_0000115>
        <rdfs:label>Necrotic wound bed</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000213 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000213">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000200"/>
        <ns1:IAO_0000115 xml:lang="en">A wound treatment plan specification that prescribes the application of sub-atmospheric pressure to the wound bed through an airtight dressing connected to a suction source.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Negative pressure wound therapy</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Negative pressure wound therapy plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000215 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000215">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <ns1:IAO_0000115 xml:lang="en">A material entity that is suture thread which is not broken down and absorbed by the body&apos;s tissues and so persists in the tissue unless it is removed.</ns1:IAO_0000115>
        <rdfs:label>Non-absorbable thread material</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000216 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000216">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000423"/>
        <ns1:IAO_0000115 xml:lang="en">A wound treatment process in which the dietary or supplementary nutrient intake of a patient who has a wound is changed with the aim of correcting a deficiency or imbalance of nutrients in the patient&apos;s body.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Nutritional status improvement process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000220 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000220">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000406"/>
        <ns1:IAO_0000115 xml:lang="en">A wound gel/ointment/cream that has a gel consistency and contains octenidine dihydrochloride as its antiseptic active substance.</ns1:IAO_0000115>
        <rdfs:label>Octenidine gel</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000221 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000221">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000093"/>
        <ns1:IAO_0000115 xml:lang="en">A drain that discharges fluid from a wound or body cavity into an absorbent dressing or the surroundings rather than into a sealed collection container.</ns1:IAO_0000115>
        <rdfs:label>Open drain</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000222 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000222">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120099"/>
        <ns1:IAO_0000115 xml:lang="en">A medical condition treatment plan specification that prescribes pharmacological or non-pharmacological measures to prevent or reduce pain experienced by the patient.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Pain management</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Pain management plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000224 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000224">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000093"/>
        <ns1:IAO_0000115 xml:lang="en">A drain that removes fluid by gravity, capillary action or pressure differences arising in the body, without suction from an external source.</ns1:IAO_0000115>
        <rdfs:label>Passive drain</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000225 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000225">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000200"/>
        <ns1:IAO_0000115 xml:lang="en">A wound treatment plan specification that prescribes instructing the patient, and where applicable the patient&apos;s caregivers, about the wound, its care and the behaviours the patient is to carry out or avoid during treatment.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Patient education</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Patient education plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000227 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000227">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000058"/>
        <ns1:IAO_0000115 xml:lang="en">A capillary drain consisting of a soft, collapsible, thin-walled open tube that is placed in a wound and conducts fluid out along its inner and outer surfaces without applied suction.</ns1:IAO_0000115>
        <rdfs:label>Penrose drain</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000228 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000228">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120100"/>
        <ns1:IAO_0000115 xml:lang="en">A prophylaxis plan specification that prescribes the administration of one or more antimicrobial agents to a patient in the period immediately before, during or after a surgical procedure, with the objective of preventing surgical site infection.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Perioperative antimicrobial prophylaxis</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Perioperative antimicrobial prophylaxis plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000229 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000229">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000466"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_120085"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">An angiopathy that is about a narrowed limb artery.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Moved from material disease entity to disease diagnostic result (curator, 2026-10-31): the name denotes a diagnostic classification, not one material disease entity; the material disease entity is what the diagnosis is about.</ns1:IAO_0000116>
        <ns1:IAO_0000116 xml:lang="en">Recategorised when the causal-role groupings &apos;Medical condition contributing to wound formation&apos; / &apos;affecting wound healing&apos; / &apos;contributing to blistering wounds&apos; were dissolved. Those classes grouped entities by what they were said to cause, which this ontology does not assert, and they mixed material disorders with dispositions and processes. Relevance to wounds is now carried by co-location axioms on the wound classes instead of by membership in a causal class.</ns1:IAO_0000116>
        <rdfs:label>Peripheral arterial occlusive disease</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000233 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000233">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120024"/>
        <ns1:IAO_0000115 xml:lang="en">A disease diagnostic result that is about a material disease entity consisting in a purulent inflammation of soft connective tissue that spreads diffusely through the tissue and is not confined by a capsule.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Moved from material disease entity to disease diagnostic result (curator, 2026-10-31): the name denotes a diagnostic classification, not one material disease entity; the material disease entity is what the diagnosis is about.</ns1:IAO_0000116>
        <rdfs:label>Phlegmon</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000235 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000235">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000224"/>
        <ns1:IAO_0000115 xml:lang="en">A passive drain consisting of a thin flexible catheter whose distal end curls into a loop once placed, holding the catheter in position, and that has side holes in the looped segment through which fluid enters.</ns1:IAO_0000115>
        <rdfs:label>Pigtail catheter</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000236 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000236">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000419"/>
        <ns1:IAO_0000115 xml:lang="en">A wound size measurement process in which the outline of the wound is traced or photographed and the area it encloses is determined.</ns1:IAO_0000115>
        <rdfs:label>Planimetry</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000237 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000237">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000112"/>
        <ns1:IAO_0000115 xml:lang="en">A fixing bandage consisting of a flexible backing strip coated on one side with a pressure-sensitive adhesive, that holds a dressing or device in place by adhering to the skin.</ns1:IAO_0000115>
        <rdfs:label>Plaster</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000238 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000238">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_3095"/>
        <ns1:IAO_0000115 xml:lang="en">A biguanide that is a polymer whose repeating unit consists of a biguanide group linked to a hexamethylene chain.</ns1:IAO_0000115>
        <rdfs:label>Polihexanide</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000239 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000239">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000026"/>
        <ns1:IAO_0000115 xml:lang="en">An antiseptic solution that has polihexanide as an active antiseptic ingredient.</ns1:IAO_0000115>
        <rdfs:label>Polihexanide containing solution</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000240 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000240">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000406"/>
        <ns1:IAO_0000115 xml:lang="en">A wound gel/ointment/cream that has a semi-solid, water-based gel consistency and contains polihexanide as an active antiseptic ingredient.</ns1:IAO_0000115>
        <rdfs:label>Polihexanide gel</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000241 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000241">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <ns1:IAO_0000115 xml:lang="en">A material entity consisting of surgical suture thread in which each strand is made of multiple filaments braided or twisted together.</ns1:IAO_0000115>
        <rdfs:label>Polyfilament thread material</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000243 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000243">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000395"/>
        <ns1:IAO_0000115 xml:lang="en">A wound diagnostic process in which a surgical wound is inspected and assessed after the operation that created it, to monitor its healing and to detect wound complications.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Postoperative wound control process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000245 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000245">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000418"/>
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000519"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000519"/>
        <ns1:IAO_0000115 xml:lang="en">A pressure impact process that is a wound development subprocess.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Pressure impact process in wound development</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000247 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000247">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000248"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
        <ns1:IAO_0000115 xml:lang="en">A wound that participates in a wound healing by primary intention.</ns1:IAO_0000115>
        <rdfs:label>Primarily-healing wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000248 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000248">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0042060"/>
        <ns1:IAO_0000115 xml:lang="en">A wound healing in which the directly approximated edges of a wound with little tissue loss join together, so that the wound closes with minimal granulation tissue formation and leaves a narrow scar.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Wound healing by primary intention</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Wound healing by primary intention process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000253 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000253">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000404"/>
        <ns1:IAO_0000115 xml:lang="en">A wound exudate that is opaque and viscous and consists predominantly of neutrophils, cellular debris and liquefied necrotic tissue.</ns1:IAO_0000115>
        <rdfs:label>Purulent exudate</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000256 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000256">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000401"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000456"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000401"/>
        <ns1:IAO_0000115 xml:lang="en">A wound edge that bears the quality reddened.</ns1:IAO_0000115>
        <rdfs:label>Reddened wound edge</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000257 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000257">
        <ns1:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000227"/>
        <ns1:IAO_0100001 rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000456"/>
        <rdfs:comment xml:lang="en">Merged into WONT_0000456 reddened (curator 2026-10-31, relayed by the thesis session: &quot;all ok, merge 18 and 19&quot;).</rdfs:comment>
        <rdfs:label>obsolete Redness</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000258 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000258">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000145"/>
        <ns1:IAO_0000115 xml:lang="en">A high-vacuum drain consisting of a perforated plastic tube placed in a wound and connected to a closed collecting bottle that is evacuated before use, so that the negative pressure in the bottle draws fluid out of the wound.</ns1:IAO_0000115>
        <rdfs:label>Redon drain</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000260 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000260">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0042060"/>
        <ns1:IAO_0000115 xml:lang="en">A wound healing in which the tissue lost in the wound is replaced by newly formed tissue of the same type, restoring the original tissue architecture and function without scar formation.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Regenerative wound healing</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Regenerative wound healing process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000261 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000261">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000260"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
        <ns1:IAO_0000115 xml:lang="en">A wound that participates in a regenerative wound healing.</ns1:IAO_0000115>
        <rdfs:label>Regeneratively-healing wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000263 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000263">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000409"/>
        <ns1:IAO_0000115 xml:lang="en">A wound healing related physiological process in which damaged or lost tissue is replaced by newly formed tissue, by regeneration, by scar formation or both, so that the continuity of the injured tissue is restored.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Tissue repair process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000265 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000265">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <ns1:IAO_0000115 xml:lang="en">A material entity consisting of surgical suture thread made of a material that, after implantation, is degraded by hydrolysis or enzymatic action in the body and absorbed, so that it does not have to be removed.</ns1:IAO_0000115>
        <rdfs:label>Resorbable thread material</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000266 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000266">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000412"/>
        <ns1:IAO_0000115 xml:lang="en">A wound irrigation solution consisting of sodium chloride, potassium chloride and calcium chloride dissolved in water, isotonic with blood plasma.</ns1:IAO_0000115>
        <rdfs:label>Ringer solution</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000267 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000267">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000133"/>
        <ns1:IAO_0000115 xml:lang="en">A gravity drain that is a closed passive system consisting of a soft perforated tube leading from the wound or body cavity into a sealed collection bag.</ns1:IAO_0000115>
        <rdfs:label>Robinson drain</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000268 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000268">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000404"/>
        <ns1:IAO_0000115 xml:lang="en">A wound exudate that consists predominantly of fresh blood and is thin and red.</ns1:IAO_0000115>
        <rdfs:label>Sanguine exudate</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000269 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000269">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120021"/>
        <ns1:IAO_0000115 xml:lang="en">A disorder development process in which the fibrous tissue laid down during wound repair is deposited in excess or in a disorganized way, and that has as output an abnormal scar.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Pathological scarring process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000271 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000271">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000339"/>
        <ns1:IAO_0000115 xml:lang="en">A traumatic wound that is a superficial linear disruption of the skin and the output of a process in which a sharp or rough object is drawn across the skin surface.</ns1:IAO_0000115>
        <rdfs:label>Scratch wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000272 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000272">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000274"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
        <ns1:IAO_0000115 xml:lang="en">A wound that participates in a wound healing by secondary intention.</ns1:IAO_0000115>
        <rdfs:label>Secondarily-healing wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000273 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000273">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000398"/>
        <ns1:IAO_0000115 xml:lang="en">A wound dressing that is placed over a primary dressing and does not itself contact the wound bed.</ns1:IAO_0000115>
        <rdfs:label>Secondary dressing</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000274 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000274">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0042060"/>
        <ns1:IAO_0000115 xml:lang="en">A wound healing in which the wound edges are not approximated and the tissue defect is closed by the formation of granulation tissue, wound contraction and epithelialization.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Wound healing by secondary intention</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Wound healing by secondary intention process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000275 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000275">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000093"/>
        <ns1:IAO_0000115 xml:lang="en">A drain consisting of a tube that leads fluid out of the wound into a dressing or an unsealed receptacle, so that the drainage pathway remains open to the environment.</ns1:IAO_0000115>
        <rdfs:label>Semi-open drain</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000276 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000276">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120020"/>
        <ns1:IAO_0000115 xml:lang="en">A material disease entity that is a collection of serous fluid accumulated in a tissue space or surgically created dead space, consisting of neither pus nor blood.</ns1:IAO_0000115>
        <rdfs:label>Seroma</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000277 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000277">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000404"/>
        <ns1:IAO_0000115 xml:lang="en">A wound exudate that is thin, watery and pale red to pink, consisting of serous fluid mixed with a small amount of blood.</ns1:IAO_0000115>
        <rdfs:label>Serosanguineous exudate</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000278 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000278">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000404"/>
        <ns1:IAO_0000115 xml:lang="en">A wound exudate that is thin, watery and clear to pale yellow, consisting of plasma-derived fluid without appreciable blood or pus.</ns1:IAO_0000115>
        <rdfs:label>Serous exudate</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000279 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000279">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000066"/>
        <ns1:IAO_0000115 xml:lang="en">A wound classification scale that grades pressure ulcers according to Shea by the deepest tissue layer involved, from the epidermis and dermis through subcutaneous fat and deep fascia to bone.</ns1:IAO_0000115>
        <rdfs:label>Shea classification of pressure ulcers</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000280 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000280">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000398"/>
        <ns1:IAO_0000115 xml:lang="en">A wound dressing consisting of a thin perforated silicone sheet that is placed in direct contact with the wound bed and through whose openings exudate passes to an overlying dressing.</ns1:IAO_0000115>
        <rdfs:label>Silicone spacer grid</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000282 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000282">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000398"/>
        <ns1:IAO_0000115 xml:lang="en">A wound dressing that has silver, in elemental, ionic or compound form, incorporated as a component bearing an antimicrobial agent role.</ns1:IAO_0000115>
        <rdfs:label>Silver-containing wound dressing</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000283 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000283">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000301"/>
        <ns1:IAO_0000115 xml:lang="en">A suture in situ consisting of a single stitch that passes through both wound edges and is knotted and cut separately from any adjacent stitch.</ns1:IAO_0000115>
        <rdfs:label>Simple interrupted suture</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000284 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000284">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000395"/>
        <ns1:IAO_0000115 xml:lang="en">A wound diagnostic process in which the hue of the skin in and around the wound is inspected and that has as specified output a datum about that hue.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Skin color assessment process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000285 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000285">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <ns1:IAO_0000115 xml:lang="en">A material entity that is a portion of skin, comprising epidermis and part or all of the dermis, that has been separated from its donor site and its blood supply and is transferred to a recipient site.</ns1:IAO_0000115>
        <rdfs:label>Skin graft</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000286 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000286">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000200"/>
        <ns1:IAO_0000115 xml:lang="en">A wound treatment plan specification that prescribes harvesting a skin graft from a donor site and fixing it onto the wound bed as the recipient site.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Skin grafting</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Skin grafting plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000287 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000287">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000389"/>
        <ns1:IAO_0000115 xml:lang="en">A wound closure technique plan specification that prescribes approximating the skin edges of a wound with metal staples inserted by a stapling device.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Skin stapling</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Skin stapling plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000289 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000289">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <ns1:IAO_0000115 xml:lang="en">A process in which a person inhales and exhales the smoke produced by burning tobacco or another plant material.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Recategorised when the causal-role groupings &apos;Medical condition contributing to wound formation&apos; / &apos;affecting wound healing&apos; / &apos;contributing to blistering wounds&apos; were dissolved. Those classes grouped entities by what they were said to cause, which this ontology does not assert, and they mixed material disorders with dispositions and processes. Relevance to wounds is now carried by co-location axioms on the wound classes instead of by membership in a causal class.</ns1:IAO_0000116>
        <rdfs:label>Smoking</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000290 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000290">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000401"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000458"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000401"/>
        <ns1:IAO_0000115 xml:lang="en">A wound edge that bears the quality softened.</ns1:IAO_0000115>
        <rdfs:label>Softened wound edge</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000291 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000291">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000395"/>
        <ns1:IAO_0000115 xml:lang="en">A wound diagnostic process that examines the presence, intensity and character of the odor emanating from a wound and has as specified output a datum about that wound odor.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Wound odor assessment process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000292 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000292">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000285"/>
        <ns1:IAO_0000115 xml:lang="en">A skin graft that consists of the epidermis together with only part of the thickness of the underlying dermis of the donor site.</ns1:IAO_0000115>
        <rdfs:label>Split-thickness skin graft</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000296 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000296">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000188"/>
        <ns1:IAO_0000115 xml:lang="en">A material used for wound treatment that contains exogenous enzymes which, when applied to a wound, degrade necrotic tissue and devitalized extracellular matrix so that they can be removed from the wound bed.</ns1:IAO_0000115>
        <rdfs:label>Substance used for enzymatic wound debridement</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000297 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000297">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000029"/>
        <ns1:IAO_0000115 xml:lang="en">An aseptic conditions plan specification that prescribes that the surfaces on which instruments and materials for the wound treatment are laid out be disinfected beforehand.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Surface disinfection</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Surface disinfection plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000298 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000298">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120086"/>
        <ns1:IAO_0000115 xml:lang="en">A disease disorder treatment process in which the disease or disorder is treated by an operative manual and instrumental intervention on the patient&apos;s body, such as incision, excision, manipulation or repair of tissue.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Surgical treatment process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000299 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000299">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000084"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002233"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A debridement process in which necrotic, devitalized or infected tissue and foreign material are removed from a wound by sharp excision with surgical instruments.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Surgical wound debridement process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000301 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000301">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0001300"/>
        <ns1:IAO_0000115 xml:lang="en">A device consisting of suture material that has been placed through or around tissue of a patient and secured there so that it holds the tissue in apposition or in position.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Suture in situ</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000302 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000302">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000389"/>
        <ns1:IAO_0000115 xml:lang="en">A wound closure technique plan specification that prescribes approximating the wound edges by passing a needle with attached suture material through the tissue on both sides of the wound and securing the thread.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Suturing</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Suturing plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000304 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000304">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000398"/>
        <ns1:IAO_0000115 xml:lang="en">A wound dressing that consists of a porous, absorbent foam made of a synthetic polymer.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Synthetic wound dressing foam</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000305 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000305">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000016"/>
        <ns1:IAO_0000115 xml:lang="en">An antibiotic therapy plan specification that prescribes administering an antibiotic by an enteral or parenteral route so that it is distributed throughout the body via the bloodstream.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Systemic antibiotic therapy</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Systemic antibiotic therapy plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000306 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000306">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000089"/>
        <ns1:IAO_0000115 xml:lang="en">A diagnostic process to assess wound characteristics in which a swab is passed over the wound bed to collect a specimen of wound material for laboratory examination.</ns1:IAO_0000115>
        <rdfs:label>Taking a wound swab</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000307 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000307">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000308"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
        <ns1:IAO_0000115 xml:lang="en">A wound that participates in a wound healing by tertiary intention.</ns1:IAO_0000115>
        <rdfs:label>Tertiarily-healing wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000308 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000308">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0042060"/>
        <ns1:IAO_0000115 xml:lang="en">A wound healing in which the wound is initially left open and only closed surgically after a delay, with healing proceeding after this delayed primary closure.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Wound healing by tertiary intention</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Wound healing by tertiary intention process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000310 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000310">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000339"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002353"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000140"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A traumatic wound that is the output of a heat impact process in wound development, in which tissue is damaged by the action of excessive heat.</ns1:IAO_0000115>
        <rdfs:label>Thermal wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000311 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000311">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000093"/>
        <ns1:IAO_0000115 xml:lang="en">A drain that is inserted through the chest wall into the pleural cavity or mediastinum to evacuate air, fluid or blood from it.</ns1:IAO_0000115>
        <rdfs:label>Thoracic drain</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000315 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000315">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000117"/>
        <ns1:IAO_0000115 xml:lang="en">A size that inheres in a surgical suture thread and corresponds to a designation of its diameter in a standardized suture sizing scale.</ns1:IAO_0000115>
        <rdfs:label>Thread size</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000316 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000316">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000315"/>
        <ns1:IAO_0000115 xml:lang="en">A thread size that corresponds to the suture size designation 0 of the United States Pharmacopeia scale, next larger than 2-0 and next smaller than 1.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">1-0</ns1:IAO_0000118>
        <rdfs:label>Thread size 0</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000317 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000317">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000315"/>
        <ns1:IAO_0000115 xml:lang="en">A thread size that corresponds to the suture size designation 1 of the United States Pharmacopeia scale, next larger than 0 and next smaller than 2.</ns1:IAO_0000115>
        <rdfs:label>Thread size 1</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000318 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000318">
        <ns1:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000227"/>
        <ns1:IAO_0100001 rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000316"/>
        <rdfs:comment xml:lang="en">Merged into WONT_0000316 Thread size 0, which carries &apos;1-0&apos; as a synonym (curator 2026-10-31, relayed by the thesis session: &quot;all ok, merge 18 and 19&quot;).</rdfs:comment>
        <rdfs:label>obsolete Thread size 1-0</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000319 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000319">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000315"/>
        <ns1:IAO_0000115 xml:lang="en">A thread size that corresponds to the suture size designation 10-0 of the United States Pharmacopeia scale, next smaller than 9-0 and next larger than 11-0.</ns1:IAO_0000115>
        <rdfs:label>Thread size 10-0</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000320 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000320">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000315"/>
        <ns1:IAO_0000115 xml:lang="en">A thread size that corresponds to the suture size designation 11-0 of the United States Pharmacopeia scale, next smaller than 10-0.</ns1:IAO_0000115>
        <rdfs:label>Thread size 11-0</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000321 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000321">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000315"/>
        <ns1:IAO_0000115 xml:lang="en">A thread size that is the suture size designation 12-0, one step finer than 11-0 on the suture size scale, on which sizes written n-0 become finer as n increases.</ns1:IAO_0000115>
        <rdfs:label>Thread size 12-0</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000322 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000322">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000315"/>
        <ns1:IAO_0000115 xml:lang="en">A thread size that is the suture size designation 13-0, one step finer than 12-0 on the suture size scale, on which sizes written n-0 become finer as n increases.</ns1:IAO_0000115>
        <rdfs:label>Thread size 13-0</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000323 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000323">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000315"/>
        <ns1:IAO_0000115 xml:lang="en">A thread size that is the suture size designation 2, one step coarser than 1 on the suture size scale, on which sizes written as whole numbers become coarser as the number increases.</ns1:IAO_0000115>
        <rdfs:label>Thread size 2</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000324 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000324">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000315"/>
        <ns1:IAO_0000115 xml:lang="en">A thread size that is the suture size designation 2-0, one step finer than 0 and one step coarser than 3-0 on the suture size scale.</ns1:IAO_0000115>
        <rdfs:label>Thread size 2-0</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000325 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000325">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000315"/>
        <ns1:IAO_0000115 xml:lang="en">A thread size that is the suture size designation 3, one step coarser than 2 on the suture size scale, on which sizes written as whole numbers become coarser as the number increases.</ns1:IAO_0000115>
        <rdfs:label>Thread size 3</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000326 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000326">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000315"/>
        <ns1:IAO_0000115 xml:lang="en">A thread size that is the suture size designation 3-0, one step finer than 2-0 and one step coarser than 4-0 on the suture size scale.</ns1:IAO_0000115>
        <rdfs:label>Thread size 3-0</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000327 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000327">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000315"/>
        <ns1:IAO_0000115 xml:lang="en">A thread size that is the suture size designation 4, one step coarser than 3 on the suture size scale, on which sizes written as whole numbers become coarser as the number increases.</ns1:IAO_0000115>
        <rdfs:label>Thread size 4</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000328 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000328">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000315"/>
        <ns1:IAO_0000115 xml:lang="en">A thread size that is the suture size designation 4-0, one step finer than 3-0 and one step coarser than 5-0 on the suture size scale.</ns1:IAO_0000115>
        <rdfs:label>Thread size 4-0</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000329 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000329">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000315"/>
        <ns1:IAO_0000115 xml:lang="en">A thread size that is the suture size designation 5, one step coarser than 4 on the suture size scale, on which sizes written as whole numbers become coarser as the number increases.</ns1:IAO_0000115>
        <rdfs:label>Thread size 5</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000330 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000330">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000315"/>
        <ns1:IAO_0000115 xml:lang="en">A thread size that is the suture size designation 5-0, one step finer than 4-0 and one step coarser than 6-0 on the suture size scale.</ns1:IAO_0000115>
        <rdfs:label>Thread size 5-0</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000331 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000331">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000315"/>
        <ns1:IAO_0000115 xml:lang="en">A thread size that is the suture size designation 6-0, one step finer than 5-0 and one step coarser than 7-0 on the suture size scale.</ns1:IAO_0000115>
        <rdfs:label>Thread size 6-0</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000332 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000332">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000315"/>
        <ns1:IAO_0000115 xml:lang="en">A thread size that is the suture size designation 7-0, one step finer than 6-0 and one step coarser than 8-0 on the suture size scale.</ns1:IAO_0000115>
        <rdfs:label>Thread size 7-0</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000333 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000333">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000315"/>
        <ns1:IAO_0000115 xml:lang="en">A thread size that is the suture size designation 8-0, one step finer than 7-0 and one step coarser than 9-0 on the suture size scale.</ns1:IAO_0000115>
        <rdfs:label>Thread size 8-0</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000334 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000334">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000315"/>
        <ns1:IAO_0000115 xml:lang="en">A thread size that is the suture size designation 9-0, one step finer than 8-0 and one step coarser than 10-0 on the suture size scale.</ns1:IAO_0000115>
        <rdfs:label>Thread size 9-0</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000335 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000335">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000016"/>
        <ns1:IAO_0000115 xml:lang="en">An antibiotic therapy plan specification that prescribes applying an antibiotic agent directly onto the surface of the skin, a mucous membrane or a wound at the site to be treated rather than giving it systemically.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Topical antibiotic therapy</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Topical antibiotic therapy plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000336 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000336">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33284"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A material entity that bears the role nutrient.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">trace element</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000337 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000337">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000398"/>
        <ns1:IAO_0000115 xml:lang="en">A wound dressing that consists of a thin, transparent, semipermeable sheet of polyurethane through which the covered wound can be inspected.</ns1:IAO_0000115>
        <rdfs:label>Transparent polyurethane film</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000338 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000338">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <ns1:IAO_0000115 xml:lang="en">A process in which a sudden external mechanical force acts on a tissue.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Trauma process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000339 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000339">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002353"/>
                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000516"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
        <ns1:IAO_0000115 xml:lang="en">A wound that is the output of a trauma process in wound development.</ns1:IAO_0000115>
        <rdfs:label>Traumatic wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000341 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000341">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000066"/>
        <ns1:IAO_0000115 xml:lang="en">A wound classification scale that grades the severity of the soft-tissue injury accompanying a closed or open fracture.</ns1:IAO_0000115>
        <rdfs:label>Tscherne and Oestern wound classification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000342 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000342">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_120016"/>
        <ns1:IAO_0000115 xml:lang="en">A wound classification grade that is a category of the Tscherne and Oestern wound classification.</ns1:IAO_0000115>
        <rdfs:label>Tscherne and Oestern wound classification grade</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000344 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000344">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000093"/>
        <ns1:IAO_0000115 xml:lang="en">A drain that is a small tube placed through an incision in the tympanic membrane so that the middle ear is ventilated and fluid can drain from it.</ns1:IAO_0000115>
        <rdfs:label>Tympanic drain</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000346 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000346">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000441"/>
        <ns1:IAO_0000115 xml:lang="en">A skin wound that is an ulcer of the lower leg in a patient who has both chronic venous insufficiency and peripheral arterial disease, so that venous and arterial disorders together form its pathogenic background.</ns1:IAO_0000115>
        <rdfs:label>Ulcus cruris mixtum</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000347 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000347">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000384"/>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000441"/>
        <ns1:IAO_0000115 xml:lang="en">A venous insufficiency wound that is an ulcer of the skin of the lower leg.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Venous leg ulcer</ns1:IAO_0000118>
        <rdfs:label>Ulcus cruris venosum</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000348 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000348">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000441"/>
        <ns1:IAO_0000115 xml:lang="en">A skin wound that is an ulcer of the lower leg at a site of ischemic necrosis of the skin, with stenosing arteriolosclerosis of subcutaneous arterioles, in a patient with arterial hypertension.</ns1:IAO_0000115>
        <rdfs:label>Ulcus hypertonicus Martorell</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000350 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000350">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000084"/>
        <ns1:IAO_0000115 xml:lang="en">A debridement process in which devitalized tissue, debris and biofilm are detached from a wound bed by ultrasonic energy transmitted through a fluid applied to the wound.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Ultrasound-assisted wound debridement process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000351 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000351">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000401"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000459"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000401"/>
        <ns1:IAO_0000115 xml:lang="en">A wound edge that bears the quality undermined.</ns1:IAO_0000115>
        <rdfs:label>Undermined wound margin</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000352 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000352">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000066"/>
        <ns1:IAO_0000115 xml:lang="en">A wound classification scale that structures the assessment of a wound into four features recorded in turn: the skin surrounding the wound, the wound edge, the wound base and the exudate.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">URGE scheme</ns1:IAO_0000118>
        <rdfs:label>Wound assessment scheme of surroundings, edge, base and exudate</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000355 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000355">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000093"/>
        <ns1:IAO_0000115 xml:lang="en">A drain that is inserted through the skull into a cerebral ventricle to conduct cerebrospinal fluid out of the ventricular system.</ns1:IAO_0000115>
        <rdfs:label>Ventricular drain</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000356 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000356">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000301"/>
        <ns1:IAO_0000115 xml:lang="en">A suture in situ in which each stitch crosses the wound twice in a plane perpendicular to the wound edge, with one deep pass placed far from the wound edge and one superficial pass placed near it, and is tied on the side where it entered.</ns1:IAO_0000115>
        <rdfs:label>Vertical mattress suture</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000358 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000358">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000406"/>
        <ns1:IAO_0000115 xml:lang="en">A wound gel/ointment/cream that is a gel with diclofenac as its active ingredient.</ns1:IAO_0000115>
        <ns2:hasRelatedSynonym xml:lang="en">Voltaren gel</ns2:hasRelatedSynonym>
        <rdfs:label>Diclofenac gel</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000375 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000375">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000066"/>
        <ns1:IAO_0000115 xml:lang="en">A wound classification scale that grades a diabetic foot wound by combining a depth grade from 0 to 3 with a stage from A to D that records whether neither, infection, ischaemia or both are present.</ns1:IAO_0000115>
        <rdfs:label>University of Texas wound classification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000376 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000376">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_120016"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000549"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A wound classification grade that is a category of the University of Texas wound classification.</ns1:IAO_0000115>
        <rdfs:label>University of Texas wound classification grade</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000377 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000377">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000084"/>
        <ns1:IAO_0000115 xml:lang="en">A debridement process in which devitalized tissue and debris are cut away from a wound and removed by a high-velocity jet of sterile liquid.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Water-jet assisted wound debridement process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000378 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000378">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000029"/>
        <ns1:IAO_0000115 xml:lang="en">An aseptic conditions plan specification that prescribes that persons coming into contact with a wound or sterile field cover their hands with gloves that are free of viable microorganisms.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Wearing Sterile gloves</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Wearing sterile gloves plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000379 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000379">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000392"/>
        <ns1:IAO_0000115 xml:lang="en">A wound dehiscence that is the output of a wound dehiscence process in which the sutures holding the wound edges together fail to keep them approximated.</ns1:IAO_0000115>
        <rdfs:label>Wound dehiscence with suture insufficiency</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380">
        <owl:equivalentClass>
