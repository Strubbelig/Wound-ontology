                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002353"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000414"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000587"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
        <ns1:IAO_0000115 xml:lang="en">A wound that is the output of a wound development process that has as part a foreign body process.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Foreign body wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000555 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000555">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <ns1:IAO_0000115 xml:lang="en">A material entity that is located in a body part or wound of an organism, is not part of that organism, and has entered or been placed there from outside.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Foreign body</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000556 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000556">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002353"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000154"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A material entity that is a raised mass of excess collagenous scar tissue at the site of a healed wound, is the output of an excessive collagen deposition process, and remains confined to the boundaries of the original wound.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Hypertrophic scar</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000558 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000558">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120024"/>
        <ns1:IAO_0000115 xml:lang="en">A disease diagnostic result that is about a material disease entity consisting in the abnormal organization of the organs or tissues of a patient that is the output of a dysregulated host response to an infection, such that organ function is impaired.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Moved from material disease entity to disease diagnostic result (curator, 2026-10-31): the name denotes a diagnostic classification, not one material disease entity; the material disease entity is what the diagnosis is about.</ns1:IAO_0000116>
        <rdfs:label xml:lang="en">Sepsis</rdfs:label>
        <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/DOID_0040085"/>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000559 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000559">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120024"/>
        <ns1:IAO_0000115 xml:lang="en">A disease diagnostic result that is about a material disease entity that is a portion of bone, including its marrow, affected by inflammation.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Moved from material disease entity to disease diagnostic result (curator, 2026-10-31): the name denotes a diagnostic classification, not one material disease entity; the material disease entity is what the diagnosis is about.</ns1:IAO_0000116>
        <rdfs:label xml:lang="en">Osteomyelitis</rdfs:label>
        <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/DOID_1019"/>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000560 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000560">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000418"/>
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000586"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000586"/>
        <ns1:IAO_0000115 xml:lang="en">A neuropathic disease process that is a wound development subprocess.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Neuropathic disease process in wound development</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000561 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000561">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_120016"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0042060"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A wound classification grade of the scheme that divides wound healing into phases (hemostasis, inflammatory, proliferative, remodeling). The phases are labels assigned to stretches of the healing process, not processes themselves; each is about the processes it groups.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Wound healing phase</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000566 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000566">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <ns1:IAO_0000115 xml:lang="en">A process in which bacteria adhere to and multiply on the surface of or within a tissue of a host organism.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Bacterial colonization process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000568 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000568">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000423"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000580"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A wound treatment process that realizes a pressure redistribution function, in which mechanical load on the wound site is reduced or removed.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Pressure offloading process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000569 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000569">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120100"/>
        <ns1:IAO_0000115 xml:lang="en">A prophylaxis plan specification that prescribes giving a substance bearing an antibiotic drug role to a patient to prevent a bacterial infection.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Prophylactic antibiotic therapy</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Prophylactic antibiotic therapy plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000570 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000570">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0001300"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000568"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000085"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000580"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A device that is a support surface on which a recumbent person lies and that bears a pressure redistribution function.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Pressure redistribution mattress</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000571 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000571">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0001300"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000568"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000085"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000580"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A device that is worn on the foot and bears a pressure redistribution function acting on the surfaces of the foot.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Therapeutic footwear</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000572 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000572">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000395"/>
        <ns1:IAO_0000115 xml:lang="en">A wound diagnostic process in which a specimen taken from a wound is incubated in a growth medium so that bacteria present in it multiply and can be detected and identified.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Bacterial culture process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000573 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000573">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000395"/>
        <ns1:IAO_0000115 xml:lang="en">A wound diagnostic process that evaluates the condition of the blood vessels supplying or draining the body region in which a wound is located.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Vascular assessment process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000574 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000574">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000573"/>
        <ns1:IAO_0000115 xml:lang="en">A vascular assessment process that has as specified output the ratio of the systolic blood pressure measured at the ankle to the systolic blood pressure measured at the arm.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Ankle-brachial index measurement process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000575 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000575">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000397"/>
        <ns1:IAO_0000115 xml:lang="en">A wound documentation process in which a photographic image of a wound is produced as a record of its appearance.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Wound photography process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000576 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000576">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120098"/>
        <ns1:IAO_0000115 xml:lang="en">A threshold specification that specifies a value of a wound attribute whose attainment indicates that a wound has healed or has reached a specified stage of healing.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Wound healing criterion</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000577 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000577">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000576"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000455"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A wound healing criterion that is about the degree of epithelialization of a wound, specifying the extent of epithelial coverage of the wound surface to be attained.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Epithelialization criterion</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000578 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000578">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DRON_00000001"/>
        <ns1:IAO_0000115 xml:lang="en">A clinical drug role borne by a substance used to kill bacteria or inhibit their growth.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">antibiotic drug role</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000579 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000579">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000040"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DRON_00000001"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A process in which a material entity bearing a clinical drug role is introduced into or applied onto the body of a patient.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Process of drug administration</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000580 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000580">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
        <ns1:IAO_0000115 xml:lang="en">A function that is realized by spreading the mechanical load exerted on a body surface over a larger contact area or over time, thereby lowering the pressure on any single region.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">pressure redistribution function</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000581 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000581">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120089"/>
        <ns1:IAO_0000115 xml:lang="en">A treatment plan specification that prescribes the removal of necrotic, infected or devitalized tissue from a wound by means of surgical instruments.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Surgical debridement</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Surgical debridement plan specification</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000582 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000582">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <ns1:IAO_0000115 xml:lang="en">A role that is borne by an entity in virtue of its being used to treat, alleviate or cure a disease of a patient.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">therapeutic role</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000583 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000583">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
        <ns1:IAO_0000115 xml:lang="en">A function whose realization serves the prevention, diagnosis, treatment or monitoring of a disease in a patient.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">clinical function</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000584 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000584">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000583"/>
        <ns1:IAO_0000115 xml:lang="en">A clinical function whose realization contributes to the treatment of a disease of a patient.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">therapeutic function</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000585 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000585">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DRON_00000001"/>
        <ns1:IAO_0000115 xml:lang="en">A clinical drug role borne by a substance used to produce local anesthesia.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">local anesthetic drug role</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000586 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000586">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120028"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_574"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A course of the disease process that has as participant a peripheral nervous system disease (peripheral neuropathy).</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Neuropathic disease process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000587 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000587">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000418"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000555"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A wound development subprocess in which a foreign body participates.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Foreign body process in wound development</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000589 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000589">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000579"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000929"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000040"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000578"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A process of drug administration in which a material entity bearing an antibiotic drug role participates.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Antibiotic administration process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000590 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000590">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000409"/>
    </owl:Class>
    


