        <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002566"/>
        <ns1:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <ns1:IAO_0000119 rdf:resource="http://purl.obolibrary.org/obo/ro/docs/causal-relations"/>
        <ns1:IAO_0000589>causally influenced by (entity-centric)</ns1:IAO_0000589>
        <rdfs:label>causally influenced by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0002563 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002563">
