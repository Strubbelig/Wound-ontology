    <!-- http://purl.obolibrary.org/obo/RO_0012006 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0012006">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002597"/>
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0012004"/>
        <ns1:IAO_0000115>a relation between a continuant and a process, in which the continuant is a small molecule that inhibits the process</ns1:IAO_0000115>
