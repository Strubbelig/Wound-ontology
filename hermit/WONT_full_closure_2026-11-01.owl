            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <ns1:IAO_0000111 xml:lang="en">collection of specimens</ns1:IAO_0000111>
        <ns1:IAO_0000112 xml:lang="en">Blood cells collected from multiple donors over the course of a study.</ns1:IAO_0000112>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">A material entity that has two or more specimens as its parts.</ns1:IAO_0000115>
        <ns1:IAO_0000116>Details see tracker: https://sourceforge.net/p/obi/obi-terms/778/</ns1:IAO_0000116>
        <ns1:IAO_0000117 xml:lang="en">Person: Chris Stoeckert, Jie Zheng</ns1:IAO_0000117>
        <ns1:IAO_0000119>OBIB, OBI</ns1:IAO_0000119>
        <dc:source>Biobank</dc:source>
        <rdfs:label xml:lang="en">collection of specimens</rdfs:label>
    </owl:Class>
    


