    <!-- http://purl.obolibrary.org/obo/OBI_0002251 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/OBI_0002251">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/OBI_0002243"/>
        <ns1:IAO_0000111>pT3 (kidney)</ns1:IAO_0000111>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <ns1:IAO_0000115 xml:lang="en">A pathologic primary tumor stage for kidney according to AJCC 7th edition indicating that the tumor extends into major veins or perinephric tissues but not into the ipsilateral adrenal gland and not beyond the Gerota fascia.</ns1:IAO_0000115>
