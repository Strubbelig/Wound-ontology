        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <ns1:IAO_0000115 xml:lang="en">A pathologic distant metastases stage for lung according to AJCC 7th edition indicating that there is a distant metastases that is histologically confirmed and associated with distant lymph nodes or carcinomatosis.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Chris Stoeckert, Helena Ellis</ns1:IAO_0000117>
        <ns1:IAO_0000119>https://staging.seer.cancer.gov/tnm/input/1.0/lung/path_m/</ns1:IAO_0000119>
        <ns1:IAO_0000234>NCI BBRB</ns1:IAO_0000234>
        <rdfs:label>pM1b (lung)</rdfs:label>
    </owl:NamedIndividual>
    


