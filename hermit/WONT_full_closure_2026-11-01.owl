    <!-- http://purl.obolibrary.org/obo/OBI_0001856 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/OBI_0001856">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/OBI_0000835"/>
