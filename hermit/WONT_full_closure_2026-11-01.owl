                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000088"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FMA_9664"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A diabetic wound that is located in a foot.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Diabetic foot ulcer</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000550 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000550">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120024"/>
        <ns1:IAO_0000115 xml:lang="en">A disease diagnostic result that is about a material disease entity that is an infection by microorganisms of the surgical incision, of the tissues at the operative site or of an organ or space manipulated during a surgical operation, beginning after that operation.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Moved from material disease entity to disease diagnostic result (curator, 2026-10-31): the name denotes a diagnostic classification, not one material disease entity; the material disease entity is what the diagnosis is about.</ns1:IAO_0000116>
        <rdfs:label xml:lang="en">Surgical site infection</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000551 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000551">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
        <ns1:IAO_0000115 xml:lang="en">A wound whose damaged tissue is non-osseous covering, connecting or supporting tissue of the body, such as skin, subcutis, fascia, muscle, tendon or ligament, rather than bone or a parenchymal organ.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Soft tissue wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000552 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000552">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000339"/>
        <ns1:IAO_0000115 xml:lang="en">A traumatic wound in which tissue has been torn or split by blunt force and that has irregular wound margins.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Laceration</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000553 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000553">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
        <ns1:IAO_0000115 xml:lang="en">A wound that has recently arisen and participates in a wound healing proceeding through the normal phases of repair in an orderly and timely sequence.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Acute wound</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000554 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000554">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
