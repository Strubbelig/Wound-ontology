        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <ns1:IAO_0000115>Similarity that is characterized by the organization of anatomical structures through the expression of homologous or identical patterning genes.</ns1:IAO_0000115>
        <dcterms:creator rdf:resource="https://www.wikidata.org/wiki/Q54985720"/>
