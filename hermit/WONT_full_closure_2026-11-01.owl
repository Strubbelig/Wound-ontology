    <!-- http://purl.obolibrary.org/obo/RO_0002004 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002004">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0001025"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000061"/>
