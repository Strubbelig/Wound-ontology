        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <ns1:IAO_0000111 xml:lang="en">has role</ns1:IAO_0000111>
        <ns1:IAO_0000112 xml:lang="en">this person has role this investigator role (more colloquially: this person has this role of investigator)</ns1:IAO_0000112>
        <ns1:IAO_0000115 xml:lang="en">a relation between an independent continuant (the bearer) and a role, in which the role specifically depends on the bearer for its existence</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">A bearer can have many roles, and its roles can exist for different periods of time, but none of its roles can exist when the bearer does not exist. A role need not be realized at all the times that the role exists.</ns1:IAO_0000116>
        <ns1:IAO_0000118 xml:lang="en">has_role</ns1:IAO_0000118>
