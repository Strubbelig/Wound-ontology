        <ns1:IAO_0000111>pT1b (kidney)</ns1:IAO_0000111>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <ns1:IAO_0000115 xml:lang="en">A pathologic primary tumor stage for kidney according to AJCC 7th edition indicating that the tumor is more than 4 cm but not more than 7 cm.</ns1:IAO_0000115>
