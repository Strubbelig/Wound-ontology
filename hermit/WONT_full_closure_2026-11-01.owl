    <!-- http://purl.obolibrary.org/obo/RO_0013004 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0013004">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0013001"/>
        <ns1:IAO_0000115>A relationship between a neuron and a region, where the neuron has a functionally relevant number of input and/or output synapses distributed throughout that region (rather than confined to a subregion).</ns1:IAO_0000115>
        <ns2:created_by rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
