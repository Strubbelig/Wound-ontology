    <!-- http://purl.obolibrary.org/obo/HP_0012399 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0012399">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011121"/>
        <ns1:IAO_0000115>A type of ulcer that is caused when an area of skin is subject to pressure over a prolonged period of time, ranging in range in severity from patches of discolored skin to open wounds that expose the underlying bone or muscle. The most common sites are the sacrum, coccyx, heels and the hips.</ns1:IAO_0000115>
        <dcterms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-11-08T08:49:52Z</dcterms:date>
        <ns2:hasDbXref>SNOMEDCT_US:399912005</ns2:hasDbXref>
        <ns2:hasDbXref>SNOMEDCT_US:420226006</ns2:hasDbXref>
        <ns2:hasDbXref>UMLS:C0011127</ns2:hasDbXref>
        <ns2:hasExactSynonym>Bedsore</ns2:hasExactSynonym>
        <ns2:hasExactSynonym>Decubitus Ulcer</ns2:hasExactSynonym>
        <ns2:hasExactSynonym>Pressure Sore</ns2:hasExactSynonym>
        <ns2:hasExactSynonym>Pressure ulcer</ns2:hasExactSynonym>
        <ns2:hasOBONamespace>human_phenotype</ns2:hasOBONamespace>
        <ns2:id>HP:0012399</ns2:id>
        <rdfs:comment>Pressure ulcers tend to affect persons with reduced mobility who are bedridden or wheelchair-bound.</rdfs:comment>
        <rdfs:label>Pressure ulcer</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012399"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of ulcer that is caused when an area of skin is subject to pressure over a prolonged period of time, ranging in range in severity from patches of discolored skin to open wounds that expose the underlying bone or muscle. The most common sites are the sacrum, coccyx, heels and the hips.</owl:annotatedTarget>
        <ns2:hasDbXref>https://orcid.org/0000-0002-0736-9199</ns2:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012399"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Bedsore</owl:annotatedTarget>
        <ns2:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/hp.obo#layperson"/>
