            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000312"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120047"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">An information content entity that classifies or groups one or more material disease entities according to diagnostic criteria. Names such as &apos;substance use disorder&apos; can denote this diagnostic layer when used as DSM/ICD-style categories or results; this diagnostic use is distinct from any material disease entity in the patient.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">diagnosis</ns1:IAO_0000118>
        <dc:description xml:lang="en">An information content entity that classifies or groups one or more material disease entities according to diagnostic criteria. Names such as &apos;substance use disorder&apos; can denote this diagnostic layer when used as DSM/ICD-style categories or results; this diagnostic use is distinct from any material disease entity in the patient.</dc:description>
        <rdfs:label xml:lang="en">disease diagnostic result</rdfs:label>
    </owl:Class>
    


