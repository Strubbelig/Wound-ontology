        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <ns1:IAO_0000115 xml:lang="en">A pathologic distant metastases stage for lung according to AJCC 7th edition indicating that metastasis is histologically confirmed and a separate tumor nodule(s) in a contralateral lobe; tumor with pleural nodules OR malignant pleural or pericardial effusion.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Chris Stoeckert, Helena Ellis</ns1:IAO_0000117>
        <ns1:IAO_0000119>https://staging.seer.cancer.gov/tnm/input/1.0/lung/path_m/</ns1:IAO_0000119>
        <ns1:IAO_0000234>NCI BBRB</ns1:IAO_0000234>
        <rdfs:label>pM1a (lung)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0002305 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/OBI_0002305">
