        <ns1:IAO_0000117>Chris Stoeckert, Helena Ellis</ns1:IAO_0000117>
        <ns1:IAO_0000118>pT: Pathologic spread lung primary tumor (AJCC 7th Edition)</ns1:IAO_0000118>
