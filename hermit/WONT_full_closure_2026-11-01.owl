        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/CL_0000540"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000465"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0002100"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000050"/>
        </owl:propertyChainAxiom>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0020104"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000050"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0020105"/>
        </owl:propertyChainAxiom>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relation between a neuron and a material anatomical entity that its soma is part of.</ns1:IAO_0000115>
        <ns1:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <ns1:IAO_0000424>&lt;http://purl.obolibrary.org/obo/BFO_0000051&gt; some (
   &lt;http://purl.obolibrary.org/obo/GO_0043025&gt; and   &lt;http://purl.obolibrary.org/obo/BFO_0000050&gt; some ?Y)</ns1:IAO_0000424>
