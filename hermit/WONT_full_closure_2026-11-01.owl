        <ns1:IAO_0000116>This is an exploratory relation. The label is taken from the FMA. It needs aligned with the neuron-specific relations such as has postsynaptic terminal in.</ns1:IAO_0000116>
        <ns1:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
