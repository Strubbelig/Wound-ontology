    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000524 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000524">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
        <ns1:IAO_0000115 xml:lang="en">A wound that is classified by the CDC surgical wound classification: clean, clean-contaminated, contaminated or dirty, according to the state of the operative field.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Wound with microbial burden assessed according to CDC</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000525 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000525">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000524"/>
        <ns1:IAO_0000115 xml:lang="en">A wound with microbial burden assessed according to CDC that is an open, fresh, accidental wound, or an operative wound with a major break in sterile technique or gross spillage from the gastrointestinal tract.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Contaminated wound according to CDC</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000526 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000526">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000524"/>
        <ns1:IAO_0000115 xml:lang="en">A wound with microbial burden assessed according to CDC that is an old traumatic wound with retained devitalized tissue, or one that involves existing clinical infection or perforated viscera.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Dirty wound according to CDC</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000527 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000527">
        <rdfs:comment xml:lang="en">Made obsolete without replacement (curator 2026-11-01, on the thesis read-through: &quot;Veraltet ohne Ersatz&quot;): the IWII wound infection continuum has no clean or sterile stage; a clean wound is the CDC class, Clean wound according to CDC (WONT_0000068), which is not the same thing. No obsolescence reason is given, since none of IAO&apos;s says that a class is not in the scheme it cites.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Clean wound according to IWII</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000528 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000528">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000066"/>
        <ns1:IAO_0000115 xml:lang="en">A wound classification scale that grades a wound by its microbial burden on the wound infection continuum of the International Wound Infection Institute: clean, contaminated, colonized, infected.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">IWII wound classification scale</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000529 -->

