            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000050"/>
        </owl:propertyChainAxiom>
        <ns1:IAO_0000115>A relationship between a neuron and a region, where the neuron has a functionally relevant number of output synapses in that region.</ns1:IAO_0000115>
        <ns2:created_by rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
        <ns2:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-07-17T09:45:06Z</ns2:creation_date>
        <rdfs:label xml:lang="en">sends synaptic output to region</rdfs:label>
