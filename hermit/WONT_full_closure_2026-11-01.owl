    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FMA_7149 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_7149">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_67135"/>
        <ns1:IAO_0000115>Anatomical structure, which has as its direct parts instances of one or more organ types which are interconnected with one another by zones of continuity. Examples: skeletal system, cardiovascular system, alimentary system.</ns1:IAO_0000115>
        <ns2:hasOBONamespace>fma</ns2:hasOBONamespace>
        <ns2:id>FMA:7149</ns2:id>
        <rdfs:label>Organ system</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FMA_7163 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_7163">
