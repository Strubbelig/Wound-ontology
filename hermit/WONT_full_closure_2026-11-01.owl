    <!-- http://purl.obolibrary.org/obo/GO_0003008 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0003008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0032501"/>
        <ns1:IAO_0000115>A multicellular organismal process carried out by any of the organs or tissues in an organ system. An organ system is a regularly interacting or interdependent group of organs or tissues that work together to carry out a biological objective.</ns1:IAO_0000115>
