        <ns2:inSubset rdf:resource="http://purl.obolibrary.org/obo/valid_for_gocam"/>
        <rdfs:label xml:lang="en">acts on population of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0012004 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0012004">
