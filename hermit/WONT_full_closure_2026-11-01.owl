        <chemrof:charge rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</chemrof:charge>
        <chemrof:generalized_empirical_formula>CNOR3</chemrof:generalized_empirical_formula>
        <chemrof:mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">42.017</chemrof:mass>
