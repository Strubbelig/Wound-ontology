        <ns1:IAO_0000115 xml:lang="en">A pathologic primary tumor stage for lung according to AJCC 7th edition indicating that the tumor is 2 cm or less in greatest dimension.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Chris Stoeckert, Helena Ellis</ns1:IAO_0000117>
        <ns1:IAO_0000119>https://staging.seer.cancer.gov/tnm/input/1.0/lung/path_t/</ns1:IAO_0000119>
