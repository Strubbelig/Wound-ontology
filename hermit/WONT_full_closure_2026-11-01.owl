        <ns1:IAO_0000115 xml:lang="en">A data visualization which has input of a clustered data set and produces an output of a report graph which is capable of rendering data of this type.</ns1:IAO_0000115>
        <ns1:IAO_0000117>James Malone</ns1:IAO_0000117>
        <rdfs:label>clustered data visualization</rdfs:label>
    </owl:Class>
    


