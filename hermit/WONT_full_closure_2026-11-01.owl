        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_9637"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/fma#regional_part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FMA_14065"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115>Tissue, which consists of one or more layers of epithelial cells and a basement membrane; it covers the external surface of the body and lines the internal surfaces of the anatomical structures. Examples: simple squamous epithelium, glandular cuboidal epithelium, transitional epithelium, myoepithelium.</ns1:IAO_0000115>
        <ns2:hasExactSynonym>Epithelial tissue</ns2:hasExactSynonym>
        <ns2:hasExactSynonym>Epithelium</ns2:hasExactSynonym>
        <ns2:hasOBONamespace>fma</ns2:hasOBONamespace>
        <ns2:id>FMA:9639</ns2:id>
        <rdfs:label>Portion of epithelium</rdfs:label>
    </owl:Class>
    


