    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_120002 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_120002">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_120004"/>
        <ns1:IAO_0000115 xml:lang="en">A wound dressing layer function that is borne by a layer of a wound dressing made to lie directly on the wound, and that is realized when the layer is placed there.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">first wound dressing layer function</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_120003 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_120003">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_120004"/>
        <ns1:IAO_0000115 xml:lang="en">A wound dressing layer function that is borne by a layer of a wound dressing made to lie over a layer that lies directly on the wound, and that is realized when the layer is placed there.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">second wound dressing layer function</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_120004 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_120004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
        <ns1:IAO_0000115 xml:lang="en">A function that is borne by a layer of a wound dressing and is realized in processes in which that layer contributes to the action of the dressing on the wound.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">wound dressing layer function</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_120005 -->

