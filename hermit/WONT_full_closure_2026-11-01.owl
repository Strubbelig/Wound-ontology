        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
        <ns1:IAO_0000115 xml:lang="en">A function that is realized in holding a wound dressing in place on or over a wound.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">wound dressing fixation function</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_120006 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_120006">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_120005"/>
        <ns1:IAO_0000115 xml:lang="en">A wound dressing fixation function that is realized without its bearer adhering to the patient&apos;s skin.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">non adhesive wound dressing fixation function</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_120007 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_120007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
        <ns1:IAO_0000115 xml:lang="en">A function that is realized in the uptake of exudate or other fluid from a wound into the bearer.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">wound moisture absorbance function</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_120008 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_120008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
        <ns1:IAO_0000115 xml:lang="en">A function that is realized in keeping the moisture of a wound bed from becoming either excessive or insufficient, by taking up fluid from the wound or by retaining or supplying fluid to it.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">wound moisture regulation function</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_120009 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_120009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
        <ns1:IAO_0000115 xml:lang="en">A function that is realized in killing or inactivating microorganisms in or on a wound.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">wound desinfecting function</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_120010 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_120010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
        <ns1:IAO_0000115 xml:lang="en">A function that is realized in bringing the edges of a wound together and holding them in apposition.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">wound edge approximating function</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_120011 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_120011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
        <ns1:IAO_0000115 xml:lang="en">A function that is realized in making a wound more readily accessible to visual or other examination.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">wound inspection facilitation function</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_120012 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_120012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
        <ns1:IAO_0000115 xml:lang="en">A function that is realized in covering a wound so that it is shielded from the external environment.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">wound coverage function</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_120013 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_120013">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000423"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000398"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A wound treatment process in which a wound dressing is applied to or renewed on a wound.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Wound dressing process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_120015 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_120015">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120055"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_120017"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A disease classification process that has as specified output a wound classification result.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Wound classification process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_120016 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_120016">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120000"/>
        <ns1:IAO_0000115 xml:lang="en">A disease classification stage that is assigned to a wound under a wound grading system and ranks the wound according to its severity.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">wound classification grade</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_120017 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_120017">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120054"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000312"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_120015"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A disease stage classification result that is about a wound and that is the specified output of a wound classification process.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Wound classification result</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_120018 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_120018">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120005"/>
        <ns1:IAO_0000115 xml:lang="en">A tendency that inheres in a microorganism and is realized in processes in which the microorganism invades and multiplies in the tissue of a wound.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">wound infecting tendency</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_120019 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_120019">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000040"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120101"/>
                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_120018"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IDO_0000528"/>
        <ns1:IAO_0000115 xml:lang="en">A pathogen that bears a wound infecting tendency.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">pathogen with wound infecting tendency</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_120020 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_120020">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120020"/>
        <ns1:IAO_0000115 xml:lang="en">A material disease entity consisting of a portion of a patient&apos;s tissue whose cells have died through pathological cell death while that portion remains within or attached to the body.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Necrotic material</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_120085 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_120085">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120020"/>
        <ns1:IAO_0000115 xml:lang="en">A material disease entity consisting in one or more arteries supplying an extremity whose lumen is narrowed or occluded, such that perfusion of the tissue of the affected limb is reduced.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Narrowed limb artery</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_120086 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_120086">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120020"/>
        <ns1:IAO_0000115 xml:lang="en">A material disease entity consisting in one or more veins of a limb whose valves or walls are abnormally structured, such that venous return from that limb against gravity is impaired.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Insufficient limb vein</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_120087 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_120087">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                        <owl:someValuesFrom>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FMA_70596"/>
                            </owl:Restriction>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000380"/>
        <ns1:IAO_0000115 xml:lang="en">A wound that has as part a portion of the epidermis: the damage reaches at least into the epidermis.</ns1:IAO_0000115>
        <rdfs:comment xml:lang="en">One of six depth classes -- epidermis, dermis, subcutis, fascia, muscle, bone, as FMA (release 2020-04-13, the FMA OFL imports) names them: the deepest of them a wound falls under is how deep it reaches. They are not nested, since a wound that reaches the bone need not pass through a fascia, as over the anterior border of the tibia. Added 2026-10-31 (curator 2026-10-31: &quot;ich will das vor submission erledigt haben, nicht offen lassen&quot;; definitions &quot;Alle ok&quot;).</rdfs:comment>
        <rdfs:label xml:lang="en">Wound reaching the epidermis</rdfs:label>
    </owl:Class>
    


