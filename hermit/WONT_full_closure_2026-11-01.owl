                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PR_000000001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000111>protein-containing complex</ns1:IAO_0000111>
        <ns1:IAO_0000112>A ribosome is a protein complex.</ns1:IAO_0000112>
        <ns1:IAO_0000115>A stable assembly of two or more macromolecules, i.e. proteins, nucleic acids, carbohydrates or lipids, in which at least one component is a protein and the constituent parts function together.</ns1:IAO_0000115>
