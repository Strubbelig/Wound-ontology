        <ns2:hasDbXref>GOC:mtg_apoptosis</ns2:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0012501"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>Reactome:R-HSA-5357801</owl:annotatedTarget>
        <rdfs:label>Programmed Cell Death</rdfs:label>
    </owl:Axiom>
    


