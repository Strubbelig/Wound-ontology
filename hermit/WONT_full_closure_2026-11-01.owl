        <ns2:hasExactSynonym>homocracous to</ns2:hasExactSynonym>
        <rdfs:comment>Homology and homocracy are not mutually exclusive. The homology relationships of patterning genes may be unresolved and thus may include orthologues and paralogues.</rdfs:comment>
        <rdfs:label>in homocracy relationship with</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/HOM_0000003"/>
    </owl:ObjectProperty>
