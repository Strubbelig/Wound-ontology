        </rdfs:subClassOf>
        <ns1:IAO_0000111 xml:lang="en">collecting specimen from organism</ns1:IAO_0000111>
        <ns1:IAO_0000112 xml:lang="en">taking a sputum sample from a cancer patient, taking the spleen from a killed mouse, collecting a urine sample from a patient</ns1:IAO_0000112>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <ns1:IAO_0000115 xml:lang="en">a process with the objective to obtain a material entity that was part of an organism for potential future use in an investigation</ns1:IAO_0000115>
