    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0012003 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0012003">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
        <ns1:IAO_0000115>p acts on population of c iff c&apos; is a collection, has members of type c, and p has participant c</ns1:IAO_0000115>
