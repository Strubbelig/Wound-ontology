    <!-- http://purl.obolibrary.org/obo/CHEBI_33229 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_33229">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_27027"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33284"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_52206"/>
        <ns1:IAO_0000115>A biochemical role played by any micronutrient that is an organic compound. Vitamins are present in foods in small amounts and are essential to normal metabolism and biochemical functions, usually as coenzymes. The term &quot;vitamines&quot; (from &lt;em&gt;vita&lt;/em&gt; + amines) was coined in 1912 by Casimir Funk, who believed that these compounds were amines.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">vitamin</ns1:IAO_0000118>
        <ns2:hasAlternativeId>CHEBI:10004</ns2:hasAlternativeId>
        <ns2:hasAlternativeId>CHEBI:27305</ns2:hasAlternativeId>
        <ns2:hasDbXref>wikipedia.en:Vitamin</ns2:hasDbXref>
        <ns2:hasOBONamespace>chebi_ontology</ns2:hasOBONamespace>
        <ns2:hasRelatedSynonym>vitamin</ns2:hasRelatedSynonym>
        <ns2:hasRelatedSynonym>vitamina</ns2:hasRelatedSynonym>
        <ns2:hasRelatedSynonym>vitaminas</ns2:hasRelatedSynonym>
        <ns2:hasRelatedSynonym>vitamine</ns2:hasRelatedSynonym>
        <ns2:hasRelatedSynonym>vitamines</ns2:hasRelatedSynonym>
        <ns2:hasRelatedSynonym>vitamins</ns2:hasRelatedSynonym>
        <ns2:hasRelatedSynonym>vitaminum</ns2:hasRelatedSynonym>
        <ns2:id>CHEBI:33229</ns2:id>
        <ns2:inSubset rdf:resource="http://purl.obolibrary.org/obo/3_STAR"/>
        <rdfs:label>vitamin (role)</rdfs:label>
        <rdfs:label xml:lang="en">vitamin (role)</rdfs:label>
    </owl:Class>
