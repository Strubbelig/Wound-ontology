    <!-- http://purl.obolibrary.org/obo/GO_0008015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0008015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0003013"/>
        <ns1:IAO_0000115>The flow of blood through the body of an animal, enabling the transport of nutrients to the tissues and the removal of waste products.</ns1:IAO_0000115>
