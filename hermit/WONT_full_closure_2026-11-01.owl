        <ns2:hasRelatedSynonym>Amide</ns2:hasRelatedSynonym>
        <ns2:hasRelatedSynonym>amides</ns2:hasRelatedSynonym>
        <ns2:id>CHEBI:32988</ns2:id>
        <ns2:inSubset rdf:resource="http://purl.obolibrary.org/obo/3_STAR"/>
        <rdfs:label>amide</rdfs:label>
    </owl:Class>
