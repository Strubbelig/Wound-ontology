    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000544 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000544">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0042060"/>
        <ns1:IAO_0000115 xml:lang="en">A wound healing that deviates from the normal orderly and timely sequence of healing phases, such that restoration of tissue integrity is delayed, arrested or yields abnormal tissue.</ns1:IAO_0000115>
        <ns1:IAO_0000118 xml:lang="en">Pathological wound healing process</ns1:IAO_0000118>
        <rdfs:label xml:lang="en">Impaired wound healing process</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000547 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000547">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IDO_0000528"/>
        <ns1:IAO_0000115 xml:lang="en">A pathogen that is a Gram-positive coccus of the genus Streptococcus bearing the Lancefield group A carbohydrate antigen in its cell wall.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Group A Streptococcus</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000548 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000548">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000013"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000589"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000578"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A molecule of the glycopeptide vancomycin, a glycosylated tricyclic heptapeptide that binds the D-alanyl-D-alanine termini of peptidoglycan precursors and thereby inhibits bacterial cell wall synthesis, and that has an antibiotic drug role.</ns1:IAO_0000115>
        <rdfs:label xml:lang="en">Vancomycin</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/WONT/WONT_0000549 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/WONT/WONT_0000549">
        <owl:equivalentClass>
            <owl:Class>
