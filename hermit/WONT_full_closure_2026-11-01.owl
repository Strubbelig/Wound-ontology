        <ns1:IAO_0000115 xml:lang="en">A health care role inhering in an organization or human being that is realized by a process of providing health care services to an organism.</ns1:IAO_0000115>
        <ns1:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/omrse.owl"/>
        <rdfs:label xml:lang="en">health care provider role</rdfs:label>
    </owl:Class>
    


