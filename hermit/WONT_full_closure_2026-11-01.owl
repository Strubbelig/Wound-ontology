    <!-- https://bioportal.bioontology.org/ontologies/MILD/MILD_120001 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/MILD/MILD_120001">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120020"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120028"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002353"/>
                <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/MILD/MILD_120021"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A disease whose disorders had to develop.</ns1:IAO_0000115>
        <dc:description xml:lang="en">A disease whose disorders had to develop.</dc:description>
        <rdfs:label xml:lang="en">Developed material disease entity</rdfs:label>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/MILD/MILD_120005 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/MILD/MILD_120005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000197"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns1:IAO_0000115 xml:lang="en">A realizable entity that inheres in a material entity and that, in virtue of the physical makeup of its bearer, inclines that bearer toward participating in processes of a certain type — such that the inclination raises the objective probability of, but does not necessitate, the occurrence of those processes; that may be counteracted or reinforced by other tendencies of the same bearer without thereby ceasing to exist; and that may be realized to varying degrees, or not at all.</ns1:IAO_0000115>
        <rdfs:comment xml:lang="en">A tendency is distinguished from a disposition not by its bearer or by requiring a material basis — both inhere in a material entity and supervene on its physical makeup — but by its mode of realization: a disposition, once its trigger conditions obtain, is realized; a tendency only probabilistically and partially inclines toward realization and can be opposed by competing tendencies. It is therefore modelled as a sibling of disposition, function, and role under realizable entity, not as a subtype of disposition.</rdfs:comment>
        <rdfs:label xml:lang="en">tendency</rdfs:label>
        <skos:definition xml:lang="en">A realizable entity that inheres in a material entity and that, in virtue of the physical makeup of its bearer, inclines that bearer toward participating in processes of a certain type — such that the inclination raises the objective probability of, but does not necessitate, the occurrence of those processes; that may be counteracted or reinforced by other tendencies of the same bearer without thereby ceasing to exist; and that may be realized to varying degrees, or not at all.</skos:definition>
    </owl:Class>
    


