        </rdfs:subClassOf>
        <ns1:IAO_0000111 xml:lang="en">data transformation</ns1:IAO_0000111>
        <ns1:IAO_0000112>The application of a clustering protocol to microarray data or the application of a statistical testing method on a primary data set to determine a p-value.</ns1:IAO_0000112>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <ns1:IAO_0000115 xml:lang="en">A completely executed planned process that produces output data from input data.</ns1:IAO_0000115>
        <ns1:IAO_0000115 xml:lang="en">A planned process that produces output data from input data.</ns1:IAO_0000115>
        <ns1:IAO_0000117 xml:lang="en">Elisabetta Manduchi</ns1:IAO_0000117>
        <ns1:IAO_0000117 xml:lang="en">Helen Parkinson</ns1:IAO_0000117>
