        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <ns1:IAO_0000111 xml:lang="en">has quality</ns1:IAO_0000111>
        <ns1:IAO_0000112 xml:lang="en">this apple has quality this red color</ns1:IAO_0000112>
        <ns1:IAO_0000115 xml:lang="en">a relation between an independent continuant (the bearer) and a quality, in which the quality specifically depends on the bearer for its existence</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">A bearer can have many qualities, and its qualities can exist for different periods of time, but none of its qualities can exist when the bearer does not exist.</ns1:IAO_0000116>
        <ns1:IAO_0000118 xml:lang="en">has_quality</ns1:IAO_0000118>
        <ns1:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ro.owl"/>
        <rdfs:label xml:lang="en">has quality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0000087 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0000087">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
