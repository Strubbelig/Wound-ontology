    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0006950 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0006950">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0050896"/>
        <ns1:IAO_0000115>Any process that results in a change in state or activity of a cell or an organism (in terms of movement, secretion, enzyme production, gene expression, etc.) as a result of a disturbance in organismal or cellular homeostasis, usually, but not necessarily, exogenous (e.g. temperature, humidity, ionizing radiation).</ns1:IAO_0000115>
