        <ns2:hasAlternativeId>GO:0044765</ns2:hasAlternativeId>
        <ns2:hasDbXref>Reactome:R-HSA-382551</ns2:hasDbXref>
        <ns2:hasOBONamespace>biological_process</ns2:hasOBONamespace>
        <ns2:hasRelatedSynonym>single-organism transport</ns2:hasRelatedSynonym>
        <ns2:id>GO:0006810</ns2:id>
