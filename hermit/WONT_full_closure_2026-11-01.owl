        <ns1:RO_0040042 rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <ns1:RO_0040042 rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <dcterms:creator rdf:resource="https://www.wikidata.org/wiki/Q54985720"/>
        <dcterms:source rdf:resource="http://www.ncbi.nlm.nih.gov/pubmed/20116127"/>
        <ns2:hasDbXref>ECO:0000041</ns2:hasDbXref>
        <ns2:hasDbXref>SO:similar_to</ns2:hasDbXref>
        <ns2:hasExactSynonym>sameness</ns2:hasExactSynonym>
        <ns2:hasExactSynonym>similar to</ns2:hasExactSynonym>
        <ns2:hasRelatedSynonym>correspondence</ns2:hasRelatedSynonym>
        <ns2:hasRelatedSynonym>resemblance</ns2:hasRelatedSynonym>
        <rdfs:label>in similarity relationship with</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/HOM_0000000"/>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/RO_HOM0000000"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Relation between biological objects that resemble or are related to each other sufficiently to warrant a comparison.</owl:annotatedTarget>
        <ns2:hasDbXref rdf:resource="http://purl.obolibrary.org/obo/HOM_0000000"/>
        <ns2:hasDbXref>BGEE:curator</ns2:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/RO_HOM0000000"/>
