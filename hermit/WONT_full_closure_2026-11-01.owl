        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NCBITaxon_10239"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NCBITaxon_2"/>
