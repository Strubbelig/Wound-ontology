  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Synthetic Electrospun Fiber Matrix</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Material_Entity">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Material Entity</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Tibial_Plateau_Fracture">
  <rdfs:subClassOf rdf:resource="#Fracture"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tibial Plateau Fracture</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Fracture">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fracture</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Traumatic_Wound">
  <rdfs:subClassOf rdf:resource="#Wound"/>
  <rdfs:subClassOf rdf:resource="#Wound_Or_Injury"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Traumatic Wound</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Tunneling_Wound">
  <rdfs:subClassOf rdf:resource="#Wound_Complication"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tunneling Wound</rdfs:label>
