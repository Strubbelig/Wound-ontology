  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Infectious Complication</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Surgical_Wound">
  <rdfs:subClassOf rdf:resource="#Wound"/>
  <rdfs:subClassOf rdf:resource="#Wound_Or_Injury"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Surgical Wound</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Surgical-Site_Infection">
  <rdfs:subClassOf rdf:resource="#Healthcare-Associated_Infection"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Surgical-Site Infection</rdfs:label>
</owl:Class>

