  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wound Dehiscence</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Wound_Infection">
  <rdfs:subClassOf rdf:resource="#Wound_Complication"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wound Infection</rdfs:label>
