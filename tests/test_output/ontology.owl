<owl:Class rdf:about="#L-Arginine">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#part_of"/>
      <owl:someValuesFrom rdf:resource="#Hydrophilic_Layer"/>
    </owl:Restriction>
  </rdfs:subClassOf>
