<owl:Class rdf:about="#Aligned_Microchannels">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#part_of"/>
      <owl:someValuesFrom rdf:resource="#Bilayer_Polyurethane_Scaffold"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Aligned Microchannels</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Bilayer_Polyurethane_Scaffold">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bilayer Polyurethane Scaffold</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Hydrophilic_Layer">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#part_of"/>
      <owl:someValuesFrom rdf:resource="#Bilayer_Polyurethane_Scaffold"/>
    </owl:Restriction>
  </rdfs:subClassOf>
