<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/ontology"
         xmlns="http://example.org/ontology#">

<owl:Ontology rdf:about="http://example.org/ontology"/>

<owl:ObjectProperty rdf:about="#part_of">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
</owl:ObjectProperty>

<owl:Class rdf:about="#Acute_Wound">
  <rdfs:subClassOf rdf:resource="#Wound"/>
  <rdfs:subClassOf rdf:resource="#Wound_Or_Injury"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Acute Wound</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Wound">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wound</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Wound_Or_Injury">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wound Or Injury</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Cavity_Wound">
  <rdfs:subClassOf rdf:resource="#Wound_Complication"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cavity Wound</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Wound_Complication">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wound Complication</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Chronic_Non-Healing_Wound">
  <rdfs:subClassOf rdf:resource="#Chronic_Wound"/>
  <rdfs:subClassOf rdf:resource="#Wound_Or_Injury"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chronic Non-Healing Wound</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Chronic_Wound">
  <rdfs:subClassOf rdf:resource="#Wound"/>
  <rdfs:subClassOf rdf:resource="#Wound_Or_Injury"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chronic Wound</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Deep_Surgical-Site_Infection">
  <rdfs:subClassOf rdf:resource="#Surgical_Site_Infection"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deep Surgical-Site Infection</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Surgical_Site_Infection">
  <rdfs:subClassOf rdf:resource="#Infectious_Complication"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Surgical Site Infection</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Diabetic_Infected_Wound">
  <rdfs:subClassOf rdf:resource="#Diabetic_Wound"/>
  <rdfs:subClassOf rdf:resource="#Wound_Or_Injury"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diabetic Infected Wound</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Diabetic_Wound">
  <rdfs:subClassOf rdf:resource="#Chronic_Wound"/>
  <rdfs:subClassOf rdf:resource="#Wound_Or_Injury"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diabetic Wound</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Diabetic_Wound_Healing">
  <rdfs:subClassOf rdf:resource="#Wound_Healing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diabetic Wound Healing</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Wound_Healing">
  <rdfs:subClassOf rdf:resource="#Process"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wound Healing</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Granulation">
  <rdfs:subClassOf rdf:resource="#Process"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#part_of"/>
      <owl:someValuesFrom rdf:resource="#Wound_Healing"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Granulation</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Process">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Process</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Iatrogenic_Wound">
  <rdfs:subClassOf rdf:resource="#Wound"/>
  <rdfs:subClassOf rdf:resource="#Wound_Or_Injury"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Iatrogenic Wound</rdfs:label>
</owl:Class>

