# QC: every WOND class must have at least one subClassOf (no floating classes)
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX WOND: <http://purl.obolibrary.org/obo/WOND_>

SELECT ?class ?label WHERE {
  ?class a owl:Class .
  FILTER(STRSTARTS(STR(?class), STR(WOND:)))
  OPTIONAL { ?class rdfs:label ?label }
  FILTER NOT EXISTS { ?class rdfs:subClassOf ?parent }
}
