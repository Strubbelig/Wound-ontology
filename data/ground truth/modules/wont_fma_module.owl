    <!-- http://purl.obolibrary.org/obo/FMA_7149 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_7149">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_67135"/>
        <obo:IAO_0000115>Anatomical structure, which has as its direct parts instances of one or more organ types which are interconnected with one another by zones of continuity. Examples: skeletal system, cardiovascular system, alimentary system.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>fma</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FMA:7149</oboInOwl:id>
        <rdfs:label>Organ system</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FMA_7163 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_7163">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_55665"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/fma#constitutional_part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FMA_20394"/>
