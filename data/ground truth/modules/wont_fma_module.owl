    <!-- http://purl.obolibrary.org/obo/FMA_14065 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_14065">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_82472"/>
        <obo:IAO_0000115>Cardinal organ part which is bounded predominantly by bonafide boundaries.  Examples: lobe of lung, osteon, acinus, submucosa, anterior leaflet of mitral valve, capsule of kidney, cortical bone, muscle fasciculus.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>fma</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FMA:14065</oboInOwl:id>
        <rdfs:label>Organ component</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FMA_20394 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_20394">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_256133"/>
        <obo:IAO_0000115>Anatomical structure which is the aggregate material substance of an individual member of the Homo sapiens species. Examples: There is only one human body.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>fma</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FMA:20394</oboInOwl:id>
        <rdfs:label>Human body</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FMA_256133 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_256133">
