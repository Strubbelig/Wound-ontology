        <oboInOwl:hasOBONamespace>fma</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FMA:67811</oboInOwl:id>
        <rdfs:label>Male human body</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FMA_67812 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_67812">
