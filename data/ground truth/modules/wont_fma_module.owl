        <oboInOwl:hasOBONamespace>fma</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FMA:67812</oboInOwl:id>
        <rdfs:label>Female human body</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FMA_70323 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_70323">
