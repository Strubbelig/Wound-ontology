    <!-- http://purl.obolibrary.org/obo/HP_0012399 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0012399">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0200042"/>
        <obo:IAO_0000115>A type of ulcer that is caused when an area of skin is subject to pressure over a prolonged period of time, ranging in range in severity from patches of discolored skin to open wounds that expose the underlying bone or muscle. The most common sites are the sacrum, coccyx, heels and the hips.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-11-08T08:49:52Z</terms:date>
        <oboInOwl:hasDbXref>SNOMEDCT_US:399912005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:420226006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0011127</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Bedsore</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Decubitus Ulcer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pressure Sore</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pressure ulcer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>human_phenotype</oboInOwl:hasOBONamespace>
        <oboInOwl:id>HP:0012399</oboInOwl:id>
        <rdfs:comment>Pressure ulcers tend to affect persons with reduced mobility who are bedridden or wheelchair-bound.</rdfs:comment>
        <rdfs:label>Pressure ulcer</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012399"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of ulcer that is caused when an area of skin is subject to pressure over a prolonged period of time, ranging in range in severity from patches of discolored skin to open wounds that expose the underlying bone or muscle. The most common sites are the sacrum, coccyx, heels and the hips.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-0736-9199</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012399"/>
