        <rdfs:label>peptide</rdfs:label>
        <chemrof:charge rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</chemrof:charge>
        <chemrof:generalized_empirical_formula>(C2H2NOR)nC2H3NOR</chemrof:generalized_empirical_formula>
