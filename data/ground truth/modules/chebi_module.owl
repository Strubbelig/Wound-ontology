        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35352"/>
        <obo:IAO_0000115>Any organonitrogen compound containing a carbamimidamido (guanidino) group. Guanidines have the general structure (R&lt;small&gt;&lt;sup&gt;1&lt;/small&gt;&lt;/sup&gt;R&lt;small&gt;&lt;sup&gt;2&lt;/small&gt;&lt;/sup&gt;N)(R&lt;small&gt;&lt;sup&gt;3&lt;/small&gt;&lt;/sup&gt;R&lt;small&gt;&lt;sup&gt;4&lt;/small&gt;&lt;/sup&gt;N)C=N-R&lt;small&gt;&lt;sup&gt;5&lt;/small&gt;&lt;/sup&gt; and are related structurally to amidines and ureas.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>CHEBI:24436</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/3_STAR"/>
        <rdfs:label>guanidines</rdfs:label>
    </owl:Class>
    


