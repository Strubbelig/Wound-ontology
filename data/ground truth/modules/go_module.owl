    <!-- http://purl.obolibrary.org/obo/GO_0031099 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0031099">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0048856"/>
        <obo:IAO_0000115>The regrowth of a lost or destroyed body part, such as an organ or tissue. This process may occur via renewal, repair, and/or growth alone (i.e. increase in size or mass).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Wikipedia:Regeneration_(biology)</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0031099</oboInOwl:id>
        <rdfs:label>regeneration</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0031099"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The regrowth of a lost or destroyed body part, such as an organ or tissue. This process may occur via renewal, repair, and/or growth alone (i.e. increase in size or mass).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:mah</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:pr</oboInOwl:hasDbXref>
    </owl:Axiom>
    


