    <!-- http://purl.obolibrary.org/obo/GO_0042060 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0042060">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0009611"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0042246"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The series of events that restore integrity to a damaged tissue, following an injury.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Wikipedia:Wound_healing</oboInOwl:hasDbXref>
