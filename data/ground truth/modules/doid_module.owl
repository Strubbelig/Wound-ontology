        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007644"/>
        <oboInOwl:hasDbXref>url:https://medlineplus.gov/chickenpox.html</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.cdc.gov/chickenpox/about/index.html</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/books/NBK448191/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


