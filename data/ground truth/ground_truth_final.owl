###  http://purl.obolibrary.org/obo/DOID_0050061
ns1:DOID_0050061 rdf:type owl:Class ;
                 rdfs:subClassOf ns1:IDO_0000586 ;
                 ns1:IAO_0000115 "A primary bacterial infectious disease that results_in infection located_in skin, has_material_basis_in Erysipelothrix rhusiopathiae, which is transmitted_by contact with infected animals. The infection has_symptom redness of skin, has_symptom tenderness of skin and has_symptom warmth of skin." ;
                 rdfs:label "Erysipel" ,
                            "erysipeloid" .


###  http://purl.obolibrary.org/obo/DOID_0050426
ns1:DOID_0050426 rdf:type owl:Class ;
                 rdfs:subClassOf wont:WONT_0000194 ;
                 ns1:IAO_0000115 "A skin disease that is characterized by ulceration of less than 10 percent of the surface area of the body. The disease is often precipitated by the use of medications, such as antibiotics or antiepileptics, or onset of infection." ;
                 rdfs:label "Stevens-Johnson syndrome" .


###  http://purl.obolibrary.org/obo/DOID_0050853
ns1:DOID_0050853 rdf:type owl:Class ;
                 rdfs:subClassOf wont:WONT_0000192 ;
                 ns1:IAO_0000115 "A venous insufficiency that is characterized by lower extremity swelling, hyperpigmentation, pruritus and venous ulceration caused by blood pooling in the veins." ;
                 rdfs:label "Chronic venous insufficiency" ,
                            "chronic venous insufficiency" .


###  http://purl.obolibrary.org/obo/DOID_0060851
ns1:DOID_0060851 rdf:type owl:Class ;
                 rdfs:subClassOf wont:WONT_0000194 ;
                 ns1:IAO_0000115 "A pemphigus characterized by autosomal dominant blisters and erosions on the skin and mucous membranes erosions cause by autoantibodies to intercellular cement substance." ;
                 rdfs:label "Pemphigus vulgaris" ,
                            "pemphigus vulgaris" .


###  http://purl.obolibrary.org/obo/DOID_0080841
ns1:DOID_0080841 rdf:type owl:Class ;
                 rdfs:subClassOf wont:WONT_0000194 ;
                 ns1:IAO_0000115 "An autoimmune disease of skin and connective tissue that is characterized by subepidermal blistering especially in the lower abdomen, groin, and flexor surfaces of the extremities, creating tense blisters that do not break easily." ;
                 rdfs:label "Mucous membrane pemphigoid" ,
                            "pemphigoid" .


###  http://purl.obolibrary.org/obo/DOID_10881
ns1:DOID_10881 rdf:type owl:Class ;
               rdfs:subClassOf wont:WONT_0000194 ;
               ns1:IAO_0000115 "A viral infectious disease that results_in infection located_in skin, has_material_basis_in Enterovirus A (Enterovirus alphacoxsackie), which are transmitted_by contaminated fomites, and transmitted_by contact with nose and throat secretions, saliva, blister fluid and stool of infected persons. The infection has_symptom fever, has_symptom poor appetite, has_symptom malaise, has_symptom sore throat, has_symptom painful sores in the mouth, and has_symptom skin rash on the palms of the hands and soles of the feet." ;
               rdfs:label "Hand-foot-and-mouth disease" ,
                          "hand, foot and mouth disease" .


###  http://purl.obolibrary.org/obo/DOID_2730
ns1:DOID_2730 rdf:type owl:Class ;
              rdfs:subClassOf wont:WONT_0000194 ;
              ns1:IAO_0000115 "A vesiculobullous skin disease that is characterized by formation of blisters with only minor skin trauma, which can cause widespread wounds, dehydration, electrolyte abnormalities, and severe infection, frequently develops_from mutations in connective tissue elements, including genes encoding keratin, collagen, and laminin." ;
              rdfs:label "Epidermolysis bullosa" ,
                         "epidermolysis bullosa" .


###  http://purl.obolibrary.org/obo/DOID_3042
ns1:DOID_3042 rdf:type owl:Class ;
              rdfs:subClassOf wont:WONT_0000194 ;
              ns1:IAO_0000115 "A contact dermatitis that is an allergic skin reaction to foreign chemical or substances leading to red, itchy, weepy reaction where the skin has come into contact with a substance that the immune system recognizes as foreign." ;
              rdfs:label "Allergic contact dermatitis" ,
                         "allergic contact dermatitis" .


###  http://purl.obolibrary.org/obo/DOID_3132
ns1:DOID_3132 rdf:type owl:Class ;
              rdfs:subClassOf wont:WONT_0000194 ;
              ns1:IAO_0000115 "An acute porphyria characterized by painful, blistering skin lesions that develop on sun-exposed skin." ;
              rdfs:label "Porphyria cutanea tarda" ,
                         "porphyria cutanea tarda" .


###  http://purl.obolibrary.org/obo/DOID_4347
ns1:DOID_4347 rdf:type owl:Class ;
              rdfs:subClassOf ns1:BFO_0000040 ;
              rdfs:label "Lymphocele" ,
                         "lymphocele" .


###  http://purl.obolibrary.org/obo/DOID_8505
ns1:DOID_8505 rdf:type owl:Class ;
              rdfs:subClassOf wont:WONT_0000194 ;
              rdfs:label "Dermatitis herpetiformis Duhring" ,
                         "dermatitis herpetiformis" .


###  http://purl.obolibrary.org/obo/DOID_8506
ns1:DOID_8506 rdf:type owl:Class ;
              rdfs:subClassOf wont:WONT_0000194 ;
              ns1:IAO_0000115 "A pemphigoid that is characterized by large blisters." ;
              rdfs:label "Bullous pemphigoid" ,
                         "bullous pemphigoid" .


###  http://purl.obolibrary.org/obo/DOID_8536
ns1:DOID_8536 rdf:type owl:Class ;
              rdfs:subClassOf wont:WONT_0000194 ;
              ns1:IAO_0000115 "A viral infectious disease that results_in infection located_in nerve fiber, has_material_basis_in Human herpesvirus 3 (Varicellovirus humanalpha3), which reactivates after appearing as chickenpox in childhood. The virus is transmitted_by direct contact with the rash, which can develop into chickenpox in newly-infected individuals. The infection has_symptom rash which is followed by blisters, has_symptom headache, has_symptom fever, has_symptom malaise, has_symptom itching, has_symptom burning pain, and has_symptom paresthesia." ;
              rdfs:label "Herpes zoster" ,
                         "herpes zoster" .


###  http://purl.obolibrary.org/obo/DOID_8566
ns1:DOID_8566 rdf:type owl:Class ;
              rdfs:subClassOf wont:WONT_0000194 ;
              ns1:IAO_0000115 "A viral infectious disease that results_in_formation_of lesions, located_in mouth, located_in face, located_in genitalia, or located_in hands, has_material_basis_in Human herpesvirus 1 (Simplexvirus humanalpha1) or 2 (Simplexvirus humanalpha2), which are transmitted_by direct contact with an active lesion or body fluid of an infected person." ;
              rdfs:label "Herpes simplex (e.g. cold sores)" ,
                         "herpes simplex" .


###  http://purl.obolibrary.org/obo/DOID_8659
ns1:DOID_8659 rdf:type owl:Class ;
              rdfs:subClassOf wont:WONT_0000194 ;
              ns1:IAO_0000115 "A viral infectious disease that results_in infection located_in skin, has_material_basis_in Human herpesvirus 3 (Varicellovirus humanalpha3), which is transmitted_by direct contact with secretions from the rash, or transmitted_by droplet spread of respiratory secretions. The infection has_symptom anorexia, has_symptom myalgia, has_symptom nausea, has_symptom fever, has_symptom headache, has_symptom sore throat, and has_symptom blisters." ;
              rdfs:label "Chickenpox (varicella)" ,
                         "chickenpox" .


###  http://purl.obolibrary.org/obo/DOID_9351
ns1:DOID_9351 rdf:type owl:Class ;
              rdfs:subClassOf wont:WONT_0000192 ;
              ns1:IAO_0000115 "A glucose metabolism disease that is characterized by chronic hyperglycaemia with disturbances of carbohydrate, fat and protein metabolism resulting from defects in insulin secretion, insulin action, or both." ;
              rdfs:label "Diabetes mellitus" ,
                         "diabetes mellitus" .


###  http://purl.obolibrary.org/obo/DOID_9602
ns1:DOID_9602 rdf:type owl:Class ;
              rdfs:subClassOf ns1:BFO_0000040 ;
              rdfs:label "Necrotizing fasciitis" ,
                         "necrotizing fasciitis" .


###  http://purl.obolibrary.org/obo/DOID_9970
ns1:DOID_9970 rdf:type owl:Class ;
              rdfs:subClassOf wont:WONT_0000193 ;
              ns1:IAO_0000115 "An overnutrition that is characterized by excess body fat, traditionally defined as an elevated ratio of weight to height (specifically 30 kilograms per meter squared), has_material_basis_in a multifactorial etiology related to excess nutrition intake, decreased caloric utilization, and genetic susceptibility, and possibly medications and certain disorders of metabolism, endocrine function, and mental illness." ;
              rdfs:label "Obesity" ,
                         "obesity" .


###  http://purl.obolibrary.org/obo/DRON_00000005
ns1:DRON_00000005 rdf:type owl:Class ;
                  rdfs:label "clinical drug product" .


###  http://purl.obolibrary.org/obo/GO_0001525
ns1:GO_0001525 rdf:type owl:Class ;
               rdfs:subClassOf wont:WONT_0000409 ;
               ns1:IAO_0000115 "Blood vessel formation when new vessels emerge from the proliferation of pre-existing blood vessels." ;
               rdfs:label "Angiogenesis process"@en ,
                          "angiogenesis" .


###  http://purl.obolibrary.org/obo/GO_0007599
ns1:GO_0007599 rdf:type owl:Class ;
               rdfs:subClassOf wont:WONT_0000409 ;
               ns1:IAO_0000115 "The stopping of bleeding (loss of body fluid) or the arrest of the circulation to an organ or part." ;
               rdfs:label "Hemostasis process"@en ,
                          "hemostasis" .


###  http://purl.obolibrary.org/obo/GO_0008150
ns1:GO_0008150 rdf:type owl:Class ;
               ns1:IAO_0000115 "A biological process is the execution of a genetically-encoded biological module or program. It consists of all the steps required to achieve the specific biological objective of the module. A biological process is accomplished by a particular set of molecular functions carried out by specific gene products (or macromolecular complexes), often in a highly regulated manner and in a particular temporal sequence." ;
               rdfs:label "biological_process" .


###  http://purl.obolibrary.org/obo/GO_0008283
ns1:GO_0008283 rdf:type owl:Class ;
               rdfs:subClassOf wont:WONT_0000409 ;
               ns1:IAO_0000115 "The multiplication or reproduction of cells, resulting in the expansion of a cell population." ;
               rdfs:label "Proliferation process"@en ,
                          "cell population proliferation" .


###  http://purl.obolibrary.org/obo/GO_0042060
ns1:GO_0042060 rdf:type owl:Class ;
               rdfs:subClassOf ns1:GO_0008150 ;
               ns1:IAO_0000115 "The series of events that restore integrity to a damaged tissue, following an injury." ;
               ns1:IAO_0000118 "wound healing process"@en ;
               rdfs:label "wound healing"@en ,
                          "wound healing" .


###  http://purl.obolibrary.org/obo/GO_0042246
ns1:GO_0042246 rdf:type owl:Class ;
               rdfs:subClassOf wont:WONT_0000409 ;
               ns1:IAO_0000115 "The regrowth of lost or destroyed tissues." ;
               rdfs:label "Tissue regeneration process"@en ,
                          "tissue regeneration" .


###  http://purl.obolibrary.org/obo/GO_0042310
ns1:GO_0042310 rdf:type owl:Class ;
               rdfs:subClassOf wont:WONT_0000409 ;
               ns1:IAO_0000115 "A decrease in the diameter of blood vessels, especially arteries, due to constriction of smooth muscle cells that line the vessels, and usually causing an increase in blood pressure." ;
               rdfs:label "Vasoconstriction process"@en ,
                          "vasoconstriction" .


###  http://purl.obolibrary.org/obo/GO_0042311
ns1:GO_0042311 rdf:type owl:Class ;
               rdfs:subClassOf wont:WONT_0000409 ;
               ns1:IAO_0000115 "An increase in the internal diameter of blood vessels, especially arterioles or capillaries, due to relaxation of smooth muscle cells that line the vessels, and usually resulting in a decrease in blood pressure." ;
               rdfs:label "Vasodilation process"@en ,
                          "vasodilation" .


###  http://purl.obolibrary.org/obo/GO_0048771
ns1:GO_0048771 rdf:type owl:Class ;
               rdfs:subClassOf wont:WONT_0000409 ;
               ns1:IAO_0000115 "The reorganization or renovation of existing tissues. This process can either change the characteristics of a tissue such as in blood vessel remodeling, or result in the dynamic equilibrium of a tissue such as in bone remodeling." ;
               rdfs:label "Remodeling process"@en ,
                          "tissue remodeling" .


###  http://purl.obolibrary.org/obo/GO_0050817
ns1:GO_0050817 rdf:type owl:Class ;
               rdfs:subClassOf wont:WONT_0000409 ;
               ns1:IAO_0000115 "The process in which a fluid solution, or part of it, changes into a solid or semisolid mass." ;
               rdfs:label "Coagulation process"@en ,
                          "coagulation" .


###  http://purl.obolibrary.org/obo/HP_0000961
ns1:HP_0000961 rdf:type owl:Class ;
               rdfs:subClassOf ns1:PATO_0000014 ;
               ns1:IAO_0000115 "Bluish discoloration of the skin and mucosa due to poor circulation or inadequate oxygenation of arterial or capillary blood." ;
               rdfs:label "Cyanosis" .


###  http://purl.obolibrary.org/obo/HP_0000980
ns1:HP_0000980 rdf:type owl:Class ;
               rdfs:subClassOf ns1:PATO_0000014 ;
               ns1:IAO_0000115 "Abnormally pale skin." ;
               rdfs:label "Pallor" .


###  http://purl.obolibrary.org/obo/HP_0004395
ns1:HP_0004395 rdf:type owl:Class ;
               rdfs:subClassOf wont:WONT_0000193 ;
               ns1:IAO_0000115 "A deficiency in the intake of energy and nutrients." ;
               rdfs:label "Malnutrition" .


###  http://purl.obolibrary.org/obo/HP_0012399
ns1:HP_0012399 rdf:type owl:Class ;
               rdfs:subClassOf ns1:HP_0032674 ;
               ns1:IAO_0000115 "A chronic ulcer of skin where the ulcer is an ulceration of tissue deprived of adequate blood supply by prolonged pressure." ,
                               "A type of ulcer that is caused when an area of skin is subject to pressure over a prolonged period of time, ranging in range in severity from patches of discolored skin to open wounds that expose the underlying bone or muscle. The most common sites are the sacrum, coccyx, heels and the hips." ;
               rdfs:label "Pressure ulcer" ,
                          "decubitus ulcer" .


###  http://purl.obolibrary.org/obo/HP_0025615
ns1:HP_0025615 rdf:type owl:Class ;
               rdfs:subClassOf ns1:IDO_0000586 ;
               ns1:IAO_0000115 "An abscess is a localized collection of purulent material surrounded by inflammation and granulation." ;
               rdfs:label "abscess"@en .


###  http://purl.obolibrary.org/obo/HP_0032326
ns1:HP_0032326 rdf:type owl:Class ;
               rdfs:subClassOf ns1:NCBITaxon_1280 ;
               ns1:IAO_0000115 "Infection with staphylococcus aureus resistant to the antibiotic methicillin (MRSA). MRSA can infect any individual but is more common among hospitalized patients, and can also occur as an opportunistic infection." ;
               rdfs:label "Methicillin-resistant Staphylococcus aureus infection" .


###  http://purl.obolibrary.org/obo/HP_0032674
ns1:HP_0032674 rdf:type owl:Class ;
               rdfs:subClassOf wont:WONT_0000380 ;
               ns1:IAO_0000115 "A cutaneous wound is a defined as a disruption of normal anatomic structure and function of the skin that occurs owing to an injury of the skin. Wound healing is a dynamic, interactive process involving soluble mediators, blood cells, extracellularmatrix, and parenchymal cells. Wound healing has three phases: inflammation, tissue formation, and tissue remodeling, that overlap in time." ;
               rdfs:label "Cutaneous wound" ,
                          "Skin wound" .


###  http://purl.obolibrary.org/obo/HP_0032675
ns1:HP_0032675 rdf:type owl:Class ;
               rdfs:subClassOf ns1:HP_0032674 ;
               ns1:IAO_0000115 "A cutaneous wound that is proceeding through an orderly and timely reparative process that results in sustained restoration of the anatomic and functional integrity of the skin." ;
               rdfs:label "Acute cutaneous wound" .


###  http://purl.obolibrary.org/obo/HP_0032676
ns1:HP_0032676 rdf:type owl:Class ;
               rdfs:subClassOf ns1:HP_0032674 ;
               ns1:IAO_0000115 "A cutaneous wound that has failed to proceed through the orderly and timely process to produce an atomic and functional integrity, or proceeded through the repair process without establishing a sustained anatomic and functional result." ;
               rdfs:label "Chronic cutaneous wound" ,
                          "Chronic wound" .


###  http://purl.obolibrary.org/obo/HP_0100699
ns1:HP_0100699 rdf:type owl:Class ;
               rdfs:subClassOf wont:WONT_0000409 ;
               ns1:IAO_0000115 "A scar refers to a lesion in which wound, burn, or sore has not healed completely and fibrous connective tissue has developed." ;
               rdfs:label "Scarring process"@en ,
                          "Scarring" .


###  http://purl.obolibrary.org/obo/HP_0100758
ns1:HP_0100758 rdf:type owl:Class ;
               rdfs:subClassOf :WONT_120020 ;
               ns1:IAO_0000115 "A serious and potentially life-threatening condition that arises when a considerable mass of body tissue dies (necrosis)." ;
               rdfs:label "gangrene"@en ,
                          "Gangrene" .


