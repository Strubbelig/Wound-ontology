ns1:CHEBI_33229 rdf:type owl:Class ;
                rdfs:subClassOf ns1:CHEBI_33284 ;
                ns1:IAO_0000115 "A biochemical role played by any micronutrient that is an organic compound. Vitamins are present in foods in small amounts and are essential to normal metabolism and biochemical functions, usually as coenzymes. The term \\" ;
                rdfs:label "vitamin"@en ,
                           "vitamin (role)" .


###  http://purl.obolibrary.org/obo/CHEBI_33284
ns1:CHEBI_33284 rdf:type owl:Class ;
