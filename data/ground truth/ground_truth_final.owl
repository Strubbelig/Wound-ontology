wont:WONT_0000485 rdf:type owl:Class ;
                  rdfs:subClassOf wont:WONT_0000310 ;
                  ns1:IAO_0000115 "A thermal wound in which the injury extends beyond the skin into underlying tissue such as fascia, muscle or bone."@en ;
                  rdfs:label "Fourth-degree burn wound"@en .


###  https://bioportal.bioontology.org/ontologies/WONT/WONT_0000486
