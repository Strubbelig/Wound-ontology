                                                                                                  wont:WONT_0000512
                                                                                                )
                                                                                  ]
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                  rdfs:subClassOf wont:WONT_0000380 ;
                  ns1:IAO_0000115 "A wound whose microbial burden is assessed on the IWII wound infection continuum: it bears the quality sterile, contaminated, colonized or infected."@en ;
                  rdfs:label "Wound with microbial burden assessed according to IWII"@en .


