###  https://bioportal.bioontology.org/ontologies/WONT/WONT_0000382
wont:WONT_0000382 rdf:type owl:Class ;
                  rdfs:subClassOf ns1:BFO_0000040 ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ns1:BFO_0000050 ;
                                    owl:someValuesFrom wont:WONT_0000380
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ns1:RO_0000086 ;
                                    owl:someValuesFrom wont:WONT_0000452
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ns1:RO_0000086 ;
                                    owl:someValuesFrom wont:WONT_0000453
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ns1:RO_0000086 ;
                                    owl:someValuesFrom wont:WONT_0000454
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ns1:RO_0000086 ;
                                    owl:someValuesFrom wont:WONT_0000455
                                  ] ;
                  ns1:IAO_0000116 "Structural axiom, not a definition. This class was label-only under a bare BFO_0000040, so nothing in the ontology said it had anything to do with a wound - the mereology lived only in the class name. Asserting part_of some Wound makes the name's claim checkable and is what CQ025 was failing on. No genus-differentia definition is written here; per the C6 decision the axiom is left to carry the content."@en ;
                  rdfs:label "Wound base" .


###  https://bioportal.bioontology.org/ontologies/WONT/WONT_0000383
wont:WONT_0000383 rdf:type owl:Class ;
                  rdfs:subClassOf ns1:BFO_0000040 ;
                  rdfs:label "Wound biofilm" .


###  https://bioportal.bioontology.org/ontologies/WONT/WONT_0000384
wont:WONT_0000384 rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( wont:WONT_0000380
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty ns1:RO_0002353 ;
                                                               owl:someValuesFrom [ owl:intersectionOf ( wont:WONT_0000414
                                                                                                         [ rdf:type owl:Restriction ;
                                                                                                           owl:onProperty ns1:BFO_0000051 ;
                                                                                                           owl:someValuesFrom wont:WONT_0000541
                                                                                                         ]
                                                                                                       ) ;
                                                                                    rdf:type owl:Class
                                                                                  ]
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                  rdfs:subClassOf wont:WONT_0000380 ;
                  ns1:IAO_0000115 "A wound that is the output of a wound development process that has as part a wound causing process of the course of a venous insufficiency disorder: a complication of that disorder. No claim is made that the disorder caused the wound."@en ;
                  ns1:IAO_0000116 "COMPLICATION, NOT CAUSATION, NOT CO-LOCATION (2026-09-17). This class was defined until today as a wound that is part of the same material disease entity as the other disorder. That axiom asserted only that a diagnostic classification files the two under one disease, and its label promised a spatial adjacency the logic never stated. MILD already models a complication: a disorder that is the output of a process in another disease's course (MILD_120053). This class now follows that pattern - the wound is the output of a wound development process that has, as a part, a wound causing process which is itself a process of the other disease's course. No causal relation between the two disorders is asserted, in keeping with MILD model commitment 4; the causal order lives in the processes, where MILD licenses it."@en ,
                                  "RENAMED. The previous label, 'Wound causally related to impaired venous backflow', asserted in its own name a causal relation that this ontology does not hold to be assertable: what a disease causes cannot be reliably separated from what the disease is. Only co-location in space and time is claimed. The old label is deliberately NOT retained as an alternative term, because doing so would keep the rejected causal claim in circulation as a searchable synonym."@en ;
                  ns1:IAO_0000118 "venous insufficiency ulcer"@en ,
                                  "venous wound"@en ;
                  rdfs:label "Venous insufficiency wound"@en .


