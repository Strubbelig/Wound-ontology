###  https://bioportal.bioontology.org/ontologies/WONT/WONT_0000464
wont:WONT_0000464 rdf:type owl:Class ;
                  rdfs:subClassOf mild:MILD_120020 ;
                  ns1:IAO_0000115 "A material disease entity that has as part an abnormal mass of tissue arising from autonomous, uncoordinated proliferation of its constituent cells."@en ;
                  rdfs:label "Neoplasm"@en .


###  https://bioportal.bioontology.org/ontologies/WONT/WONT_0000465
wont:WONT_0000465 rdf:type owl:Class ;
                  rdfs:subClassOf wont:WONT_0000464 ;
                  ns1:IAO_0000115 "A neoplasm whose constituent cells are disposed to invade surrounding tissue or to metastasize."@en ;
                  rdfs:comment "PATO_0002097 'neoplastic, malignant' is a quality and cannot subsume a material disease entity, so it is bridged rather than used as a parent. Minted under MILD_120020 because the imported DOID module contains no neoplasm or carcinoma class."@en ;
                  rdfs:label "Malignancy"@en ;
                  skos:relatedMatch ns1:PATO_0002097 .


###  https://bioportal.bioontology.org/ontologies/WONT/WONT_0000466
wont:WONT_0000466 rdf:type owl:Class ;
                  rdfs:subClassOf mild:MILD_120022 ;
                  ns1:IAO_0000115 "A pathological disorder consisting in an abnormal structure of the wall or of the lumen of one or more blood vessels, such that perfusion of the tissue those vessels supply is reduced."@en ;
                  ns1:IAO_0000116 "Minted as the shared parent of Microangiopathy (WONT_0000201) and Peripheral arterial occlusive disease (WONT_0000229) so that Angiopathic wound (WONT_0000015) has a single material co-location target. Before the causal-role groupings were dissolved, the two sat side by side under a class that grouped them by what they were said to cause; they are grouped here by what they are."@en ;
                  rdfs:label "Angiopathy"@en .


###  https://bioportal.bioontology.org/ontologies/WONT/WONT_0000467
wont:WONT_0000467 rdf:type owl:Class ;
                  rdfs:subClassOf mild:MILD_120022 ;
                  ns1:IAO_0000115 "A pathological disorder consisting in the abnormal organization of the insulin-secreting or insulin-responsive tissues of a patient, such that glucose homeostasis is not maintained."@en ;
                  rdfs:comment "Bridging annotation, not subsumption. The OBO term is a nosological category / specifically dependent continuant, whereas this class is the material pathological disorder itself. Asserting rdfs:subClassOf between them is a category error, so the relation is recorded as skos:relatedMatch instead."@en ;
                  rdfs:label "Diabetic metabolic disorder"@en ;
                  skos:relatedMatch ns1:DOID_9351 .


###  https://bioportal.bioontology.org/ontologies/WONT/WONT_0000468
wont:WONT_0000468 rdf:type owl:Class ;
                  rdfs:subClassOf mild:MILD_120022 ;
                  ns1:IAO_0000115 "A pathological disorder consisting in an abnormal structure of the valves or walls of the veins of a limb, such that venous return from that limb against gravity is impaired."@en ;
                  rdfs:comment "Bridging annotation, not subsumption. The OBO term is a nosological category / specifically dependent continuant, whereas this class is the material pathological disorder itself. Asserting rdfs:subClassOf between them is a category error, so the relation is recorded as skos:relatedMatch instead."@en ;
                  rdfs:label "Venous insufficiency disorder"@en ;
                  skos:relatedMatch ns1:DOID_0050853 .


###  https://bioportal.bioontology.org/ontologies/WONT/WONT_0000469
wont:WONT_0000469 rdf:type owl:Class ;
                  rdfs:subClassOf mild:MILD_120022 ;
                  ns1:IAO_0000115 "A pathological disorder consisting in tissue of a patient that has been damaged by an immune response directed against constituents normally present in that patient's own body."@en ;
                  rdfs:comment "Bridging annotation, not subsumption. The OBO term is a nosological category / specifically dependent continuant, whereas this class is the material pathological disorder itself. Asserting rdfs:subClassOf between them is a category error, so the relation is recorded as skos:relatedMatch instead."@en ;
                  rdfs:label "Autoimmune tissue disorder"@en ;
                  skos:relatedMatch ns1:DOID_417 .


###  https://bioportal.bioontology.org/ontologies/WONT/WONT_0000470
wont:WONT_0000470 rdf:type owl:Class ;
                  rdfs:subClassOf mild:MILD_120022 ;
                  ns1:IAO_0000115 "A pathological disorder consisting in a collection of lymphatic fluid within a non-epithelialised cavity in a bodily structure."@en ;
                  rdfs:comment "Bridging annotation, not subsumption. The OBO term is a nosological category / specifically dependent continuant, whereas this class is the material pathological disorder itself. Asserting rdfs:subClassOf between them is a category error, so the relation is recorded as skos:relatedMatch instead."@en ;
                  rdfs:label "Lymphocele"@en ;
                  skos:relatedMatch ns1:DOID_4347 .


###  https://bioportal.bioontology.org/ontologies/WONT/WONT_0000471
wont:WONT_0000471 rdf:type owl:Class ;
                  rdfs:subClassOf wont:WONT_0000409 ;
                  ns1:IAO_0000115 "A wound healing related physiological process in which fibrous connective tissue replaces tissue lost in a wound, yielding a scar rather than restoration of the original tissue architecture."@en ;
                  rdfs:comment "Bridging annotation, not subsumption. HP_0100699 'Scarring' is a phenotypic abnormality, i.e. a quality and therefore a continuant, whereas this class is the process of scar formation. Asserting rdfs:subClassOf between them crosses the continuant/occurrent divide and renders both unsatisfiable, so the relation is recorded as skos:relatedMatch instead."@en ;
                  rdfs:label "Scarring process"@en ;
                  skos:relatedMatch ns1:HP_0100699 .


###  https://bioportal.bioontology.org/ontologies/WONT/WONT_0000472
wont:WONT_0000472 rdf:type owl:Class ;
                  rdfs:subClassOf mild:MILD_120022 ;
                  ns1:IAO_0000115 "A pathological disorder consisting in a localized collection of purulent material within a bodily structure, surrounded by inflamed and granulating tissue."@en ;
                  rdfs:comment "Bridging annotation, not subsumption. The OBO term is a phenotypic abnormality / nosological category, i.e. a specifically dependent continuant, whereas this class is the material pathological disorder itself. Asserting rdfs:subClassOf between them is a category error that renders both unsatisfiable, so the relation is recorded as skos:relatedMatch instead."@en ;
                  rdfs:label "Abscess"@en ;
                  skos:relatedMatch ns1:HP_0025615 .


###  https://bioportal.bioontology.org/ontologies/WONT/WONT_0000473
wont:WONT_0000473 rdf:type owl:Class ;
                  rdfs:subClassOf mild:MILD_120022 ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ns1:BFO_0000050 ;
                                    owl:someValuesFrom ns1:UBERON_0000344
                                  ] ;
                  ns1:IAO_0000115 "A pathological disorder that is part of a mucosa and consists in a fluid-filled separation of the epithelium of that mucosa from the tissue beneath it."@en ;
                  ns1:IAO_0000116 "The anatomical location uses BFO_0000050 part_of rather than RO_0004026 disease has location, deliberately. RO_0004026 carries rdfs:domain OGMS_0000031, the disposition-based disease class that MILD refuses as a parent; asserting it of a MILD_120022 pathological disorder would infer that subsumption and silently reimport the OGMS commitment this ontology was built to avoid. That is the same domain trap already documented on BFO_0000218 in MILD. Plain mereology carries the intended content with no such side effect, and stays in the EL profile."@en ;
                  rdfs:comment "Minted so that the blistering diseases of the mucosa can be composed out of the disorders that actually constitute them, rather than asserted as unanalysed nosological labels. Deliberately not restricted to autoimmune blistering: friction, thermal and drug-induced mucosal blisters are instances too. The autoimmune reading is added at the point of use by intersecting this class with WONT_0000469."@en ;
                  rdfs:label "Mucosal blister"@en .


###  https://bioportal.bioontology.org/ontologies/WONT/WONT_0000474
wont:WONT_0000474 rdf:type owl:Class ;
                  rdfs:subClassOf wont:WONT_0000415 ;
                  ns1:IAO_0000115 "A degree of wound pain that qualifies its bearer as painful."@en ;
                  rdfs:label "painful"@en .


###  https://bioportal.bioontology.org/ontologies/WONT/WONT_0000475
wont:WONT_0000475 rdf:type owl:Class ;
                  rdfs:subClassOf ns1:BFO_0000019 ;
                  ns1:IAO_0000115 "A quality of a pathological disorder that is the time that has elapsed since the disorder came into existence, taken relative to the course expected for a disorder of its kind."@en ;
                  rdfs:label "degree of time after disease inception"@en .


###  https://bioportal.bioontology.org/ontologies/WONT/WONT_0000476
wont:WONT_0000476 rdf:type owl:Class ;
                  rdfs:subClassOf wont:WONT_0000475 ;
                  ns1:IAO_0000115 "A degree of time after disease inception that qualifies its bearer as acute: the disorder is of recent onset and still within the period in which an orderly course is expected."@en ;
                  rdfs:label "acute"@en .


###  https://bioportal.bioontology.org/ontologies/WONT/WONT_0000477
wont:WONT_0000477 rdf:type owl:Class ;
                  rdfs:subClassOf wont:WONT_0000475 ;
                  ns1:IAO_0000115 "A degree of time after disease inception that qualifies its bearer as chronic: the disorder has persisted beyond the period in which an orderly course is expected."@en ;
                  rdfs:comment "PATO_0001863 chronic is a duration quality of a process; this quality is borne by the disorder itself, a material entity. Bridged, not subsumed."@en ;
                  rdfs:label "chronic"@en ;
                  skos:relatedMatch ns1:PATO_0001863 .


###  https://bioportal.bioontology.org/ontologies/WONT/WONT_0000478
wont:WONT_0000478 rdf:type owl:Class ;
                  rdfs:subClassOf ns1:BFO_0000019 ;
                  ns1:IAO_0000115 "A quality of a wound that is the extent to which microorganisms are present in it, multiply in it and elicit a response from its bearer."@en ;
                  rdfs:label "degree of microbial burden"@en .


###  https://bioportal.bioontology.org/ontologies/WONT/WONT_0000479
wont:WONT_0000479 rdf:type owl:Class ;
                  rdfs:subClassOf wont:WONT_0000478 ;
                  ns1:IAO_0000115 "A degree of microbial burden that qualifies its bearer as contaminated: microorganisms are present in the wound but are not multiplying."@en ;
                  rdfs:label "contaminated"@en .


###  https://bioportal.bioontology.org/ontologies/WONT/WONT_0000480
wont:WONT_0000480 rdf:type owl:Class ;
                  rdfs:subClassOf wont:WONT_0000478 ;
                  ns1:IAO_0000115 "A degree of microbial burden that qualifies its bearer as infected: microorganisms are present in the wound, multiply in it and elicit a host response."@en ;
                  ns1:IAO_0000116 "Added as a determinate beside the process reading, not instead of it: Infected wound (WONT_0000163) also participates in a wound infection process (WONT_0000410)."@en ;
                  rdfs:label "infected"@en .


###  https://bioportal.bioontology.org/ontologies/WONT/WONT_0000481
wont:WONT_0000481 rdf:type owl:Class ;
