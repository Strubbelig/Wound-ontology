###  https://bioportal.bioontology.org/ontologies/WONT/WONT_0000013
wont:WONT_0000013 rdf:type owl:Class ;
                  rdfs:subClassOf mild:MILD_120022 ;
                  ns1:IAO_0000116 "Recategorised when the causal-role groupings 'Medical condition contributing to wound formation' / 'affecting wound healing' / 'contributing to blistering wounds' were dissolved. Those classes grouped entities by what they were said to cause, which this ontology does not assert, and they mixed material disorders with dispositions and processes. Relevance to wounds is now carried by co-location axioms on the wound classes instead of by membership in a causal class."@en ;
                  rdfs:label "ANCA-associated Vasculitis" .


###  https://bioportal.bioontology.org/ontologies/WONT/WONT_0000015
wont:WONT_0000015 rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( wont:WONT_0000380
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty ns1:RO_0002353 ;
                                                               owl:someValuesFrom [ owl:intersectionOf ( wont:WONT_0000414
                                                                                                         [ rdf:type owl:Restriction ;
                                                                                                           owl:onProperty ns1:BFO_0000051 ;
                                                                                                           owl:someValuesFrom wont:WONT_0000537
                                                                                                         ]
                                                                                                       ) ;
                                                                                    rdf:type owl:Class
                                                                                  ]
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                  rdfs:subClassOf wont:WONT_0000380 ;
                  ns1:IAO_0000115 "A wound that is the output of a wound development process that has as part a wound causing process of the course of an angiopathy: a complication of that disorder. No claim is made that the disorder caused the wound."@en ;
                  ns1:IAO_0000116 "COMPLICATION, NOT CAUSATION, NOT CO-LOCATION (2026-09-17). This class was defined until today as a wound that is part of the same material disease entity as the other disorder. That axiom asserted only that a diagnostic classification files the two under one disease, and its label promised a spatial adjacency the logic never stated. MILD already models a complication: a disorder that is the output of a process in another disease's course (MILD_120053). This class now follows that pattern - the wound is the output of a wound development process that has, as a part, a wound causing process which is itself a process of the other disease's course. No causal relation between the two disorders is asserted, in keeping with MILD model commitment 4; the causal order lives in the processes, where MILD licenses it."@en ;
                  rdfs:label "Angiopathic wound"@en .


