    rdfs:label "benzalkonium chloride"@en ;
    rdfs:subClassOf ns1:CHEBI_35273 .

ns1:CHEBI_30512 a owl:Class ;
    rdfs:label "silver atom"@en ;
    rdfs:subClassOf wont:WONT_0000022 .

ns1:CHEBI_33229 a owl:Class ;
    rdfs:label "vitamin (role)"@en ;
    ns1:IAO_0000118 "vitamin"@en ;
    rdfs:subClassOf ns1:CHEBI_33284 .

ns1:CHEBI_33301 a owl:Class ;
    rdfs:label "bismuth atom"@en ;
    rdfs:subClassOf wont:WONT_0000022 .

ns1:CHEBI_35267 a owl:Class ;
    rdfs:label "quaternary ammonium ion" .

ns1:CHEBI_36080 a owl:Class ;
    rdfs:label "protein"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000087 ;
            owl:someValuesFrom ns1:CHEBI_33284 ] .

ns1:CHEBI_3614 a owl:Class ;
    rdfs:label "chlorhexidine"@en ;
    ns1:IAO_0000118 "Chlorhexidine"@en ;
    rdfs:subClassOf wont:WONT_0000445 .

ns1:CHEBI_64275 a owl:Class ;
    rdfs:label "2-phenoxyethanol"@en ;
    ns1:IAO_0000118 "Phenoxyethanol"@en ;
    rdfs:subClassOf wont:WONT_0000025 .

ns1:CHEBI_8347 a owl:Class ;
    rdfs:label "Povidone-iodine" ;
    rdfs:subClassOf wont:WONT_0000021 .

ns1:DOID_0050061 a owl:Class ;
    rdfs:label "erysipeloid" ;
    rdfs:subClassOf ns1:IDO_0000586 .

ns1:DOID_0050426 a owl:Class ;
    rdfs:label "Stevens-Johnson syndrome" .

ns1:DOID_0060851 a owl:Class ;
    rdfs:label "pemphigus vulgaris"@en ;
    ns1:IAO_0000118 "Pemphigus vulgaris"@en .

ns1:DOID_10881 a owl:Class ;
    rdfs:label "hand, foot and mouth disease"@en ;
    ns1:IAO_0000118 "Hand-foot-and-mouth disease"@en .

ns1:DOID_2730 a owl:Class ;
    rdfs:label "epidermolysis bullosa"@en ;
    ns1:IAO_0000118 "Epidermolysis bullosa"@en .

ns1:DOID_3042 a owl:Class ;
    rdfs:label "allergic contact dermatitis"@en ;
    ns1:IAO_0000118 "Allergic contact dermatitis"@en .

ns1:DOID_3132 a owl:Class ;
    rdfs:label "porphyria cutanea tarda"@en ;
    ns1:IAO_0000118 "Porphyria cutanea tarda"@en .

ns1:DOID_8505 a owl:Class ;
    rdfs:label "dermatitis herpetiformis"@en ;
    ns1:IAO_0000118 "Dermatitis herpetiformis Duhring"@en .

ns1:DOID_8506 a owl:Class ;
    rdfs:label "bullous pemphigoid"@en ;
    ns1:IAO_0000118 "Bullous pemphigoid"@en .

ns1:DOID_8536 a owl:Class ;
    rdfs:label "herpes zoster"@en ;
    ns1:IAO_0000118 "Herpes zoster"@en .

ns1:DOID_8566 a owl:Class ;
    rdfs:label "herpes simplex"@en ;
    ns1:IAO_0000118 "Herpes simplex (e.g. cold sores)"@en .

ns1:DOID_8659 a owl:Class ;
    rdfs:label "chickenpox"@en ;
    ns1:IAO_0000118 "Chickenpox (varicella)"@en .

ns1:DOID_9970 a owl:Class ;
    rdfs:label "obesity"@en ;
    ns1:IAO_0000118 "Obesity"@en .

ns1:GO_0001525 a owl:Class ;
    rdfs:label "angiogenesis"@en ;
    ns1:IAO_0000118 "Angiogenesis process"@en ;
    rdfs:subClassOf wont:WONT_0000409 .

ns1:GO_0008283 a owl:Class ;
    rdfs:label "cell population proliferation"@en ;
    ns1:IAO_0000118 "Proliferation process"@en ;
    rdfs:subClassOf wont:WONT_0000409 .

ns1:GO_0042246 a owl:Class ;
    rdfs:label "tissue regeneration"@en ;
    ns1:IAO_0000118 "Tissue regeneration process"@en ;
    rdfs:subClassOf wont:WONT_0000409 .

ns1:GO_0042310 a owl:Class ;
    rdfs:label "vasoconstriction"@en ;
    ns1:IAO_0000118 "Vasoconstriction process"@en ;
    rdfs:subClassOf wont:WONT_0000409 .

ns1:GO_0042311 a owl:Class ;
    rdfs:label "vasodilation"@en ;
    ns1:IAO_0000118 "Vasodilation process"@en ;
    rdfs:subClassOf wont:WONT_0000409 .

ns1:GO_0050817 a owl:Class ;
    rdfs:label "coagulation"@en ;
    ns1:IAO_0000118 "Coagulation process"@en ;
    rdfs:subClassOf wont:WONT_0000409 .

ns1:HP_0000961 a owl:Class ;
    rdfs:label "Cyanosis" ;
    rdfs:subClassOf ns1:PATO_0000014 .

ns1:HP_0000980 a owl:Class ;
    rdfs:label "Pallor" ;
    rdfs:subClassOf ns1:PATO_0000014 .

ns1:HP_0004395 a owl:Class ;
    rdfs:label "Malnutrition" .

ns1:HP_0032675 a owl:Class .

ns1:HP_0100758 a owl:Class ;
    rdfs:label "Gangrene"@en ;
    ns1:IAO_0000118 "gangrene"@en ;
    rdfs:comment "Bridging annotation, not subsumption. MILD models a wound/disease as a material continuant; the OBO term below is a phenotype or nosological category, i.e. a specifically dependent continuant. Asserting rdfs:subClassOf between them is a category error that renders both unsatisfiable, so the relation is recorded as skos:relatedMatch instead."@en ;
    skos:relatedMatch mild:MILD_120020 .

ns1:IAO_0000104 a owl:Class .

ns1:IAO_0000115 a owl:AnnotationProperty .

ns1:IAO_0000118 a owl:AnnotationProperty .

ns1:NCBITaxon_1301 a owl:Class ;
    rdfs:label "Streptococcus" ;
    rdfs:subClassOf ns1:NCBITaxon_2 .

ns1:NCBITaxon_287 a owl:Class ;
    rdfs:label "Pseudomonas aeruginosa" ;
    rdfs:subClassOf ns1:NCBITaxon_2 .

ns1:NCBITaxon_562 a owl:Class ;
    rdfs:label "Escherichia coli" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty mild:MILD_120101 ;
            owl:someValuesFrom wont:WONT_120018 ],
        ns1:NCBITaxon_2 .

ns1:OBI_0000938 a owl:Class ;
    rdfs:label "categorical measurement datum" .

ns1:OBI_0600022 a owl:Class ;
    rdfs:label "excision"@en ;
    ns1:IAO_0000118 "Surgical excision"@en ;
    rdfs:subClassOf wont:WONT_0000190 .

ns1:OBI_0600044 a owl:Class ;
    rdfs:label "lavage"@en ;
    ns1:IAO_0000118 "Lavage process"@en ;
    rdfs:subClassOf wont:WONT_0000387 .

ns1:OGMS_0000031 a owl:Class .

ns1:PATO_0000586 a owl:Class ;
    rdfs:label "increased size" ;
    rdfs:subClassOf ns1:PATO_0000117 .

ns1:PATO_0001851 a owl:Class ;
    rdfs:label "swollen"@en ;
    ns1:IAO_0000118 "Swelling"@en ;
    rdfs:subClassOf ns1:BFO_0000019 .

ns1:PATO_0002104 a owl:Class ;
    rdfs:label "inflamed" .

ns1:RO_0000091 a owl:ObjectProperty .

skos:relatedMatch a owl:AnnotationProperty .

<https://bioportal.bioontology.org/ontologies/WONT> a owl:Ontology ;
    dcterms:created "2026-06-15"^^xsd:date ;
    dcterms:creator <https://orcid.org/0009-0006-6251-7592>,
        "Dr. Moritz Rudolf Franz Valerius Milewski"@en ;
    dcterms:description "A domain ontology of wounds, wound assessment, wound classification and wound treatment. WONT is the domain layer over the Mid Layer Disease Ontology (MILD): a wound is modelled as a MILD material disease entity, and wound treatment, diagnosis and classification specialise the corresponding MILD processes and results."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-31"^^xsd:date ;
    dcterms:title "Wound Ontology"@en ;
    vann:preferredNamespacePrefix "WONT" ;
    vann:preferredNamespaceUri "https://bioportal.bioontology.org/ontologies/WONT/" ;
    rdfs:comment "WONT is developed by its author and, like MILD, reviewed at least once a year."@en ;
    owl:imports <https://bioportal.bioontology.org/ontologies/MILD> ;
    owl:versionIRI wont:0.1.0 .

wont:WONT_0000004 a owl:Class ;
    rdfs:label "Acidity impact process in wound development"@en ;
    rdfs:subClassOf wont:WONT_0000517 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000418 wont:WONT_0000517 ) ] .

wont:WONT_0000005 a owl:Class ;
    rdfs:label "Activated carbon layer wound dressing" ;
    ns1:IAO_0000115 "A wound dressing that has as part a layer of activated carbon, a highly porous carbon that adsorbs volatile odour molecules released from the wound."@en ;
    rdfs:subClassOf wont:WONT_0000398 .

wont:WONT_0000008 a owl:Class ;
    rdfs:label "Adhesive silicone grid" ;
    ns1:IAO_0000115 "A silicone spacer grid whose silicone surface is tacky, so that it adheres to the skin around the wound without a separate fixation material."@en ;
    rdfs:subClassOf wont:WONT_0000280 .

wont:WONT_0000011 a owl:Class ;
    rdfs:label "Alginate containing wound dressing" ;
    ns1:IAO_0000115 "A wound dressing that has as part fibres or a gel of alginate, a salt of alginic acid obtained from brown seaweed, which forms a gel on contact with wound exudate."@en ;
    rdfs:subClassOf wont:WONT_0000398 .

wont:WONT_0000013 a owl:Class ;
    rdfs:label "ANCA-associated Vasculitis" ;
    ns1:IAO_0000115 "A material disease entity consisting of necrotizing inflammation of the walls of predominantly small blood vessels, with few or no immune deposits, that is associated with antineutrophil cytoplasmic antibodies."@en ;
    ns1:IAO_0000116 "Recategorised when the causal-role groupings 'Medical condition contributing to wound formation' / 'affecting wound healing' / 'contributing to blistering wounds' were dissolved. Those classes grouped entities by what they were said to cause, which this ontology does not assert, and they mixed material disorders with dispositions and processes. Relevance to wounds is now carried by co-location axioms on the wound classes instead of by membership in a causal class."@en ;
    rdfs:subClassOf mild:MILD_120020 .

wont:WONT_0000027 a owl:Class ;
    rdfs:label "Arterial leg ulcer" ;
    ns1:IAO_0000115 "A skin wound located on the leg or foot in which the skin and underlying tissue are disrupted in an area that is ischaemic, with insufficient arterial blood supply."@en ;
    rdfs:subClassOf wont:WONT_0000441 .

wont:WONT_0000028 a owl:Class ;
    rdfs:label "ASEPSIS score" ;
    ns1:IAO_0000115 "A wound classification scale that grades a surgical wound for infection by summing points for additional treatment, serous discharge, erythema, purulent exudate, separation of deep tissues, isolation of bacteria and prolonged inpatient stay."@en ;
    rdfs:subClassOf wont:WONT_0000066 .

wont:WONT_0000030 a owl:Class ;
    rdfs:label "obsolete Aseptic cuticle plan specification"@en ;
    ns1:IAO_0000231 ns1:IAO_0000227 ;
    ns1:IAO_0100001 wont:WONT_0000029 ;
    rdfs:comment "Merged into WONT_0000029 Aseptic conditions plan specification: 'aseptic cuticle' is a mistranslation of the German 'aseptische Kautelen', aseptic conditions (curator 2026-10-31, relayed by the thesis session: \"i agree with 1,2,3,4,5\")."@en ;
    owl:deprecated true .

wont:WONT_0000032 a owl:Class ;
    rdfs:label "Assessing patient's medical history" ;
    ns1:IAO_0000115 "A diagnostic process to assess wound characteristics in which information on the patient's past and current diseases, treatments and the origin and course of the wound is obtained from the patient, relatives or records."@en ;
    rdfs:subClassOf wont:WONT_0000089 .

wont:WONT_0000033 a owl:Class ;
    rdfs:label "Autoimmune disease related wound"@en ;
    ns1:IAO_0000115 "A wound that is the output of a wound development process that has as part a process of the course of an autoimmune tissue disorder. No claim is made that the disorder caused the wound."@en ;
    rdfs:subClassOf wont:WONT_0000380 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000380 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0002353 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( wont:WONT_0000414 [ a owl:Restriction ;
                                            owl:onProperty ns1:BFO_0000051 ;
                                            owl:someValuesFrom wont:WONT_0000538 ] ) ] ] ) ] .

wont:WONT_0000034 a owl:Class ;
    rdfs:label "Autolytic wound debridement process"@en ;
    ns1:IAO_0000115 "A debridement process in which necrotic tissue and slough are broken down by the patient's own enzymes and phagocytic cells in a wound kept moist."@en ;
    rdfs:subClassOf wont:WONT_0000084 .

wont:WONT_0000037 a owl:Class ;
    rdfs:label "Bepanthen ointment" ;
    rdfs:subClassOf wont:WONT_0000406 .

wont:WONT_0000038 a owl:Class ;
    rdfs:label "Biobag debridement plan specification"@en ;
    ns1:IAO_0000115 "A biosurgical debridement plan specification that prescribes applying the sterile fly larvae to the wound enclosed in a sealed mesh bag, so that the larvae do not move freely over the wound surface."@en ;
    ns1:IAO_0000118 "Biobag debridement"@en ;
    rdfs:subClassOf wont:WONT_0000040 .

wont:WONT_0000039 a owl:Class ;
    rdfs:label "Wound specimen procurement by biopsy process"@en ;
    ns1:IAO_0000115 "A wound diagnostic process in which a sample of tissue is cut or punched from the wound bed or wound edge and that has as specified output a wound tissue specimen for laboratory examination."@en ;
    rdfs:subClassOf wont:WONT_0000395 .

wont:WONT_0000041 a owl:Class ;
    rdfs:label "Biosurgical wound debridement process" ;
    ns1:IAO_0000115 "A debridement process in which live sterile fly larvae applied to a wound remove its necrotic or devitalized tissue."@en ;
    rdfs:subClassOf wont:WONT_0000084 .

wont:WONT_0000042 a owl:Class ;
    rdfs:label "Biosynthetic cellulose" ;
    ns1:IAO_0000115 "A wound dressing whose wound-contacting material is a cellulose membrane synthesized by bacteria."@en ;
    rdfs:subClassOf wont:WONT_0000398 .

wont:WONT_0000043 a owl:Class ;
    rdfs:label "Bismuth III bromide" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000087 ;
            owl:someValuesFrom ns1:CHEBI_48218 ],
        wont:WONT_0000022 .

wont:WONT_0000045 a owl:Class ;
    rdfs:label "Blake drain" ;
    ns1:IAO_0000115 "A low-vacuum drain consisting of a silicone tube whose intracorporeal portion has open longitudinal channels around a solid core instead of side holes."@en ;
    rdfs:subClassOf wont:WONT_0000177 .

wont:WONT_0000046 a owl:Class ;
    rdfs:label "Blistering skin wound" ;
    ns1:IAO_0000115 "A skin wound in which the skin layers separate within the epidermis or at the dermo-epidermal junction, and fluid collects in the space between them."@en ;
    rdfs:subClassOf wont:WONT_0000441 .

wont:WONT_0000047 a owl:Class ;
    rdfs:label "Bovine collagen containing wound dressing" ;
    ns1:IAO_0000115 "A wound-integrating wound dressing that has as part collagen derived from cattle."@en ;
    rdfs:subClassOf wont:WONT_0000427 .

wont:WONT_0000048 a owl:Class ;
    rdfs:label "Bromelain" ;
    ns1:IAO_0000115 "A substance used for enzymatic wound debridement that consists of a mixture of cysteine proteases extracted from the pineapple plant (Ananas comosus)."@en ;
    rdfs:subClassOf wont:WONT_0000296 .

wont:WONT_0000049 a owl:Class ;
    rdfs:label "Bullosis diabeticorum" ;
    ns1:IAO_0000115 "A material disease entity that has as parts one or more spontaneously arising, non-inflammatory skin blisters in a patient who has a diabetic metabolic disorder."@en ;
    ns1:IAO_0000116 "Recategorised when the causal-role groupings 'Medical condition contributing to wound formation' / 'affecting wound healing' / 'contributing to blistering wounds' were dissolved. Those classes grouped entities by what they were said to cause, which this ontology does not assert, and they mixed material disorders with dispositions and processes. Relevance to wounds is now carried by co-location axioms on the wound classes instead of by membership in a causal class."@en ;
    rdfs:subClassOf mild:MILD_120020 .

wont:WONT_0000050 a owl:Class ;
    rdfs:label "Bullous impetigo" ;
    ns1:IAO_0000115 "A material disease entity consisting of a superficial Staphylococcus aureus infection of the epidermis that has as parts one or more flaccid subcorneal blisters."@en ;
    ns1:IAO_0000116 "Recategorised when the causal-role groupings 'Medical condition contributing to wound formation' / 'affecting wound healing' / 'contributing to blistering wounds' were dissolved. Those classes grouped entities by what they were said to cause, which this ontology does not assert, and they mixed material disorders with dispositions and processes. Relevance to wounds is now carried by co-location axioms on the wound classes instead of by membership in a causal class."@en ;
    rdfs:subClassOf mild:MILD_120020 .

wont:WONT_0000057 a owl:Class ;
    rdfs:label "Bülau drain" ;
    ns1:IAO_0000115 "A thoracic drain whose external end is placed under water in a collecting container, forming an underwater seal that lets air and fluid leave the pleural cavity while preventing their return."@en ;
    rdfs:subClassOf wont:WONT_0000311 .

wont:WONT_0000060 a owl:Class ;
    rdfs:label "Cat bite wound" ;
    ns1:IAO_0000115 "A bite wound inflicted by the teeth of a cat."@en ;
    rdfs:subClassOf wont:WONT_0000044 .

wont:WONT_0000061 a owl:Class ;
    rdfs:label "Cellulose acetate mesh impregnated with a petrolatum emulsion" ;
    ns1:IAO_0000115 "A wound dressing that is a non-adherent wound contact layer formed by a knitted mesh of cellulose acetate fibres coated with an emulsion of petrolatum."@en ;
    rdfs:subClassOf wont:WONT_0000398 .

wont:WONT_0000067 a owl:Class ;
    rdfs:label "Clean-contaminated wound according to CDC"@en ;
    ns1:IAO_0000115 "A wound with microbial burden assessed according to CDC that is an operative wound in which the respiratory, alimentary, genital or urinary tract is entered under controlled conditions and without unusual contamination."@en ;
    rdfs:subClassOf wont:WONT_0000524 .

wont:WONT_0000068 a owl:Class ;
    rdfs:label "Clean wound according to CDC"@en ;
    ns1:IAO_0000115 "A wound with microbial burden assessed according to CDC that is an uninfected operative wound in which no inflammation is encountered and the respiratory, alimentary, genital or urinary tract is not entered."@en ;
    rdfs:subClassOf wont:WONT_0000524 .

wont:WONT_0000069 a owl:Class ;
    rdfs:label "Clinical inspection" ;
    ns1:IAO_0000115 "A diagnostic process to assess wound characteristics in which a clinician directly observes the wound and the periwound skin by eye."@en ;
    rdfs:subClassOf wont:WONT_0000089 .

wont:WONT_0000070 a owl:Class ;
    rdfs:label "Clinical wound assessment" ;
    ns1:IAO_0000115 "A diagnostic process to assess wound characteristics in which a healthcare professional evaluates the wound, the periwound skin and the patient by history taking and physical examination at the point of care."@en ;
    rdfs:subClassOf wont:WONT_0000089 .

wont:WONT_0000071 a owl:Class ;
    rdfs:label "Closed drain" ;
    ns1:IAO_0000115 "A drain whose external end is connected to a sealed collecting container or system, so that the drained fluid is not exposed to the environment."@en ;
    rdfs:subClassOf wont:WONT_0000093 .

wont:WONT_0000072 a owl:Class ;
    rdfs:label "CO2 bath wound therapy plan specification"@en ;
    ns1:IAO_0000115 "A wound treatment plan specification that prescribes a bath in which the wound-bearing body part is exposed to carbon dioxide, either dissolved in water or as a gas."@en ;
    ns1:IAO_0000118 "CO2 bath wound therapy"@en ;
    rdfs:subClassOf wont:WONT_0000200 .

wont:WONT_0000074 a owl:Class ;
    rdfs:label "Cold plasma wound treatment process"@en ;
    ns1:IAO_0000115 "A wound treatment process in which a non-thermal, partially ionized gas generated at atmospheric pressure is applied to the wound."@en ;
    rdfs:subClassOf wont:WONT_0000423 .

wont:WONT_0000076 a owl:Class ;
    rdfs:label "Compress debridement plan specification"@en ;
    ns1:IAO_0000115 "A mechanical debridement plan specification that prescribes removing necrotic tissue, slough and debris from the wound bed by wiping or lifting them off with compresses."@en ;
    ns1:IAO_0000118 "Compress debridement"@en ;
    rdfs:subClassOf wont:WONT_0000189 .

wont:WONT_0000077 a owl:Class ;
    rdfs:label "Compression therapy plan specification"@en ;
    ns1:IAO_0000115 "A wound treatment plan specification that prescribes applying sustained external pressure to the wound-bearing limb or body part by means of bandages, garments or devices."@en ;
    ns1:IAO_0000118 "Compression therapy"@en ;
    rdfs:subClassOf wont:WONT_0000200 .

wont:WONT_0000078 a owl:Class ;
    rdfs:label "Contaminated wound" ;
    ns1:IAO_0000115 "A wound with recognized microbial burden that bears the quality contaminated."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000481 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000086 ;
                        owl:someValuesFrom wont:WONT_0000479 ] ) ] .

wont:WONT_0000079 a owl:Class ;
    rdfs:label "Continuous suture" ;
    ns1:IAO_0000115 "A suture in situ in which a single uninterrupted strand of suture material passes repeatedly through the tissue along the wound and is knotted only at its two ends."@en ;
    rdfs:subClassOf wont:WONT_0000301 .

wont:WONT_0000082 a owl:Class ;
    rdfs:label "CUSA(r) assisted debridement" ;
    ns1:IAO_0000115 "An ultrasound-assisted wound debridement process that uses an ultrasonic surgical aspirator, which fragments tissue by ultrasonic vibration while simultaneously irrigating the site and aspirating the fragments."@en ;
    rdfs:subClassOf wont:WONT_0000350 .

wont:WONT_0000091 a owl:Class ;
    rdfs:label "Dog bite wound" ;
    ns1:IAO_0000115 "A bite wound that was inflicted by the teeth of a dog."@en ;
    rdfs:subClassOf wont:WONT_0000044 .

wont:WONT_0000092 a owl:Class ;
    rdfs:label "Doppler sonographic diagnostic process"@en ;
    ns1:IAO_0000115 "A wound diagnostic process that uses ultrasound and the frequency shift of waves reflected from moving blood to assess blood flow in the vessels supplying the wound region."@en ;
    rdfs:subClassOf wont:WONT_0000395 .

wont:WONT_0000094 a owl:Class ;
    rdfs:label "Dressing change plan specification"@en ;
    ns1:IAO_0000115 "A wound treatment plan specification that prescribes removing the wound dressing currently applied to a wound and applying a new one."@en ;
    ns1:IAO_0000118 "Dressing change"@en ;
    rdfs:subClassOf wont:WONT_0000200 .

wont:WONT_0000095 a owl:Class ;
    rdfs:label "Dry necrosis" ;
    ns1:IAO_0000115 "A necrotic material that has lost its water content and is firm to hard in consistency."@en ;
    rdfs:subClassOf wont:WONT_120020 .

wont:WONT_0000096 a owl:Class ;
    rdfs:label "Easy-Flow drain" ;
    ns1:IAO_0000115 "A capillary drain consisting of a flat, flexible tube with longitudinal internal grooves along which wound fluid flows passively out of the wound."@en ;
    rdfs:subClassOf wont:WONT_0000058 .

wont:WONT_0000097 a owl:Class ;
    rdfs:label "Elastic bandage" ;
    ns1:IAO_0000115 "A fixing bandage made of a material that can be stretched lengthwise and returns to its original length when released."@en ;
    rdfs:subClassOf wont:WONT_0000112 .

wont:WONT_0000098 a owl:Class ;
    rdfs:label "Enzymatic wound debridement process" ;
    ns1:IAO_0000115 "A debridement process in which necrotic tissue and slough are broken down and removed by topically applied proteolytic enzymes."@en ;
    rdfs:subClassOf wont:WONT_0000084 .

wont:WONT_0000101 a owl:Class ;
    rdfs:label "Epithelializing wound bed" ;
    ns1:IAO_0000115 "A wound base that bears the quality epithelialized."@en ;
    rdfs:subClassOf wont:WONT_0000382 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000382 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000086 ;
                        owl:someValuesFrom wont:WONT_0000463 ] ) ] .

wont:WONT_0000106 a owl:Class ;
    rdfs:label "Exudation process"@en ;
    ns1:IAO_0000115 "A wound healing related physiological process in which fluid containing plasma proteins and cells passes from blood vessels into the wound tissue and onto the wound surface."@en ;
    rdfs:subClassOf wont:WONT_0000409 .

wont:WONT_0000107 a owl:Class ;
    rdfs:label "Fat gauze" ;
    ns1:IAO_0000115 "A wound dressing consisting of a wide-meshed gauze impregnated with a fatty or ointment-based substance that reduces its adherence to the wound surface."@en ;
    rdfs:subClassOf wont:WONT_0000398 .

wont:WONT_0000108 a owl:Class ;
    rdfs:label "Fibrin coating of the wound"@en ;
    ns1:IAO_0000115 "A material entity consisting of a layer of fibrin, formed from fibrinogen in wound exudate, that adheres to the surface of a wound bed."@en ;
    rdfs:subClassOf ns1:BFO_0000040 .

wont:WONT_0000109 a owl:Class ;
    rdfs:label "Fibrin-covered wound bed" ;
    ns1:IAO_0000115 "A wound base that bears the quality fibrin-covered."@en ;
    rdfs:subClassOf wont:WONT_0000382 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000382 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000086 ;
                        owl:someValuesFrom wont:WONT_0000462 ] ) ] .

wont:WONT_0000110 a owl:Class ;
    rdfs:label "fistula"@en ;
    ns1:IAO_0000115 "A material disease entity that is an abnormal tract connecting two hollow organs, body cavities or vessels, or connecting one of these with the body surface."@en ;
    rdfs:subClassOf mild:MILD_120020 .

wont:WONT_0000111 a owl:Class ;
    rdfs:label "Fixed drug exanthema" ;
    ns1:IAO_0000115 "A material disease entity consisting of one or more sharply demarcated inflammatory lesions of the skin or mucosa that are the output of a hypersensitivity reaction to a drug and recur at the same sites each time the patient is re-exposed to that drug."@en ;
    ns1:IAO_0000116 "Recategorised when the causal-role groupings 'Medical condition contributing to wound formation' / 'affecting wound healing' / 'contributing to blistering wounds' were dissolved. Those classes grouped entities by what they were said to cause, which this ontology does not assert, and they mixed material disorders with dispositions and processes. Relevance to wounds is now carried by co-location axioms on the wound classes instead of by membership in a causal class."@en ;
    rdfs:subClassOf mild:MILD_120020 .

wont:WONT_0000113 a owl:Class ;
    rdfs:label "Flaminal" ;
    ns1:IAO_0000115 "A wound gel/ointment/cream that is an alginate hydrogel containing the enzymes glucose oxidase and lactoperoxidase."@en ;
    rdfs:subClassOf wont:WONT_0000406 .

wont:WONT_0000114 a owl:Class ;
    rdfs:label "Flap plasty plan specification"@en ;
    ns1:IAO_0000115 "A wound treatment plan specification that prescribes closing or covering a wound by moving tissue from a donor site to the wound together with its own blood supply."@en ;
    ns1:IAO_0000118 "Flap plasty"@en ;
    rdfs:subClassOf wont:WONT_0000200 .

wont:WONT_0000115 a owl:Class ;
    rdfs:label "Fournier's gangrene" ;
    ns1:IAO_0000115 "A material disease entity that is a necrotizing infection of the fascia and soft tissues of the perineal, genital or perianal region."@en ;
    rdfs:subClassOf mild:MILD_120020 ;
    skos:relatedMatch ns1:DOID_9602 .

wont:WONT_0000116 a owl:Class ;
    rdfs:label "Friction bubble" ;
    ns1:IAO_0000115 "A material disease entity that is a fluid-filled cleft within the epidermis formed by repeated frictional shear forces acting on the skin."@en ;
    ns1:IAO_0000116 "Recategorised when the causal-role groupings 'Medical condition contributing to wound formation' / 'affecting wound healing' / 'contributing to blistering wounds' were dissolved. Those classes grouped entities by what they were said to cause, which this ontology does not assert, and they mixed material disorders with dispositions and processes. Relevance to wounds is now carried by co-location axioms on the wound classes instead of by membership in a causal class."@en ;
    rdfs:subClassOf mild:MILD_120020 .

wont:WONT_0000117 a owl:Class ;
    rdfs:label "Full-thickness skin graft" ;
    ns1:IAO_0000115 "A skin graft that consists of the entire epidermis and the entire dermis of the donor site."@en ;
    rdfs:subClassOf wont:WONT_0000285 .

wont:WONT_0000120 a owl:Class ;
    rdfs:label "Gauze bandage" ;
    ns1:IAO_0000115 "A fixing bandage that is a roll of thin, loosely woven or knitted fabric with an open mesh."@en ;
    rdfs:subClassOf wont:WONT_0000112 .

wont:WONT_0000121 a owl:Class ;
    rdfs:label "Germ spectrum assessment process"@en ;
    ns1:IAO_0000115 "A wound diagnostic process that has as specified output a datum identifying the microorganisms present in a sample of wound material."@en ;
    rdfs:subClassOf wont:WONT_0000395 .

wont:WONT_0000131 a owl:Class ;
    rdfs:label "Granulating wound bed" ;
    ns1:IAO_0000115 "A wound base that bears the quality granulating."@en ;
    rdfs:subClassOf wont:WONT_0000382 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000382 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000086 ;
                        owl:someValuesFrom wont:WONT_0000460 ] ) ] .

wont:WONT_0000134 a owl:Class ;
    rdfs:label "Gustilo and Anderson wound classification" ;
    ns1:IAO_0000115 "A wound classification scale that stratifies the wounds of open fractures by wound size, extent of soft-tissue damage, degree of contamination and presence of arterial injury requiring repair."@en ;
    rdfs:subClassOf wont:WONT_0000066 .

wont:WONT_0000138 a owl:Class ;
    rdfs:label "Hand disinfection plan specification"@en ;
    ns1:IAO_0000118 "Hand disinfection"@en ;
    rdfs:subClassOf wont:WONT_0000029 .

wont:WONT_0000141 a owl:Class ;
    rdfs:label "Hematoma" ;
    ns1:IAO_0000115 "A material disease entity consisting of a localized accumulation of blood that has escaped from blood vessels into a tissue, an organ or a body space."@en ;
    rdfs:subClassOf mild:MILD_120020 .

wont:WONT_0000146 a owl:Class ;
    rdfs:label "Histopathological examination process of wound material"@en ;
    ns1:IAO_0000115 "A wound diagnostic process in which tissue taken from a wound is fixed, sectioned, stained and examined microscopically to determine its cellular and structural characteristics."@en ;
    rdfs:subClassOf wont:WONT_0000395 .

wont:WONT_0000147 a owl:Class ;
    rdfs:label "Horizontal mattress suture" ;
    ns1:IAO_0000115 "A suture in situ in which each stitch crosses the wound twice, entering and leaving the skin on both sides of the wound, so that the exposed thread segments lie parallel to the wound edge and the knot lies on one side of the wound."@en ;
    rdfs:subClassOf wont:WONT_0000301 .

wont:WONT_0000148 a owl:Class ;
    rdfs:label "Human bite wound" ;
    ns1:IAO_0000115 "A bite wound inflicted by the teeth of a human."@en ;
    rdfs:subClassOf wont:WONT_0000044 .

wont:WONT_0000149 a owl:Class ;
    rdfs:label "Hydrocolloid containing wound dressing" ;
    ns1:IAO_0000115 "A wound dressing that has as part a hydrocolloid, a hydrophilic colloidal material held in an adhesive matrix that forms a gel on contact with wound exudate."@en ;
    rdfs:subClassOf wont:WONT_0000398 .

wont:WONT_0000150 a owl:Class ;
    rdfs:label "Hydrofiber-containing wound dressing" ;
    ns1:IAO_0000115 "A wound dressing that has as part a hydrofiber, a nonwoven layer of gelling carboxymethylcellulose fibres that absorb wound exudate and turn into a cohesive gel."@en ;
    rdfs:subClassOf wont:WONT_0000398 .

wont:WONT_0000151 a owl:Class ;
    rdfs:label "Hydrogel containing wound dressing" ;
    ns1:IAO_0000115 "A wound dressing that has as part a hydrogel, a cross-linked network of hydrophilic polymers with a high water content."@en ;
    rdfs:subClassOf wont:WONT_0000398 .

wont:WONT_0000152 a owl:Class ;
    rdfs:label "Hyperbaric O2 wound therapy plan specification"@en ;
    ns1:IAO_0000115 "A wound treatment plan specification that prescribes that the patient breathe oxygen while inside a chamber pressurized above atmospheric pressure."@en ;
    ns1:IAO_0000118 "Hyperbaric O2 wound therapy"@en ;
    rdfs:subClassOf wont:WONT_0000200 .

wont:WONT_0000153 a owl:Class ;
    rdfs:label "Hypergranulation" ;
    ns1:IAO_0000115 "A material disease entity consisting of granulation tissue in a wound bed that has proliferated above the level of the surrounding skin surface."@en ;
    rdfs:subClassOf mild:MILD_120020 .

wont:WONT_0000161 a owl:Class ;
    rdfs:label "Immunosuppression" ;
    ns1:IAO_0000115 "A disease predisposition that inheres in a patient whose immune response is weaker than normal, whether through a disorder of the immune system or through drugs given to suppress it."@en ;
    ns1:IAO_0000116 "Recategorised when the causal-role groupings 'Medical condition contributing to wound formation' / 'affecting wound healing' / 'contributing to blistering wounds' were dissolved. Those classes grouped entities by what they were said to cause, which this ontology does not assert, and they mixed material disorders with dispositions and processes. Relevance to wounds is now carried by co-location axioms on the wound classes instead of by membership in a causal class."@en ;
    rdfs:subClassOf mild:MILD_120023 .

wont:WONT_0000162 a owl:Class ;
    rdfs:label "Incision foil" ;
    ns1:IAO_0000115 "A material entity that is an adhesive polymer film applied to the skin over a surgical site, through which the surgical incision is made."@en ;
    rdfs:subClassOf ns1:BFO_0000040 .

wont:WONT_0000163 a owl:Class ;
    rdfs:label "Infected wound" ;
    ns1:IAO_0000115 "A wound that participates in a wound infection process."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000056 ;
            owl:someValuesFrom wont:WONT_0000410 ] ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000481 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000086 ;
                        owl:someValuesFrom wont:WONT_0000480 ] ) ] .

wont:WONT_0000165 a owl:Class ;
    rdfs:label "Intact wound margin" ;
    ns1:IAO_0000115 "A wound edge whose skin is continuous and shows no maceration, erosion, inflammation or other damage."@en ;
    rdfs:subClassOf wont:WONT_0000401 .

wont:WONT_0000166 a owl:Class ;
    rdfs:label "Intracutaneous suture" ;
    ns1:IAO_0000115 "A suture in situ that runs within the dermis along the wound edges and, between its ends, does not pass through the epidermal surface."@en ;
    rdfs:subClassOf wont:WONT_0000301 .

wont:WONT_0000168 a owl:Class ;
    rdfs:label "Iodine ointment" ;
    ns1:IAO_0000115 "A wound gel/ointment/cream that is an ointment with iodine or an iodine-releasing compound as its active ingredient."@en ;
    rdfs:subClassOf wont:WONT_0000406 .

wont:WONT_0000170 a owl:Class ;
    rdfs:label "Jackson-Pratt drain" ;
    ns1:IAO_0000115 "A low-vacuum drain consisting of a perforated flexible tube connected to a compressible bulb reservoir whose re-expansion after manual compression produces the suction."@en ;
    rdfs:subClassOf wont:WONT_0000177 .

wont:WONT_0000171 a owl:Class ;
    rdfs:label "Keloid development process"@en ;
    ns1:IAO_0000115 "A pathological scarring process in which collagen is deposited beyond the margins of the original wound into the surrounding skin, yielding a raised scar that extends past the wound boundaries."@en ;
    rdfs:subClassOf wont:WONT_0000269 .

wont:WONT_0000173 a owl:Class ;
    rdfs:label "Linear IgA dermatosis" ;
    ns1:IAO_0000115 "A material disease entity that has as parts one or more subepidermal blisters that are immune-mediated tissue disorders marked by linear deposits of IgA antibodies along the epidermal basement membrane zone."@en ;
    ns1:IAO_0000116 "Recategorised when the causal-role groupings 'Medical condition contributing to wound formation' / 'affecting wound healing' / 'contributing to blistering wounds' were dissolved. Those classes grouped entities by what they were said to cause, which this ontology does not assert, and they mixed material disorders with dispositions and processes. Relevance to wounds is now carried by co-location axioms on the wound classes instead of by membership in a causal class."@en ;
    rdfs:subClassOf mild:MILD_120020 .

wont:WONT_0000174 a owl:Class ;
    rdfs:label "Livedovasculopathy" ;
    ns1:IAO_0000115 "A material disease entity consisting of occlusive thrombi in small blood vessels of the dermis, without primary inflammation of the vessel walls."@en ;
    ns1:IAO_0000116 "Recategorised when the causal-role groupings 'Medical condition contributing to wound formation' / 'affecting wound healing' / 'contributing to blistering wounds' were dissolved. Those classes grouped entities by what they were said to cause, which this ontology does not assert, and they mixed material disorders with dispositions and processes. Relevance to wounds is now carried by co-location axioms on the wound classes instead of by membership in a causal class."@en ;
    rdfs:subClassOf mild:MILD_120020 .

wont:WONT_0000175 a owl:Class ;
    rdfs:label "Livider wound margin" ;
    ns1:IAO_0000115 "A wound edge that bears the quality livid."@en ;
    rdfs:subClassOf wont:WONT_0000401 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000401 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000086 ;
                        owl:someValuesFrom wont:WONT_0000457 ] ) ] .

wont:WONT_0000176 a owl:Class ;
    rdfs:label "Process of administering a local anesthetic agent"@en ;
    ns1:IAO_0000115 "A process of drug administration in which a material entity bearing a local anesthetic drug role participates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:BFO_0000040 [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000087 ;
                                owl:someValuesFrom wont:WONT_0000585 ] ) ] ],
        wont:WONT_0000579 .

wont:WONT_0000178 a owl:Class ;
    rdfs:label "Lymphatic fistula" ;
    ns1:IAO_0000115 "A material disease entity consisting of an abnormal passage that connects a lymphatic vessel or lymph node with the body surface or another anatomical structure and through which lymph leaks."@en ;
    rdfs:subClassOf mild:MILD_120020 .

wont:WONT_0000180 a owl:Class ;
    rdfs:label "Macerated wound edge" ;
    ns1:IAO_0000115 "A wound edge that bears the quality macerated."@en ;
    rdfs:subClassOf wont:WONT_0000401 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000401 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000086 ;
                        owl:someValuesFrom wont:WONT_0000435 ] ) ] .

wont:WONT_0000182 a owl:Class ;
    rdfs:label "Malignant wound" ;
    ns1:IAO_0000115 "A wound that is the specified output of a disorder development process that has as participant a malignancy."@en ;
    rdfs:subClassOf wont:WONT_0000380 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000380 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0002353 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( wont:WONT_0000414 [ a owl:Restriction ;
                                            owl:onProperty ns1:BFO_0000051 ;
                                            owl:someValuesFrom wont:WONT_0000515 ] ) ] ] ) ] .

wont:WONT_0000185 a owl:Class ;
    rdfs:label "Manuka honey" ;
    ns1:IAO_0000115 "A medicinal honey produced by bees from the nectar of the manuka tree, Leptospermum scoparium."@en ;
    rdfs:subClassOf wont:WONT_0000196 .

wont:WONT_0000186 a owl:Class ;
    rdfs:label "Marjolin ulcer" ;
    ns1:IAO_0000115 "A skin wound that is an ulcerated malignant neoplasm in scar tissue or in a long-standing chronic wound."@en ;
    rdfs:subClassOf wont:WONT_0000441 .

wont:WONT_0000201 a owl:Class ;
    rdfs:label "Microangiopathy" ;
    ns1:IAO_0000115 "An angiopathy in which the abnormal structure of the vessel wall or lumen affects small blood vessels, namely arterioles, capillaries or venules."@en ;
    ns1:IAO_0000116 "Recategorised when the causal-role groupings 'Medical condition contributing to wound formation' / 'affecting wound healing' / 'contributing to blistering wounds' were dissolved. Those classes grouped entities by what they were said to cause, which this ontology does not assert, and they mixed material disorders with dispositions and processes. Relevance to wounds is now carried by co-location axioms on the wound classes instead of by membership in a causal class."@en ;
    rdfs:subClassOf wont:WONT_0000466 .

wont:WONT_0000202 a owl:Class ;
    rdfs:label "Microbial analysis of the wound swab for wound pathogens" ;
    ns1:IAO_0000115 "A diagnostic process to assess wound characteristics in which a specimen collected from the wound with a swab is examined in a laboratory to detect and identify microorganisms that participate in wound infection."@en ;
    rdfs:subClassOf wont:WONT_0000089 .

wont:WONT_0000203 a owl:Class ;
    rdfs:label "Moist necrosis" ;
    ns1:IAO_0000115 "A necrotic material that has a high water content and a soft, wet consistency, in contrast to dry, hardened necrotic tissue such as eschar."@en ;
    rdfs:subClassOf wont:WONT_120020 .

wont:WONT_0000204 a owl:Class ;
    rdfs:label "Monaldi drain" ;
    ns1:IAO_0000115 "A thoracic drain that is inserted through the anterior chest wall at the second intercostal space in the midclavicular line."@en ;
    rdfs:subClassOf wont:WONT_0000311 .

wont:WONT_0000205 a owl:Class ;
    rdfs:label "Monofilament thread material" ;
    ns1:IAO_0000115 "A material entity that is suture thread consisting of a single strand, rather than of several filaments braided or twisted together."@en ;
    rdfs:subClassOf ns1:BFO_0000040 .

wont:WONT_0000207 a owl:Class ;
    rdfs:label "n-propanol" ;
    ns1:IAO_0000115 "An antiseptic alcohol that consists of propan-1-ol, the unbranched primary alcohol with three carbon atoms."@en ;
    rdfs:subClassOf wont:WONT_0000010 .

wont:WONT_0000208 a owl:Class ;
    rdfs:label "NaCl 0.9%" ;
    ns1:IAO_0000115 "A wound irrigation solution that is an aqueous solution of sodium chloride at a concentration of 0.9% (w/v), isotonic with body fluids."@en ;
    rdfs:subClassOf wont:WONT_0000412 .

wont:WONT_0000209 a owl:Class ;
    rdfs:label "NaCl 10%" ;
    ns1:IAO_0000115 "A wound irrigation solution that is an aqueous solution of sodium chloride at a concentration of 10% (w/v), hypertonic relative to body fluids."@en ;
    rdfs:subClassOf wont:WONT_0000412 .

wont:WONT_0000211 a owl:Class ;
    rdfs:label "Necrotic wound bed" ;
    ns1:IAO_0000115 "A wound base that bears the quality necrotic."@en ;
    rdfs:subClassOf wont:WONT_0000382 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000382 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000086 ;
                        owl:someValuesFrom wont:WONT_0000461 ] ) ] .

wont:WONT_0000213 a owl:Class ;
    rdfs:label "Negative pressure wound therapy plan specification"@en ;
    ns1:IAO_0000115 "A wound treatment plan specification that prescribes the application of sub-atmospheric pressure to the wound bed through an airtight dressing connected to a suction source."@en ;
    ns1:IAO_0000118 "Negative pressure wound therapy"@en ;
    rdfs:subClassOf wont:WONT_0000200 .

wont:WONT_0000215 a owl:Class ;
    rdfs:label "Non-absorbable thread material" ;
    ns1:IAO_0000115 "A material entity that is suture thread which is not broken down and absorbed by the body's tissues and so persists in the tissue unless it is removed."@en ;
    rdfs:subClassOf ns1:BFO_0000040 .

wont:WONT_0000216 a owl:Class ;
    rdfs:label "Nutritional status improvement process"@en ;
    ns1:IAO_0000115 "A wound treatment process in which the dietary or supplementary nutrient intake of a patient who has a wound is changed with the aim of correcting a deficiency or imbalance of nutrients in the patient's body."@en ;
    rdfs:subClassOf wont:WONT_0000423 .

wont:WONT_0000220 a owl:Class ;
    rdfs:label "Octenidine gel" ;
    ns1:IAO_0000115 "A wound gel/ointment/cream that has a gel consistency and contains octenidine dihydrochloride as its antiseptic active substance."@en ;
    rdfs:subClassOf wont:WONT_0000406 .

wont:WONT_0000221 a owl:Class ;
    rdfs:label "Open drain" ;
    ns1:IAO_0000115 "A drain that discharges fluid from a wound or body cavity into an absorbent dressing or the surroundings rather than into a sealed collection container."@en ;
    rdfs:subClassOf wont:WONT_0000093 .

wont:WONT_0000222 a owl:Class ;
    rdfs:label "Pain management plan specification"@en ;
    ns1:IAO_0000115 "A medical condition treatment plan specification that prescribes pharmacological or non-pharmacological measures to prevent or reduce pain experienced by the patient."@en ;
    ns1:IAO_0000118 "Pain management"@en ;
    rdfs:subClassOf mild:MILD_120099 .

wont:WONT_0000225 a owl:Class ;
    rdfs:label "Patient education plan specification"@en ;
    ns1:IAO_0000115 "A wound treatment plan specification that prescribes instructing the patient, and where applicable the patient's caregivers, about the wound, its care and the behaviours the patient is to carry out or avoid during treatment."@en ;
    ns1:IAO_0000118 "Patient education"@en ;
    rdfs:subClassOf wont:WONT_0000200 .

wont:WONT_0000227 a owl:Class ;
    rdfs:label "Penrose drain" ;
    ns1:IAO_0000115 "A capillary drain consisting of a soft, collapsible, thin-walled open tube that is placed in a wound and conducts fluid out along its inner and outer surfaces without applied suction."@en ;
    rdfs:subClassOf wont:WONT_0000058 .

wont:WONT_0000228 a owl:Class ;
    rdfs:label "Perioperative antimicrobial prophylaxis plan specification"@en ;
    ns1:IAO_0000115 "A prophylaxis plan specification that prescribes the administration of one or more antimicrobial agents to a patient in the period immediately before, during or after a surgical procedure, with the objective of preventing surgical site infection."@en ;
    ns1:IAO_0000118 "Perioperative antimicrobial prophylaxis"@en ;
    rdfs:subClassOf mild:MILD_120100 .

wont:WONT_0000233 a owl:Class ;
    rdfs:label "Phlegmon" ;
    ns1:IAO_0000115 "A material disease entity consisting in a purulent inflammation of soft connective tissue that spreads diffusely through the tissue and is not confined by a capsule."@en ;
    rdfs:subClassOf mild:MILD_120020 .

wont:WONT_0000235 a owl:Class ;
    rdfs:label "Pigtail catheter" ;
    ns1:IAO_0000115 "A passive drain consisting of a thin flexible catheter whose distal end curls into a loop once placed, holding the catheter in position, and that has side holes in the looped segment through which fluid enters."@en ;
    rdfs:subClassOf wont:WONT_0000224 .

wont:WONT_0000236 a owl:Class ;
    rdfs:label "Planimetry" ;
    rdfs:subClassOf wont:WONT_0000419 .

wont:WONT_0000237 a owl:Class ;
    rdfs:label "Plaster" ;
    ns1:IAO_0000115 "A fixing bandage consisting of a flexible backing strip coated on one side with a pressure-sensitive adhesive, that holds a dressing or device in place by adhering to the skin."@en ;
    rdfs:subClassOf wont:WONT_0000112 .

wont:WONT_0000238 a owl:Class ;
    rdfs:label "Polihexanide" ;
    ns1:IAO_0000115 "A biguanide that is a polymer whose repeating unit consists of a biguanide group linked to a hexamethylene chain."@en ;
    rdfs:subClassOf ns1:CHEBI_3095 .

wont:WONT_0000239 a owl:Class ;
    rdfs:label "Polihexanide containing solution" ;
    ns1:IAO_0000115 "An antiseptic solution that has polihexanide as an active antiseptic ingredient."@en ;
    rdfs:subClassOf wont:WONT_0000026 .

wont:WONT_0000240 a owl:Class ;
    rdfs:label "Polihexanide gel" ;
    ns1:IAO_0000115 "A wound gel/ointment/cream that has a semi-solid, water-based gel consistency and contains polihexanide as an active antiseptic ingredient."@en ;
    rdfs:subClassOf wont:WONT_0000406 .

wont:WONT_0000241 a owl:Class ;
    rdfs:label "Polyfilament thread material" ;
    ns1:IAO_0000115 "A material entity consisting of surgical suture thread in which each strand is made of multiple filaments braided or twisted together."@en ;
    rdfs:subClassOf ns1:BFO_0000040 .

wont:WONT_0000243 a owl:Class ;
    rdfs:label "Postoperative wound control process"@en ;
    ns1:IAO_0000115 "A wound diagnostic process in which a surgical wound is inspected and assessed after the operation that created it, to monitor its healing and to detect wound complications."@en ;
    rdfs:subClassOf wont:WONT_0000395 .

wont:WONT_0000247 a owl:Class ;
    rdfs:label "Primarily-healing wound" ;
    ns1:IAO_0000115 "A wound that participates in a wound healing by primary intention."@en ;
    rdfs:subClassOf wont:WONT_0000380 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000380 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000056 ;
                        owl:someValuesFrom wont:WONT_0000248 ] ) ] .

wont:WONT_0000253 a owl:Class ;
    rdfs:label "Purulent exudate" ;
    ns1:IAO_0000115 "A wound exudate that is opaque and viscous and consists predominantly of neutrophils, cellular debris and liquefied necrotic tissue."@en ;
    rdfs:subClassOf wont:WONT_0000404 .

wont:WONT_0000256 a owl:Class ;
    rdfs:label "Reddened wound edge" ;
    ns1:IAO_0000115 "A wound edge that bears the quality reddened."@en ;
    rdfs:subClassOf wont:WONT_0000401 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000401 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000086 ;
                        owl:someValuesFrom wont:WONT_0000456 ] ) ] .

wont:WONT_0000257 a owl:Class ;
    rdfs:label "Redness" ;
    rdfs:subClassOf ns1:PATO_0000014 .

wont:WONT_0000258 a owl:Class ;
    rdfs:label "Redon drain" ;
    ns1:IAO_0000115 "A high-vacuum drain consisting of a perforated plastic tube placed in a wound and connected to a closed collecting bottle that is evacuated before use, so that the negative pressure in the bottle draws fluid out of the wound."@en ;
    rdfs:subClassOf wont:WONT_0000145 .

wont:WONT_0000261 a owl:Class ;
    rdfs:label "Regeneratively-healing wound" ;
    ns1:IAO_0000115 "A wound that participates in a regenerative wound healing."@en ;
    rdfs:subClassOf wont:WONT_0000380 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000380 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000056 ;
                        owl:someValuesFrom wont:WONT_0000260 ] ) ] .

wont:WONT_0000263 a owl:Class ;
    rdfs:label "Tissue repair process"@en ;
    ns1:IAO_0000115 "A wound healing related physiological process in which damaged or lost tissue is replaced by newly formed tissue, by regeneration, by scar formation or both, so that the continuity of the injured tissue is restored."@en ;
    rdfs:subClassOf wont:WONT_0000409 .

wont:WONT_0000265 a owl:Class ;
    rdfs:label "Resorbable thread material" ;
    ns1:IAO_0000115 "A material entity consisting of surgical suture thread made of a material that, after implantation, is degraded by hydrolysis or enzymatic action in the body and absorbed, so that it does not have to be removed."@en ;
    rdfs:subClassOf ns1:BFO_0000040 .

wont:WONT_0000266 a owl:Class ;
    rdfs:label "Ringer solution" ;
    ns1:IAO_0000115 "A wound irrigation solution consisting of sodium chloride, potassium chloride and calcium chloride dissolved in water, isotonic with blood plasma."@en ;
    rdfs:subClassOf wont:WONT_0000412 .

wont:WONT_0000267 a owl:Class ;
    rdfs:label "Robinson drain" ;
    ns1:IAO_0000115 "A gravity drain that is a closed passive system consisting of a soft perforated tube leading from the wound or body cavity into a sealed collection bag."@en ;
    rdfs:subClassOf wont:WONT_0000133 .

wont:WONT_0000268 a owl:Class ;
    rdfs:label "Sanguine exudate" ;
    ns1:IAO_0000115 "A wound exudate that consists predominantly of fresh blood and is thin and red."@en ;
    rdfs:subClassOf wont:WONT_0000404 .

wont:WONT_0000271 a owl:Class ;
    rdfs:label "Scratch wound" ;
    ns1:IAO_0000115 "A traumatic wound that is a superficial linear disruption of the skin and the output of a process in which a sharp or rough object is drawn across the skin surface."@en ;
    rdfs:subClassOf wont:WONT_0000339 .

wont:WONT_0000272 a owl:Class ;
    rdfs:label "Secondarily-healing wound" ;
    ns1:IAO_0000115 "A wound that participates in a wound healing by secondary intention."@en ;
    rdfs:subClassOf wont:WONT_0000380 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000380 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000056 ;
                        owl:someValuesFrom wont:WONT_0000274 ] ) ] .

wont:WONT_0000273 a owl:Class ;
    rdfs:label "Secondary dressing" ;
    ns1:IAO_0000115 "A wound dressing that is placed over a primary dressing and does not itself contact the wound bed."@en ;
    rdfs:subClassOf wont:WONT_0000398 .

wont:WONT_0000275 a owl:Class ;
    rdfs:label "Semi-open drain" ;
    ns1:IAO_0000115 "A drain consisting of a tube that leads fluid out of the wound into a dressing or an unsealed receptacle, so that the drainage pathway remains open to the environment."@en ;
    rdfs:subClassOf wont:WONT_0000093 .

wont:WONT_0000276 a owl:Class ;
    rdfs:label "Seroma" ;
    ns1:IAO_0000115 "A material disease entity that is a collection of serous fluid accumulated in a tissue space or surgically created dead space, consisting of neither pus nor blood."@en ;
    rdfs:subClassOf mild:MILD_120020 .

wont:WONT_0000277 a owl:Class ;
    rdfs:label "Serosanguineous exudate" ;
    ns1:IAO_0000115 "A wound exudate that is thin, watery and pale red to pink, consisting of serous fluid mixed with a small amount of blood."@en ;
    rdfs:subClassOf wont:WONT_0000404 .

wont:WONT_0000278 a owl:Class ;
    rdfs:label "Serous exudate" ;
    ns1:IAO_0000115 "A wound exudate that is thin, watery and clear to pale yellow, consisting of plasma-derived fluid without appreciable blood or pus."@en ;
    rdfs:subClassOf wont:WONT_0000404 .

wont:WONT_0000279 a owl:Class ;
    rdfs:label "Shea classification of pressure ulcers" ;
    ns1:IAO_0000115 "A wound classification scale that grades pressure ulcers according to Shea by the deepest tissue layer involved, from the epidermis and dermis through subcutaneous fat and deep fascia to bone."@en ;
    rdfs:subClassOf wont:WONT_0000066 .

wont:WONT_0000282 a owl:Class ;
    rdfs:label "Silver-containing wound dressing" ;
    ns1:IAO_0000115 "A wound dressing that has silver, in elemental, ionic or compound form, incorporated as a component bearing an antimicrobial agent role."@en ;
    rdfs:subClassOf wont:WONT_0000398 .

wont:WONT_0000283 a owl:Class ;
    rdfs:label "Simple interrupted suture" ;
    ns1:IAO_0000115 "A suture in situ consisting of a single stitch that passes through both wound edges and is knotted and cut separately from any adjacent stitch."@en ;
    rdfs:subClassOf wont:WONT_0000301 .

wont:WONT_0000284 a owl:Class ;
    rdfs:label "Skin color assessment process"@en ;
    ns1:IAO_0000115 "A wound diagnostic process in which the hue of the skin in and around the wound is inspected and that has as specified output a datum about that hue."@en ;
    rdfs:subClassOf wont:WONT_0000395 .

wont:WONT_0000286 a owl:Class ;
    rdfs:label "Skin grafting plan specification"@en ;
    ns1:IAO_0000115 "A wound treatment plan specification that prescribes harvesting a skin graft from a donor site and fixing it onto the wound bed as the recipient site."@en ;
    ns1:IAO_0000118 "Skin grafting"@en ;
    rdfs:subClassOf wont:WONT_0000200 .

wont:WONT_0000287 a owl:Class ;
    rdfs:label "Skin stapling plan specification"@en ;
    ns1:IAO_0000115 "A wound closure technique plan specification that prescribes approximating the skin edges of a wound with metal staples inserted by a stapling device."@en ;
    ns1:IAO_0000118 "Skin stapling"@en ;
    rdfs:subClassOf wont:WONT_0000389 .

wont:WONT_0000289 a owl:Class ;
    rdfs:label "Smoking" ;
    ns1:IAO_0000115 "A process in which a person inhales and exhales the smoke produced by burning tobacco or another plant material."@en ;
    ns1:IAO_0000116 "Recategorised when the causal-role groupings 'Medical condition contributing to wound formation' / 'affecting wound healing' / 'contributing to blistering wounds' were dissolved. Those classes grouped entities by what they were said to cause, which this ontology does not assert, and they mixed material disorders with dispositions and processes. Relevance to wounds is now carried by co-location axioms on the wound classes instead of by membership in a causal class."@en ;
    rdfs:subClassOf ns1:BFO_0000015 .

wont:WONT_0000290 a owl:Class ;
    rdfs:label "Softened wound edge" ;
    ns1:IAO_0000115 "A wound edge that bears the quality softened."@en ;
    rdfs:subClassOf wont:WONT_0000401 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000401 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000086 ;
                        owl:someValuesFrom wont:WONT_0000458 ] ) ] .

wont:WONT_0000291 a owl:Class ;
    rdfs:label "Wound odor assessment process"@en ;
    ns1:IAO_0000115 "A wound diagnostic process that examines the presence, intensity and character of the odor emanating from a wound and has as specified output a datum about that wound odor."@en ;
    rdfs:subClassOf wont:WONT_0000395 .

wont:WONT_0000292 a owl:Class ;
    rdfs:label "Split-thickness skin graft" ;
    ns1:IAO_0000115 "A skin graft that consists of the epidermis together with only part of the thickness of the underlying dermis of the donor site."@en ;
    rdfs:subClassOf wont:WONT_0000285 .

wont:WONT_0000297 a owl:Class ;
    rdfs:label "Surface disinfection plan specification"@en ;
    ns1:IAO_0000118 "Surface disinfection"@en ;
    rdfs:subClassOf wont:WONT_0000029 .

wont:WONT_0000298 a owl:Class ;
    rdfs:label "Surgical treatment process"@en ;
    ns1:IAO_0000115 "A disease disorder treatment process in which the disease or disorder is treated by an operative manual and instrumental intervention on the patient's body, such as incision, excision, manipulation or repair of tissue."@en ;
    rdfs:subClassOf mild:MILD_120086 .

wont:WONT_0000299 a owl:Class ;
    rdfs:label "Surgical wound debridement process"@en ;
    ns1:IAO_0000115 "A debridement process in which necrotic, devitalized or infected tissue and foreign material are removed from a wound by sharp excision with surgical instruments."@en ;
    rdfs:subClassOf wont:WONT_0000084 .

wont:WONT_0000302 a owl:Class ;
    rdfs:label "Suturing plan specification"@en ;
    ns1:IAO_0000115 "A wound closure technique plan specification that prescribes approximating the wound edges by passing a needle with attached suture material through the tissue on both sides of the wound and securing the thread."@en ;
    ns1:IAO_0000118 "Suturing"@en ;
    rdfs:subClassOf wont:WONT_0000389 .

wont:WONT_0000304 a owl:Class ;
    rdfs:label "Synthetic wound dressing foam"@en ;
    ns1:IAO_0000115 "A wound dressing that consists of a porous, absorbent foam made of a synthetic polymer."@en ;
    rdfs:subClassOf wont:WONT_0000398 .

wont:WONT_0000305 a owl:Class ;
    rdfs:label "Systemic antibiotic therapy plan specification"@en ;
    ns1:IAO_0000115 "An antibiotic therapy plan specification that prescribes administering an antibiotic by an enteral or parenteral route so that it is distributed throughout the body via the bloodstream."@en ;
    ns1:IAO_0000118 "Systemic antibiotic therapy"@en ;
    rdfs:subClassOf wont:WONT_0000016 .

wont:WONT_0000306 a owl:Class ;
    rdfs:label "Taking a wound swab" ;
    ns1:IAO_0000115 "A diagnostic process to assess wound characteristics in which a swab is passed over the wound bed to collect a specimen of wound material for laboratory examination."@en ;
    rdfs:subClassOf wont:WONT_0000089 .

wont:WONT_0000307 a owl:Class ;
    rdfs:label "Tertiarily-healing wound" ;
    ns1:IAO_0000115 "A wound that participates in a wound healing by tertiary intention."@en ;
    rdfs:subClassOf wont:WONT_0000380 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000380 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000056 ;
                        owl:someValuesFrom wont:WONT_0000308 ] ) ] .

wont:WONT_0000316 a owl:Class ;
    rdfs:label "Thread size 0" ;
    ns1:IAO_0000115 "A thread size that corresponds to the suture size designation 0 of the United States Pharmacopeia scale, next larger than 2-0 and next smaller than 1."@en ;
    rdfs:subClassOf wont:WONT_0000315 .

wont:WONT_0000317 a owl:Class ;
    rdfs:label "Thread size 1" ;
    ns1:IAO_0000115 "A thread size that corresponds to the suture size designation 1 of the United States Pharmacopeia scale, next larger than 0 and next smaller than 2."@en ;
    rdfs:subClassOf wont:WONT_0000315 .

wont:WONT_0000318 a owl:Class ;
    rdfs:label "Thread size 1-0" ;
    rdfs:subClassOf wont:WONT_0000315 .

wont:WONT_0000319 a owl:Class ;
    rdfs:label "Thread size 10-0" ;
    ns1:IAO_0000115 "A thread size that corresponds to the suture size designation 10-0 of the United States Pharmacopeia scale, next smaller than 9-0 and next larger than 11-0."@en ;
    rdfs:subClassOf wont:WONT_0000315 .

wont:WONT_0000320 a owl:Class ;
    rdfs:label "Thread size 11-0" ;
    ns1:IAO_0000115 "A thread size that corresponds to the suture size designation 11-0 of the United States Pharmacopeia scale, next smaller than 10-0."@en ;
    rdfs:subClassOf wont:WONT_0000315 .

wont:WONT_0000321 a owl:Class ;
    rdfs:label "Thread size 12-0" ;
    ns1:IAO_0000115 "A thread size that is the suture size designation 12-0, one step finer than 11-0 on the suture size scale, on which sizes written n-0 become finer as n increases."@en ;
    rdfs:subClassOf wont:WONT_0000315 .

wont:WONT_0000322 a owl:Class ;
    rdfs:label "Thread size 13-0" ;
    ns1:IAO_0000115 "A thread size that is the suture size designation 13-0, one step finer than 12-0 on the suture size scale, on which sizes written n-0 become finer as n increases."@en ;
    rdfs:subClassOf wont:WONT_0000315 .

wont:WONT_0000323 a owl:Class ;
    rdfs:label "Thread size 2" ;
    ns1:IAO_0000115 "A thread size that is the suture size designation 2, one step coarser than 1 on the suture size scale, on which sizes written as whole numbers become coarser as the number increases."@en ;
    rdfs:subClassOf wont:WONT_0000315 .

wont:WONT_0000324 a owl:Class ;
    rdfs:label "Thread size 2-0" ;
    ns1:IAO_0000115 "A thread size that is the suture size designation 2-0, one step finer than 0 and one step coarser than 3-0 on the suture size scale."@en ;
    rdfs:subClassOf wont:WONT_0000315 .

wont:WONT_0000325 a owl:Class ;
    rdfs:label "Thread size 3" ;
    ns1:IAO_0000115 "A thread size that is the suture size designation 3, one step coarser than 2 on the suture size scale, on which sizes written as whole numbers become coarser as the number increases."@en ;
    rdfs:subClassOf wont:WONT_0000315 .

wont:WONT_0000326 a owl:Class ;
    rdfs:label "Thread size 3-0" ;
    ns1:IAO_0000115 "A thread size that is the suture size designation 3-0, one step finer than 2-0 and one step coarser than 4-0 on the suture size scale."@en ;
    rdfs:subClassOf wont:WONT_0000315 .

wont:WONT_0000327 a owl:Class ;
    rdfs:label "Thread size 4" ;
    ns1:IAO_0000115 "A thread size that is the suture size designation 4, one step coarser than 3 on the suture size scale, on which sizes written as whole numbers become coarser as the number increases."@en ;
    rdfs:subClassOf wont:WONT_0000315 .

wont:WONT_0000328 a owl:Class ;
    rdfs:label "Thread size 4-0" ;
    ns1:IAO_0000115 "A thread size that is the suture size designation 4-0, one step finer than 3-0 and one step coarser than 5-0 on the suture size scale."@en ;
    rdfs:subClassOf wont:WONT_0000315 .

wont:WONT_0000329 a owl:Class ;
    rdfs:label "Thread size 5" ;
    ns1:IAO_0000115 "A thread size that is the suture size designation 5, one step coarser than 4 on the suture size scale, on which sizes written as whole numbers become coarser as the number increases."@en ;
    rdfs:subClassOf wont:WONT_0000315 .

wont:WONT_0000330 a owl:Class ;
    rdfs:label "Thread size 5-0" ;
    ns1:IAO_0000115 "A thread size that is the suture size designation 5-0, one step finer than 4-0 and one step coarser than 6-0 on the suture size scale."@en ;
    rdfs:subClassOf wont:WONT_0000315 .

wont:WONT_0000331 a owl:Class ;
    rdfs:label "Thread size 6-0" ;
    ns1:IAO_0000115 "A thread size that is the suture size designation 6-0, one step finer than 5-0 and one step coarser than 7-0 on the suture size scale."@en ;
    rdfs:subClassOf wont:WONT_0000315 .

wont:WONT_0000332 a owl:Class ;
    rdfs:label "Thread size 7-0" ;
    ns1:IAO_0000115 "A thread size that is the suture size designation 7-0, one step finer than 6-0 and one step coarser than 8-0 on the suture size scale."@en ;
    rdfs:subClassOf wont:WONT_0000315 .

wont:WONT_0000333 a owl:Class ;
    rdfs:label "Thread size 8-0" ;
    ns1:IAO_0000115 "A thread size that is the suture size designation 8-0, one step finer than 7-0 and one step coarser than 9-0 on the suture size scale."@en ;
    rdfs:subClassOf wont:WONT_0000315 .

wont:WONT_0000334 a owl:Class ;
    rdfs:label "Thread size 9-0" ;
    ns1:IAO_0000115 "A thread size that is the suture size designation 9-0, one step finer than 8-0 and one step coarser than 10-0 on the suture size scale."@en ;
    rdfs:subClassOf wont:WONT_0000315 .

wont:WONT_0000335 a owl:Class ;
    rdfs:label "Topical antibiotic therapy plan specification"@en ;
    ns1:IAO_0000115 "An antibiotic therapy plan specification that prescribes applying an antibiotic agent directly onto the surface of the skin, a mucous membrane or a wound at the site to be treated rather than giving it systemically."@en ;
    ns1:IAO_0000118 "Topical antibiotic therapy"@en ;
    rdfs:subClassOf wont:WONT_0000016 .

wont:WONT_0000336 a owl:Class ;
    rdfs:label "trace element"@en ;
    ns1:IAO_0000115 "A material entity that bears the role nutrient."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000087 ;
            owl:someValuesFrom ns1:CHEBI_33284 ],
        ns1:BFO_0000040 .

wont:WONT_0000337 a owl:Class ;
    rdfs:label "Transparent polyurethane film" ;
    ns1:IAO_0000115 "A wound dressing that consists of a thin, transparent, semipermeable sheet of polyurethane through which the covered wound can be inspected."@en ;
    rdfs:subClassOf wont:WONT_0000398 .

wont:WONT_0000341 a owl:Class ;
    rdfs:label "Tscherne and Oestern wound classification" ;
    ns1:IAO_0000115 "A wound classification scale that grades the severity of the soft-tissue injury accompanying a closed or open fracture."@en ;
    rdfs:subClassOf wont:WONT_0000066 .

wont:WONT_0000344 a owl:Class ;
    rdfs:label "Tympanic drain" ;
    ns1:IAO_0000115 "A drain that is a small tube placed through an incision in the tympanic membrane so that the middle ear is ventilated and fluid can drain from it."@en ;
    rdfs:subClassOf wont:WONT_0000093 .

wont:WONT_0000346 a owl:Class ;
    rdfs:label "Ulcus cruris mixtum" ;
    ns1:IAO_0000115 "A skin wound that is an ulcer of the lower leg in a patient who has both chronic venous insufficiency and peripheral arterial disease, so that venous and arterial disorders together form its pathogenic background."@en ;
    rdfs:subClassOf wont:WONT_0000441 .

wont:WONT_0000347 a owl:Class ;
    rdfs:label "Ulcus cruris venosum" ;
    ns1:IAO_0000115 "A venous insufficiency wound that is an ulcer of the skin of the lower leg."@en ;
    ns1:IAO_0000118 "Venous leg ulcer"@en ;
    rdfs:subClassOf wont:WONT_0000384,
        wont:WONT_0000441 .

wont:WONT_0000348 a owl:Class ;
    rdfs:label "Ulcus hypertonicus Martorell" ;
    ns1:IAO_0000115 "A skin wound that is an ulcer of the lower leg at a site of ischemic necrosis of the skin, with stenosing arteriolosclerosis of subcutaneous arterioles, in a patient with arterial hypertension."@en ;
    rdfs:subClassOf wont:WONT_0000441 .

wont:WONT_0000351 a owl:Class ;
    rdfs:label "Undermined wound margin" ;
    ns1:IAO_0000115 "A wound edge that bears the quality undermined."@en ;
    rdfs:subClassOf wont:WONT_0000401 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000401 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000086 ;
                        owl:someValuesFrom wont:WONT_0000459 ] ) ] .

wont:WONT_0000352 a owl:Class ;
    rdfs:label "URGE scale" ;
    rdfs:subClassOf wont:WONT_0000066 .

wont:WONT_0000355 a owl:Class ;
    rdfs:label "Ventricular drain" ;
    ns1:IAO_0000115 "A drain that is inserted through the skull into a cerebral ventricle to conduct cerebrospinal fluid out of the ventricular system."@en ;
    rdfs:subClassOf wont:WONT_0000093 .

wont:WONT_0000356 a owl:Class ;
    rdfs:label "Vertical mattress suture" ;
    ns1:IAO_0000115 "A suture in situ in which each stitch crosses the wound twice in a plane perpendicular to the wound edge, with one deep pass placed far from the wound edge and one superficial pass placed near it, and is tied on the side where it entered."@en ;
    rdfs:subClassOf wont:WONT_0000301 .

wont:WONT_0000358 a owl:Class ;
    rdfs:label "Voltaren gel" ;
    rdfs:subClassOf wont:WONT_0000406 .

wont:WONT_0000375 a owl:Class ;
    rdfs:label "Wagner and Anderson wound classification" ;
    rdfs:subClassOf wont:WONT_0000066 .

wont:WONT_0000377 a owl:Class ;
    rdfs:label "Water-jet assisted wound debridement process"@en ;
    ns1:IAO_0000115 "A debridement process in which devitalized tissue and debris are cut away from a wound and removed by a high-velocity jet of sterile liquid."@en ;
    rdfs:subClassOf wont:WONT_0000084 .

wont:WONT_0000378 a owl:Class ;
    rdfs:label "Wearing sterile gloves plan specification"@en ;
    ns1:IAO_0000115 "An aseptic conditions plan specification that prescribes that persons coming into contact with a wound or sterile field cover their hands with gloves that are free of viable microorganisms."@en ;
    ns1:IAO_0000118 "Wearing Sterile gloves"@en ;
    rdfs:subClassOf wont:WONT_0000029 .

wont:WONT_0000379 a owl:Class ;
    rdfs:label "Wound dehiscence with suture insufficiency" ;
    ns1:IAO_0000115 "A wound dehiscence that is the output of a wound dehiscence process in which the sutures holding the wound edges together fail to keep them approximated."@en ;
    rdfs:subClassOf wont:WONT_0000392 .

wont:WONT_0000381 a owl:Class ;
    rdfs:label "Wound and soft tissue drain" ;
    ns1:IAO_0000115 "A drain that is placed in a wound or in soft tissue to conduct accumulated fluid out of it."@en ;
    rdfs:subClassOf wont:WONT_0000093 .

wont:WONT_0000383 a owl:Class ;
    rdfs:label "Wound biofilm" ;
    ns1:IAO_0000115 "A material entity that is a structured community of microorganisms embedded in a self-produced extracellular polymeric matrix and attached to the surface or tissue of a wound."@en ;
    rdfs:subClassOf ns1:BFO_0000040 .

wont:WONT_0000388 a owl:Class ;
    rdfs:label "Wound closure process"@en ;
    ns1:IAO_0000115 "A wound treatment process that brings the edges of a wound into apposition or covers the wound defect with tissue, so that the wound is no longer open."@en ;
    rdfs:subClassOf wont:WONT_0000423 .

wont:WONT_0000391 a owl:Class ;
    rdfs:label "Wound contraction process"@en ;
    ns1:IAO_0000115 "A wound healing related physiological process in which myofibroblasts in the granulation tissue draw the wound edges centripetally toward each other, reducing the area of the open wound."@en ;
    rdfs:subClassOf wont:WONT_0000409 .

wont:WONT_0000399 a owl:Class ;
    rdfs:label "Wound dressing composed of a polylactide membrane" ;
    ns1:IAO_0000115 "A wound-integrating wound dressing that consists of a membrane made of polylactide, a resorbable polymer of lactic acid."@en ;
    rdfs:subClassOf wont:WONT_0000427 .

wont:WONT_0000400 a owl:Class ;
    rdfs:label "Wound dressing composed of polyurethane foam" ;
    ns1:IAO_0000115 "A wound-integrating wound dressing that consists of a porous foam matrix made of polyurethane."@en ;
    rdfs:subClassOf wont:WONT_0000427 .

wont:WONT_0000402 a owl:Class ;
    rdfs:label "Wound edge protection process"@en ;
    ns1:IAO_0000115 "A wound treatment process in which the wound edge is shielded from agents and forces that would damage it, such as exudate or adhesive stripping."@en ;
    rdfs:subClassOf wont:WONT_0000423 .

wont:WONT_0000403 a owl:Class ;
    rdfs:label "Wound expert role"@en ;
    ns1:IAO_0000115 "A health care provider role that is borne by a person holding a specialised qualification in wound care and that is realized in the assessment and treatment of patients' wounds."@en ;
    rdfs:subClassOf ns1:OMRSE_00000012 .

wont:WONT_0000405 a owl:Class ;
    rdfs:label "Wound fabric adhesive plan specification"@en ;
    ns1:IAO_0000118 "Wound Fabric adhesive"@en ;
    rdfs:subClassOf wont:WONT_0000389 .

wont:WONT_0000408 a owl:Class ;
    rdfs:label "Wound healing disorder" ;
    ns1:IAO_0000115 "A material disease entity consisting in the abnormal organization of the tissues of and around a wound of a patient, such that the wound does not progress through healing in the expected manner."@en ;
    ns1:IAO_0000116 "Recategorised when the causal-role groupings 'Medical condition contributing to wound formation' / 'affecting wound healing' / 'contributing to blistering wounds' were dissolved. Those classes grouped entities by what they were said to cause, which this ontology does not assert, and they mixed material disorders with dispositions and processes. Relevance to wounds is now carried by co-location axioms on the wound classes instead of by membership in a causal class."@en,
        "Reparented from BFO_0000016 disposition to MILD_120022 pathological disorder (since 2026-10-30 merged into MILD_120020 material disease entity, whose exact synonym it is). A disorder is not a disposition. What is present in the patient is an abnormal organisation of material components in and around the wound; impaired healing is what that disorder is a disorder OF, not a potential the disorder bears. The dispositional reading was a residue of the dissolved causal-role grouping, which mixed material disorders with dispositions and processes."@en ;
    rdfs:subClassOf mild:MILD_120020 .

wont:WONT_0000411 a owl:Class ;
    rdfs:label "Wound irrigation process"@en ;
    ns1:IAO_0000115 "A wound treatment process in which a flow of liquid is applied to a wound to rinse debris, exudate and microorganisms from its surface."@en ;
    rdfs:subClassOf wont:WONT_0000423 .

wont:WONT_0000413 a owl:Class ;
    rdfs:label "Wound manager role"@en ;
    ns1:IAO_0000115 "A health care provider role that is borne by a person holding a qualification in wound management and that is realized in organising and coordinating the wound care of patients."@en ;
    rdfs:subClassOf ns1:OMRSE_00000012 .

wont:WONT_0000416 a owl:Class ;
    rdfs:label "Wound palpation" ;
    ns1:IAO_0000115 "A diagnostic process to assess wound characteristics in which an examiner touches and presses the wound and the surrounding tissue with the hands to perceive their physical properties."@en ;
    rdfs:subClassOf wont:WONT_0000089 .

wont:WONT_0000420 a owl:Class ;
    rdfs:label "Wound spacer grid" ;
    ns1:IAO_0000115 "A wound dressing that is a non-adherent open-mesh layer placed in direct contact with the wound bed, which separates the wound from a secondary dressing and lets exudate pass through it."@en ;
    rdfs:subClassOf wont:WONT_0000398 .

wont:WONT_0000421 a owl:Class ;
    rdfs:label "Wound staple plastering plan specification"@en ;
    ns1:IAO_0000118 "Wound staple plastering"@en ;
    rdfs:subClassOf wont:WONT_0000389 .

wont:WONT_0000422 a owl:Class ;
    rdfs:label "Wound temperature assessment process"@en ;
    ns1:IAO_0000115 "A wound diagnostic process that has as specified output a datum about the temperature of the wound bed or of the periwound skin."@en ;
    rdfs:subClassOf wont:WONT_0000395 .

wont:WONT_0000425 a owl:Class ;
    rdfs:label "Wound volumetrics" ;
    ns1:IAO_0000115 "A wound size measurement process that has as specified output a datum about the volume of the wound cavity."@en ;
    rdfs:subClassOf wont:WONT_0000419 .

wont:WONT_0000429 a owl:Class ;
    rdfs:label "Wounds classified according to Gustilo and Anderson" ;
    ns1:IAO_0000115 "A wound with accompanying fracture that is a skin wound through which the fracture site communicates with the outside of the body, i.e. the soft tissue wound of an open fracture graded by the Gustilo and Anderson classification."@en ;
    rdfs:subClassOf wont:WONT_0000426,
        wont:WONT_0000441 .

wont:WONT_0000430 a owl:Class ;
    rdfs:label "Wounds classified according to Tscherne and Oestern" ;
    rdfs:subClassOf wont:WONT_0000426,
        wont:WONT_0000441 .

wont:WONT_0000432 a owl:Class ;
    rdfs:label "T drain" ;
    ns1:IAO_0000115 "An abdominal drain consisting of a T-shaped tube whose short crossbar limbs lie in the lumen of the common bile duct and whose long limb leads out through the abdominal wall, bearing a function of draining bile externally."@en ;
    rdfs:subClassOf wont:WONT_0000002 .

wont:WONT_0000439 a owl:Class ;
    rdfs:label "CDC surgical wound classification"@en ;
    ns1:IAO_0000115 "A wound classification scale that stratifies surgical wounds by degree of intraoperative microbial contamination."@en ;
    rdfs:subClassOf wont:WONT_0000066 .

wont:WONT_0000442 a owl:Class ;
    rdfs:label "Chronic wound"@en ;
    ns1:IAO_0000115 "A wound that has failed to progress through the phases of healing in an orderly and timely fashion."@en ;
    ns1:IAO_0000118 "Chronic non-healing wound"@en,
        "Non-healing wound"@en ;
    rdfs:comment "WONT-owned material counterpart of HP_0032676, which HP models as a phenotypic abnormality. Bridged, not subsumed."@en ;
    rdfs:subClassOf wont:WONT_0000380 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000380 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000086 ;
                        owl:someValuesFrom wont:WONT_0000477 ] ) ] ;
    skos:relatedMatch ns1:HP_0032676 .

wont:WONT_0000443 a owl:Class ;
    rdfs:label "Erysipelas"@en ;
    ns1:IAO_0000115 "A superficial bacterial skin infection, characteristically caused by Streptococcus pyogenes, involving the upper dermis and superficial lymphatics."@en ;
    ns1:IAO_0000116 "Recategorised when the causal-role groupings 'Medical condition contributing to wound formation' / 'affecting wound healing' / 'contributing to blistering wounds' were dissolved. Those classes grouped entities by what they were said to cause, which this ontology does not assert, and they mixed material disorders with dispositions and processes. Relevance to wounds is now carried by co-location axioms on the wound classes instead of by membership in a causal class."@en ;
    rdfs:comment "Minted because no erysipelas class was available in the imported DOID module. DOID_0050061 is erysipeloid - a distinct zoonotic infection caused by Erysipelothrix rhusiopathiae - and had been mislabelled 'Erysipel' in WONT. Deliberately NOT related to DOID_0050061."@en ;
    rdfs:subClassOf mild:MILD_120020 .

wont:WONT_0000446 a owl:Class ;
    rdfs:label "Mucous membrane pemphigoid"@en ;
    ns1:IAO_0000115 "A material disease entity that has as parts one or more mucosal blisters that are autoimmune tissue disorders."@en ;
    ns1:IAO_0000116 "Reparented from ns1:DOID_0080841 pemphigoid to mild:MILD_120020 material disease entity. This class had been the only WONT class with no BFO anchor: its only parent chain ran into DOID and dead-ended at DOID_4, so nothing placed it in a BFO category. It is a disease, and it is a disease in virtue of the material disorders that compose it - several blisters in the mucosa, arising from an immune response against the patient's own tissue. That is now what the axiom says: MILD_120020 has_part some (mucosal blister and autoimmune tissue disorder). No causal claim is made between the autoimmunity and the blistering; the blisters simply ARE autoimmune tissue disorders, which is assertable under MILD model commitment 4 whereas an aetiological arrow is not."@en ;
    rdfs:comment "Bridging annotation, not subsumption. DOID_0080841 pemphigoid is a nosological category, i.e. a specifically dependent continuant, whereas this class is the material disease entity itself; the imported DOID module also carries only that generic term, which WONT had been narrowing by label. Asserting rdfs:subClassOf between them is the category error corrected here, so the relation is recorded as skos:relatedMatch instead."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( wont:WONT_0000469 wont:WONT_0000473 ) ] ],
        mild:MILD_120020 ;
    skos:relatedMatch ns1:DOID_0080841 .

wont:WONT_0000449 a owl:Class ;
    rdfs:label "advanced age wound-healing predisposition"@en ;
    ns1:IAO_0000115 "A disease predisposition that inheres in a human being of advanced age and whose realization impairs wound healing."@en ;
    rdfs:comment "Advanced age is a quality of the patient (PATO_0001764), not a disease. It is represented here as the predisposition it grounds, rather than by subsuming the PATO quality under a disease class."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000197 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:NCBITaxon_9606 [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000086 ;
                                owl:someValuesFrom ns1:PATO_0001764 ] ) ] ],
        mild:MILD_120023 .

wont:WONT_0000467 a owl:Class ;
    rdfs:label "Diabetic metabolic disorder"@en ;
    ns1:IAO_0000115 "A material disease entity consisting in the abnormal organization of the insulin-secreting or insulin-responsive tissues of a patient, such that glucose homeostasis is not maintained."@en ;
    rdfs:comment "Bridging annotation, not subsumption. The OBO term is a nosological category / specifically dependent continuant, whereas this class is the material disease entity itself. Asserting rdfs:subClassOf between them is a category error, so the relation is recorded as skos:relatedMatch instead."@en ;
    rdfs:subClassOf mild:MILD_120020 ;
    skos:relatedMatch ns1:DOID_9351 .

wont:WONT_0000474 a owl:Class ;
    rdfs:label "painful"@en ;
    ns1:IAO_0000115 "A degree of wound pain that qualifies its bearer as painful."@en ;
    rdfs:subClassOf wont:WONT_0000415 .

wont:WONT_0000476 a owl:Class ;
    rdfs:label "acute"@en ;
    ns1:IAO_0000115 "A degree of time after disease inception that qualifies its bearer as acute: the disorder is of recent onset and still within the period in which an orderly course is expected."@en ;
    rdfs:subClassOf wont:WONT_0000475 .

wont:WONT_0000482 a owl:Class ;
    rdfs:label "First-degree burn wound"@en ;
    ns1:IAO_0000115 "A thermal wound in which the injury is confined to the epidermis."@en ;
    rdfs:subClassOf wont:WONT_0000310 .

wont:WONT_0000483 a owl:Class ;
    rdfs:label "Second-degree burn wound"@en ;
    ns1:IAO_0000115 "A thermal wound in which the injury extends through the epidermis into the dermis."@en ;
    ns1:IAO_0000118 "2nd degree burn"@en ;
    rdfs:subClassOf wont:WONT_0000310 .

wont:WONT_0000484 a owl:Class ;
    rdfs:label "Third-degree burn wound"@en ;
    ns1:IAO_0000115 "A thermal wound in which the injury extends through the full thickness of the skin."@en ;
    rdfs:subClassOf wont:WONT_0000310 .

wont:WONT_0000485 a owl:Class ;
    rdfs:label "Fourth-degree burn wound"@en ;
    ns1:IAO_0000115 "A thermal wound in which the injury extends beyond the skin into underlying tissue such as fascia, muscle or bone."@en ;
    rdfs:subClassOf wont:WONT_0000310 .

wont:WONT_0000493 a owl:Class ;
    rdfs:label "Jackson burn wound zone classification"@en ;
    ns1:IAO_0000115 "A wound classification scale that divides a burn wound into three concentric zones - coagulation, stasis and hyperemia - by the severity of tissue damage."@en ;
    ns1:IAO_0000118 "Jackson burn wound classification"@en ;
    dcterms:source "Jackson DM. The diagnosis of the depth of burning. Br J Surg. 1953;40(164):588-596." ;
    rdfs:subClassOf wont:WONT_0000436 .

wont:WONT_0000494 a owl:Class ;
    rdfs:label "Burn wound classification according to Hildanus and Derganc"@en ;
    ns1:IAO_0000115 "A wound classification scale that grades a burn wound by the depth of tissue destroyed: superficial, superficial partial-thickness, deep partial-thickness and full-thickness. Derganc's subdivision of the second degree refines the degree scheme attributed to Hildanus."@en ;
    dcterms:source "Derganc M. The theoretical and practical significance of the subdivision of the second degree burn into superficial and deep type. In: Artz CP, ed. Research in Burns. Vol 9. American Institute of Biological Sciences and F A Davis; 1962:315-326.",
        "Wallace A. Classification of Burns: A History of Development; with Comments for Today and Thoughts for the Future. Thesis PhD. University of St Andrews; 1973." ;
    rdfs:subClassOf wont:WONT_0000436 .

wont:WONT_0000499 a owl:NamedIndividual,
        wont:WONT_0000495 ;
    rdfs:label "Superficial"@en ;
    ns1:IAO_0000118 "First degree"@en .

wont:WONT_0000500 a owl:NamedIndividual,
        wont:WONT_0000513 ;
    rdfs:label "Superficial partial-thickness"@en ;
    ns1:IAO_0000118 "Second degree, 2a"@en .

wont:WONT_0000501 a owl:NamedIndividual,
        wont:WONT_0000513 ;
    rdfs:label "Deep partial-thickness"@en ;
    ns1:IAO_0000118 "Second degree, 2b"@en .

wont:WONT_0000502 a owl:NamedIndividual,
        wont:WONT_0000495 ;
    rdfs:label "Full-thickness"@en ;
    ns1:IAO_0000118 "Third degree"@en .

wont:WONT_0000504 a owl:Class ;
    rdfs:label "Open wound"@en ;
    ns1:IAO_0000115 "A wound that bears the quality open: its surface is breached, so that underlying tissue is exposed."@en ;
    rdfs:subClassOf wont:WONT_0000380 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000380 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000086 ;
                        owl:someValuesFrom ns1:PATO_0000610 ] ) ] .

wont:WONT_0000505 a owl:Class ;
    rdfs:label "Closed wound"@en ;
    ns1:IAO_0000115 "A wound that bears the quality closed: the skin or mucosal surface over the injured tissue is intact."@en ;
    rdfs:subClassOf wont:WONT_0000380 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000380 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000086 ;
                        owl:someValuesFrom ns1:PATO_0000608 ] ) ] .

wont:WONT_0000506 a owl:Class ;
    rdfs:label "Epithelialized wound"@en ;
    ns1:IAO_0000115 "A wound that bears the quality epithelialized: its surface has been covered by newly formed epithelium."@en ;
    ns1:IAO_0000118 "Healed wound"@en ;
    rdfs:subClassOf wont:WONT_0000380 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000380 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000086 ;
                        owl:someValuesFrom wont:WONT_0000463 ] ) ] .

wont:WONT_0000507 a owl:Class ;
    rdfs:label "Large wound"@en ;
    ns1:IAO_0000115 "A wound that bears the quality increased size: its extent is greater than is typical for a wound of its kind."@en ;
    rdfs:subClassOf wont:WONT_0000380 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000380 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000086 ;
                        owl:someValuesFrom ns1:PATO_0002057 ] ) ] .

wont:WONT_0000508 a owl:Class ;
    rdfs:label "Deep wound"@en ;
    ns1:IAO_0000115 "A wound that bears the quality increased depth: it extends further into the tissue than is typical for a wound of its kind."@en ;
    rdfs:subClassOf wont:WONT_0000380 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000380 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000086 ;
                        owl:someValuesFrom ns1:PATO_0001596 ] ) ] .

wont:WONT_0000509 a owl:Class ;
    rdfs:label "Ischemic wound"@en ;
    ns1:IAO_0000115 "An arterial insufficiency wound that bears the quality ischemic."@en ;
    rdfs:subClassOf wont:WONT_0000510 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000510 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000086 ;
                        owl:someValuesFrom wont:WONT_0000488 ] ) ] .

wont:WONT_0000511 a owl:Class ;
    rdfs:label "Colonized wound"@en ;
    ns1:IAO_0000115 "A wound with recognized microbial burden that bears the quality colonized."@en ;
    rdfs:subClassOf wont:WONT_0000481 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000481 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000086 ;
                        owl:someValuesFrom wont:WONT_0000512 ] ) ] .

wont:WONT_0000520 a owl:Class ;
    rdfs:label "Diabetes mellitus type II disease process"@en ;
    ns1:IAO_0000115 "A diabetes mellitus disease process of a diabetic metabolic disorder of type II."@en ;
    rdfs:subClassOf wont:WONT_0000535 .

wont:WONT_0000521 a owl:Class ;
    rdfs:label "Irreversibly diminished microvascular perfusion process"@en ;
    ns1:IAO_0000115 "A process in which the perfusion of a tissue through its microvasculature is reduced without recovery."@en ;
    rdfs:subClassOf ns1:BFO_0000015 .

wont:WONT_0000525 a owl:Class ;
    rdfs:label "Contaminated wound according to CDC"@en ;
    ns1:IAO_0000115 "A wound with microbial burden assessed according to CDC that is an open, fresh, accidental wound, or an operative wound with a major break in sterile technique or gross spillage from the gastrointestinal tract."@en ;
    rdfs:subClassOf wont:WONT_0000524 .

wont:WONT_0000526 a owl:Class ;
    rdfs:label "Dirty wound according to CDC"@en ;
    ns1:IAO_0000115 "A wound with microbial burden assessed according to CDC that is an old traumatic wound with retained devitalized tissue, or one that involves existing clinical infection or perforated viscera."@en ;
    rdfs:subClassOf wont:WONT_0000524 .

wont:WONT_0000527 a owl:Class ;
    rdfs:label "Clean wound according to IWII"@en ;
    ns1:IAO_0000115 "A wound with microbial burden assessed according to IWII that bears the quality sterile."@en ;
    ns1:IAO_0000118 "Aseptic wound"@en,
        "Sterile wound"@en ;
    rdfs:subClassOf wont:WONT_0000481 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000481 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000086 ;
                        owl:someValuesFrom wont:WONT_0000486 ] ) ] .

wont:WONT_0000528 a owl:Class ;
    rdfs:label "IWII wound classification scale"@en ;
    ns1:IAO_0000115 "A wound classification scale that grades a wound by its microbial burden on the wound infection continuum of the International Wound Infection Institute: clean, contaminated, colonized, infected."@en ;
    rdfs:subClassOf wont:WONT_0000066 .

wont:WONT_0000530 a owl:NamedIndividual,
        wont:WONT_0000529 ;
    rdfs:label "clean"@en .

wont:WONT_0000531 a owl:NamedIndividual,
        wont:WONT_0000529 ;
    rdfs:label "contaminated"@en .

wont:WONT_0000532 a owl:NamedIndividual,
        wont:WONT_0000529 ;
    rdfs:label "colonized"@en .

wont:WONT_0000533 a owl:NamedIndividual,
        wont:WONT_0000529 ;
    rdfs:label "infected"@en .

wont:WONT_0000534 a owl:Class ;
    rdfs:label "Pressure ulcer"@en ;
    ns1:IAO_0000115 "A wound that is the output of a wound development process that has as part a pressure impact process."@en ;
    ns1:IAO_0000118 "decubitus ulcer"@en ;
    rdfs:subClassOf wont:WONT_0000380 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000380 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0002353 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( wont:WONT_0000414 [ a owl:Restriction ;
                                            owl:onProperty ns1:BFO_0000051 ;
                                            owl:someValuesFrom wont:WONT_0000245 ] ) ] ] ) ] ;
    skos:relatedMatch ns1:HP_0012399 .

wont:WONT_0000536 a owl:Class ;
    rdfs:label "Diabetes mellitus type I disease process"@en ;
    ns1:IAO_0000115 "A diabetes mellitus disease process of a diabetic metabolic disorder of type I."@en ;
    rdfs:subClassOf wont:WONT_0000535 .

wont:WONT_0000544 a owl:Class ;
    rdfs:label "Impaired wound healing process"@en ;
    ns1:IAO_0000115 "A wound healing that deviates from the normal orderly and timely sequence of healing phases, such that restoration of tissue integrity is delayed, arrested or yields abnormal tissue."@en ;
    ns1:IAO_0000118 "Pathological wound healing process"@en ;
    rdfs:subClassOf ns1:GO_0042060 .

wont:WONT_0000547 a owl:Class ;
    rdfs:label "Group A Streptococcus"@en ;
    ns1:IAO_0000115 "A pathogen that is a Gram-positive coccus of the genus Streptococcus bearing the Lancefield group A carbohydrate antigen in its cell wall."@en ;
    rdfs:subClassOf ns1:IDO_0000528 .

wont:WONT_0000548 a owl:Class ;
    rdfs:label "Vancomycin"@en ;
    ns1:IAO_0000115 "A molecule of the glycopeptide vancomycin, a glycosylated tricyclic heptapeptide that binds the D-alanyl-D-alanine termini of peptidoglycan precursors and thereby inhibits bacterial cell wall synthesis, and that has an antibiotic drug role."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000056 ;
            owl:someValuesFrom wont:WONT_0000589 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000087 ;
            owl:someValuesFrom wont:WONT_0000578 ],
        ns1:COB_0000013 .

wont:WONT_0000549 a owl:Class ;
    rdfs:label "Diabetic foot ulcer"@en ;
    ns1:IAO_0000115 "A diabetic wound that is located in a foot."@en ;
    rdfs:subClassOf wont:WONT_0000088 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000088 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0001025 ;
                        owl:someValuesFrom ns1:FMA_9664 ] ) ] .

wont:WONT_0000550 a owl:Class ;
    rdfs:label "Surgical site infection"@en ;
    ns1:IAO_0000115 "A material disease entity that is an infection by microorganisms of the surgical incision, of the tissues at the operative site or of an organ or space manipulated during a surgical operation, beginning after that operation."@en ;
    rdfs:subClassOf mild:MILD_120020 .

wont:WONT_0000551 a owl:Class ;
    rdfs:label "Soft tissue wound"@en ;
    ns1:IAO_0000115 "A wound whose damaged tissue is non-osseous covering, connecting or supporting tissue of the body, such as skin, subcutis, fascia, muscle, tendon or ligament, rather than bone or a parenchymal organ."@en ;
    rdfs:subClassOf wont:WONT_0000380 .

wont:WONT_0000552 a owl:Class ;
    rdfs:label "Laceration"@en ;
    ns1:IAO_0000115 "A traumatic wound in which tissue has been torn or split by blunt force and that has irregular wound margins."@en ;
    rdfs:subClassOf wont:WONT_0000339 .

wont:WONT_0000553 a owl:Class ;
    rdfs:label "Acute wound"@en ;
    ns1:IAO_0000115 "A wound that has recently arisen and participates in a wound healing proceeding through the normal phases of repair in an orderly and timely sequence."@en ;
    rdfs:subClassOf wont:WONT_0000380 .

wont:WONT_0000554 a owl:Class ;
    rdfs:label "Foreign body wound"@en ;
    ns1:IAO_0000115 "A wound that is the output of a wound development process that has as part a foreign body process."@en ;
    rdfs:subClassOf wont:WONT_0000380 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000380 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0002353 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( wont:WONT_0000414 [ a owl:Restriction ;
                                            owl:onProperty ns1:BFO_0000051 ;
                                            owl:someValuesFrom wont:WONT_0000587 ] ) ] ] ) ] .

wont:WONT_0000556 a owl:Class ;
    rdfs:label "Hypertrophic scar"@en ;
    ns1:IAO_0000115 "A material entity that is a raised mass of excess collagenous scar tissue at the site of a healed wound, is the output of an excessive collagen deposition process, and remains confined to the boundaries of the original wound."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0002353 ;
            owl:someValuesFrom wont:WONT_0000154 ],
        ns1:BFO_0000040 .

wont:WONT_0000558 a owl:Class ;
    rdfs:label "Sepsis"@en ;
    ns1:IAO_0000115 "A material disease entity consisting in the abnormal organization of the organs or tissues of a patient that is the output of a dysregulated host response to an infection, such that organ function is impaired."@en ;
    rdfs:subClassOf mild:MILD_120020 ;
    skos:relatedMatch ns1:DOID_0040085 .

wont:WONT_0000559 a owl:Class ;
    rdfs:label "Osteomyelitis"@en ;
    ns1:IAO_0000115 "A material disease entity that is a portion of bone, including its marrow, affected by inflammation."@en ;
    rdfs:subClassOf mild:MILD_120020 ;
    skos:relatedMatch ns1:DOID_1019 .

wont:WONT_0000560 a owl:Class ;
    rdfs:label "Neuropathic disease process in wound development"@en ;
    ns1:IAO_0000115 "A neuropathic disease process that is a wound development subprocess."@en ;
    rdfs:subClassOf wont:WONT_0000586 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000418 wont:WONT_0000586 ) ] .

wont:WONT_0000562 a owl:NamedIndividual,
        wont:WONT_0000561 ;
    rdfs:label "Hemostasis phase"@en ;
    ns1:IAO_0000136 ns1:GO_0007599 .

wont:WONT_0000563 a owl:NamedIndividual,
        wont:WONT_0000561 ;
    rdfs:label "Inflammatory phase"@en ;
    ns1:IAO_0000136 wont:WONT_0000590 .

wont:WONT_0000564 a owl:NamedIndividual,
        wont:WONT_0000561 ;
    rdfs:label "Proliferative phase"@en ;
    ns1:IAO_0000136 wont:WONT_0000100,
        wont:WONT_0000132 .

wont:WONT_0000565 a owl:NamedIndividual,
        wont:WONT_0000561 ;
    rdfs:label "Remodeling phase"@en ;
    ns1:IAO_0000136 ns1:GO_0048771 .

wont:WONT_0000566 a owl:Class ;
    rdfs:label "Bacterial colonization process"@en ;
    ns1:IAO_0000115 "A process in which bacteria adhere to and multiply on the surface of or within a tissue of a host organism."@en ;
    rdfs:subClassOf ns1:BFO_0000015 .

wont:WONT_0000569 a owl:Class ;
    rdfs:label "Prophylactic antibiotic therapy plan specification"@en ;
    ns1:IAO_0000115 "A prophylaxis plan specification that prescribes giving a substance bearing an antibiotic drug role to a patient to prevent a bacterial infection."@en ;
    ns1:IAO_0000118 "Prophylactic antibiotic therapy"@en ;
    rdfs:subClassOf mild:MILD_120100 .

wont:WONT_0000570 a owl:Class ;
    rdfs:label "Pressure redistribution mattress"@en ;
    ns1:IAO_0000115 "A device that is a support surface on which a recumbent person lies and that bears a pressure redistribution function."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000056 ;
            owl:someValuesFrom wont:WONT_0000568 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom wont:WONT_0000580 ],
        ns1:COB_0001300 .

wont:WONT_0000571 a owl:Class ;
    rdfs:label "Therapeutic footwear"@en ;
    ns1:IAO_0000115 "A device that is worn on the foot and bears a pressure redistribution function acting on the surfaces of the foot."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000056 ;
            owl:someValuesFrom wont:WONT_0000568 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom wont:WONT_0000580 ],
        ns1:COB_0001300 .

wont:WONT_0000572 a owl:Class ;
    rdfs:label "Bacterial culture process"@en ;
    ns1:IAO_0000115 "A wound diagnostic process in which a specimen taken from a wound is incubated in a growth medium so that bacteria present in it multiply and can be detected and identified."@en ;
    rdfs:subClassOf wont:WONT_0000395 .

wont:WONT_0000574 a owl:Class ;
    rdfs:label "Ankle-brachial index measurement process"@en ;
    ns1:IAO_0000115 "A vascular assessment process that has as specified output the ratio of the systolic blood pressure measured at the ankle to the systolic blood pressure measured at the arm."@en ;
    rdfs:subClassOf wont:WONT_0000573 .

wont:WONT_0000575 a owl:Class ;
    rdfs:label "Wound photography process"@en ;
    ns1:IAO_0000115 "A wound documentation process in which a photographic image of a wound is produced as a record of its appearance."@en ;
    rdfs:subClassOf wont:WONT_0000397 .

wont:WONT_0000577 a owl:Class ;
    rdfs:label "Epithelialization criterion"@en ;
    ns1:IAO_0000115 "A wound healing criterion that is about the degree of epithelialization of a wound, specifying the extent of epithelial coverage of the wound surface to be attained."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000136 ;
            owl:someValuesFrom wont:WONT_0000455 ],
        wont:WONT_0000576 .

wont:WONT_0000581 a owl:Class ;
    rdfs:label "Surgical debridement plan specification"@en ;
    ns1:IAO_0000115 "A treatment plan specification that prescribes the removal of necrotic, infected or devitalized tissue from a wound by means of surgical instruments."@en ;
    ns1:IAO_0000118 "Surgical debridement"@en ;
    rdfs:subClassOf mild:MILD_120089 .

wont:WONT_0000582 a owl:Class ;
    rdfs:label "therapeutic role"@en ;
    ns1:IAO_0000115 "A role that is borne by an entity in virtue of its being used to treat, alleviate or cure a disease of a patient."@en ;
    rdfs:subClassOf ns1:BFO_0000023 .

wont:WONT_0000584 a owl:Class ;
    rdfs:label "therapeutic function"@en ;
    ns1:IAO_0000115 "A clinical function whose realization contributes to the treatment of a disease of a patient."@en ;
    rdfs:subClassOf wont:WONT_0000583 .

wont:WONT_0007237 a owl:Class ;
    rdfs:label "Traumatic injury"@en ;
    ns1:IAO_0000115 "An injury that is the output of a trauma process."@en ;
    rdfs:subClassOf wont:WONT_0007817 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0007817 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0002353 ;
                        owl:someValuesFrom wont:WONT_0000338 ] ) ] .

wont:WONT_120000 a owl:Class ;
    rdfs:label "wound protection function"@en ;
    ns1:IAO_0000115 "A function that is realized by shielding a wound from mechanical injury, contamination or other harmful external influences."@en ;
    rdfs:subClassOf ns1:BFO_0000034 .

wont:WONT_120001 a owl:Class ;
    rdfs:label "wound signaling function"@en ;
    rdfs:subClassOf ns1:BFO_0000034 .

wont:WONT_120002 a owl:Class ;
    rdfs:label "first wound dressing layer function"@en ;
    rdfs:subClassOf wont:WONT_120004 .

wont:WONT_120003 a owl:Class ;
    rdfs:label "second wound dressing layer function"@en ;
    rdfs:subClassOf wont:WONT_120004 .

wont:WONT_120006 a owl:Class ;
    rdfs:label "non adhesive wound dressing fixation function"@en ;
    ns1:IAO_0000115 "A wound dressing fixation function that is realized without its bearer adhering to the patient's skin."@en ;
    rdfs:subClassOf wont:WONT_120005 .

wont:WONT_120007 a owl:Class ;
    rdfs:label "wound moisture absorbance function"@en ;
    ns1:IAO_0000115 "A function that is realized in the uptake of exudate or other fluid from a wound into the bearer."@en ;
    rdfs:subClassOf ns1:BFO_0000034 .

wont:WONT_120008 a owl:Class ;
    rdfs:label "wound moisture regulation function"@en ;
    ns1:IAO_0000115 "A function that is realized in keeping the moisture of a wound bed from becoming either excessive or insufficient, by taking up fluid from the wound or by retaining or supplying fluid to it."@en ;
    rdfs:subClassOf ns1:BFO_0000034 .

wont:WONT_120009 a owl:Class ;
    rdfs:label "wound desinfecting function"@en ;
    ns1:IAO_0000115 "A function that is realized in killing or inactivating microorganisms in or on a wound."@en ;
    rdfs:subClassOf ns1:BFO_0000034 .

wont:WONT_120010 a owl:Class ;
    rdfs:label "wound edge approximating function"@en ;
    ns1:IAO_0000115 "A function that is realized in bringing the edges of a wound together and holding them in apposition."@en ;
    rdfs:subClassOf ns1:BFO_0000034 .

wont:WONT_120011 a owl:Class ;
    rdfs:label "wound inspection facilitation function"@en ;
    ns1:IAO_0000115 "A function that is realized in making a wound more readily accessible to visual or other examination."@en ;
    rdfs:subClassOf ns1:BFO_0000034 .

wont:WONT_120019 a owl:Class ;
    rdfs:label "pathogen with wound infecting tendency"@en ;
    ns1:IAO_0000115 "A pathogen that bears a wound infecting tendency."@en ;
    rdfs:subClassOf ns1:IDO_0000528 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:BFO_0000040 [ a owl:Restriction ;
                        owl:onProperty mild:MILD_120101 ;
                        owl:someValuesFrom wont:WONT_120018 ] ) ] .

ns1:BFO_0000023 a owl:Class ;
    rdfs:label "role" .

ns1:CHEBI_24473 a owl:Class ;
    rdfs:label "halogen"@en ;
    rdfs:subClassOf ns1:BFO_0000040 .

ns1:COB_0000082 a owl:Class ;
    rdfs:label "planned process" .

ns1:DOID_0040085 a owl:Class .

ns1:DOID_0050853 a owl:Class ;
    rdfs:label "chronic venous insufficiency"@en ;
    ns1:IAO_0000118 "Chronic venous insufficiency"@en .

ns1:DOID_0080841 a owl:Class ;
    rdfs:label "pemphigoid" .

ns1:DOID_1019 a owl:Class .

ns1:DOID_417 a owl:Class ;
    rdfs:label "autoimmune disease"@en ;
    ns1:IAO_0000118 "Autoimmune disease"@en .

ns1:DOID_4347 a owl:Class ;
    rdfs:label "lymphocele"@en ;
    rdfs:comment "Bridging annotation, not subsumption. The OBO term is a nosological category / specifically dependent continuant, whereas this class is the material disease entity itself. Asserting rdfs:subClassOf between them is a category error, so the relation is recorded as skos:relatedMatch instead."@en ;
    skos:relatedMatch wont:WONT_0000470 .

ns1:DOID_574 a owl:Class .

ns1:DOID_9351 a owl:Class ;
    rdfs:label "diabetes mellitus"@en ;
    ns1:IAO_0000118 "Diabetes mellitus"@en .

ns1:DOID_9602 a owl:Class ;
    rdfs:label "necrotizing fasciitis"@en ;
    ns1:IAO_0000118 "Necrotizing fasciitis"@en ;
    rdfs:comment "Bridging annotation, not subsumption. MILD models a wound/disease as a material continuant; the OBO term below is a phenotype or nosological category, i.e. a specifically dependent continuant. Asserting rdfs:subClassOf between them is a category error that renders both unsatisfiable, so the relation is recorded as skos:relatedMatch instead."@en ;
    skos:relatedMatch mild:MILD_120020 .

ns1:FMA_9664 a owl:Class .

ns1:GO_0007599 a owl:Class ;
    rdfs:label "hemostasis"@en ;
    ns1:IAO_0000118 "Hemostasis process"@en ;
    rdfs:subClassOf wont:WONT_0000409 .

ns1:GO_0008150 a owl:Class ;
    rdfs:label "biological_process" .

ns1:GO_0048771 a owl:Class ;
    rdfs:label "tissue remodeling"@en ;
    ns1:IAO_0000118 "Remodeling process"@en ;
    rdfs:subClassOf wont:WONT_0000409 .

ns1:HP_0012399 a owl:Class .

ns1:HP_0025615 a owl:Class ;
    rdfs:label "abscess"@en ;
    rdfs:comment "Bridging annotation, not subsumption. The OBO term is a phenotypic abnormality / nosological category, i.e. a specifically dependent continuant, whereas this class is the material disease entity itself. Asserting rdfs:subClassOf between them is a category error that renders both unsatisfiable, so the relation is recorded as skos:relatedMatch instead."@en ;
    skos:relatedMatch wont:WONT_0000472 .

ns1:HP_0032326 a owl:Class ;
    rdfs:label "Methicillin-resistant Staphylococcus aureus infection" ;
    rdfs:comment "Bridging annotation, not subsumption. The OBO term is a phenotypic abnormality / nosological category, i.e. a specifically dependent continuant, whereas this class is the material disease entity itself. Asserting rdfs:subClassOf between them is a category error that renders both unsatisfiable, so the relation is recorded as skos:relatedMatch instead. The has-participant axiom formerly asserted here used RO_0000057, whose domain is occurrent; it now sits on WONT_0000447 as a BFO_0000051 has-part axiom, where it is type-correct."@en ;
    skos:relatedMatch wont:WONT_0000447 .

ns1:HP_0032674 a owl:Class .

ns1:HP_0032676 a owl:Class .

ns1:HP_0100699 a owl:Class ;
    rdfs:label "Scarring"@en ;
    rdfs:comment "Bridging annotation, not subsumption. HP_0100699 'Scarring' is a phenotypic abnormality, i.e. a quality and therefore a continuant, whereas this class is the process of scar formation. Asserting rdfs:subClassOf between them crosses the continuant/occurrent divide and renders both unsatisfiable, so the relation is recorded as skos:relatedMatch instead."@en ;
    skos:relatedMatch wont:WONT_0000471 .

ns1:IAO_0000030 a owl:Class .

ns1:IAO_0000109 a owl:Class ;
    rdfs:label "measurement datum" .

ns1:IDO_0000586 a owl:Class .

ns1:NCBITaxon_1280 a owl:Class ;
    rdfs:label "Staphylococcus aureus" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty mild:MILD_120101 ;
            owl:someValuesFrom wont:WONT_120018 ],
        ns1:NCBITaxon_2 .

ns1:OBI_0000295 a owl:ObjectProperty .

ns1:OBI_0000312 a owl:ObjectProperty .

ns1:PATO_0000608 a owl:Class ;
    rdfs:label "closed" ;
    rdfs:subClassOf ns1:PATO_0000136 .

ns1:PATO_0000610 a owl:Class ;
    rdfs:label "open" ;
    rdfs:subClassOf ns1:PATO_0000136 .

ns1:PATO_0001596 a owl:Class ;
    rdfs:label "increased depth" ;
    rdfs:subClassOf ns1:PATO_0001595 .

ns1:PATO_0001764 a owl:Class ;
    rdfs:label "increased age" .

ns1:PATO_0002057 a owl:Class .

ns1:PATO_0002097 a owl:Class ;
    rdfs:label "neoplastic, malignant" .

ns1:RO_0002559 a owl:ObjectProperty .

wont:WONT_0000002 a owl:Class ;
    rdfs:label "Abdominal drain" ;
    ns1:IAO_0000115 "A drain that is placed in the abdominal cavity or in an abdominal surgical site to carry fluid, blood or air out of the abdomen."@en ;
    rdfs:subClassOf wont:WONT_0000093 .

wont:WONT_0000015 a owl:Class ;
    rdfs:label "Angiopathic wound"@en ;
    ns1:IAO_0000115 "A wound that is the output of a wound development process that has as part a process of the course of an angiopathy. No claim is made that the disorder caused the wound."@en ;
    rdfs:subClassOf wont:WONT_0000380 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000380 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0002353 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( wont:WONT_0000414 [ a owl:Restriction ;
                                            owl:onProperty ns1:BFO_0000051 ;
                                            owl:someValuesFrom wont:WONT_0000537 ] ) ] ] ) ] .

wont:WONT_0000020 a owl:Class ;
    rdfs:label "Antiseptic dye" ;
    ns1:IAO_0000115 "A material used for wound treatment that is a coloured compound that stains the tissue it is applied to and bears the antiseptic drug role."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000087 ;
            owl:someValuesFrom ns1:CHEBI_48218 ],
        wont:WONT_0000188 .

wont:WONT_0000021 a owl:Class ;
    rdfs:label "Antiseptic halogen-releasing compound" ;
    ns1:IAO_0000115 "A material used for wound treatment that is a chemical compound releasing an oxidizing halogen species on application and bears the antiseptic drug role."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000087 ;
            owl:someValuesFrom ns1:CHEBI_48218 ],
        wont:WONT_0000188 .

wont:WONT_0000026 a owl:Class ;
    rdfs:label "Antiseptic solution" ;
    ns1:IAO_0000115 "A wound irrigation solution that contains a dissolved substance bearing the antiseptic drug role."@en ;
    rdfs:subClassOf wont:WONT_0000412 .

wont:WONT_0000040 a owl:Class ;
    rdfs:label "Biosurgical debridement plan specification"@en ;
    ns1:IAO_0000115 "A treatment plan specification that prescribes removing necrotic or devitalized tissue from a wound by applying live sterile fly larvae to it."@en ;
    ns1:IAO_0000118 "Biosurgical debridement"@en ;
    rdfs:subClassOf mild:MILD_120089 .

wont:WONT_0000100 a owl:Class ;
    rdfs:label "Epithelialization process"@en ;
    ns1:IAO_0000115 "A wound healing related physiological process in which epithelial cells migrate, proliferate and differentiate across the wound surface until it is covered by a new epithelium."@en ;
    ns1:IAO_0000118 "Re-Epithelialization"@en ;
    rdfs:subClassOf wont:WONT_0000409 .

wont:WONT_0000123 a owl:NamedIndividual,
        wont:WONT_0000438 ;
    rdfs:label "Shea classification grade I"@en ;
    ns1:IAO_0000118 "Grade I pressure ulcer according to Shea"@en .

wont:WONT_0000125 a owl:NamedIndividual,
        wont:WONT_0000438 ;
    rdfs:label "Shea classification grade II"@en ;
    ns1:IAO_0000118 "Grade II pressure ulcer according to Shea"@en .

wont:WONT_0000127 a owl:NamedIndividual,
        wont:WONT_0000438 ;
    rdfs:label "Shea classification grade III"@en ;
    ns1:IAO_0000118 "Grade III pressure ulcer according to Shea"@en .

wont:WONT_0000129 a owl:NamedIndividual,
        wont:WONT_0000438 ;
    rdfs:label "Shea classification grade IV"@en ;
    ns1:IAO_0000118 "Grade IV pressure ulcer according to Shea"@en .

wont:WONT_0000132 a owl:Class ;
    rdfs:label "Granulation tissue formation process"@en ;
    ns1:IAO_0000115 "A wound healing related physiological process in which new connective tissue rich in capillaries and fibroblasts grows from the wound base and fills the wound bed during the proliferative phase of healing."@en ;
    ns1:IAO_0000118 "Granulation process"@en ;
    rdfs:subClassOf wont:WONT_0000409 .

wont:WONT_0000133 a owl:Class ;
    rdfs:label "Gravity drain" ;
    ns1:IAO_0000115 "A passive drain that conducts fluid out of a wound by gravitational flow into a collecting receptacle positioned below the level of the wound."@en ;
    rdfs:subClassOf wont:WONT_0000224 .

wont:WONT_0000140 a owl:Class ;
    rdfs:label "Heat impact process in wound development"@en ;
    rdfs:subClassOf wont:WONT_0000518 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000418 wont:WONT_0000518 ) ] .

wont:WONT_0000145 a owl:Class ;
    rdfs:label "High-vacuum drain" ;
    ns1:IAO_0000115 "An active drain that draws fluid out of a wound by means of high negative pressure held in a sealed, evacuated collection container."@en ;
    rdfs:subClassOf wont:WONT_0000006 .

wont:WONT_0000154 a owl:Class ;
    rdfs:label "Excessive collagen deposition process"@en ;
    ns1:IAO_0000115 "A scarring process in which collagen is laid down in excess of the amount needed to replace the tissue lost in the wound, yielding a raised scar."@en ;
    ns1:IAO_0000118 "Hypertrophic scarring process"@en ;
    rdfs:subClassOf wont:WONT_0000471 .

wont:WONT_0000189 a owl:Class ;
    rdfs:label "Mechanical debridement plan specification"@en ;
    ns1:IAO_0000115 "A treatment plan specification that prescribes the removal of non-viable tissue, debris and foreign material from a wound by physical force applied to the wound bed, without cutting and without enzymatic, autolytic or biological agents."@en ;
    ns1:IAO_0000118 "Mechanical debridement"@en ;
    rdfs:subClassOf mild:MILD_120089 .

wont:WONT_0000190 a owl:Class ;
    rdfs:label "Mechanical wound debridement process" ;
    ns1:IAO_0000115 "A debridement process in which non-viable tissue, debris and foreign material are removed from a wound by physical force applied to the wound bed, without cutting and without enzymatic, autolytic or biological action."@en ;
    rdfs:subClassOf wont:WONT_0000084 .

wont:WONT_0000196 a owl:Class ;
    rdfs:label "Medicinal honey" ;
    ns1:IAO_0000115 "A material used for wound treatment that consists of honey that has been filtered and sterilised to a standard for medical application to wounds."@en ;
    rdfs:subClassOf wont:WONT_0000188 .

wont:WONT_0000229 a owl:Class ;
    rdfs:label "Peripheral arterial occlusive disease" ;
    ns1:IAO_0000115 "An angiopathy consisting in the narrowing or occlusion of the lumen of one or more arteries supplying the extremities, such that perfusion of the tissue of the affected limb is reduced."@en ;
    ns1:IAO_0000116 "Recategorised when the causal-role groupings 'Medical condition contributing to wound formation' / 'affecting wound healing' / 'contributing to blistering wounds' were dissolved. Those classes grouped entities by what they were said to cause, which this ontology does not assert, and they mixed material disorders with dispositions and processes. Relevance to wounds is now carried by co-location axioms on the wound classes instead of by membership in a causal class."@en ;
    rdfs:subClassOf wont:WONT_0000466 .

wont:WONT_0000245 a owl:Class ;
    rdfs:label "Pressure impact process in wound development"@en ;
    rdfs:subClassOf wont:WONT_0000519 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000418 wont:WONT_0000519 ) ] .

wont:WONT_0000260 a owl:Class ;
    rdfs:label "Regenerative wound healing process"@en ;
    ns1:IAO_0000115 "A wound healing in which the tissue lost in the wound is replaced by newly formed tissue of the same type, restoring the original tissue architecture and function without scar formation."@en ;
    ns1:IAO_0000118 "Regenerative wound healing"@en ;
    rdfs:subClassOf ns1:GO_0042060 .

wont:WONT_0000269 a owl:Class ;
    rdfs:label "Pathological scarring process"@en ;
    ns1:IAO_0000115 "A disorder development process in which the fibrous tissue laid down during wound repair is deposited in excess or in a disorganized way, and that has as output an abnormal scar."@en ;
    rdfs:subClassOf mild:MILD_120021 .

wont:WONT_0000280 a owl:Class ;
    rdfs:label "Silicone spacer grid" ;
    ns1:IAO_0000115 "A wound dressing consisting of a thin perforated silicone sheet that is placed in direct contact with the wound bed and through whose openings exudate passes to an overlying dressing."@en ;
    rdfs:subClassOf wont:WONT_0000398 .

wont:WONT_0000296 a owl:Class ;
    rdfs:label "Substance used for enzymatic wound debridement" ;
    ns1:IAO_0000115 "A material used for wound treatment that contains exogenous enzymes which, when applied to a wound, degrade necrotic tissue and devitalized extracellular matrix so that they can be removed from the wound bed."@en ;
    rdfs:subClassOf wont:WONT_0000188 .

wont:WONT_0000350 a owl:Class ;
    rdfs:label "Ultrasound-assisted wound debridement process"@en ;
    ns1:IAO_0000115 "A debridement process in which devitalized tissue, debris and biofilm are detached from a wound bed by ultrasonic energy transmitted through a fluid applied to the wound."@en ;
    rdfs:subClassOf wont:WONT_0000084 .

wont:WONT_0000384 a owl:Class ;
    rdfs:label "Venous insufficiency wound"@en ;
    ns1:IAO_0000115 "A wound that is the output of a wound development process that has as part a process of the course of a venous insufficiency disorder. No claim is made that the disorder caused the wound."@en ;
    ns1:IAO_0000116 "RENAMED. The previous label, 'Wound causally related to impaired venous backflow', asserted in its own name a causal relation that this ontology does not hold to be assertable: what a disease causes cannot be reliably separated from what the disease is. Only co-location in space and time is claimed. The old label is deliberately NOT retained as an alternative term, because doing so would keep the rejected causal claim in circulation as a searchable synonym."@en ;
    ns1:IAO_0000118 "venous insufficiency ulcer"@en,
        "venous wound"@en ;
    rdfs:subClassOf wont:WONT_0000380 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000380 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0002353 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( wont:WONT_0000414 [ a owl:Restriction ;
                                            owl:onProperty ns1:BFO_0000051 ;
                                            owl:someValuesFrom wont:WONT_0000541 ] ) ] ] ) ] .

wont:WONT_0000392 a owl:Class ;
    rdfs:label "Wound dehiscence" ;
    ns1:IAO_0000115 "A material disease entity that is the output of a wound dehiscence process."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0002353 ;
            owl:someValuesFrom wont:WONT_0000433 ],
        mild:MILD_120020 .

wont:WONT_0000397 a owl:Class ;
    rdfs:label "Wound documentation process" ;
    ns1:IAO_0000115 "A planned process in which observations and findings about a wound of a patient are recorded in an information artifact."@en ;
    rdfs:subClassOf ns1:COB_0000082 .

wont:WONT_0000410 a owl:Class ;
    rdfs:label "Wound infection process"@en ;
    ns1:IAO_0000115 "A course of the disease process in which pathogenic microorganisms invade and multiply in the tissue of a wound and elicit a host response."@en ;
    rdfs:subClassOf mild:MILD_120028 .

wont:WONT_0000415 a owl:Class ;
    rdfs:label "degree of wound pain"@en ;
    ns1:IAO_0000115 "A quality that inheres in a patient, that is the extent of the pain that patient feels, and that is causally influenced by a wound."@en ;
    ns1:IAO_0000116 "Retyped from BFO_0000016 disposition to BFO_0000019 quality, and the bearer moved from the wound to the patient. Wound pain is pain felt by a patient; a wound does not feel, so it cannot be the bearer. There is always some degree of pain inhering in the patient, which is what makes this a quality rather than a disposition waiting to be realized - so the IAO_0000112 note about realization in debridement or dressing change was dropped with the disposition typing, because qualities are not realized. The single qualifying value is WONT_0000474 painful, mirroring macerated under degree of maceration."@en ;
    ns1:IAO_0000118 "Wound pain"@en ;
    ns1:IAO_0000232 "ON MILD MODEL COMMITMENT 4. Commitment 4 forbids asserting a causal relation between ONE DISORDER AND ANOTHER, on the ground that what a disease causes cannot be separated from what it is. This axiom is outside that scope: the wound is a disorder, but the pain is a quality of the patient, not a second disorder, so no disorder-to-disorder aetiology is claimed and no co-location rewrite is needed. RO_0002559 causally influenced by was chosen over RO_0002452 has symptom and RO_0004023, both of which carry rdfs:domain OGMS_0000031 and would silently infer the OGMS disposition-based disease model that MILD rejects. RO_0002559 has no domain or range axiom, so it carries the intended content with no side effect."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000197 ;
            owl:someValuesFrom ns1:NCBITaxon_9606 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0002559 ;
            owl:someValuesFrom wont:WONT_0000380 ],
        ns1:BFO_0000019 .

wont:WONT_0000417 a owl:Class ;
    rdfs:label "Wound pocket" ;
    ns1:IAO_0000116 "Structural axiom, not a definition. This class was label-only under a bare BFO_0000040, so nothing in the ontology said it had anything to do with a wound - the mereology lived only in the class name. Asserting part_of some Wound makes the name's claim checkable and is what CQ025 was failing on. No genus-differentia definition is written here; per the C6 decision the axiom is left to carry the content."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000050 ;
            owl:someValuesFrom wont:WONT_0000380 ],
        ns1:BFO_0000040 .

wont:WONT_0000433 a owl:Class ;
    rdfs:label "Wound dehiscence process"@en ;
    ns1:IAO_0000115 "A disorder development process in which previously approximated wound edges separate."@en ;
    rdfs:subClassOf mild:MILD_120021 .

wont:WONT_0000435 a owl:Class ;
    rdfs:label "macerated"@en ;
    ns1:IAO_0000115 "A degree of maceration that qualifies its bearer as macerated."@en ;
    rdfs:subClassOf wont:WONT_0000434 .

wont:WONT_0000444 a owl:Class ;
    rdfs:label "Antiseptic agent"@en ;
    ns1:IAO_0000115 "A material used for wound treatment that bears the antiseptic drug role."@en ;
    rdfs:subClassOf wont:WONT_0000188 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000188 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000087 ;
                        owl:someValuesFrom ns1:CHEBI_48218 ] ) ] ;
    skos:relatedMatch ns1:CHEBI_48218 .

wont:WONT_0000445 a owl:Class ;
    rdfs:label "Antiseptic biguanide"@en ;
    ns1:IAO_0000115 "A biguanide that bears the antiseptic drug role."@en ;
    rdfs:subClassOf wont:WONT_0000444 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:CHEBI_3095 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000087 ;
                        owl:someValuesFrom ns1:CHEBI_48218 ] ) ] ;
    skos:relatedMatch ns1:CHEBI_3095 .

wont:WONT_0000447 a owl:Class ;
    rdfs:label "MRSA infection"@en ;
    ns1:IAO_0000115 "A material disease entity that is an infection whose causal agent is a methicillin-resistant strain of Staphylococcus aureus."@en ;
    rdfs:comment "WONT-owned material disease counterpart of HP_0032326, which HP models as a phenotypic abnormality. Bridged, not subsumed."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:NCBITaxon_1280 ],
        mild:MILD_120020 ;
    skos:relatedMatch ns1:HP_0032326 .

wont:WONT_0000448 a owl:Class ;
    rdfs:label "wound depth measurement datum"@en ;
    ns1:IAO_0000115 "A measurement datum that is about the depth of a wound."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000136 ;
            owl:someValuesFrom ns1:PATO_0001595 ],
        ns1:IAO_0000109 .

wont:WONT_0000450 a owl:Class ;
    rdfs:label "degree of tissue firmness"@en ;
    ns1:IAO_0000115 "A quality of a bodily tissue that is the degree of resistance it offers to deformation."@en ;
    rdfs:subClassOf ns1:BFO_0000019 .

wont:WONT_0000456 a owl:Class ;
    rdfs:label "reddened"@en ;
    ns1:IAO_0000115 "A color that qualifies its bearer as reddened."@en ;
    rdfs:subClassOf ns1:PATO_0000014 .

wont:WONT_0000457 a owl:Class ;
    rdfs:label "livid"@en ;
    ns1:IAO_0000115 "A color that qualifies its bearer as livid."@en ;
    rdfs:subClassOf ns1:PATO_0000014 .

wont:WONT_0000458 a owl:Class ;
    rdfs:label "softened"@en ;
    ns1:IAO_0000115 "A tissue firmness that qualifies its bearer as softened."@en ;
    rdfs:subClassOf wont:WONT_0000450 .

wont:WONT_0000459 a owl:Class ;
    rdfs:label "undermined"@en ;
    ns1:IAO_0000115 "A degree of skin adherence that qualifies its bearer as undermined."@en ;
    rdfs:subClassOf wont:WONT_0000451 .

wont:WONT_0000460 a owl:Class ;
    rdfs:label "granulating"@en ;
    ns1:IAO_0000115 "A degree of granulation that qualifies its bearer as granulating."@en ;
    rdfs:subClassOf wont:WONT_0000452 .

wont:WONT_0000461 a owl:Class ;
    rdfs:label "necrotic"@en ;
    ns1:IAO_0000115 "A degree of necrosis that qualifies its bearer as necrotic."@en ;
    rdfs:subClassOf wont:WONT_0000453 .

wont:WONT_0000462 a owl:Class ;
    rdfs:label "fibrin-covered"@en ;
    ns1:IAO_0000115 "A degree of fibrin coverage that qualifies its bearer as fibrin-covered."@en ;
    rdfs:subClassOf wont:WONT_0000454 .

wont:WONT_0000464 a owl:Class ;
    rdfs:label "Neoplasm"@en ;
    ns1:IAO_0000115 "A material disease entity that has as part an abnormal mass of tissue arising from autonomous, uncoordinated proliferation of its constituent cells."@en ;
    rdfs:subClassOf mild:MILD_120020 .

wont:WONT_0000465 a owl:Class ;
    rdfs:label "Malignancy"@en ;
    ns1:IAO_0000115 "A neoplasm whose constituent cells are disposed to invade surrounding tissue or to metastasize."@en ;
    rdfs:comment "PATO_0002097 'neoplastic, malignant' is a quality and cannot subsume a material disease entity, so it is bridged rather than used as a parent. Minted under MILD_120020 because the imported DOID module contains no neoplasm or carcinoma class."@en ;
    rdfs:subClassOf wont:WONT_0000464 ;
    skos:relatedMatch ns1:PATO_0002097 .

wont:WONT_0000468 a owl:Class ;
    rdfs:label "Venous insufficiency disorder"@en ;
    ns1:IAO_0000115 "A material disease entity consisting in an abnormal structure of the valves or walls of the veins of a limb, such that venous return from that limb against gravity is impaired."@en ;
    rdfs:comment "Bridging annotation, not subsumption. The OBO term is a nosological category / specifically dependent continuant, whereas this class is the material disease entity itself. Asserting rdfs:subClassOf between them is a category error, so the relation is recorded as skos:relatedMatch instead."@en ;
    rdfs:subClassOf mild:MILD_120020 ;
    skos:relatedMatch ns1:DOID_0050853 .

wont:WONT_0000469 a owl:Class ;
    rdfs:label "Autoimmune tissue disorder"@en ;
    ns1:IAO_0000115 "A material disease entity consisting in tissue of a patient that has been damaged by an immune response directed against constituents normally present in that patient's own body."@en ;
    rdfs:comment "Bridging annotation, not subsumption. The OBO term is a nosological category / specifically dependent continuant, whereas this class is the material disease entity itself. Asserting rdfs:subClassOf between them is a category error, so the relation is recorded as skos:relatedMatch instead."@en ;
    rdfs:subClassOf mild:MILD_120020 ;
    skos:relatedMatch ns1:DOID_417 .

wont:WONT_0000470 a owl:Class ;
    rdfs:label "Lymphocele"@en ;
    ns1:IAO_0000115 "A material disease entity consisting in a collection of lymphatic fluid within a non-epithelialised cavity in a bodily structure."@en ;
    rdfs:comment "Bridging annotation, not subsumption. The OBO term is a nosological category / specifically dependent continuant, whereas this class is the material disease entity itself. Asserting rdfs:subClassOf between them is a category error, so the relation is recorded as skos:relatedMatch instead."@en ;
    rdfs:subClassOf mild:MILD_120020 ;
    skos:relatedMatch ns1:DOID_4347 .

wont:WONT_0000472 a owl:Class ;
    rdfs:label "Abscess"@en ;
    ns1:IAO_0000115 "A material disease entity consisting in a localized collection of purulent material within a bodily structure, surrounded by inflamed and granulating tissue."@en ;
    rdfs:comment "Bridging annotation, not subsumption. The OBO term is a phenotypic abnormality / nosological category, i.e. a specifically dependent continuant, whereas this class is the material disease entity itself. Asserting rdfs:subClassOf between them is a category error that renders both unsatisfiable, so the relation is recorded as skos:relatedMatch instead."@en ;
    rdfs:subClassOf mild:MILD_120020 ;
    skos:relatedMatch ns1:HP_0025615 .

wont:WONT_0000473 a owl:Class ;
    rdfs:label "Mucosal blister"@en ;
    ns1:IAO_0000115 "A material disease entity that is part of a mucosa and consists in a fluid-filled separation of the epithelium of that mucosa from the tissue beneath it."@en ;
    ns1:IAO_0000116 "The anatomical location uses BFO_0000050 part_of rather than RO_0004026 disease has location, deliberately. RO_0004026 carries rdfs:domain OGMS_0000031, the disposition-based disease class that MILD refuses as a parent; asserting it of a MILD_120020 material disease entity would infer that subsumption and silently reimport the OGMS commitment this ontology was built to avoid. That is the same domain trap already documented on BFO_0000218 in MILD. Plain mereology carries the intended content with no such side effect, and stays in the EL profile."@en ;
    rdfs:comment "Minted so that the blistering diseases of the mucosa can be composed out of the disorders that actually constitute them, rather than asserted as unanalysed nosological labels. Deliberately not restricted to autoimmune blistering: friction, thermal and drug-induced mucosal blisters are instances too. The autoimmune reading is added at the point of use by intersecting this class with WONT_0000469."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000050 ;
            owl:someValuesFrom ns1:UBERON_0000344 ],
        mild:MILD_120020 .

wont:WONT_0000477 a owl:Class ;
    rdfs:label "chronic"@en ;
    ns1:IAO_0000115 "A degree of time after disease inception that qualifies its bearer as chronic: the disorder has persisted beyond the period in which an orderly course is expected."@en ;
    rdfs:comment "PATO_0001863 chronic is a duration quality of a process; this quality is borne by the disorder itself, a material entity. Bridged, not subsumed."@en ;
    rdfs:subClassOf wont:WONT_0000475 ;
    skos:relatedMatch ns1:PATO_0001863 .

wont:WONT_0000487 a owl:Class ;
    rdfs:label "degree of tissue perfusion"@en ;
    ns1:IAO_0000115 "A quality of a wound that is the extent to which its tissue is supplied with blood."@en ;
    rdfs:subClassOf ns1:BFO_0000019 .

wont:WONT_0000488 a owl:Class ;
    rdfs:label "ischemic"@en ;
    ns1:IAO_0000115 "A degree of tissue perfusion that qualifies its bearer as ischemic: the blood supply to the tissue is insufficient for its metabolic needs."@en ;
    rdfs:subClassOf wont:WONT_0000487 .

wont:WONT_0000496 a owl:NamedIndividual,
        wont:WONT_0000492 ;
    rdfs:label "Zone of stasis"@en ;
    ns1:IAO_0000118 "Stasis"@en .

wont:WONT_0000497 a owl:NamedIndividual,
        wont:WONT_0000492 ;
    rdfs:label "Zone of hyperemia"@en ;
    ns1:IAO_0000118 "Hyperemia"@en .

wont:WONT_0000498 a owl:NamedIndividual,
        wont:WONT_0000492 ;
    rdfs:label "Zone of coagulation"@en ;
    ns1:IAO_0000118 "Coagulation"@en .

wont:WONT_0000514 a owl:Class ;
    rdfs:label "Malignant process"@en ;
    ns1:IAO_0000115 "A disease course process that has as participant a malignancy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom wont:WONT_0000465 ],
        mild:MILD_120028 .

wont:WONT_0000515 a owl:Class ;
    rdfs:label "Malignant process in wound development"@en ;
    ns1:IAO_0000115 "A malignant process that is a wound development subprocess."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000418 wont:WONT_0000514 ) ] .

wont:WONT_0000516 a owl:Class ;
    rdfs:label "Trauma process in wound development"@en ;
    ns1:IAO_0000115 "A trauma process that is a wound development subprocess."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000338 wont:WONT_0000418 ) ] .

wont:WONT_0000537 a owl:Class ;
    rdfs:label "Angiopathic disease process in wound development"@en ;
    ns1:IAO_0000115 "An angiopathic disease process that is a wound development subprocess."@en ;
    rdfs:subClassOf wont:WONT_0000522 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000418 wont:WONT_0000522 ) ] .

wont:WONT_0000538 a owl:Class ;
    rdfs:label "Autoimmune disease process in wound development"@en ;
    ns1:IAO_0000115 "An autoimmune disease process that is a wound development subprocess."@en ;
    rdfs:subClassOf wont:WONT_0000523 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000418 wont:WONT_0000523 ) ] .

wont:WONT_0000539 a owl:Class ;
    rdfs:label "Diabetes mellitus disease process in wound development"@en ;
    ns1:IAO_0000115 "A diabetes mellitus disease process that is a wound development subprocess."@en ;
    rdfs:subClassOf wont:WONT_0000535 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000418 wont:WONT_0000535 ) ] .

wont:WONT_0000541 a owl:Class ;
    rdfs:label "Venous insufficiency disease process in wound development"@en ;
    ns1:IAO_0000115 "A venous insufficiency disease process that is a wound development subprocess."@en ;
    rdfs:subClassOf wont:WONT_0000540 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000418 wont:WONT_0000540 ) ] .

wont:WONT_0000543 a owl:Class ;
    rdfs:label "Peripheral arterial occlusive disease process in wound development"@en ;
    ns1:IAO_0000115 "A peripheral arterial occlusive disease process that is a wound development subprocess."@en ;
    rdfs:subClassOf wont:WONT_0000542 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000418 wont:WONT_0000542 ) ] .

wont:WONT_0000555 a owl:Class ;
    rdfs:label "Foreign body"@en ;
    ns1:IAO_0000115 "A material entity that is located in a body part or wound of an organism, is not part of that organism, and has entered or been placed there from outside."@en ;
    rdfs:subClassOf ns1:BFO_0000040 .

wont:WONT_0000573 a owl:Class ;
    rdfs:label "Vascular assessment process"@en ;
    ns1:IAO_0000115 "A wound diagnostic process that evaluates the condition of the blood vessels supplying or draining the body region in which a wound is located."@en ;
    rdfs:subClassOf wont:WONT_0000395 .

wont:WONT_0000576 a owl:Class ;
    rdfs:label "Wound healing criterion"@en ;
    ns1:IAO_0000115 "A threshold specification that specifies a value of a wound attribute whose attainment indicates that a wound has healed or has reached a specified stage of healing."@en ;
    rdfs:subClassOf mild:MILD_120098 .

wont:WONT_0000583 a owl:Class ;
    rdfs:label "clinical function"@en ;
    ns1:IAO_0000115 "A function whose realization serves the prevention, diagnosis, treatment or monitoring of a disease in a patient."@en ;
    rdfs:subClassOf ns1:BFO_0000034 .

wont:WONT_0000585 a owl:Class ;
    rdfs:label "local anesthetic drug role"@en ;
    ns1:IAO_0000115 "A clinical drug role borne by a substance used to produce local anesthesia."@en ;
    rdfs:subClassOf ns1:DRON_00000001 .

wont:WONT_0000587 a owl:Class ;
    rdfs:label "Foreign body process in wound development"@en ;
    ns1:IAO_0000115 "A wound development subprocess in which a foreign body participates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom wont:WONT_0000555 ],
        wont:WONT_0000418 .

wont:WONT_0000589 a owl:Class ;
    rdfs:label "Antibiotic administration process"@en ;
    ns1:IAO_0000115 "A process of drug administration in which a material entity bearing an antibiotic drug role participates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:BFO_0000040 [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000087 ;
                                owl:someValuesFrom wont:WONT_0000578 ] ) ] ],
        wont:WONT_0000579 .

wont:WONT_0000590 a owl:Class ;
    rdfs:label "Inflammation process"@en ;
    ns1:IAO_0000115 "A wound healing related physiological process in which, in response to tissue injury, local blood vessels dilate and become more permeable and leukocytes migrate into the wound to clear debris and microorganisms."@en ;
    rdfs:subClassOf wont:WONT_0000409 .

wont:WONT_120005 a owl:Class ;
    rdfs:label "wound dressing fixation function"@en ;
    ns1:IAO_0000115 "A function that is realized in holding a wound dressing in place on or over a wound."@en ;
    rdfs:subClassOf ns1:BFO_0000034 .

wont:WONT_120012 a owl:Class ;
    rdfs:label "wound coverage function"@en ;
    ns1:IAO_0000115 "A function that is realized in covering a wound so that it is shielded from the external environment."@en ;
    rdfs:subClassOf ns1:BFO_0000034 .

wont:WONT_120013 a owl:Class ;
    rdfs:label "Wound dressing process"@en ;
    ns1:IAO_0000115 "A wound treatment process in which a wound dressing is applied to or renewed on a wound."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom wont:WONT_0000380 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom wont:WONT_0000398 ],
        wont:WONT_0000423 .

