    rdfs:label "potassium permanganate"@en ;
    ns1:IAO_0000118 "Crystal violet"@en ;
    rdfs:subClassOf wont:WONT_0000020 .

ns1:CHEBI_24757 a owl:Class ;
    rdfs:label "hypochlorous acid"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000087 ;
            owl:someValuesFrom ns1:CHEBI_48218 ],
        wont:WONT_0000188 .

ns1:CHEBI_27363 a owl:Class ;
    rdfs:label "zinc atom"@en ;
    rdfs:subClassOf wont:WONT_0000022 .

ns1:CHEBI_28694 a owl:Class ;
    rdfs:label "copper atom"@en ;
    rdfs:subClassOf wont:WONT_0000022 .

