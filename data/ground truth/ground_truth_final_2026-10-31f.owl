wont:WONT_0000006 a owl:Class ;
    rdfs:label "Active drain" ;
    ns1:IAO_0000115 "A drain that removes fluid or air from a wound or body cavity by negative pressure applied from a suction source, rather than by gravity or capillary action."@en ;
    rdfs:subClassOf wont:WONT_0000093 .

wont:WONT_0000016 a owl:Class ;
    rdfs:label "Antibiotic therapy plan specification"@en ;
    ns1:IAO_0000115 "A treatment plan specification that prescribes the administration to a patient of one or more drugs bearing the antibiotic role, including the agent, route and duration."@en ;
    ns1:IAO_0000118 "Antibiotic therapy"@en ;
    rdfs:subClassOf mild:MILD_120089 .

wont:WONT_0000025 a owl:Class ;
    rdfs:label "Antiseptic phenol derivative" ;
    ns1:IAO_0000115 "A material used for wound treatment that is a compound structurally derived from phenol, having a hydroxyl group bonded directly to an aromatic ring, and bears the antiseptic drug role."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000087 ;
            owl:someValuesFrom ns1:CHEBI_48218 ],
        wont:WONT_0000188 .

wont:WONT_0000058 a owl:Class ;
    rdfs:label "Capillary drain" ;
    ns1:IAO_0000115 "A passive drain that conducts wound fluid out of the wound by capillary action along narrow spaces within or between its fibres or channels, rather than through a single open lumen."@en ;
    rdfs:subClassOf wont:WONT_0000224 .

wont:WONT_0000088 a owl:Class ;
    rdfs:label "Diabetic wound"@en ;
    ns1:IAO_0000115 "A wound that is the output of a wound development process that has as part a process of the course of a diabetic metabolic disorder. No claim is made that the disorder caused the wound."@en ;
    rdfs:subClassOf wont:WONT_0000380 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000380 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0002353 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( wont:WONT_0000414 [ a owl:Restriction ;
                                            owl:onProperty ns1:BFO_0000051 ;
                                            owl:someValuesFrom wont:WONT_0000539 ] ) ] ] ) ] .

wont:WONT_0000177 a owl:Class ;
    rdfs:label "Low-vacuum drain" ;
    ns1:IAO_0000115 "An active drain that draws fluid out of a wound or body cavity under a mild negative pressure, weaker than that applied by a high-vacuum drain."@en ;
    rdfs:subClassOf wont:WONT_0000006 .

wont:WONT_0000248 a owl:Class ;
    rdfs:label "Wound healing by primary intention process"@en ;
    ns1:IAO_0000115 "A wound healing in which the directly approximated edges of a wound with little tissue loss join together, so that the wound closes with minimal granulation tissue formation and leaves a narrow scar."@en ;
    ns1:IAO_0000118 "Wound healing by primary intention"@en ;
    rdfs:subClassOf ns1:GO_0042060 .

wont:WONT_0000274 a owl:Class ;
    rdfs:label "Wound healing by secondary intention process"@en ;
    ns1:IAO_0000115 "A wound healing in which the wound edges are not approximated and the tissue defect is closed by the formation of granulation tissue, wound contraction and epithelialization."@en ;
    ns1:IAO_0000118 "Wound healing by secondary intention"@en ;
    rdfs:subClassOf ns1:GO_0042060 .

wont:WONT_0000285 a owl:Class ;
    rdfs:label "Skin graft" ;
    ns1:IAO_0000115 "A material entity that is a portion of skin, comprising epidermis and part or all of the dermis, that has been separated from its donor site and its blood supply and is transferred to a recipient site."@en ;
    rdfs:subClassOf ns1:BFO_0000040 .

wont:WONT_0000308 a owl:Class ;
    rdfs:label "Wound healing by tertiary intention process"@en ;
    ns1:IAO_0000115 "A wound healing in which the wound is initially left open and only closed surgically after a delay, with healing proceeding after this delayed primary closure."@en ;
    ns1:IAO_0000118 "Wound healing by tertiary intention"@en ;
    rdfs:subClassOf ns1:GO_0042060 .

wont:WONT_0000311 a owl:Class ;
    rdfs:label "Thoracic drain" ;
    ns1:IAO_0000115 "A drain that is inserted through the chest wall into the pleural cavity or mediastinum to evacuate air, fluid or blood from it."@en ;
    rdfs:subClassOf wont:WONT_0000093 .

wont:WONT_0000387 a owl:Class ;
    rdfs:label "Wound cleansing process" ;
    ns1:IAO_0000115 "A wound treatment process in which non-adherent material, exudate and microorganisms are removed from the wound surface and surrounding skin by rinsing or wiping with a cleansing solution, without excising tissue."@en ;
    rdfs:subClassOf wont:WONT_0000423 .

wont:WONT_0000419 a owl:Class ;
    rdfs:label "Wound size measurement process"@en ;
    ns1:IAO_0000115 "A wound diagnostic process that has as specified output a wound depth measurement datum."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom wont:WONT_0000448 ],
        wont:WONT_0000395 .

wont:WONT_0000426 a owl:Class ;
    rdfs:label "Wound with accompanying fracture" ;
    ns1:IAO_0000115 "A traumatic wound that is the output of a trauma process in wound development which also has as output a fracture of a bone in the same body region."@en ;
    rdfs:subClassOf wont:WONT_0000339,
        wont:WONT_0000380 .

wont:WONT_0000434 a owl:Class ;
    rdfs:label "degree of maceration"@en ;
    ns1:IAO_0000115 "A quality of a wound edge that is the extent to which its tissue has been softened by prolonged exposure to moisture."@en ;
    rdfs:subClassOf ns1:BFO_0000019 .

wont:WONT_0000436 a owl:Class ;
    rdfs:label "Burn classification scale"@en ;
    ns1:IAO_0000115 "A wound classification scale that stratifies burn wounds by the depth of tissue destroyed."@en ;
    rdfs:subClassOf wont:WONT_0000066 .

wont:WONT_0000437 a owl:Class ;
    rdfs:label "Burn classification grade"@en ;
    ns1:IAO_0000115 "A wound classification grade that is a category of the burn classification scale."@en ;
    rdfs:subClassOf wont:WONT_120016 .

wont:WONT_0000451 a owl:Class ;
    rdfs:label "degree of skin adherence to underlying tissue"@en ;
    ns1:IAO_0000115 "A quality of skin that is the extent to which it remains attached to the tissue beneath it."@en ;
    rdfs:subClassOf ns1:BFO_0000019 .

wont:WONT_0000452 a owl:Class ;
    rdfs:label "degree of granulation"@en ;
    ns1:IAO_0000115 "A quality of a wound base that is the extent to which it is covered by granulation tissue."@en ;
    rdfs:subClassOf ns1:BFO_0000019 .

wont:WONT_0000453 a owl:Class ;
    rdfs:label "degree of necrosis"@en ;
    ns1:IAO_0000115 "A quality of a wound base that is the extent to which its tissue is necrotic."@en ;
    rdfs:subClassOf ns1:BFO_0000019 .

wont:WONT_0000454 a owl:Class ;
    rdfs:label "degree of fibrin coverage"@en ;
    ns1:IAO_0000115 "A quality of a wound base that is the extent to which it is covered by fibrin."@en ;
    rdfs:subClassOf ns1:BFO_0000019 .

wont:WONT_0000463 a owl:Class ;
    rdfs:label "epithelialized"@en ;
    ns1:IAO_0000115 "A degree of epithelialization that qualifies its bearer as epithelialized."@en ;
    rdfs:subClassOf wont:WONT_0000455 .

wont:WONT_0000466 a owl:Class ;
    rdfs:label "Angiopathy"@en ;
    ns1:IAO_0000115 "A material disease entity consisting in an abnormal structure of the wall or of the lumen of one or more blood vessels, such that perfusion of the tissue those vessels supply is reduced."@en ;
    ns1:IAO_0000116 "Minted as the shared parent of Microangiopathy (WONT_0000201) and Peripheral arterial occlusive disease (WONT_0000229) so that Angiopathic wound (WONT_0000015) has a single material co-location target. Before the causal-role groupings were dissolved, the two sat side by side under a class that grouped them by what they were said to cause; they are grouped here by what they are."@en ;
    rdfs:subClassOf mild:MILD_120020 .

wont:WONT_0000471 a owl:Class ;
    rdfs:label "Scarring process"@en ;
    ns1:IAO_0000115 "A wound healing related physiological process in which fibrous connective tissue replaces tissue lost in a wound, yielding a scar rather than restoration of the original tissue architecture."@en ;
    rdfs:comment "Bridging annotation, not subsumption. HP_0100699 'Scarring' is a phenotypic abnormality, i.e. a quality and therefore a continuant, whereas this class is the process of scar formation. Asserting rdfs:subClassOf between them crosses the continuant/occurrent divide and renders both unsatisfiable, so the relation is recorded as skos:relatedMatch instead."@en ;
    rdfs:subClassOf wont:WONT_0000409 ;
    skos:relatedMatch ns1:HP_0100699 .

wont:WONT_0000479 a owl:Class ;
    rdfs:label "contaminated"@en ;
    ns1:IAO_0000115 "A degree of microbial burden that qualifies its bearer as contaminated: microorganisms are present in the wound but are not multiplying."@en ;
    rdfs:subClassOf wont:WONT_0000478 .

wont:WONT_0000480 a owl:Class ;
    rdfs:label "infected"@en ;
    ns1:IAO_0000115 "A degree of microbial burden that qualifies its bearer as infected: microorganisms are present in the wound, multiply in it and elicit a host response."@en ;
    ns1:IAO_0000116 "Added as a determinate beside the process reading, not instead of it: Infected wound (WONT_0000163) also participates in a wound infection process (WONT_0000410)."@en ;
    rdfs:subClassOf wont:WONT_0000478 .

wont:WONT_0000486 a owl:Class ;
    rdfs:label "sterile"@en ;
    ns1:IAO_0000115 "A degree of microbial burden that qualifies its bearer as sterile: no viable microorganisms are present in the wound."@en ;
    rdfs:comment "PATO_0000956 sterile is a fertility quality and is deliberately not used here."@en ;
    rdfs:subClassOf wont:WONT_0000478 .

wont:WONT_0000510 a owl:Class ;
    rdfs:label "Arterial insufficiency wound"@en ;
    ns1:IAO_0000115 "A wound that is the output of a wound development process that has as part a process of the course of a peripheral arterial occlusive disease. No claim is made that the disorder caused the wound."@en ;
    ns1:IAO_0000118 "arterial insufficiency ulcer"@en,
        "arterial wound"@en,
        "ischemic ulcer"@en ;
    rdfs:subClassOf wont:WONT_0000015,
        wont:WONT_0000380 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000380 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0002353 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( wont:WONT_0000414 [ a owl:Restriction ;
                                            owl:onProperty ns1:BFO_0000051 ;
                                            owl:someValuesFrom wont:WONT_0000543 ] ) ] ] ) ] .

wont:WONT_0000512 a owl:Class ;
    rdfs:label "colonized"@en ;
    ns1:IAO_0000115 "A degree of microbial burden that qualifies its bearer as colonized: microorganisms are present in the wound and multiply in it, without invading its tissue or eliciting a host response."@en ;
    rdfs:subClassOf wont:WONT_0000478 .

wont:WONT_0000513 a owl:Class ;
    rdfs:label "Partial thickness"@en ;
    ns1:IAO_0000115 "A burn wound classification grade according to Hildanus and Derganc in which the injury extends into but not through the dermis; its instances are the superficial and the deep partial-thickness grade."@en ;
    ns1:IAO_0000118 "Second degree"@en ;
    rdfs:subClassOf wont:WONT_0000495 .

wont:WONT_0000517 a owl:Class ;
    rdfs:label "Acidity impact process"@en ;
    ns1:IAO_0000115 "A process in which an acid or a base acts on a tissue."@en ;
    rdfs:subClassOf ns1:BFO_0000015 .

wont:WONT_0000518 a owl:Class ;
    rdfs:label "Heat impact process"@en ;
    ns1:IAO_0000115 "A process in which heat acts on a tissue."@en ;
    rdfs:subClassOf wont:WONT_0000338 .

wont:WONT_0000519 a owl:Class ;
    rdfs:label "Pressure impact process"@en ;
    ns1:IAO_0000115 "A process in which sustained mechanical pressure acts on a tissue."@en ;
    ns1:IAO_0000118 "Sustained mechanical load"@en,
        "Sustained mechanical load process"@en ;
    rdfs:subClassOf ns1:BFO_0000015 .

wont:WONT_0000523 a owl:Class ;
    rdfs:label "Autoimmune disease process"@en ;
    ns1:IAO_0000115 "A disease course process of an autoimmune tissue disorder."@en ;
    rdfs:subClassOf mild:MILD_120028 .

wont:WONT_0000540 a owl:Class ;
    rdfs:label "Venous insufficiency disease process"@en ;
    ns1:IAO_0000115 "A course of the disease process that has as participant a venous insufficiency disorder."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom wont:WONT_0000468 ],
        mild:MILD_120028 .

wont:WONT_0000542 a owl:Class ;
    rdfs:label "Peripheral arterial occlusive disease process"@en ;
    ns1:IAO_0000115 "An angiopathic disease process that has as participant a peripheral arterial occlusive disease."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom wont:WONT_0000229 ],
        wont:WONT_0000522 .

wont:WONT_0000568 a owl:Class ;
    rdfs:label "Pressure offloading process"@en ;
    ns1:IAO_0000115 "A wound treatment process that realizes a pressure redistribution function, in which mechanical load on the wound site is reduced or removed."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000055 ;
            owl:someValuesFrom wont:WONT_0000580 ],
        wont:WONT_0000423 .

wont:WONT_0000578 a owl:Class ;
    rdfs:label "antibiotic drug role"@en ;
    ns1:IAO_0000115 "A clinical drug role borne by a substance used to kill bacteria or inhibit their growth."@en ;
    rdfs:subClassOf ns1:DRON_00000001 .

wont:WONT_0000579 a owl:Class ;
    rdfs:label "Process of drug administration"@en ;
    ns1:IAO_0000115 "A process in which a material entity bearing a clinical drug role is introduced into or applied onto the body of a patient."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( ns1:BFO_0000040 [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000087 ;
                                owl:someValuesFrom ns1:DRON_00000001 ] ) ] ],
        ns1:BFO_0000015 .

wont:WONT_0000586 a owl:Class ;
    rdfs:label "Neuropathic disease process"@en ;
    ns1:IAO_0000115 "A course of the disease process that has as participant a peripheral nervous system disease (peripheral neuropathy)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom ns1:DOID_574 ],
        mild:MILD_120028 .

wont:WONT_120004 a owl:Class ;
    rdfs:label "wound dressing layer function"@en ;
    ns1:IAO_0000115 "A function that is borne by a layer of a wound dressing and is realized in processes in which that layer contributes to the action of the dressing on the wound."@en ;
    rdfs:subClassOf ns1:BFO_0000034 .

wont:WONT_120017 a owl:Class ;
    rdfs:label "Wound classification result"@en ;
    ns1:IAO_0000115 "A disease stage classification result that is about a wound and that is the specified output of a wound classification process."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000136 ;
            owl:someValuesFrom wont:WONT_0000380 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000312 ;
            owl:someValuesFrom wont:WONT_120015 ],
        mild:MILD_120054 .

wont:WONT_120020 a owl:Class ;
    rdfs:label "Necrotic material"@en ;
    ns1:IAO_0000115 "A material disease entity consisting of a portion of a patient's tissue whose cells have died through pathological cell death while that portion remains within or attached to the body."@en ;
    rdfs:subClassOf mild:MILD_120020 .

ns1:CHEBI_3095 a owl:Class ;
    rdfs:label "biguanide" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000087 ;
            owl:someValuesFrom ns1:CHEBI_48218 ],
        wont:WONT_0000188 .

ns1:CHEBI_33284 a owl:Class ;
    rdfs:label "nutrient" .

ns1:PATO_0000117 a owl:Class ;
    rdfs:label "size" .

ns1:PATO_0000136 a owl:Class ;
    rdfs:label "closure" .

ns1:PATO_0001595 a owl:Class ;
    rdfs:label "depth" .

ns1:RO_0000085 a owl:ObjectProperty .

ns1:RO_0001025 a owl:ObjectProperty ;
    rdfs:label "located in"@en .

wont:WONT_0000010 a owl:Class ;
    rdfs:label "Antiseptic alcohol"@en ;
    ns1:IAO_0000115 "A material used for wound treatment that is an alcohol, an organic compound bearing a hydroxyl group on a saturated carbon atom, and that bears the antiseptic drug role."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000087 ;
            owl:someValuesFrom ns1:CHEBI_48218 ],
        wont:WONT_0000188 .

wont:WONT_0000044 a owl:Class ;
    rdfs:label "Bite wound" ;
    ns1:IAO_0000115 "A traumatic wound that is the output of a trauma process in wound development in which the teeth of a human or an animal penetrate, tear or crush the tissue."@en ;
    rdfs:subClassOf wont:WONT_0000339 .

wont:WONT_0000112 a owl:Class ;
    rdfs:label "Fixing bandage" ;
    ns1:IAO_0000115 "A wound dressing that is a strip or tube of flexible material applied around a body part to hold another wound dressing in place over a wound."@en ;
    rdfs:subClassOf wont:WONT_0000398 .

wont:WONT_0000224 a owl:Class ;
    rdfs:label "Passive drain" ;
    ns1:IAO_0000115 "A drain that removes fluid by gravity, capillary action or pressure differences arising in the body, without suction from an external source."@en ;
    rdfs:subClassOf wont:WONT_0000093 .

wont:WONT_0000338 a owl:Class ;
    rdfs:label "Trauma process"@en ;
    ns1:IAO_0000115 "A process in which a sudden external mechanical force acts on a tissue."@en ;
    rdfs:subClassOf ns1:BFO_0000015 .

wont:WONT_0000427 a owl:Class ;
    rdfs:label "Wound-integrating wound dressing" ;
    rdfs:subClassOf wont:WONT_0000398 .

wont:WONT_0000455 a owl:Class ;
    rdfs:label "degree of epithelialization"@en ;
    ns1:IAO_0000115 "A quality of a wound base that is the extent to which it has been covered by new epithelium."@en ;
    rdfs:subClassOf ns1:BFO_0000019 .

wont:WONT_0000475 a owl:Class ;
    rdfs:label "degree of time after disease inception"@en ;
    ns1:IAO_0000115 "A quality of a material disease entity that is the time that has elapsed since the disorder came into existence, taken relative to the course expected for a disorder of its kind."@en ;
    rdfs:subClassOf ns1:BFO_0000019 .

wont:WONT_0000492 a owl:Class ;
    rdfs:label "Jackson burn wound zone"@en ;
    ns1:IAO_0000115 "A burn classification grade that is one of the three concentric zones of a burn wound distinguished by Jackson according to the severity of tissue damage."@en ;
    ns1:IAO_0000118 "Burn classification grade of the Jackson classification"@en ;
    rdfs:subClassOf wont:WONT_0000437 .

wont:WONT_0000495 a owl:Class ;
    rdfs:label "Burn wound classification grade according to Hildanus and Derganc"@en ;
    ns1:IAO_0000115 "A burn classification grade that is a category of the burn wound classification according to Hildanus and Derganc."@en ;
    rdfs:subClassOf wont:WONT_0000437 .

wont:WONT_0000522 a owl:Class ;
    rdfs:label "Angiopathic disease process"@en ;
    ns1:IAO_0000115 "A disease course process of an angiopathy."@en ;
    rdfs:subClassOf mild:MILD_120028 .

wont:WONT_0000580 a owl:Class ;
    rdfs:label "pressure redistribution function"@en ;
    ns1:IAO_0000115 "A function that is realized by spreading the mechanical load exerted on a body surface over a larger contact area or over time, thereby lowering the pressure on any single region."@en ;
    rdfs:subClassOf ns1:BFO_0000034 .

wont:WONT_120015 a owl:Class ;
    rdfs:label "Wound classification process"@en ;
    ns1:IAO_0000115 "A disease classification process that has as specified output a wound classification result."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom wont:WONT_120017 ],
        mild:MILD_120055 .

wont:WONT_120018 a owl:Class ;
    rdfs:label "wound infecting tendency"@en ;
    rdfs:subClassOf mild:MILD_120005 .

ns1:COB_0001300 a owl:Class ;
    rdfs:label "device" .

ns1:IAO_0000136 a owl:ObjectProperty .

ns1:NCBITaxon_2 a owl:Class .

wont:WONT_0000029 a owl:Class ;
    rdfs:label "Aseptic conditions plan specification"@en ;
    ns1:IAO_0000115 "A wound treatment plan specification that prescribes that wound treatment be carried out with sterile instruments, materials and techniques so that microorganisms are not introduced into the wound."@en ;
    rdfs:subClassOf wont:WONT_0000200 .

wont:WONT_0000310 a owl:Class ;
    rdfs:label "Thermal wound" ;
    ns1:IAO_0000115 "A traumatic wound that is the output of a heat impact process in wound development, in which tissue is damaged by the action of excessive heat."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0002353 ;
            owl:someValuesFrom wont:WONT_0000140 ],
        wont:WONT_0000339 .

wont:WONT_0000342 a owl:Class ;
    rdfs:label "Tscherne and Oestern wound classification grade" ;
    ns1:IAO_0000115 "A wound classification grade that is a category of the Tscherne and Oestern wound classification."@en ;
    rdfs:subClassOf wont:WONT_120016 .

wont:WONT_0000389 a owl:Class ;
    rdfs:label "Wound closure technique plan specification"@en ;
    ns1:IAO_0000115 "A treatment plan specification that prescribes the method and means by which a wound is to be closed in a wound closure process."@en ;
    ns1:IAO_0000118 "Wound closure technique"@en ;
    rdfs:subClassOf mild:MILD_120089 .

wont:WONT_0000404 a owl:Class ;
    rdfs:label "Wound exudate" ;
    ns1:IAO_0000115 "A material entity that is fluid released from the tissues of a wound, derived from blood plasma that has passed from the vasculature into the wound."@en ;
    rdfs:subClassOf ns1:BFO_0000040 .

wont:WONT_0000412 a owl:Class ;
    rdfs:label "Wound irrigation solution" ;
    ns1:IAO_0000115 "A clinical drug product that is a liquid formulated for rinsing a wound in a wound irrigation process."@en ;
    rdfs:subClassOf ns1:DRON_00000005 .

wont:WONT_0000438 a owl:Class ;
    rdfs:label "Shea classification grade"@en ;
    ns1:IAO_0000115 "A wound classification grade that is a category of the Shea classification of pressure ulcers."@en ;
    rdfs:subClassOf wont:WONT_120016 .

wont:WONT_0000440 a owl:Class ;
    rdfs:label "CDC surgical wound classification grade"@en ;
    ns1:IAO_0000115 "A wound classification grade that is a category of the CDC surgical wound classification."@en ;
    rdfs:subClassOf wont:WONT_120016 .

wont:WONT_0000524 a owl:Class ;
    rdfs:label "Wound with microbial burden assessed according to CDC"@en ;
    ns1:IAO_0000115 "A wound that is classified by the CDC surgical wound classification: clean, clean-contaminated, contaminated or dirty, according to the state of the operative field."@en ;
    rdfs:subClassOf wont:WONT_0000380 .

wont:WONT_0000529 a owl:Class ;
    rdfs:label "IWII wound classification grade"@en ;
    ns1:IAO_0000115 "A wound classification grade that is a category of the IWII wound classification scale."@en ;
    rdfs:subClassOf wont:WONT_120016 .

wont:WONT_0000535 a owl:Class ;
    rdfs:label "Diabetes mellitus disease process"@en ;
    ns1:IAO_0000115 "A disease course process of a diabetic metabolic disorder."@en ;
    rdfs:subClassOf mild:MILD_120028 .

wont:WONT_0000561 a owl:Class ;
    rdfs:label "Wound healing phase"@en ;
    ns1:IAO_0000115 "A wound classification grade of the scheme that divides wound healing into phases (hemostasis, inflammatory, proliferative, remodeling). The phases are labels assigned to stretches of the healing process, not processes themselves; each is about the processes it groups."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000136 ;
            owl:someValuesFrom ns1:GO_0042060 ],
        wont:WONT_120016 .

wont:WONT_0007817 a owl:Class ;
    rdfs:label "Injury"@en ;
    ns1:IAO_0000115 "A material disease entity that is structural damage to a tissue or an organ, however it came about."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0001025 ;
            owl:someValuesFrom ns1:FMA_67504 ],
        mild:MILD_120020 .

ns1:PATO_0000014 a owl:Class ;
    rdfs:label "color" .

wont:WONT_0000022 a owl:Class ;
    rdfs:label "Antiseptic metal ion"@en ;
    ns1:IAO_0000115 "A material used for wound treatment that consists of positively charged metal atoms, or of a material releasing them, and bears the antiseptic drug role."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000087 ;
            owl:someValuesFrom ns1:CHEBI_48218 ],
        wont:WONT_0000188 .

wont:WONT_0000135 a owl:Class ;
    rdfs:label "Gustilo and Anderson wound classification grade"@en ;
    ns1:IAO_0000115 "A wound classification grade that is a category of the Gustilo and Anderson wound classification."@en ;
    rdfs:subClassOf wont:WONT_120016 .

wont:WONT_0000301 a owl:Class ;
    rdfs:label "Suture in situ"@en ;
    ns1:IAO_0000115 "A device consisting of suture material that has been placed through or around tissue of a patient and secured there so that it holds the tissue in apposition or in position."@en ;
    rdfs:subClassOf ns1:COB_0001300 .

wont:WONT_0000339 a owl:Class ;
    rdfs:label "Traumatic wound" ;
    ns1:IAO_0000115 "A wound that is the output of a trauma process in wound development."@en ;
    rdfs:subClassOf wont:WONT_0000380 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000380 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0002353 ;
                        owl:someValuesFrom wont:WONT_0000516 ] ) ] .

wont:WONT_0000478 a owl:Class ;
    rdfs:label "degree of microbial burden"@en ;
    ns1:IAO_0000115 "A quality of a wound that is the extent to which microorganisms are present in it, multiply in it and elicit a response from its bearer."@en ;
    rdfs:subClassOf ns1:BFO_0000019 .

ns1:BFO_0000050 a owl:ObjectProperty .

ns1:GO_0042060 a owl:Class ;
    ns1:IAO_0000118 "wound healing process"@en .

wont:WONT_0000089 a owl:Class ;
    rdfs:label "Diagnostic process to assess wound characteristics" ;
    ns1:IAO_0000115 "A wound diagnostic process in which the wound itself is examined and that has as specified output data about qualities of that wound."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom wont:WONT_0000380 ],
        wont:WONT_0000395 .

wont:WONT_0000406 a owl:Class ;
    rdfs:label "Wound gel/ointment/cream" ;
    ns1:IAO_0000115 "A clinical drug product that has a semisolid dosage form and is intended for topical application to a wound."@en ;
    rdfs:subClassOf ns1:DRON_00000005 .

wont:WONT_0000481 a owl:Class ;
    rdfs:label "Wound with microbial burden assessed according to IWII"@en ;
    ns1:IAO_0000115 "A wound whose microbial burden is assessed on the IWII wound infection continuum: it bears the quality sterile, contaminated, colonized or infected."@en ;
    rdfs:subClassOf wont:WONT_0000380 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000380 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000086 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( wont:WONT_0000479 wont:WONT_0000480 wont:WONT_0000486 wont:WONT_0000512 ) ] ] ) ] .

ns1:BFO_0000015 a owl:Class ;
    rdfs:label "process" .

wont:WONT_0000084 a owl:Class ;
    rdfs:label "Debridement process"@en ;
    ns1:IAO_0000115 "A wound cleansing process in which necrotic or devitalized tissue, slough, foreign material and debris are removed from the wound."@en ;
    rdfs:subClassOf wont:WONT_0000387 .

wont:WONT_0000441 a owl:Class ;
    rdfs:label "Skin wound"@en ;
    ns1:IAO_0000115 "A wound whose disrupted tissue is skin."@en ;
    rdfs:comment "WONT-owned material counterpart of HP_0032674 Cutaneous wound. HP models it as a phenotypic abnormality (a specifically dependent continuant); WONT needs a material wound, so the two are related rather than one subsuming the other."@en ;
    rdfs:subClassOf wont:WONT_0000380 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000380 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0001025 ;
                        owl:someValuesFrom ns1:FMA_7163 ] ) ] ;
    skos:relatedMatch ns1:HP_0032674 .

wont:WONT_120016 a owl:Class ;
    rdfs:label "wound classification grade"@en ;
    ns1:IAO_0000115 "A disease classification stage that is assigned to a wound under a wound grading system and ranks the wound according to its severity."@en ;
    rdfs:subClassOf mild:MILD_120000 .

ns1:RO_0000056 a owl:ObjectProperty ;
    rdfs:label "participates in"@en .

wont:WONT_0000200 a owl:Class ;
    rdfs:label "Wound treatment plan specification"@en ;
    ns1:IAO_0000115 "A medical condition treatment plan specification that prescribes actions to be carried out on or for a wound with the aim of promoting its healing or preventing its deterioration."@en ;
    ns1:IAO_0000118 "Method used for wound treatment"@en ;
    rdfs:subClassOf mild:MILD_120099 .

wont:WONT_0000382 a owl:Class ;
    rdfs:label "Wound base" ;
    ns1:IAO_0000115 "A material entity that is part of a wound and consists of the tissue forming the floor of the wound, bounded by the wound edges."@en ;
    ns1:IAO_0000116 "Structural axiom, not a definition. This class was label-only under a bare BFO_0000040, so nothing in the ontology said it had anything to do with a wound - the mereology lived only in the class name. Asserting part_of some Wound makes the name's claim checkable and is what CQ025 was failing on. No genus-differentia definition is written here; per the C6 decision the axiom is left to carry the content."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000050 ;
            owl:someValuesFrom wont:WONT_0000380 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000086 ;
            owl:someValuesFrom wont:WONT_0000452 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000086 ;
            owl:someValuesFrom wont:WONT_0000453 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000086 ;
            owl:someValuesFrom wont:WONT_0000454 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000086 ;
            owl:someValuesFrom wont:WONT_0000455 ],
        ns1:BFO_0000040 .

wont:WONT_0000423 a owl:Class ;
    rdfs:label "Wound treatment process"@en ;
    ns1:IAO_0000115 "A disease disorder treatment process that has as participant a wound and is directed at that wound's healing or management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom wont:WONT_0000380 ],
        mild:MILD_120086 .

wont:WONT_0000066 a owl:Class ;
    rdfs:label "Wound classification scale"@en ;
    ns1:IAO_0000115 "An information content entity that is a specified input of a wound classification process."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000295 ;
            owl:someValuesFrom wont:WONT_120015 ],
        ns1:IAO_0000030 .

wont:WONT_0000093 a owl:Class ;
    rdfs:label "Drain" ;
    ns1:IAO_0000115 "A material used for wound treatment that is a device placed in a wound or surgical site to conduct accumulated fluid or air out of it."@en ;
    rdfs:subClassOf wont:WONT_0000188 .

wont:WONT_0000414 a owl:Class ;
    rdfs:label "Wound development process"@en ;
    ns1:IAO_0000115 "A disorder development process in which a wound comes into being in a patient through disruption of the continuity of body tissue."@en ;
    rdfs:subClassOf mild:MILD_120021 .

ns1:BFO_0000051 a owl:ObjectProperty .

ns1:BFO_0000019 a owl:Class ;
    rdfs:label "quality" .

ns1:BFO_0000034 a owl:Class .

wont:WONT_0000401 a owl:Class ;
    rdfs:label "Wound edge" ;
    ns1:IAO_0000115 "A material entity that is part of a wound and consists of the tissue at the margin of the wound where the wound bed adjoins the surrounding intact skin."@en ;
    ns1:IAO_0000116 "Structural axiom, not a definition. This class was label-only under a bare BFO_0000040, so nothing in the ontology said it had anything to do with a wound - the mereology lived only in the class name. Asserting part_of some Wound makes the name's claim checkable and is what CQ025 was failing on. No genus-differentia definition is written here; per the C6 decision the axiom is left to carry the content."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000050 ;
            owl:someValuesFrom wont:WONT_0000380 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000086 ;
            owl:someValuesFrom wont:WONT_0000434 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000086 ;
            owl:someValuesFrom wont:WONT_0000451 ],
        ns1:BFO_0000040 .

wont:WONT_0000418 a owl:Class ;
    rdfs:label "Wound development subprocess"@en ;
    ns1:IAO_0000115 "A process that has the newly developed wound as a participant or output and does so with near certainty."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000050 ;
            owl:someValuesFrom wont:WONT_0000414 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom ns1:FMA_67135 ],
        mild:MILD_120021 .

ns1:CHEBI_48218 a owl:Class ;
    rdfs:label "antiseptic drug" .

ns1:RO_0000057 a owl:ObjectProperty .

wont:WONT_0000395 a owl:Class ;
    rdfs:label "Wound diagnostic process"@en ;
    ns1:IAO_0000115 "A disease diagnostic process that is directed at a wound of a patient and assesses whether it is present and what its nature and characteristics are."@en ;
    rdfs:subClassOf mild:MILD_120047 .

ns1:RO_0002353 a owl:ObjectProperty ;
    rdfs:label "output of"@en .

wont:WONT_0000188 a owl:Class ;
    rdfs:label "Material used for wound treatment" ;
    ns1:IAO_0000115 "A material entity that is intended to be applied to or placed in a wound in the course of a wound treatment process."@en ;
    rdfs:subClassOf ns1:BFO_0000040 .

wont:WONT_0000409 a owl:Class ;
    rdfs:label "Wound healing related physiological process"@en ;
    ns1:IAO_0000115 "A biological_process that occurs in an organism after tissue injury and is part of the restoration of the integrity of the injured tissue."@en ;
    rdfs:subClassOf ns1:GO_0008150 .

wont:WONT_0000376 a owl:Class ;
    rdfs:label "Wagner and Anderson wound classification grade" ;
    ns1:IAO_0000115 "A wound classification grade that is a category of the Wagner and Anderson wound classification."@en ;
    rdfs:subClassOf wont:WONT_120016 .

ns1:RO_0000087 a owl:ObjectProperty ;
    rdfs:label "has role"@en .

wont:WONT_0000398 a owl:Class ;
    rdfs:label "Wound dressing" ;
    ns1:IAO_0000115 "A device that bears a wound coverage function."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000056 ;
            owl:someValuesFrom wont:WONT_120013 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000085 ;
            owl:someValuesFrom wont:WONT_120012 ],
        ns1:COB_0001300 .

wont:WONT_0000315 a owl:Class ;
    rdfs:label "Thread size" ;
    ns1:IAO_0000115 "A size that inheres in a surgical suture thread and corresponds to a designation of its diameter in a standardized suture sizing scale."@en ;
    rdfs:subClassOf ns1:PATO_0000117 .

ns1:BFO_0000040 a owl:Class ;
    rdfs:label "material entity" .

ns1:RO_0000086 a owl:ObjectProperty ;
    rdfs:label "has quality"@en .

wont:WONT_0000380 a owl:Class ;
    rdfs:label "Wound" ;
    ns1:IAO_0000115 "An injury that has as part a portion of the skin, alone or in continuity with damaged deeper tissue such as fascia, muscle or bone, and that is the output of a wound development process. Damaged skin tissue is a wound even while it is still attached, such as necrotic skin; an injury that involves no skin, such as a burn of the inner airways, is no wound."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000086 ;
            owl:someValuesFrom ns1:PATO_0000117 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000086 ;
            owl:someValuesFrom ns1:PATO_0000136 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000086 ;
            owl:someValuesFrom ns1:PATO_0001595 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000086 ;
            owl:someValuesFrom wont:WONT_0000475 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000086 ;
            owl:someValuesFrom wont:WONT_0000478 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0002353 ;
            owl:someValuesFrom wont:WONT_0000414 ],
        wont:WONT_0007817 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0007817 [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000051 ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty ns1:BFO_0000050 ;
                                owl:someValuesFrom ns1:FMA_7163 ] ] ) ] .

