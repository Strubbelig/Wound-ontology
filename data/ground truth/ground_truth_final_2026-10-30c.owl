    ns1:IAO_0000118 "Aseptic wound"@en,
        "Sterile wound"@en ;
    rdfs:subClassOf wont:WONT_0000481 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000481 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000086 ;
                        owl:someValuesFrom wont:WONT_0000486 ] ) ] .

