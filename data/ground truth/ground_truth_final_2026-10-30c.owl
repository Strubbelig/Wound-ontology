wont:WONT_0000380 a owl:Class ;
    rdfs:label "Wound" ;
    ns1:IAO_0000115 "An injury that has as part a portion of the skin, alone or in continuity with damaged deeper tissue such as fascia, muscle or bone, and that is the output of a wound development process. Damaged skin tissue is a wound even while it is still attached, such as necrotic skin; an injury that involves no skin, such as a burn of the inner airways, is no wound."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000086 ;
            owl:someValuesFrom ns1:PATO_0000117 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000086 ;
            owl:someValuesFrom ns1:PATO_0000136 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000086 ;
            owl:someValuesFrom ns1:PATO_0001595 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000086 ;
            owl:someValuesFrom wont:WONT_0000475 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000086 ;
            owl:someValuesFrom wont:WONT_0000478 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0002353 ;
            owl:someValuesFrom wont:WONT_0000414 ],
        wont:WONT_0007817 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0007817 [ a owl:Restriction ;
                        owl:onProperty ns1:BFO_0000051 ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty ns1:BFO_0000050 ;
                                owl:someValuesFrom ns1:FMA_7163 ] ] ) ] .

