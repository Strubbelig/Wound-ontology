    ns1:IAO_0000118 "Coagulation"@en .

wont:WONT_0000514 a owl:Class ;
    rdfs:label "Malignant process"@en ;
    ns1:IAO_0000115 "A disease course process that has as participant a malignancy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000057 ;
            owl:someValuesFrom wont:WONT_0000465 ],
        mild:MILD_120028 .

wont:WONT_0000515 a owl:Class ;
    rdfs:label "Wound causing malignant process"@en ;
    ns1:IAO_0000115 "A malignant process that is a wound causing process."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000418 wont:WONT_0000514 ) ] .

wont:WONT_0000516 a owl:Class ;
    rdfs:label "Wound causing trauma process"@en ;
    ns1:IAO_0000115 "A trauma process that is a wound causing process."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000338 wont:WONT_0000418 ) ] .

wont:WONT_0000517 a owl:Class ;
    rdfs:label "Acidity impact process"@en ;
    ns1:IAO_0000115 "A process in which an acid or a base acts on a tissue."@en ;
    rdfs:subClassOf ns1:BFO_0000015 .

wont:WONT_0000518 a owl:Class ;
    rdfs:label "Heat impact process"@en ;
    ns1:IAO_0000115 "A process in which heat acts on a tissue."@en ;
    rdfs:subClassOf wont:WONT_0000338 .

wont:WONT_0000519 a owl:Class ;
    rdfs:label "Pressure impact process"@en ;
    ns1:IAO_0000115 "A process in which sustained mechanical pressure acts on a tissue."@en ;
    ns1:IAO_0000118 "Sustained mechanical load"@en,
        "Sustained mechanical load process"@en ;
    rdfs:subClassOf ns1:BFO_0000015 .

wont:WONT_0000537 a owl:Class ;
    rdfs:label "Wound causing angiopathic disease process"@en ;
    ns1:IAO_0000115 "An angiopathic disease process that is a wound causing process."@en ;
    rdfs:subClassOf wont:WONT_0000522 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000418 wont:WONT_0000522 ) ] .

wont:WONT_0000538 a owl:Class ;
    rdfs:label "Wound causing autoimmune disease process"@en ;
    ns1:IAO_0000115 "An autoimmune disease process that is a wound causing process."@en ;
    rdfs:subClassOf wont:WONT_0000523 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000418 wont:WONT_0000523 ) ] .

wont:WONT_0000539 a owl:Class ;
    rdfs:label "Wound causing diabetes mellitus disease process"@en ;
    ns1:IAO_0000115 "A diabetes mellitus disease process that is a wound causing process."@en ;
    rdfs:subClassOf wont:WONT_0000535 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000418 wont:WONT_0000535 ) ] .

wont:WONT_0000541 a owl:Class ;
    rdfs:label "Wound causing venous insufficiency disease process"@en ;
    ns1:IAO_0000115 "A venous insufficiency disease process that is a wound causing process."@en ;
    rdfs:subClassOf wont:WONT_0000540 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000418 wont:WONT_0000540 ) ] .

wont:WONT_0000543 a owl:Class ;
    rdfs:label "Wound causing peripheral arterial occlusive disease process"@en ;
    ns1:IAO_0000115 "A peripheral arterial occlusive disease process that is a wound causing process."@en ;
    rdfs:subClassOf wont:WONT_0000542 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000418 wont:WONT_0000542 ) ] .

