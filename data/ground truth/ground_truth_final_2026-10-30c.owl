wont:WONT_0000229 a owl:Class ;
    rdfs:label "Peripheral arterial occlusive disease" ;
    ns1:IAO_0000116 "Recategorised when the causal-role groupings 'Medical condition contributing to wound formation' / 'affecting wound healing' / 'contributing to blistering wounds' were dissolved. Those classes grouped entities by what they were said to cause, which this ontology does not assert, and they mixed material disorders with dispositions and processes. Relevance to wounds is now carried by co-location axioms on the wound classes instead of by membership in a causal class."@en ;
    rdfs:subClassOf wont:WONT_0000466 .

wont:WONT_0000245 a owl:Class ;
    rdfs:label "Wound causing pressure impact process"@en ;
