<https://bioportal.bioontology.org/ontologies/WONT> a owl:Ontology ;
    dcterms:description "A domain ontology of wounds, wound assessment, wound classification and wound treatment. WONT is the domain layer over the Mid Layer Disease Ontology (MILD): a wound is modelled as a MILD material disease entity, and wound treatment, diagnosis and classification specialise the corresponding MILD processes and results."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "Wound Ontology"@en ;
    owl:imports <https://bioportal.bioontology.org/ontologies/MILD> .

wont:WONT_0000004 a owl:Class ;
    rdfs:label "Wound causing acidity impact process"@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000418 wont:WONT_0000517 ) ] .

wont:WONT_0000005 a owl:Class ;
    rdfs:label "Activated carbon layer wound dressing" ;
    rdfs:subClassOf wont:WONT_0000398 .

wont:WONT_0000008 a owl:Class ;
    rdfs:label "Adhesive silicone grid" ;
    rdfs:subClassOf wont:WONT_0000280 .

