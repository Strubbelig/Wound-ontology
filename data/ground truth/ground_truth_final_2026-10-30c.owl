wont:WONT_0000088 a owl:Class ;
    rdfs:label "Diabetic wound"@en ;
    ns1:IAO_0000115 "A wound that is the output of a wound development process that has as part a wound causing process of the course of a diabetic metabolic disorder. No claim is made that the disorder caused the wound."@en ;
    rdfs:subClassOf wont:WONT_0000380 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000380 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0002353 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( wont:WONT_0000414 [ a owl:Restriction ;
                                            owl:onProperty ns1:BFO_0000051 ;
                                            owl:someValuesFrom wont:WONT_0000539 ] ) ] ] ) ] .

wont:WONT_0000177 a owl:Class ;
    rdfs:label "Low-vacuum drain" ;
    rdfs:subClassOf wont:WONT_0000006 .

wont:WONT_0000248 a owl:Class ;
    rdfs:label "Wound healing by primary intention process"@en ;
    ns1:IAO_0000118 "Wound healing by primary intention"@en ;
    rdfs:subClassOf ns1:GO_0042060 .

wont:WONT_0000274 a owl:Class ;
    rdfs:label "Wound healing by secondary intention process"@en ;
    ns1:IAO_0000118 "Wound healing by secondary intention"@en ;
    rdfs:subClassOf ns1:GO_0042060 .

wont:WONT_0000285 a owl:Class ;
    rdfs:label "Skin graft" ;
    rdfs:subClassOf ns1:BFO_0000040 .

wont:WONT_0000308 a owl:Class ;
    rdfs:label "Wound healing by tertiary intention process"@en ;
    ns1:IAO_0000118 "Wound healing by tertiary intention"@en ;
    rdfs:subClassOf ns1:GO_0042060 .

wont:WONT_0000311 a owl:Class ;
    rdfs:label "Thoracic drain" ;
    rdfs:subClassOf wont:WONT_0000093 .

wont:WONT_0000387 a owl:Class ;
    rdfs:label "Wound cleansing process" ;
    rdfs:subClassOf wont:WONT_0000423 .

wont:WONT_0000419 a owl:Class ;
    rdfs:label "Wound size measurement process"@en ;
    ns1:IAO_0000115 "A wound diagnostic process that has as specified output a wound depth measurement datum."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom wont:WONT_0000448 ],
        wont:WONT_0000395 .

wont:WONT_0000426 a owl:Class ;
    rdfs:label "Wound with accompanying fracture" ;
    rdfs:subClassOf wont:WONT_0000339,
        wont:WONT_0000380 .

wont:WONT_0000434 a owl:Class ;
    rdfs:label "degree of maceration"@en ;
    ns1:IAO_0000115 "A quality of a wound edge that is the extent to which its tissue has been softened by prolonged exposure to moisture."@en ;
    rdfs:subClassOf ns1:BFO_0000019 .

wont:WONT_0000436 a owl:Class ;
    rdfs:label "Burn classification scale"@en ;
    ns1:IAO_0000115 "A wound classification scale that stratifies burn wounds by the depth of tissue destroyed."@en ;
    rdfs:subClassOf wont:WONT_0000066 .

wont:WONT_0000437 a owl:Class ;
    rdfs:label "Burn classification grade"@en ;
    ns1:IAO_0000115 "A wound classification grade that is a category of the burn classification scale."@en ;
    rdfs:subClassOf wont:WONT_120016 .

wont:WONT_0000451 a owl:Class ;
    rdfs:label "degree of skin adherence to underlying tissue"@en ;
    ns1:IAO_0000115 "A quality of skin that is the extent to which it remains attached to the tissue beneath it."@en ;
    rdfs:subClassOf ns1:BFO_0000019 .

wont:WONT_0000452 a owl:Class ;
    rdfs:label "degree of granulation"@en ;
    ns1:IAO_0000115 "A quality of a wound base that is the extent to which it is covered by granulation tissue."@en ;
    rdfs:subClassOf ns1:BFO_0000019 .

wont:WONT_0000453 a owl:Class ;
    rdfs:label "degree of necrosis"@en ;
    ns1:IAO_0000115 "A quality of a wound base that is the extent to which its tissue is necrotic."@en ;
    rdfs:subClassOf ns1:BFO_0000019 .

wont:WONT_0000454 a owl:Class ;
    rdfs:label "degree of fibrin coverage"@en ;
    ns1:IAO_0000115 "A quality of a wound base that is the extent to which it is covered by fibrin."@en ;
    rdfs:subClassOf ns1:BFO_0000019 .

wont:WONT_0000463 a owl:Class ;
    rdfs:label "epithelialized"@en ;
    ns1:IAO_0000115 "A degree of epithelialization that qualifies its bearer as epithelialized."@en ;
    rdfs:subClassOf wont:WONT_0000455 .

wont:WONT_0000466 a owl:Class ;
    rdfs:label "Angiopathy"@en ;
    ns1:IAO_0000115 "A material disease entity consisting in an abnormal structure of the wall or of the lumen of one or more blood vessels, such that perfusion of the tissue those vessels supply is reduced."@en ;
    ns1:IAO_0000116 "Minted as the shared parent of Microangiopathy (WONT_0000201) and Peripheral arterial occlusive disease (WONT_0000229) so that Angiopathic wound (WONT_0000015) has a single material co-location target. Before the causal-role groupings were dissolved, the two sat side by side under a class that grouped them by what they were said to cause; they are grouped here by what they are."@en ;
    rdfs:subClassOf mild:MILD_120020 .

wont:WONT_0000471 a owl:Class ;
    rdfs:label "Scarring process"@en ;
    ns1:IAO_0000115 "A wound healing related physiological process in which fibrous connective tissue replaces tissue lost in a wound, yielding a scar rather than restoration of the original tissue architecture."@en ;
    rdfs:comment "Bridging annotation, not subsumption. HP_0100699 'Scarring' is a phenotypic abnormality, i.e. a quality and therefore a continuant, whereas this class is the process of scar formation. Asserting rdfs:subClassOf between them crosses the continuant/occurrent divide and renders both unsatisfiable, so the relation is recorded as skos:relatedMatch instead."@en ;
    rdfs:subClassOf wont:WONT_0000409 ;
    skos:relatedMatch ns1:HP_0100699 .

wont:WONT_0000479 a owl:Class ;
    rdfs:label "contaminated"@en ;
    ns1:IAO_0000115 "A degree of microbial burden that qualifies its bearer as contaminated: microorganisms are present in the wound but are not multiplying."@en ;
    rdfs:subClassOf wont:WONT_0000478 .

wont:WONT_0000480 a owl:Class ;
    rdfs:label "infected"@en ;
    ns1:IAO_0000115 "A degree of microbial burden that qualifies its bearer as infected: microorganisms are present in the wound, multiply in it and elicit a host response."@en ;
    ns1:IAO_0000116 "Added as a determinate beside the process reading, not instead of it: Infected wound (WONT_0000163) also participates in a wound infection process (WONT_0000410)."@en ;
    rdfs:subClassOf wont:WONT_0000478 .

wont:WONT_0000486 a owl:Class ;
    rdfs:label "sterile"@en ;
    ns1:IAO_0000115 "A degree of microbial burden that qualifies its bearer as sterile: no viable microorganisms are present in the wound."@en ;
    rdfs:comment "PATO_0000956 sterile is a fertility quality and is deliberately not used here."@en ;
    rdfs:subClassOf wont:WONT_0000478 .

wont:WONT_0000510 a owl:Class ;
    rdfs:label "Arterial insufficiency wound"@en ;
    ns1:IAO_0000115 "A wound that is the output of a wound development process that has as part a wound causing process of the course of a peripheral arterial occlusive disease. No claim is made that the disorder caused the wound."@en ;
    ns1:IAO_0000118 "arterial insufficiency ulcer"@en,
        "arterial wound"@en,
        "ischemic ulcer"@en ;
    rdfs:subClassOf wont:WONT_0000015,
        wont:WONT_0000380 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000380 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0002353 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( wont:WONT_0000414 [ a owl:Restriction ;
                                            owl:onProperty ns1:BFO_0000051 ;
                                            owl:someValuesFrom wont:WONT_0000543 ] ) ] ] ) ] .

wont:WONT_0000512 a owl:Class ;
    rdfs:label "colonized"@en ;
    ns1:IAO_0000115 "A degree of microbial burden that qualifies its bearer as colonized: microorganisms are present in the wound and multiply in it, without invading its tissue or eliciting a host response."@en ;
    rdfs:subClassOf wont:WONT_0000478 .

wont:WONT_0000513 a owl:Class ;
    rdfs:label "Partial thickness"@en ;
    ns1:IAO_0000115 "A burn wound classification grade according to Hildanus and Derganc in which the injury extends into but not through the dermis; its instances are the superficial and the deep partial-thickness grade."@en ;
    ns1:IAO_0000118 "Second degree"@en ;
    rdfs:subClassOf wont:WONT_0000495 .

wont:WONT_0000523 a owl:Class ;
