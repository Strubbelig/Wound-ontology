    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000380 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000086 ;
                        owl:someValuesFrom wont:WONT_0000463 ] ) ] .

wont:WONT_0000507 a owl:Class ;
    rdfs:label "Large wound"@en ;
    ns1:IAO_0000115 "A wound that bears the quality increased size: its extent is greater than is typical for a wound of its kind."@en ;
    rdfs:subClassOf wont:WONT_0000380 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000380 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000086 ;
                        owl:someValuesFrom ns1:PATO_0002057 ] ) ] .

wont:WONT_0000508 a owl:Class ;
    rdfs:label "Deep wound"@en ;
    ns1:IAO_0000115 "A wound that bears the quality increased depth: it extends further into the tissue than is typical for a wound of its kind."@en ;
    rdfs:subClassOf wont:WONT_0000380 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( wont:WONT_0000380 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000086 ;
                        owl:someValuesFrom ns1:PATO_0001596 ] ) ] .

wont:WONT_0000509 a owl:Class ;
    rdfs:label "Ischemic wound"@en ;
    ns1:IAO_0000115 "An arterial insufficiency wound that bears the quality ischemic."@en ;
