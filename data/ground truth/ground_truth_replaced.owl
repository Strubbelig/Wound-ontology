ns1:CHEBI_15882 a owl:Class ;
    rdfs:label "phenol",
        "phenol"@en ;
    ns1:IAO_0000115 "An organic hydroxy compound that consists of benzene bearing a single hydroxy substituent. The parent of the class of phenols." ;
    rdfs:subClassOf ns1:WOND_0000017 .

ns1:CHEBI_16236 a owl:Class ;
    rdfs:label "ethanol",
        "ethanol"@en ;
    ns1:IAO_0000115 "A primary alcohol that is ethane in which one of the hydrogens is substituted by a hydroxy group." ;
    rdfs:subClassOf ns1:WOND_0000010 .

ns1:CHEBI_164200 a owl:Class ;
    rdfs:label "Triclosan",
        "triclosan" ;
    ns1:IAO_0000115 "An aromatic ether that is phenol which is substituted at C-5 by a chloro group and at C-2 by a 2,4-dichlorophenoxy group. It is widely used as a preservative and antimicrobial agent in personal care products such as soaps, skin creams, toothpaste and deodorants as well as in household items such as plastic chopping boards, sports equipment and shoes." ;
    rdfs:subClassOf ns1:WOND_0000025 .

ns1:CHEBI_17606 a owl:Class ;
    rdfs:label "diiodine",
        "Iodine"@en ;
    ns1:IAO_0000115 "Molecule comprising two covalently bonded iodine atoms with overall zero charge.." ;
    rdfs:subClassOf ns1:CHEBI_24473 .

ns1:CHEBI_231501 a owl:Class ;
    rdfs:label "potassium permanganate",
        "potassium permanganate"@en ;
    ns1:IAO_0000115 "An inorganic potassium salt of permanganic acid." ;
    ns1:IAO_0000118 "Crystal violet"@en ;
    rdfs:subClassOf ns1:WOND_0000020 .

ns1:CHEBI_24757 a owl:Class ;
    rdfs:label "hypochlorous acid",
        "hypochlorous acid"@en ;
    ns1:IAO_0000115 "A chlorine oxoacid with formula HOCl; a weak, unstable acid, it is the active form of chlorine in water." ;
    rdfs:subClassOf ns1:WOND_0000017 .

ns1:CHEBI_27363 a owl:Class ;
    rdfs:label "zinc atom",
        "zinc atom"@en ;
    rdfs:subClassOf ns1:WOND_0000022 .

ns1:CHEBI_28694 a owl:Class ;
    rdfs:label "copper atom",
        "copper atom"@en ;
    rdfs:subClassOf ns1:WOND_0000022 .

ns1:CHEBI_3020 a owl:Class ;
    rdfs:label "benzalkonium chloride",
        "benzalkonium chloride"@en ;
    ns1:IAO_0000115 "A class of quaternary ammonium chloride salts in which the nitrogen is substituted by a benzyl group, two methyl groups and an even-numbered alkyl chain." ;
    rdfs:subClassOf ns1:CHEBI_35273 .

ns1:CHEBI_30512 a owl:Class ;
    rdfs:label "silver atom",
        "silver atom"@en ;
    rdfs:subClassOf ns1:WOND_0000022 .

ns1:CHEBI_33301 a owl:Class ;
    rdfs:label "bismuth atom",
        "bismuth atom"@en ;
    rdfs:subClassOf ns1:WOND_0000022 .

ns1:CHEBI_36080 a owl:Class ;
    rdfs:label "protein",
        "protein"@en ;
    ns1:IAO_0000115 "A biological macromolecule minimally consisting of one polypeptide chain synthesized at the ribosome." ;
    rdfs:subClassOf ns1:WOND_0000217 .

ns1:CHEBI_3614 a owl:Class ;
    rdfs:label "Chlorhexidine",
        "chlorhexidine" ;
    ns1:IAO_0000115 "A bisbiguanide compound with a structure consisting of two (<em>p</em>-chlorophenyl)guanide units linked by a hexamethylene bridge." ;
    rdfs:subClassOf ns1:WOND_0000019 .

ns1:CHEBI_8347 a owl:Class ;
    rdfs:label "Povidone-iodine" ;
    rdfs:subClassOf ns1:WOND_0000021 .

ns1:DOID_0050426 a owl:Class ;
    rdfs:label "Stevens-Johnson syndrome" ;
    ns1:IAO_0000115 "A skin disease that is characterized by ulceration of less than 10 percent of the surface area of the body. The disease is often precipitated by the use of medications, such as antibiotics or antiepileptics, or onset of infection." ;
    rdfs:subClassOf ns1:WOND_0000194 .

ns1:DOID_0050853 a owl:Class ;
    rdfs:label "Chronic venous insufficiency",
        "chronic venous insufficiency" ;
    ns1:IAO_0000115 "A venous insufficiency that is characterized by lower extremity swelling, hyperpigmentation, pruritus and venous ulceration caused by blood pooling in the veins." ;
    rdfs:subClassOf ns1:WOND_0000192 .

ns1:DOID_0060851 a owl:Class ;
    rdfs:label "Pemphigus vulgaris",
        "pemphigus vulgaris" ;
    ns1:IAO_0000115 "A pemphigus characterized by autosomal dominant blisters and erosions on the skin and mucous membranes erosions cause by autoantibodies to intercellular cement substance." ;
    rdfs:subClassOf ns1:WOND_0000194 .

ns1:DOID_2730 a owl:Class ;
    rdfs:label "Epidermolysis bullosa",
        "epidermolysis bullosa" ;
    ns1:IAO_0000115 "A vesiculobullous skin disease that is characterized by formation of blisters with only minor skin trauma, which can cause widespread wounds, dehydration, electrolyte abnormalities, and severe infection, frequently develops_from mutations in connective tissue elements, including genes encoding keratin, collagen, and laminin." ;
    rdfs:subClassOf ns1:WOND_0000194 .

ns1:DOID_3042 a owl:Class ;
    rdfs:label "Allergic contact dermatitis",
        "allergic contact dermatitis" ;
    ns1:IAO_0000115 "A contact dermatitis that is an allergic skin reaction to foreign chemical or substances leading to red, itchy, weepy reaction where the skin has come into contact with a substance that the immune system recognizes as foreign." ;
    rdfs:subClassOf ns1:WOND_0000194 .

ns1:DOID_3132 a owl:Class ;
    rdfs:label "Porphyria cutanea tarda",
        "porphyria cutanea tarda" ;
    ns1:IAO_0000115 "An acute porphyria characterized by painful, blistering skin lesions that develop on sun-exposed skin." ;
    rdfs:subClassOf ns1:WOND_0000194 .

ns1:DOID_4347 a owl:Class ;
    rdfs:label "Lymphocele",
        "lymphocele" ;
    rdfs:subClassOf ns1:BFO_0000040 .

ns1:DOID_8506 a owl:Class ;
    rdfs:label "Bullous pemphigoid",
        "bullous pemphigoid" ;
    ns1:IAO_0000115 "A pemphigoid that is characterized by large blisters." ;
    rdfs:subClassOf ns1:WOND_0000194 .

ns1:DOID_8536 a owl:Class ;
    rdfs:label "Herpes zoster",
        "herpes zoster" ;
    ns1:IAO_0000115 "A viral infectious disease that results_in infection located_in nerve fiber, has_material_basis_in Human herpesvirus 3 (Varicellovirus humanalpha3), which reactivates after appearing as chickenpox in childhood. The virus is transmitted_by direct contact with the rash, which can develop into chickenpox in newly-infected individuals. The infection has_symptom rash which is followed by blisters, has_symptom headache, has_symptom fever, has_symptom malaise, has_symptom itching, has_symptom burning pain, and has_symptom paresthesia." ;
    rdfs:subClassOf ns1:WOND_0000194 .

ns1:DOID_9351 a owl:Class ;
    rdfs:label "Diabetes mellitus",
        "diabetes mellitus" ;
    ns1:IAO_0000115 "A glucose metabolism disease that is characterized by chronic hyperglycaemia with disturbances of carbohydrate, fat and protein metabolism resulting from defects in insulin secretion, insulin action, or both." ;
    rdfs:subClassOf ns1:WOND_0000192 .

ns1:DOID_9970 a owl:Class ;
    rdfs:label "Obesity",
        "obesity" ;
    ns1:IAO_0000115 "An overnutrition that is characterized by excess body fat, traditionally defined as an elevated ratio of weight to height (specifically 30 kilograms per meter squared), has_material_basis_in a multifactorial etiology related to excess nutrition intake, decreased caloric utilization, and genetic susceptibility, and possibly medications and certain disorders of metabolism, endocrine function, and mental illness." ;
    rdfs:subClassOf ns1:WOND_0000193 .

ns1:HP_0000961 a owl:Class ;
    rdfs:label "Cyanosis" ;
    ns1:IAO_0000115 "Bluish discoloration of the skin and mucosa due to poor circulation or inadequate oxygenation of arterial or capillary blood." ;
    rdfs:subClassOf ns1:PATO_0000014 .

ns1:HP_0000980 a owl:Class ;
    rdfs:label "Pallor" ;
    ns1:IAO_0000115 "Abnormally pale skin." ;
    rdfs:subClassOf ns1:PATO_0000014 .

ns1:HP_0004395 a owl:Class ;
    rdfs:label "Malnutrition" ;
    ns1:IAO_0000115 "A deficiency in the intake of energy and nutrients." ;
    rdfs:subClassOf ns1:WOND_0000193 .

ns1:HP_0025615 a owl:Class ;
    rdfs:label "Abscess",
        "abscess"@en ;
    ns1:IAO_0000115 "An abscess is a localized collection of purulent material surrounded by inflammation and granulation." ;
    rdfs:subClassOf ns1:BFO_0000040 .

ns1:HP_0100758 a owl:Class ;
    rdfs:label "Gangrene",
        "gangrene"@en ;
    ns1:IAO_0000115 "A serious and potentially life-threatening condition that arises when a considerable mass of body tissue dies (necrosis)." ;
    rdfs:subClassOf ns1:WOND_0000210 .

