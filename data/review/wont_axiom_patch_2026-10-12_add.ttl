obo:FMA_25452 rdf:type owl:Class ; rdfs:label "Surface of heel"@en .
obo:FMA_25046 rdf:type owl:Class ; rdfs:label "Toe"@en .
obo:FMA_35451 rdf:type owl:Class ; rdfs:label "Medial malleolus"@en .
obo:FMA_35502 rdf:type owl:Class ; rdfs:label "Lateral malleolus"@en .

# FMA -- skin of a region
obo:FMA_37834 rdf:type owl:Class ; rdfs:label "Skin of foot"@en .
obo:FMA_37849 rdf:type owl:Class ; rdfs:label "Skin of sole of foot"@en .
obo:FMA_37846 rdf:type owl:Class ; rdfs:label "Skin of dorsum of foot"@en .
