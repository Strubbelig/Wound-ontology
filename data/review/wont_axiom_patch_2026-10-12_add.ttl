# WONT axiom patch, 2026-10-12 -- ADDITIONS
# For the curated WONT (data/ground truth/ground_truth_final.owl); a hand edit.
# Source: WONT_AXIOM_TODO.md, decisions D1-D7 and N2/N4 (2026-10-12).
# The matching removals are in wont_axiom_patch_2026-10-12_remove.ttl.
#
# New ids: WONT_0007807 ... WONT_0007838 (NEXT_FREE_WONT_ID.txt said 0007807).
# Four classes keep the id the pipeline already gave the same class from the
# literature (rule 71, one class one id): WONT_0001864 Complete-Thickness Wound,
# WONT_0006845 Surgical Wound, WONT_0005837 Radiation-Induced Ulcer,
# WONT_0006773 Superficial Partial Thickness Burn.
# Set Protégé's counter to 7839 afterwards.

@prefix : <https://bioportal.bioontology.org/ontologies/WONT/> .
@prefix wont: <https://bioportal.bioontology.org/ontologies/WONT/> .
@prefix mild: <https://bioportal.bioontology.org/ontologies/MILD/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

#################################################################
#  External classes WONT now names (they seed the import modules,
#  rule 34). Labels as in the source ontologies.
#################################################################

# FMA (fma_obo.owl 2020-04-13, the same OBO IRIs as OFL) -- layers
obo:FMA_7163 rdf:type owl:Class ; rdfs:label "Skin"@en .
obo:FMA_70596 rdf:type owl:Class ; rdfs:label "Epidermis"@en .
obo:FMA_70323 rdf:type owl:Class ; rdfs:label "Dermis"@en .
obo:FMA_64776 rdf:type owl:Class ; rdfs:label "Papillary layer of dermis"@en .
obo:FMA_64778 rdf:type owl:Class ; rdfs:label "Reticular layer of dermis"@en .
obo:FMA_70544 rdf:type owl:Class ; rdfs:label "Hypodermis"@en .
obo:FMA_74315 rdf:type owl:Class ; rdfs:label "Subcutaneous adipose tissue"@en .
