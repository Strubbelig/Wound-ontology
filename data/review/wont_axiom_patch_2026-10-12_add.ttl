obo:FMA_12167 rdf:type owl:Class ; rdfs:label "Skin of trunk"@en .
obo:FMA_22988 rdf:type owl:Class ; rdfs:label "Skin of abdomen"@en .
obo:FMA_10464 rdf:type owl:Class ; rdfs:label "Skin of breast"@en .
obo:FMA_20429 rdf:type owl:Class ; rdfs:label "Skin of perineum"@en .
obo:FMA_12166 rdf:type owl:Class ; rdfs:label "Skin of head"@en .
obo:FMA_24757 rdf:type owl:Class ; rdfs:label "Skin of scalp"@en .
obo:FMA_24758 rdf:type owl:Class ; rdfs:label "Skin of face"@en .
