obo:FMA_224804 rdf:type owl:Class ; rdfs:label "Bone tissue"@en .
obo:FMA_65132 rdf:type owl:Class ; rdfs:label "Nerve"@en .
obo:FMA_63183 rdf:type owl:Class ; rdfs:label "Blood vessel"@en .
obo:FMA_9637 rdf:type owl:Class ; rdfs:label "Portion of tissue"@en .
obo:FMA_86166 rdf:type owl:Class ; rdfs:label "Zone of skin"@en .
obo:FMA_67726 rdf:type owl:Class ; rdfs:label "Surface of skin"@en .

# FMA -- regions (for "located in some X", D5: by query, not pre-coordinated)
obo:FMA_7153 rdf:type owl:Class ; rdfs:label "Cardinal body part"@en .
obo:FMA_7154 rdf:type owl:Class ; rdfs:label "Head"@en .
obo:FMA_46494 rdf:type owl:Class ; rdfs:label "Scalp"@en .
obo:FMA_24728 rdf:type owl:Class ; rdfs:label "Face"@en .
obo:FMA_7155 rdf:type owl:Class ; rdfs:label "Neck"@en .
obo:FMA_7181 rdf:type owl:Class ; rdfs:label "Trunk"@en .
obo:FMA_9576 rdf:type owl:Class ; rdfs:label "Thorax"@en .
obo:FMA_14181 rdf:type owl:Class ; rdfs:label "Back"@en .
obo:FMA_9577 rdf:type owl:Class ; rdfs:label "Abdomen"@en .
obo:FMA_14627 rdf:type owl:Class ; rdfs:label "Anterior abdominal wall"@en .
obo:FMA_9578 rdf:type owl:Class ; rdfs:label "Pelvis"@en .
obo:FMA_9579 rdf:type owl:Class ; rdfs:label "Perineum"@en .
obo:FMA_25245 rdf:type owl:Class ; rdfs:label "Buttock"@en .
obo:FMA_9601 rdf:type owl:Class ; rdfs:label "Breast"@en .
obo:FMA_16202 rdf:type owl:Class ; rdfs:label "Sacrum"@en .
obo:FMA_31692 rdf:type owl:Class ; rdfs:label "Surface of sacrum"@en .
obo:FMA_32852 rdf:type owl:Class ; rdfs:label "Greater trochanter"@en .
obo:FMA_17010 rdf:type owl:Class ; rdfs:label "Ischial tuberosity"@en .
obo:FMA_7183 rdf:type owl:Class ; rdfs:label "Upper limb"@en .
obo:FMA_24890 rdf:type owl:Class ; rdfs:label "Arm"@en .
obo:FMA_24901 rdf:type owl:Class ; rdfs:label "Elbow"@en .
obo:FMA_9663 rdf:type owl:Class ; rdfs:label "Forearm"@en .
obo:FMA_9712 rdf:type owl:Class ; rdfs:label "Hand"@en .
obo:FMA_7184 rdf:type owl:Class ; rdfs:label "Lower limb"@en .
obo:FMA_24879 rdf:type owl:Class ; rdfs:label "Free lower limb"@en .
