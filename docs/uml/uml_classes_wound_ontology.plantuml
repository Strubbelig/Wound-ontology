NormalizationResponse --> "*" NormalizationEntry : mappings
FillNanBatchResponse --> "*" FillNanEntityResult : results
GateBatchResponse --> "*" GateVerdict : verdicts
OccursInTargetBatch --> "*" OccursInTargetResult : results
TypingResponse --> "*" TypedTerm : terms
RelationResponse --> "*" RelationCandidate : relations
MappingVerdictBatch --> "*" MappingVerdict : results
TermMapper --> "1" TermMappingAndGate : term_mapping
_PassCache --> "1" TermMappingAndGate : owner
TermMappingAndGate --> "1" DataManager : dm
TermMappingAndGate ..> _PassCache : «create»
Orchestrator *-- "1" DataManager : dm
